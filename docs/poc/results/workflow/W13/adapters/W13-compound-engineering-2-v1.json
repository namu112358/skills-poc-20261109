{
  "create": {
    "method": "POST",
    "path": "/api/instruments/{instrumentId}/reservations",
    "body": {
      "startOn": "{start}",
      "endOn": "{end}"
    },
    "id": "reservation.id"
  },
  "list": {
    "method": "GET",
    "path": "/api/instruments/{instrumentId}/reservations?cancelled=1",
    "items": "reservations"
  },
  "cancel": {
    "method": "POST",
    "path": "/api/instruments/{instrumentId}/reservations/{reservationId}/cancel"
  },
  "fields": {
    "id": "id",
    "status": [
      "cancelledAt"
    ],
    "start": "startOn",
    "end": "endOn",
    "user": "reserverId"
  },
  "status": {
    "active": [
      "null"
    ],
    "cancelled": [
      "@notnull"
    ]
  },
  "jobs": []
}