  },
  "list": {
   "path": "/api/instruments/{instrumentId}/order",
   "items": "orders"
  },
  "fields": {
   "id": "id",
   "status": "status",
   "externalId": "order_id",
   "returnOn": "return_on"
  },
  "status": {
   "accepted": [
    "ordered"
   ]
  }
 },
 "f5": {
  "list": {
   "path": "/api/instruments/{instrumentId}/history",
   "items": "history"
  },
  "fields": {
