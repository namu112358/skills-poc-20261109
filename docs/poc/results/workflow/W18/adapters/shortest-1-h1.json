   "status": "status",
   "start": "startOn",
   "end": "endOn",
   "user": "userId"
  },
  "status": {
   "active": [
    "reserved"
   ],
   "cancelled": [
    "cancelled"
   ]
  }
 },
 "f3": {
  "list": {
   "path": "/api/locations",
   "items": "locations"
  },
  "create": {
   "method": "POST",
   "path": "/api/locations",
   "body": {
    "name": "{name}"
   },
   "id": "location.id"
  },
  "rename": {
   "method": "PATCH",
   "path": "/api/locations/{locationId}",
   "body": {
    "name": "{name}"
   }
  },
  "delete": {
   "method": "DELETE",
   "path": "/api/locations/{locationId}"
  },
  "fields": {
   "id": "id",
   "name": "name"
  },
  "instrumentSet": {
   "location": "{name}"
  },
  "filter": {
   "param": "location",
   "value": "name"
  }
 },
 "f4": {
  "create": {
   "method": "POST",
   "path": "/api/instruments/{instrumentId}/order",
   "body": {},
