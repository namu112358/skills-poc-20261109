   "method": "POST",
   "path": "/api/notify-due"
  }
 },
 "f2": {
  "create": {
   "method": "POST",
   "path": "/api/instruments/{instrumentId}/reservations",
   "body": {
    "startOn": "{start}",
    "endOn": "{end}"
   },
   "id": "reservation.id"
  },
  "list": {
   "path": "/api/instruments/{instrumentId}/reservations",
   "items": "reservations"
  },
  "cancel": {
   "method": "POST",
   "path": "/api/instruments/{instrumentId}/reservations/{reservationId}/cancel"
  },
  "fields": {
