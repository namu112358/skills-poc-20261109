@@ -0,0 +1,43 @@
+import { getDb, type Db } from "./db/index.ts";
+import type { ValidationResult } from "./tasks.ts";
+
+/** タグの名前を検証する。前後の空白を除いた 1〜20 文字で、空白・カンマ・スラッシュを含まないこと。 */
+export function validateTagName(value: unknown): ValidationResult<string> {
+  if (typeof value !== "string") return { ok: false, errors: ["タグの名前を入力してください"] };
+  const name = value.trim();
+  if (name.length < 1 || name.length > 20) return { ok: false, errors: ["タグの名前は 1〜20 文字で入力してください"] };
+  if (/[\s,/]/.test(name)) return { ok: false, errors: ["タグの名前に空白・カンマ・スラッシュは使えません"] };
+  return { ok: true, value: name };
+}
+
+export function validateTagInput(body: unknown): ValidationResult<string> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  return validateTagName((body as Record<string, unknown>).name);
+}
+
+export function listTaskTags(taskId: number, db: Db = getDb()): string[] {
+  const rows = db.prepare("SELECT name FROM task_tags WHERE task_id = ? ORDER BY id").all(taskId) as { name: string }[];
+  return rows.map((r) => r.name);
+}
+
+/** タスク ID ごとのタグ（付けた古い順）。 */
+export function tagsByTask(db: Db = getDb()): Map<number, string[]> {
+  const rows = db.prepare("SELECT task_id, name FROM task_tags ORDER BY id").all() as { task_id: number; name: string }[];
+  const map = new Map<number, string[]>();
+  for (const r of rows) map.set(r.task_id, [...(map.get(r.task_id) ?? []), r.name]);
+  return map;
+}
+
+/** タグを付ける。すでに付いていれば false。 */
+export function addTaskTag(taskId: number, name: string, db: Db = getDb()): boolean {
+  const { changes } = db.prepare("INSERT OR IGNORE INTO task_tags (task_id, name) VALUES (?, ?)").run(taskId, name);
+  return Number(changes) > 0;
+}
+
+/** タグを外す。付いていなければ false。 */
+export function removeTaskTag(taskId: number, name: string, db: Db = getDb()): boolean {
+  const { changes } = db.prepare("DELETE FROM task_tags WHERE task_id = ? AND name = ?").run(taskId, name);
+  return Number(changes) > 0;
+}
