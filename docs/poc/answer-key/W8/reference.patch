diff --git a/tests/tags.test.ts b/tests/tags.test.ts
new file mode 100644
index 0000000..e43d28e
--- /dev/null
+++ b/tests/tags.test.ts
@@ -0,0 +1,41 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { addTaskTag, listTaskTags, removeTaskTag, tagsByTask, validateTagInput, validateTagName } from "../src/lib/tags.ts";
+import { listTasks } from "../src/lib/tasks.ts";
+
+describe("validateTagName", () => {
+  it("trims and accepts 1-20 chars", () => {
+    assert.deepEqual(validateTagName("  急ぎ "), { ok: true, value: "急ぎ" });
+    assert.equal(validateTagName("a".repeat(20)).ok, true);
+    assert.equal(validateTagName("a".repeat(21)).ok, false);
+    assert.equal(validateTagName("   ").ok, false);
+  });
+  it("rejects spaces, commas, slashes and non-strings", () => {
+    for (const v of ["a b", "a,b", "a/b", 1, null, undefined]) assert.equal(validateTagName(v).ok, false);
+    assert.equal(validateTagInput(undefined).ok, false);
+  });
+});
+
+describe("task tags", () => {
+  it("adds in order, rejects duplicates, is case-sensitive, removes", () => {
+    const db = openDb();
+    assert.equal(addTaskTag(1, "急ぎ", db), true);
+    assert.equal(addTaskTag(1, "Bug", db), true);
+    assert.equal(addTaskTag(1, "bug", db), true);
+    assert.equal(addTaskTag(1, "急ぎ", db), false);
+    assert.deepEqual(listTaskTags(1, db), ["急ぎ", "Bug", "bug"]);
+    assert.equal(removeTaskTag(1, "Bug", db), true);
+    assert.equal(removeTaskTag(1, "Bug", db), false);
+    assert.deepEqual(listTaskTags(1, db), ["急ぎ", "bug"]);
+  });
+  it("filters tasks by tag and status", () => {
+    const db = openDb();
+    addTaskTag(1, "x", db);
+    addTaskTag(4, "x", db);
+    assert.deepEqual(listTasks({ tag: "x" }, db).map((t) => t.id), [1, 4]);
+    assert.deepEqual(listTasks({ tag: "x", status: "todo" }, db).map((t) => t.id), [4]);
+    assert.deepEqual(listTasks({ tag: "none" }, db), []);
+    assert.deepEqual(tagsByTask(db).get(4), ["x"]);
+  });
+});
