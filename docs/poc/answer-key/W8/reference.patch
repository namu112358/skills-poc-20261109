+"use client";
+import { useState, type FormEvent } from "react";
+
+export default function TagEditor({ taskId, initialTags }: { taskId: number; initialTags: string[] }) {
+  const [tags, setTags] = useState(initialTags);
+  const [name, setName] = useState("");
+  const [error, setError] = useState("");
+
+  async function add(e: FormEvent) {
+    e.preventDefault();
+    const res = await fetch(`/api/tasks/${taskId}/tags`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ name }),
+    });
+    const data = await res.json().catch(() => ({}));
+    if (res.status === 201) {
+      setTags(data.tags);
+      setName("");
+      setError("");
+    } else {
+      setError([data.error, ...(data.details ?? [])].filter(Boolean).join(" ") || "タグを追加できませんでした");
+    }
+  }
+
+  async function remove(tag: string) {
+    const res = await fetch(`/api/tasks/${taskId}/tags/${encodeURIComponent(tag)}`, { method: "DELETE" });
+    if (res.status === 204 || res.status === 404) setTags((ts) => ts.filter((t) => t !== tag));
+  }
+
+  return (
+    <section>
+      <h2>タグ</h2>
+      {tags.length === 0 ? (
+        <p>タグはまだありません。</p>
+      ) : (
+        <ul>
+          {tags.map((t) => (
+            <li key={t}>
+              <span data-testid="tag">{t}</span>{" "}
+              <button type="button" aria-label={`タグ「${t}」を外す`} onClick={() => remove(t)}>
+                外す
+              </button>
+            </li>
+          ))}
+        </ul>
+      )}
+      <form aria-label="タグの追加" onSubmit={add}>
+        <input name="name" value={name} onChange={(e) => setName(e.target.value)} aria-label="タグの名前" />{" "}
+        <button type="submit">追加する</button>
+        {error && <p role="alert">{error}</p>}
+      </form>
+    </section>
+  );
+}
