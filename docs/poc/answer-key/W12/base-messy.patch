@@ -0,0 +1,10 @@
+// 台帳の CSV 出力（旧画面用。2025 年に画面を作り直したあとは使っていない）
+import type { Instrument } from "../instruments.ts";
+
+export function toCsv(rows: Instrument[]): string {
+  const head = "kanri_no,meisho,katashiki,basho,kanrisha,shuki,zenkai,jotai";
+  const body = rows.map((r) =>
+    [r.managementNo, r.name, r.model, r.location, r.managerId, r.intervalMonths, r.lastCalibratedOn, r.status].join(","),
+  );
+  return [head, ...body].join("\n");
+}
