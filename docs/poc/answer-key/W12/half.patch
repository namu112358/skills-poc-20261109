+++ b/src/lib/notify-client.ts
@@ -0,0 +1,37 @@
+// 社内通知サービスのクライアント（失敗したら 1 秒おきに 3 回まで送り直す）。
+export type Notification = { recipient: string; title: string; body: string; category?: string };
+export type SendResult =
+  | { ok: true; id: string; attempts: number }
+  | { ok: false; retryable: boolean; status?: number; error: string; attempts: number };
+export type NotifyClient = { send(n: Notification, idempotencyKey: string): Promise<SendResult> };
+
+export function createNotifyClient(options: { url: string; token: string; fetch?: typeof fetch; sleep?: (ms: number) => Promise<void> }): NotifyClient {
+  const doFetch = options.fetch ?? fetch;
+  const sleep = options.sleep ?? ((ms: number) => new Promise<void>((r) => setTimeout(r, ms)));
+  return {
+    async send(n) {
+      let last: SendResult = { ok: false, retryable: true, error: "", attempts: 0 };
+      for (let attempt = 1; attempt <= 3; attempt++) {
+        try {
+          const res = await doFetch(new URL("/v1/notifications", options.url), {
+            method: "POST",
+            headers: { authorization: `Bearer ${options.token}`, "content-type": "application/json" },
+            body: JSON.stringify(n),
+          });
+          if (res.ok) return { ok: true, id: "", attempts: attempt };
+          last = { ok: false, retryable: true, status: res.status, error: `HTTP ${res.status}`, attempts: attempt };
+        } catch (e) {
+          console.error("notify error", e);
+          last = { ok: false, retryable: true, error: String(e), attempts: attempt };
+        }
+        await sleep(1000);
+      }
+      return last;
+    },
+  };
+}
+
+export function notifyClientFromEnv(env: NodeJS.ProcessEnv = process.env): NotifyClient | undefined {
+  if (!env.NOTIFY_API_URL || !env.NOTIFY_API_TOKEN) return undefined;
+  return createNotifyClient({ url: env.NOTIFY_API_URL, token: env.NOTIFY_API_TOKEN });
+}
