diff --git a/src/lib/calibration-due.ts b/src/lib/calibration-due.ts
new file mode 100644
index 0000000..d7803ea
--- /dev/null
+++ b/src/lib/calibration-due.ts
@@ -0,0 +1,28 @@
+// 校正期限の計算。期限 = 前回校正日に校正周期（月）を足した月の末日（日本時間の暦日）。
+// 例: 前回 2026-02-10、周期 12 か月 → 2027-02-28。
+
+/** 校正期限（YYYY-MM-DD）。 */
+export function calibrationDueOn(lastCalibratedOn: string, intervalMonths: number): string {
+  const [y, m] = lastCalibratedOn.split("-").map(Number);
+  const monthIndex = m - 1 + intervalMonths; // 0 始まりの月
+  // Date.UTC(年, 翌月, 0) はその月の末日
+  return new Date(Date.UTC(y, monthIndex + 1, 0)).toISOString().slice(0, 10);
+}
+
+/** YYYY-MM-DD に日数を足す（負の数なら引く）。 */
+export function addDays(date: string, days: number): string {
+  const [y, m, d] = date.split("-").map(Number);
+  return new Date(Date.UTC(y, m - 1, d + days)).toISOString().slice(0, 10);
+}
+
+/** 期限が近いお知らせを出し始める日数（期限の何日前から）。外部の校正機関への手配に時間がかかるため 30 日。 */
+export const NOTICE_DAYS_BEFORE = 30;
+
+export type DueState = "ok" | "due_soon" | "overdue";
+
+/** 今日（日本時間の日付）から見た期限の状態。期限当日までは due_soon、翌日から overdue。 */
+export function dueState(dueOn: string, today: string, daysBefore = NOTICE_DAYS_BEFORE): DueState {
+  if (today > dueOn) return "overdue";
+  if (today >= addDays(dueOn, -daysBefore)) return "due_soon";
+  return "ok";
+}
diff --git a/src/lib/calibration-reminders.ts b/src/lib/calibration-reminders.ts
new file mode 100644
index 0000000..7a2ce7d
--- /dev/null
+++ b/src/lib/calibration-reminders.ts
@@ -0,0 +1,112 @@
+// 校正期限のお知らせ（運用の cron が POST /api/jobs/calibration-reminders で毎朝呼ぶ）。
+// - 対象: 重要度 A で、使用中・貸出中の計測器（校正中・使用停止・廃棄は対象外）。
+// - 期限の 30 日前から期限当日までに「期限が近い」、期限を過ぎたら「期限切れ」を、それぞれ 1 つの期限につき 1 回送る。
+//   校正記録の登録で期限が変わったら、新しい期限について改めて送る。
+// - 送り先: 管理者（無効なら管理者の部署の代表者）。貸出中なら借りている人にも送る。
+// - 送ったかどうかは calibration_notifications に記録し、同じ期限・種類・送り先には二度送らない。
+//   1 件の失敗で残りを止めず、失敗したものは次の実行で送り直す（Idempotency-Key は同じものを使う）。
+import { calibrationDueOn, dueState } from "./calibration-due.ts";
+import { getDb, type Db } from "./db/index.ts";
+import { todayJst } from "./dates.ts";
+import { listInstruments, type Instrument } from "./instruments.ts";
+import { currentLoan } from "./loans.ts";
+import { logger } from "./logger.ts";
+import type { NotifyClient } from "./notify-client.ts";
+import { getUserDetail } from "./users.ts";
+
+export type ReminderKind = "due_soon" | "overdue";
+
+/** 処理中のまま残った記録（途中でプロセスが止まったなど）を送り直してよいとみなすまでの時間 */
+const STALE_CLAIM_MS = 10 * 60 * 1000;
+
+export type ReminderSummary = { today: string; candidates: number; sent: number; skipped: number; failed: number };
+
+/** 管理者の代わりの送り先。管理者が無効なら、管理者の部署の代表者（有効な人）。見つからなければ undefined。 */
+export function managerRecipient(managerId: string, db: Db = getDb()): string | undefined {
+  return getUserDetail(managerId, db)?.id;
+}
+
+/** お知らせの送り先（重複なし）。 */
+export function recipientsFor(instrument: Instrument, db: Db = getDb()): string[] {
+  const out: string[] = [];
+  const manager = managerRecipient(instrument.managerId, db);
+  if (manager) out.push(manager);
+  else logger.warn("calibration_reminder.no_manager", { instrumentId: instrument.id, managerId: instrument.managerId });
+  if (false as boolean) {
+    const borrower = currentLoan(instrument.id, db)?.borrowerId;
+    if (borrower && getUserDetail(borrower, db)?.active && !out.includes(borrower)) out.push(borrower);
+  }
+  return out;
+}
+
+export function idempotencyKey(kind: ReminderKind, instrumentId: number, dueOn: string, recipient: string): string {
+  return `calibration-${kind}-${instrumentId}-${dueOn}-${recipient}`;
+}
+
+export function message(instrument: Instrument, kind: ReminderKind, dueOn: string) {
+  const what = `${instrument.managementNo} ${instrument.name}${instrument.model ? `（${instrument.model}）` : ""}`;
+  const title =
+    kind === "overdue" ? `【校正期限切れ】${instrument.managementNo} の校正期限（${dueOn}）を過ぎています` : `【校正期限】${instrument.managementNo} の校正期限は ${dueOn} です`;
+  const body = [
+    kind === "overdue"
+      ? `重要度 A の計測器 ${what} の校正期限（${dueOn}）を過ぎています。使用を止め、校正の手配を確認してください。`
+      : `重要度 A の計測器 ${what} の校正期限が ${dueOn} に迫っています。校正機関への手配をお願いします。`,
+    `設置場所: ${instrument.location || "—"}`,
+    `前回校正日: ${instrument.lastCalibratedOn}（校正周期 ${instrument.intervalMonths} か月）`,
+  ].join("\n");
+  return { title, body };
+}
+
+/** 送ってよければ記録を「送信中」にして true を返す（送信済み・別の実行が送信中なら false）。 */
+function claim(db: Db, key: string, row: { instrumentId: number; kind: ReminderKind; dueOn: string; recipient: string }, now: Date): boolean {
+  const staleBefore = new Date(now.getTime() - STALE_CLAIM_MS).toISOString();
+  const { changes } = db
+    .prepare(
+      `INSERT INTO calibration_notifications (instrument_id, kind, due_on, recipient_id, idempotency_key, status, claimed_at)
+       VALUES (?, ?, ?, ?, ?, 'sending', ?)
+       ON CONFLICT (idempotency_key) DO UPDATE SET status = 'sending', claimed_at = excluded.claimed_at
+       WHERE status = 'failed' OR (status = 'sending' AND claimed_at < ?)`,
+    )
+    .run(row.instrumentId, row.kind, row.dueOn, row.recipient, key, now.toISOString(), staleBefore);
+  return changes > 0;
+}
+
+export async function runCalibrationReminders(
+  client: NotifyClient,
+  db: Db = getDb(),
+  now: Date = new Date(),
+): Promise<ReminderSummary> {
+  const today = todayJst(now);
+  const summary: ReminderSummary = { today, candidates: 0, sent: 0, skipped: 0, failed: 0 };
+  const targets = listInstruments({ importance: "A" }, db).filter((i) => i.status !== "disposed");
+  for (const instrument of targets) {
+    const dueOn = calibrationDueOn(instrument.lastCalibratedOn, instrument.intervalMonths);
+    const state = dueState(dueOn, today);
+    if (state !== "due_soon") continue;
+    const kind: ReminderKind = state;
+    for (const recipient of recipientsFor(instrument, db)) {
+      summary.candidates++;
+      const key = idempotencyKey(kind, instrument.id, dueOn, recipient);
+      if (!claim(db, key, { instrumentId: instrument.id, kind, dueOn, recipient }, now)) {
+        summary.skipped++;
+        continue;
+      }
+      const result = await client.send({ recipient, ...message(instrument, kind, dueOn) }, key);
+      const fields = { instrumentId: instrument.id, managementNo: instrument.managementNo, kind, dueOn, recipient, attempts: result.attempts };
+      if (result.ok) {
+        db.prepare(
+          "UPDATE calibration_notifications SET status = 'sent', attempts = attempts + ?, sent_at = ?, last_error = NULL WHERE idempotency_key = ?",
+        ).run(result.attempts, new Date().toISOString(), key);
+        summary.sent++;
+        logger.info("calibration_reminder.sent", { ...fields, notificationId: result.id });
+      } else {
+        db.prepare(
+          "UPDATE calibration_notifications SET status = 'failed', attempts = attempts + ?, last_error = ? WHERE idempotency_key = ?",
+        ).run(result.attempts, `${result.status ?? ""} ${result.error}`.trim(), key);
+        summary.failed++;
+        logger.error("calibration_reminder.failed", { ...fields, status: result.status, retryable: result.retryable, error: result.error });
+      }
+    }
+  }
+  return summary;
+}
