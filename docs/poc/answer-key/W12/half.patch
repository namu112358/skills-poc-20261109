index 0000000..f557c64
--- /dev/null
+++ b/src/app/api/jobs/calibration-reminders/route.ts
@@ -0,0 +1,21 @@
+// POST /api/jobs/calibration-reminders — 重要度 A の計測器の校正期限が近い・過ぎたことを管理者に知らせる
+//（運用の cron が毎朝 7:30 JST に呼ぶ。docs/operations.md）。
+import { NextResponse } from "next/server";
+import { jsonError, requireJobAuth } from "@/lib/api";
+import { runCalibrationReminders } from "@/lib/calibration-reminders";
+import { logger } from "@/lib/logger";
+import { notifyClientFromEnv } from "@/lib/notify-client";
+
+export async function POST(request: Request) {
+  const denied = requireJobAuth(request, "calibration-reminders");
+  if (denied) return denied;
+  const client = notifyClientFromEnv();
+  if (!client) {
+    logger.error("job.misconfigured", { job: "calibration-reminders", missing: "NOTIFY_API_URL / NOTIFY_API_TOKEN" });
+    return jsonError(500, "通知サービスの設定がありません");
+  }
+  const started = Date.now();
+  const summary = await runCalibrationReminders(client);
+  logger.info("job.completed", { job: "calibration-reminders", ...summary, durationMs: Date.now() - started });
+  return NextResponse.json(summary);
+}
