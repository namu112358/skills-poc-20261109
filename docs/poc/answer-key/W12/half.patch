+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { addDays, calibrationDueOn, dueState } from "../src/lib/calibration-due.ts";
+
+describe("calibrationDueOn", () => {
+  it("is the last day of the month after adding the interval", () => {
+    assert.equal(calibrationDueOn("2026-02-10", 12), "2027-02-28");
+    assert.equal(calibrationDueOn("2026-01-31", 1), "2026-02-28");
+    assert.equal(calibrationDueOn("2027-08-01", 6), "2028-02-29");
+    assert.equal(calibrationDueOn("2026-11-30", 2), "2027-01-31");
+  });
+});
+
+describe("dueState", () => {
+  it("is due_soon from 30 days before the due date through the due date, then overdue", () => {
+    assert.equal(addDays("2027-01-31", -30), "2027-01-01");
+    assert.equal(dueState("2027-01-31", "2026-12-31"), "ok");
+    assert.equal(dueState("2027-01-31", "2027-01-01"), "due_soon");
+    assert.equal(dueState("2027-01-31", "2027-01-31"), "due_soon");
+    assert.equal(dueState("2027-01-31", "2027-02-01"), "overdue");
+  });
+});
diff --git a/tests/calibration-reminders.test.ts b/tests/calibration-reminders.test.ts
new file mode 100644
index 0000000..05e13ef
--- /dev/null
+++ b/tests/calibration-reminders.test.ts
@@ -0,0 +1,84 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { runCalibrationReminders } from "../src/lib/calibration-reminders.ts";
+import { openDb, type Db } from "../src/lib/db/index.ts";
+import { createInstrument, updateInstrument, type InstrumentInput } from "../src/lib/instruments.ts";
+import type { Notification, NotifyClient, SendResult } from "../src/lib/notify-client.ts";
+
+function recorder(result: (n: Notification) => SendResult = () => ({ ok: true, id: "ntf", attempts: 1 })) {
+  const sent: { n: Notification; key: string }[] = [];
+  const client: NotifyClient = {
+    async send(n, key) {
+      sent.push({ n, key });
+      return result(n);
+    },
+  };
+  return { client, sent };
+}
+
+let seq = 0;
+function add(db: Db, over: Partial<InstrumentInput> = {}) {
+  seq++;
+  return createInstrument(
+    {
+      managementNo: `TS-${String(seq).padStart(4, "0")}`,
+      name: "抵抗計",
+      model: "",
+      location: "",
+      note: "",
+      managerId: "sato",
+      intervalMonths: 12,
+      lastCalibratedOn: "2026-01-31", // 期限 2027-01-31、お知らせは 2027-01-01 から
+      status: "in_use",
+      importance: "A",
+      ...over,
+    },
+    db,
+  );
+}
+
+const at = (jstDate: string) => new Date(`${jstDate}T07:30:00+09:00`);
+function fresh() {
+  const db = openDb();
+  db.exec("UPDATE instruments SET status = 'disposed'"); // 初期データの計測器は対象にしない
+  return db;
+}
+
+describe("runCalibrationReminders", () => {
+  it("notifies once from 30 days before the due date, in Japan time", async () => {
+    const db = fresh();
+    const inst = add(db);
+    const r = recorder();
+    await runCalibrationReminders(r.client, db, at("2026-12-31"));
+    assert.equal(r.sent.length, 0);
+    await runCalibrationReminders(r.client, db, new Date("2026-12-31T15:30:00Z")); // 日本時間 2027-01-01 00:30
+    assert.equal(r.sent.length, 1);
+    assert.equal(r.sent[0].n.recipient, "sato");
+    assert.match(r.sent[0].n.title, new RegExp(inst.managementNo));
+    await runCalibrationReminders(r.client, db, at("2027-01-02"));
+    assert.equal(r.sent.length, 1);
+  });
+
+  it("retries failed sends on the next run with the same key and keeps going after a failure", async () => {
+    const db = fresh();
+    const a = add(db, { managerId: "kato" });
+    const b = add(db, { managerId: "ito" });
+    let fail = true;
+    const r = recorder((n) => (n.recipient === "kato" && fail ? { ok: false, retryable: true, status: 503, error: "x", attempts: 3 } : { ok: true, id: "n", attempts: 1 }));
+    const s1 = await runCalibrationReminders(r.client, db, at("2027-01-10"));
+    assert.deepEqual([s1.sent, s1.failed], [1, 1]);
+    fail = false;
+    const s2 = await runCalibrationReminders(r.client, db, at("2027-01-11"));
+    assert.deepEqual([s2.sent, s2.skipped], [1, 1]);
+    const keys = r.sent.filter((x) => x.key.includes(`-${a.id}-`)).map((x) => x.key);
+    assert.equal(keys.length, 2);
+    assert.equal(keys[0], keys[1]);
+    assert.ok(r.sent.some((x) => x.key.includes(`-${b.id}-`)));
+  });
+
+  it("keeps the importance when other fields are updated", () => {
+    const db = fresh();
+    const inst = add(db);
+    assert.equal(updateInstrument(inst.id, { location: "倉庫" }, db)?.importance, "A");
+  });
+});
