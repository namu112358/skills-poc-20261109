@@ -0,0 +1,17 @@
+// POST /api/assistant — { request } の依頼をアシスタントに渡し、提案された操作を実行する。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { runAssistant } from "@/lib/assistant";
+import { callLlm } from "@/lib/llm";
+
+export async function POST(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const body = (await readJson(request)) as { request?: unknown } | undefined;
+  if (typeof body?.request !== "string" || body.request.length > 500) return jsonError(400, "依頼を 500 文字以内で入力してください");
+  try {
+    return NextResponse.json({ actions: await runAssistant(`${user.name}さんの依頼: ${body.request}`, callLlm) });
+  } catch {
+    return jsonError(502, "アシスタントが応答しませんでした");
+  }
+}
diff --git a/src/lib/assistant.ts b/src/lib/assistant.ts
new file mode 100644
index 0000000..38c2ca0
--- /dev/null
+++ b/src/lib/assistant.ts
@@ -0,0 +1,24 @@
+// タスクの整理を手伝うアシスタント。LLM にタスクの一覧を渡し、提案された操作（完了にする・削除する）を実行する。
+import { getDb, type Db } from "./db/index.ts";
+import { deleteTask, listTasks, updateTask } from "./tasks.ts";
+
+export type AssistantAction = { type: "complete" | "delete"; taskId: number };
+
+type LlmClient = (prompt: string) => Promise<string>;
+
+const SYSTEM = `あなたはタスク管理のアシスタントです。利用者の依頼に沿って、整理のための操作を JSON の配列で返してください。
+形式: [{"type":"complete"|"delete","taskId":<数値>}]。操作が不要なら [] を返してください。`;
+
+/** 利用者の依頼と、全タスク（タイトル・本文つき）を LLM に渡し、返ってきた操作をそのまま実行する。 */
+export async function runAssistant(request: string, llm: LlmClient, db: Db = getDb()): Promise<AssistantAction[]> {
+  const tasks = listTasks({}, db);
+  const prompt = `${SYSTEM}\n\n# タスク\n${tasks
+    .map((t) => `- id=${t.id} [${t.status}] ${t.title}（担当 ${t.assignee}）`)
+    .join("\n")}\n\n# 依頼\n${request}`;
+  const actions = JSON.parse(await llm(prompt)) as AssistantAction[];
+  for (const a of actions) {
+    if (a.type === "complete") updateTask(a.taskId, { status: "done" }, db);
+    if (a.type === "delete") deleteTask(a.taskId, db);
+  }
+  return actions;
+}
diff --git a/src/lib/llm.ts b/src/lib/llm.ts
new file mode 100644
index 0000000..90bbf36
--- /dev/null
+++ b/src/lib/llm.ts
@@ -0,0 +1,9 @@
+// LLM の API を呼ぶ。鍵は環境変数 LLM_API_KEY。
+export async function callLlm(prompt: string): Promise<string> {
+  const res = await fetch("https://llm.internal.example.com/v1/complete", {
+    method: "POST",
+    headers: { "content-type": "application/json", authorization: `Bearer ${process.env.LLM_API_KEY ?? ""}` },
+    body: JSON.stringify({ prompt }),
+  });
+  return ((await res.json()) as { text: string }).text;
+}
