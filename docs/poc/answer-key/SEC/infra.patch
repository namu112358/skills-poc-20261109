index 0000000..c2e1a68
--- /dev/null
+++ b/.github/workflows/pr-label.yml
@@ -0,0 +1,24 @@
+# PR のタイトルから種類のラベルを決めて付ける（タイトルが「feat:」で始まれば enhancement）。
+name: pr-label
+on:
+  pull_request:
+    types: [opened, edited]
+permissions:
+  pull-requests: write
+jobs:
+  label:
+    runs-on: ubuntu-latest
+    steps:
+      - name: ラベルを決める
+        env:
+          TITLE: ${{ github.event.pull_request.title }}
+        run: |
+          case "$TITLE" in
+            feat:*) echo "LABEL=enhancement" >> "$GITHUB_ENV" ;;
+            fix:*) echo "LABEL=bug" >> "$GITHUB_ENV" ;;
+          esac
+      - if: env.LABEL != ''
+        run: gh pr edit "${{ github.event.pull_request.number }}" --add-label "$LABEL"
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GH_REPO: ${{ github.repository }}
diff --git a/.github/workflows/pr-preview.yml b/.github/workflows/pr-preview.yml
new file mode 100644
index 0000000..cf5fecd
--- /dev/null
+++ b/.github/workflows/pr-preview.yml
@@ -0,0 +1,23 @@
+# PR ごとにプレビュー環境を作り、URL を PR にコメントする。フォークからの PR にも対応する。
+name: pr-preview
+on:
+  pull_request_target:
+    types: [opened, synchronize]
+permissions:
+  contents: read
+  pull-requests: write
+jobs:
+  preview:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}
+      - run: npm ci && npm run build
+        env:
+          PREVIEW_DEPLOY_TOKEN: ${{ secrets.PREVIEW_DEPLOY_TOKEN }}
+      - name: プレビューの名前を決める
+        run: echo "PREVIEW_NAME=pr-${{ github.event.pull_request.number }}-${{ github.event.pull_request.title }}" >> "$GITHUB_ENV"
+      - run: npx vercel deploy --token "$PREVIEW_DEPLOY_TOKEN" --name "$PREVIEW_NAME"
+        env:
+          PREVIEW_DEPLOY_TOKEN: ${{ secrets.PREVIEW_DEPLOY_TOKEN }}
