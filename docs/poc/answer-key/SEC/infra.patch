--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,12 @@
+# 本番用のイメージ。社内の npm レジストリから依存を取るため、ビルド時にトークンを渡す:
+#   docker build --build-arg NPM_TOKEN=... .
+FROM node:24
+ARG NPM_TOKEN
+WORKDIR /app
+COPY package.json package-lock.json ./
+RUN echo "//npm.internal.example.com/:_authToken=${NPM_TOKEN}" > .npmrc && npm ci
+COPY . .
+RUN npm run build
+ENV NODE_ENV=production
+EXPOSE 3000
+CMD ["npm", "start"]
