+
+export function isAdmin(user: User | undefined): boolean {
+  return user?.role === "admin";
+}
+
+/** プロフィールを更新する。送られた項目だけを書き換える。 */
+export function updateUser(id: string, changes: Record<string, unknown>, db: Db = getDb()): User | undefined {
+  const keys = Object.keys(changes);
+  if (keys.length === 0) return getUser(id, db);
+  const sets = keys.map((k) => `${k} = ?`).join(", ");
+  db.prepare(`UPDATE users SET ${sets} WHERE id = ?`).run(...keys.map((k) => String(changes[k])), id);
+  return getUser(id, db);
 }
