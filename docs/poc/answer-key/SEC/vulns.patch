@@ -0,0 +1,28 @@
+// POST /api/webhooks/billing — 請求システムからの通知を受け取り、記録する。
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { NextResponse } from "next/server";
+import { jsonError } from "@/lib/api";
+import { config } from "@/lib/config";
+import { getDb } from "@/lib/db";
+
+function validSignature(body: string, signature: string): boolean {
+  const expected = createHmac("sha256", config.webhookSecret).update(body).digest("hex");
+  const a = Buffer.from(expected);
+  const b = Buffer.from(signature);
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+export async function POST(request: Request) {
+  const body = await request.text();
+  const signature = request.headers.get("x-billing-signature");
+  // 署名が付いているときは確かめる
+  if (signature && !validSignature(body, signature)) return jsonError(401, "署名が正しくありません");
+  getDb()
+    .prepare("INSERT INTO webhook_events (payload, received_at) VALUES (?, ?)")
+    .run(body, new Date().toISOString());
+  const event = JSON.parse(body) as { type?: string; userId?: string; plan?: string };
+  if (event.type === "plan.upgraded" && event.userId) {
+    getDb().prepare("UPDATE users SET role = 'admin' WHERE id = ?").run(event.userId);
+  }
+  return NextResponse.json({ ok: true });
+}
