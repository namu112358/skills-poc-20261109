+// GET /api/me — ログイン中のユーザー / PATCH /api/me — 自分のプロフィール（表示名・メール）を更新する。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { updateUser } from "@/lib/users";
