+// POST /api/tasks/import — { url } の CSV（タイトル,担当者,期限）を読み込み、タスクを作る。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { fetchText } from "@/lib/fetcher";
+import { createTask, validateTaskInput, type TaskInput } from "@/lib/tasks";
+
+export async function POST(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const body = (await readJson(request)) as { url?: unknown } | undefined;
+  if (typeof body?.url !== "string") return jsonError(400, "url を指定してください");
+  let text: string;
+  try {
+    text = await fetchText(body.url);
+  } catch (e) {
+    return jsonError(400, "取り込みに失敗しました", [String(e)]);
+  }
+  const created = [];
+  const errors: string[] = [];
+  for (const [i, line] of text.split("\n").entries()) {
+    const [title, assignee, dueDate] = line.split(",").map((s) => s.trim());
+    const result = validateTaskInput({ title, status: "todo", assignee, dueDate });
+    if (result.ok) created.push(createTask(result.value as TaskInput));
+    else errors.push(`${i + 1} 行目: ${line}`);
+  }
+  return NextResponse.json({ created: created.length, errors });
+}
