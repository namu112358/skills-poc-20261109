@@ -40,3 +40,8 @@ export function getSessionUser(token: string | undefined, db: Db = getDb(), now:
 export function deleteSession(token: string, db: Db = getDb()): void {
   db.prepare("DELETE FROM sessions WHERE token = ?").run(token);
 }
+
+/** ユーザーのセッションをすべて削除する（すべての端末からログアウトする）。削除した数を返す。 */
+export function deleteUserSessions(userId: string, db: Db = getDb()): number {
+  return Number(db.prepare("DELETE FROM sessions WHERE user_id = ?").run(userId).changes);
+}
