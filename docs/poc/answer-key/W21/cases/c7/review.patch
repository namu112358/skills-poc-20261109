diff --git a/tests/notify.test.ts b/tests/notify.test.ts
new file mode 100644
index 0000000..b71db3c
--- /dev/null
+++ b/tests/notify.test.ts
@@ -0,0 +1,23 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { eventBus } from "../src/lib/notify/events.ts";
+import { ConsoleNotifier, NotifierFactory } from "../src/lib/notify/notifier.ts";
+
+describe("eventBus", () => {
+  it("delivers events to subscribers and stops after unsubscribe", () => {
+    const got: number[] = [];
+    const off = eventBus.subscribe("task.created", (e) => got.push(e.taskId));
+    eventBus.emit({ type: "task.created", taskId: 1, at: new Date() });
+    off();
+    eventBus.emit({ type: "task.created", taskId: 2, at: new Date() });
+    assert.deepEqual(got, [1]);
+  });
+});
+
+describe("NotifierFactory", () => {
+  it("creates a console notifier by default and for unknown kinds", () => {
+    assert.ok(NotifierFactory.create("console") instanceof ConsoleNotifier);
+    assert.ok(NotifierFactory.create("unknown") instanceof ConsoleNotifier);
+    assert.equal(NotifierFactory.create("slack").kind, "slack");
+  });
+});
