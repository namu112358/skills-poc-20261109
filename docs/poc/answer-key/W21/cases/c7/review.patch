+// 通知の初期化。読み込んだ時点で、イベントバスに通知の購読者を登録する。
+import { eventBus } from "./events.ts";
+import { NotifierFactory } from "./notifier.ts";
+
+export { eventBus } from "./events.ts";
+
+const notifier = NotifierFactory.create();
+
+eventBus.subscribe("task.assignee_changed", (e) => {
+  notifier.send(`[audit] task ${e.taskId}: assignee ${e.from} -> ${e.to} at ${e.at.toISOString()}`, e);
+});
