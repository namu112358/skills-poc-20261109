@@ -0,0 +1,48 @@
+// 通知の送り先。今はサーバーのログだけ。Slack・メールは将来の拡張用。
+import type { AppEvent } from "./events.ts";
+
+export interface Notifier {
+  readonly kind: NotifierKind;
+  send(message: string, event: AppEvent): void;
+}
+
+export type NotifierKind = "console" | "slack" | "email";
+
+export class ConsoleNotifier implements Notifier {
+  readonly kind = "console" as const;
+  send(message: string): void {
+    console.log(message);
+  }
+}
+
+export class SlackNotifier implements Notifier {
+  readonly kind = "slack" as const;
+  private readonly webhookUrl: string;
+  constructor(webhookUrl: string = process.env.SLACK_WEBHOOK_URL ?? "") {
+    this.webhookUrl = webhookUrl;
+  }
+  send(): void {
+    throw new Error(`Slack への通知は未実装です（${this.webhookUrl ? "URL 設定済み" : "URL 未設定"}）`);
+  }
+}
+
+export class EmailNotifier implements Notifier {
+  readonly kind = "email" as const;
+  send(): void {
+    throw new Error("メールでの通知は未実装です");
+  }
+}
+
+export class NotifierFactory {
+  private static readonly registry: Record<NotifierKind, () => Notifier> = {
+    console: () => new ConsoleNotifier(),
+    slack: () => new SlackNotifier(),
+    email: () => new EmailNotifier(),
+  };
+
+  /** 環境変数 NOTIFIER_KIND（既定は console）の送り先を作る。知らない値なら console。 */
+  static create(kind: string = process.env.NOTIFIER_KIND ?? "console"): Notifier {
+    const make = NotifierFactory.registry[kind as NotifierKind] ?? NotifierFactory.registry.console;
+    return make();
+  }
+}
