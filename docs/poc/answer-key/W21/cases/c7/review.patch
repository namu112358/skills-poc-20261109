@@ -0,0 +1,31 @@
+// アプリ内のイベントの発行・購読。通知の経路を増やすときは、ここに購読者を足す。
+export type AppEvent =
+  | { type: "task.assignee_changed"; taskId: number; from: string; to: string; at: Date }
+  | { type: "task.status_changed"; taskId: number; from: string; to: string; at: Date }
+  | { type: "task.created"; taskId: number; at: Date };
+
+export type AppEventType = AppEvent["type"];
+type Handler<T extends AppEventType> = (event: Extract<AppEvent, { type: T }>) => void;
+
+class EventBus {
+  private handlers = new Map<AppEventType, Handler<AppEventType>[]>();
+
+  subscribe<T extends AppEventType>(type: T, handler: Handler<T>): () => void {
+    const list = this.handlers.get(type) ?? [];
+    list.push(handler as unknown as Handler<AppEventType>);
+    this.handlers.set(type, list);
+    return () =>
+      this.handlers.set(type, (this.handlers.get(type) ?? []).filter((h) => h !== (handler as unknown)));
+  }
+
+  emit(event: AppEvent): void {
+    for (const handler of this.handlers.get(event.type) ?? []) handler(event as never);
+  }
+
+  clear(): void {
+    this.handlers.clear();
+  }
+}
+
+/** アプリ全体で 1 つのイベントバス。 */
+export const eventBus = new EventBus();
