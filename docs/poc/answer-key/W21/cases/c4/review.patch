diff --git a/src/lib/due.ts b/src/lib/due.ts
new file mode 100644
index 0000000..82028e1
--- /dev/null
+++ b/src/lib/due.ts
@@ -0,0 +1,19 @@
+// 期限が近いタスクの判定。
+import type { Task } from "./tasks.ts";
+
+/** 「期限が近い」とみなす日数。 */
+export const DUE_SOON_DAYS = 3;
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/** 期限までの残り日数（今日が期限なら 0、過ぎていれば負の数）。 */
+export function daysUntilDue(dueDate: string, now: Date = new Date()): number {
+  return Math.floor((Date.parse(dueDate) - now.getTime()) / DAY_MS);
+}
+
+/** 未完了で、期限が今日から DUE_SOON_DAYS 日以内のタスクか。 */
+export function isDueSoon(task: Task, now: Date = new Date()): boolean {
+  if (task.status === "done") return false;
+  const days = daysUntilDue(task.dueDate, now);
+  return days >= 0 && days < DUE_SOON_DAYS;
+}
diff --git a/tests/due.test.ts b/tests/due.test.ts
new file mode 100644
index 0000000..32b051a
--- /dev/null
+++ b/tests/due.test.ts
@@ -0,0 +1,35 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { daysUntilDue, isDueSoon } from "../src/lib/due.ts";
+import type { Task } from "../src/lib/tasks.ts";
+
+// 日本時間 2026-11-12 0:00
+const now = new Date("2026-11-12T00:00:00+09:00");
+const task = (dueDate: string, status: Task["status"] = "todo"): Task => ({
+  id: 1,
+  title: "t",
+  status,
+  assignee: "sato",
+  dueDate,
+});
+
+describe("daysUntilDue", () => {
+  it("counts days from today", () => {
+    assert.equal(daysUntilDue("2026-11-12", now), 0);
+    assert.equal(daysUntilDue("2026-11-13", now), 1);
+    assert.equal(daysUntilDue("2026-11-11", now), -1);
+  });
+});
+
+describe("isDueSoon", () => {
+  it("is true for unfinished tasks due within the next days", () => {
+    assert.equal(isDueSoon(task("2026-11-12"), now), true);
+    assert.equal(isDueSoon(task("2026-11-14"), now), true);
+  });
+
+  it("is false for finished, overdue or far tasks", () => {
+    assert.equal(isDueSoon(task("2026-11-12", "done"), now), false);
+    assert.equal(isDueSoon(task("2026-11-11"), now), false);
+    assert.equal(isDueSoon(task("2026-11-30"), now), false);
+  });
+});
