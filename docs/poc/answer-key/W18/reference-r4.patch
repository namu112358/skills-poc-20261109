@@ -0,0 +1,20 @@
+// POST /api/jobs/calibration-orders — 未送信の校正の発注を、校正機関の受付システムに送り直す（運用の cron が毎朝 8:30 JST に呼ぶ）。
+import { NextResponse } from "next/server";
+import { agencyClientFromEnv } from "@/lib/agency-client";
+import { jsonError, requireJobAuth } from "@/lib/api";
+import { sendPendingOrders } from "@/lib/calibration-orders";
+import { logger } from "@/lib/logger";
+
+export async function POST(request: Request) {
+  const denied = requireJobAuth(request, "calibration-orders");
+  if (denied) return denied;
+  const client = agencyClientFromEnv();
+  if (!client) {
+    logger.error("job.misconfigured", { job: "calibration-orders", missing: "AGENCY_API_URL / AGENCY_API_KEY" });
+    return jsonError(500, "受付システムの設定がありません");
+  }
+  const started = Date.now();
+  const summary = await sendPendingOrders(client);
+  logger.info("job.completed", { job: "calibration-orders", ...summary, durationMs: Date.now() - started });
+  return NextResponse.json(summary);
+}
