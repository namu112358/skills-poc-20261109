@@ -0,0 +1,41 @@
+// GET /api/instruments/:id/calibration-orders — 校正の発注（新しい順） / POST — 校正機関に発注する（本文 { note? }。発注者はログイン中の本人）。
+// 発注を記録してからすぐに受付システムに送る。送れなくても発注は受け付け（未送信）、毎朝のジョブで送り直す。
+import { NextResponse } from "next/server";
+import { agencyClientFromEnv } from "@/lib/agency-client";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { createOrder, listOrders, notifyCancelledReservations, sendOrder, validateOrderInput } from "@/lib/calibration-orders";
+import { getInstrument, parseId } from "@/lib/instruments";
+import { logger } from "@/lib/logger";
+import { notifyClientFromEnv } from "@/lib/notify-client";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function GET(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  if (id === undefined || !getInstrument(id)) return jsonError(404, "計測器が見つかりません");
+  return NextResponse.json({ orders: listOrders(id) });
+}
+
+export async function POST(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  if (id === undefined || !getInstrument(id)) return jsonError(404, "計測器が見つかりません");
+  const input = validateOrderInput(await readJson(request));
+  if (!input.ok) return jsonError(400, "入力内容に誤りがあります", input.errors);
+  const result = createOrder(id, user.id, input.value);
+  if (!result.ok) {
+    if (result.reason === "not_found") return jsonError(404, "計測器が見つかりません");
+    return result.reason === "already_ordered"
+      ? jsonError(409, "この計測器はすでに校正に発注しています")
+      : jsonError(409, "使用中・使用停止の計測器だけを校正に発注できます");
+  }
+  const instrument = getInstrument(id)!;
+  await notifyCancelledReservations(notifyClientFromEnv(), instrument, result.cancelledReservations);
+  const agency = agencyClientFromEnv();
+  if (!agency) logger.error("calibration_order.misconfigured", { orderId: result.order.id, missing: "AGENCY_API_URL / AGENCY_API_KEY" });
+  const order = agency ? await sendOrder(agency, result.order.id) : result.order;
+  return NextResponse.json({ order, cancelledReservations: result.cancelledReservations.length }, { status: 201 });
+}
diff --git a/src/app/api/jobs/calibration-orders/route.ts b/src/app/api/jobs/calibration-orders/route.ts
