new file mode 100644
index 0000000..2a55808
--- /dev/null
+++ b/src/lib/http-retry.ts
@@ -0,0 +1,90 @@
+// 外部サービスへの HTTP 要求の共通部分（社内通知サービス・校正機関の受付システムで使う）。
+// - 503・429・通信エラー・タイムアウトは、指数バックオフ（ジッター付き）で決まった回数まで再試行する。429 は Retry-After を守る。
+// - 400・401 などは再試行しない（送り直しても結果が変わらないため）。呼び出し側が成功とみなす応答（isSuccess）も指定できる。
+// - 再試行でも同じ Idempotency-Key を送る（キーは呼び出し側が決める）。
+// fetch・待ち時間・乱数は差し替えられる（テスト用）。
+
+export type RetryOptions = {
+  timeoutMs?: number; // 1 回の要求のタイムアウト
+  maxAttempts?: number; // 最初の 1 回を含む試行回数
+  baseDelayMs?: number; // 再試行の待ち時間の基準（1 回目）
+  maxDelayMs?: number; // 再試行の待ち時間の上限
+  fetch?: typeof fetch;
+  sleep?: (ms: number) => Promise<void>;
+  random?: () => number;
+};
+
+export type HttpResult =
+  | { ok: true; status: number; data: unknown; attempts: number }
+  | { ok: false; retryable: boolean; status?: number; data?: unknown; error: string; attempts: number };
+
+const defaultSleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+/** Retry-After（秒、または HTTP 日付）をミリ秒にする。読めなければ undefined。 */
+export function parseRetryAfter(value: string | null, now: number = Date.now()): number | undefined {
+  if (!value) return undefined;
+  if (/^\d+$/.test(value.trim())) return Number(value.trim()) * 1000;
+  const at = Date.parse(value);
+  return Number.isNaN(at) ? undefined : Math.max(0, at - now);
+}
+
+/** n 回目（1 始まり）の失敗の後の待ち時間。base × 2^(n-1) を上限で切り、50〜100% のジッターをかける。 */
+export function backoffDelay(n: number, base: number, max: number, random: () => number = Math.random): number {
+  const exp = Math.min(max, base * 2 ** (n - 1));
+  return Math.round(exp * (0.5 + random() * 0.5));
+}
+
+/** JSON を POST し、失敗したら再試行する。isSuccess を指定すると、2xx 以外の応答も成功として扱える（例: 409 の重複）。 */
+export async function postJsonWithRetry(
+  endpoint: string,
+  headers: Record<string, string>,
+  body: unknown,
+  options: RetryOptions & { isSuccess?: (status: number, data: unknown) => boolean } = {},
+): Promise<HttpResult> {
+  const {
+    timeoutMs = 10_000,
+    maxAttempts = 5,
+    baseDelayMs = 500,
+    maxDelayMs = 8_000,
+    fetch: doFetch = fetch,
+    sleep = defaultSleep,
+    random = Math.random,
+    isSuccess = (status: number) => status >= 200 && status < 300,
+  } = options;
+  let last: HttpResult = { ok: false, retryable: true, error: "未送信", attempts: 0 };
+  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
+    let retryAfterMs: number | undefined;
+    try {
+      const res = await doFetch(endpoint, {
+        method: "POST",
+        headers: { "content-type": "application/json", ...headers },
+        body: JSON.stringify(body),
+        signal: AbortSignal.timeout(timeoutMs),
+      });
+      const text = await res.text().catch(() => "");
+      let data: unknown;
+      try {
+        data = text ? JSON.parse(text) : {};
+      } catch {
+        data = undefined;
+      }
+      if (isSuccess(res.status, data)) return { ok: true, status: res.status, data, attempts: attempt };
+      const retryable = res.status === 429 || res.status >= 500;
+      last = { ok: false, retryable, status: res.status, data, error: text.slice(0, 200) || `HTTP ${res.status}`, attempts: attempt };
+      if (!retryable) return last;
+      if (res.status === 429) retryAfterMs = parseRetryAfter(res.headers.get("retry-after"));
+    } catch (e) {
+      const name = e instanceof Error ? e.name : "";
+      last = {
+        ok: false,
+        retryable: true,
+        error: name === "TimeoutError" ? `タイムアウト（${timeoutMs}ms）` : String(e instanceof Error ? e.message : e),
+        attempts: attempt,
+      };
+    }
+    if (attempt < maxAttempts) {
+      await sleep(Math.max(retryAfterMs ?? 0, backoffDelay(attempt, baseDelayMs, maxDelayMs, random)));
+    }
+  }
+  return last;
+}
