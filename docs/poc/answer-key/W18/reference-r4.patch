+/**
+ * 計測器を使えなくなったとき（校正の不合格で使用停止・校正に出す発注）に、これから（終了日が今日以降）の予約を取り消す。
+ * 取り消した予約を返す。トランザクションの中で呼ぶ。
+ */
+export function cancelUpcomingReservations(instrumentId: number, cancelledBy: string, db: Db, now: Date = new Date()): Reservation[] {
+  const rows = db
+    .prepare(`SELECT ${COLUMNS} FROM reservations WHERE instrument_id = ? AND status = 'active' AND end_on >= ? ORDER BY start_on, id`)
+    .all(instrumentId, todayJst(now)) as Row[];
+  const cancel = db.prepare("UPDATE reservations SET status = 'cancelled', cancelled_at = ?, cancelled_by = ? WHERE id = ?");
+  for (const r of rows) cancel.run(now.toISOString(), cancelledBy, r.id);
+  return rows.map((r) => ({ ...toReservation(r), status: "cancelled", cancelledAt: now.toISOString(), cancelledBy }));
 }
diff --git a/tests/calibration-orders.test.ts b/tests/calibration-orders.test.ts
