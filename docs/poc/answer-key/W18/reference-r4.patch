diff --git a/src/lib/agency-client.ts b/src/lib/agency-client.ts
new file mode 100644
index 0000000..4e7c35a
--- /dev/null
+++ b/src/lib/agency-client.ts
@@ -0,0 +1,47 @@
+// 校正機関の受付システム（docs/agency-api.md）のクライアント。再試行・タイムアウトは http-retry.ts の共通部分を使う。
+// - 発注ごとに一意の clientReference を送り、Idempotency-Key にも同じ値を使う。再試行や翌朝の送り直しでも同じ値なので、
+//   受付システムに同じ発注が二重に登録されない。
+// - 409（同じ clientReference の発注がすでにある）は、前の要求が受け付けられていたとみなし、その受付番号を使う。
+import { postJsonWithRetry, type RetryOptions } from "./http-retry.ts";
+
+export type AgencyOrder = {
+  clientReference: string;
+  item: { managementNo: string; name: string; model: string };
+  requestedBy: string;
+  note?: string;
+};
+
+export type AgencyResult =
+  | { ok: true; orderId: string; estimatedReturnOn: string | null; attempts: number }
+  | { ok: false; retryable: boolean; status?: number; error: string; attempts: number };
+
+export type AgencyClient = { order(o: AgencyOrder): Promise<AgencyResult> };
+
+export type AgencyClientOptions = RetryOptions & { url: string; apiKey: string };
+
+export function createAgencyClient(options: AgencyClientOptions): AgencyClient {
+  const { url, apiKey, ...retry } = options;
+  const endpoint = new URL("/v1/orders", url).toString();
+  return {
+    async order(o) {
+      const r = await postJsonWithRetry(endpoint, { "x-api-key": apiKey, "idempotency-key": o.clientReference }, o, {
+        ...retry,
+        isSuccess: (status, data) => (status >= 200 && status < 300) || (status === 409 && typeof (data as { orderId?: unknown })?.orderId === "string"),
+      });
+      if (!r.ok) return { ok: false, retryable: r.retryable, status: r.status, error: r.error, attempts: r.attempts };
+      const d = (r.data ?? {}) as { orderId?: unknown; estimatedReturnOn?: unknown };
+      return {
+        ok: true,
+        orderId: typeof d.orderId === "string" ? d.orderId : "",
+        estimatedReturnOn: typeof d.estimatedReturnOn === "string" ? d.estimatedReturnOn : null,
+        attempts: r.attempts,
+      };
+    },
+  };
+}
+
+/** 環境変数（AGENCY_API_URL・AGENCY_API_KEY）からクライアントを作る。未設定なら undefined。 */
+export function agencyClientFromEnv(env: NodeJS.ProcessEnv = process.env): AgencyClient | undefined {
+  if (!env.AGENCY_API_URL || !env.AGENCY_API_KEY) return undefined;
+  return createAgencyClient({ url: env.AGENCY_API_URL, apiKey: env.AGENCY_API_KEY, timeoutMs: Number(env.AGENCY_API_TIMEOUT_MS) || undefined });
+}
diff --git a/src/lib/calibration-orders.ts b/src/lib/calibration-orders.ts
new file mode 100644
index 0000000..00f5d10
--- /dev/null
+++ b/src/lib/calibration-orders.ts
@@ -0,0 +1,215 @@
+// 校正機関への発注（docs/agency-api.md の受付システムに送る）。
+// - 発注できるのは使用中・使用停止（修理後の再校正）の計測器。発注すると計測器は「校正中」になり、
+//   これからの予約は取り消して、予約した人に社内の通知サービスで知らせる。
+// - 発注はまず「未送信」として記録し、すぐに受付システムに送る。送れなければ未送信のまま残し、
+//   毎朝のジョブ（POST /api/jobs/calibration-orders）で送り直す。clientReference と Idempotency-Key は発注ごとに固定。
+// - 1 台に進行中（未送信・受付済み）の発注は 1 件だけ。校正記録を登録すると、進行中の発注は完了になる（calibrations.ts）。
+import { randomUUID } from "node:crypto";
+import type { AgencyClient } from "./agency-client.ts";
+import { getDb, transaction, type Db } from "./db/index.ts";
+import { getInstrument, type Instrument, type ValidationResult } from "./instruments.ts";
+import { logger } from "./logger.ts";
+import type { NotifyClient } from "./notify-client.ts";
+import { cancelUpcomingReservations, type Reservation } from "./reservations.ts";
+
+export type OrderStatus = "pending" | "accepted" | "completed" | "failed";
+
+export const ORDER_STATUS_LABELS: Record<OrderStatus, string> = {
+  pending: "未送信",
+  accepted: "受付済み",
+  completed: "完了",
+  failed: "受付不可（要確認）",
+};
+
+/** 送信中のまま残った発注（途中でプロセスが止まったなど）を送り直してよいとみなすまでの時間 */
+const STALE_CLAIM_MS = 10 * 60 * 1000;
+
+export type CalibrationOrder = {
+  id: number;
+  instrumentId: number;
+  clientReference: string;
+  requestedBy: string;
+  requestedAt: string;
+  note: string;
+  status: OrderStatus;
+  agencyOrderId: string | null;
+  estimatedReturnOn: string | null;
+  attempts: number;
+  lastError: string | null;
+  acceptedAt: string | null;
+  completedAt: string | null;
+};
+
+type Row = {
+  id: number;
+  instrument_id: number;
+  client_reference: string;
+  requested_by: string;
+  requested_at: string;
+  note: string;
+  status: OrderStatus;
+  agency_order_id: string | null;
+  estimated_return_on: string | null;
+  attempts: number;
+  last_error: string | null;
+  accepted_at: string | null;
+  completed_at: string | null;
+};
+
+const COLUMNS = `id, instrument_id, client_reference, requested_by, requested_at, note, status, agency_order_id,
+  estimated_return_on, attempts, last_error, accepted_at, completed_at`;
+
+function toOrder(r: Row): CalibrationOrder {
+  return {
+    id: r.id,
+    instrumentId: r.instrument_id,
+    clientReference: r.client_reference,
+    requestedBy: r.requested_by,
+    requestedAt: r.requested_at,
+    note: r.note,
+    status: r.status,
+    agencyOrderId: r.agency_order_id,
+    estimatedReturnOn: r.estimated_return_on,
+    attempts: r.attempts,
+    lastError: r.last_error,
+    acceptedAt: r.accepted_at,
+    completedAt: r.completed_at,
+  };
+}
+
+export function getOrder(id: number, db: Db = getDb()): CalibrationOrder | undefined {
+  const row = db.prepare(`SELECT ${COLUMNS} FROM calibration_orders WHERE id = ?`).get(id) as Row | undefined;
+  return row && toOrder(row);
+}
+
+/** 計測器の発注を新しい順に返す。 */
+export function listOrders(instrumentId: number, db: Db = getDb()): CalibrationOrder[] {
+  const rows = db
+    .prepare(`SELECT ${COLUMNS} FROM calibration_orders WHERE instrument_id = ? ORDER BY requested_at DESC, id DESC`)
+    .all(instrumentId) as Row[];
+  return rows.map(toOrder);
+}
+
+export type OrderInput = { note: string };
+
+export function validateOrderInput(body: unknown): ValidationResult<OrderInput> {
+  if (body === undefined || body === null) return { ok: true, value: { note: "" } };
+  if (typeof body !== "object" || Array.isArray(body)) return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  const note = (body as Record<string, unknown>).note ?? "";
+  if (typeof note !== "string" || note.length > 500) return { ok: false, errors: ["備考は 500 文字以内で入力してください"] };
+  return { ok: true, value: { note: note.trim() } };
+}
+
+export type CreateOrderResult =
+  | { ok: true; order: CalibrationOrder; cancelledReservations: Reservation[] }
+  | { ok: false; reason: "not_found" | "not_orderable" | "already_ordered" };
+
+/** 発注を記録し（未送信）、計測器を校正中にして、これからの予約を取り消す。受付システムへの送信は sendOrder で行う。 */
+export function createOrder(
+  instrumentId: number,
+  requestedBy: string,
+  input: OrderInput,
+  db: Db = getDb(),
+  now: Date = new Date(),
+): CreateOrderResult {
+  return transaction(db, () => {
+    const instrument = getInstrument(instrumentId, db);
+    if (!instrument) return { ok: false, reason: "not_found" } as const;
+    if (instrument.status !== "in_use" && instrument.status !== "suspended") return { ok: false, reason: "not_orderable" } as const;
+    if (db.prepare("SELECT 1 FROM calibration_orders WHERE instrument_id = ? AND status IN ('pending', 'accepted')").get(instrumentId)) {
+      return { ok: false, reason: "already_ordered" } as const;
+    }
+    const { lastInsertRowid } = db
+      .prepare(
+        `INSERT INTO calibration_orders (instrument_id, client_reference, requested_by, requested_at, note, status)
+         VALUES (?, ?, ?, ?, ?, 'pending')`,
+      )
+      .run(instrumentId, `calib-order-${randomUUID()}`, requestedBy, now.toISOString(), input.note);
+    db.prepare("UPDATE instruments SET status = 'calibrating' WHERE id = ?").run(instrumentId);
+    const cancelledReservations = cancelUpcomingReservations(instrumentId, requestedBy, db, now);
+    return { ok: true, order: getOrder(Number(lastInsertRowid), db)!, cancelledReservations } as const;
+  });
+}
+
+/** 送ってよければ「送信中」にして true を返す（未送信で、ほかの送信が動いていないとき）。 */
+function claim(db: Db, id: number, now: Date): boolean {
+  const staleBefore = new Date(now.getTime() - STALE_CLAIM_MS).toISOString();
+  const { changes } = db
+    .prepare("UPDATE calibration_orders SET claimed_at = ? WHERE id = ? AND status = 'pending' AND (claimed_at IS NULL OR claimed_at < ?)")
+    .run(now.toISOString(), id, staleBefore);
+  return changes > 0;
+}
+
+/** 未送信の発注を受付システムに送る。送れたら受付済みにする。送れなければ未送信のまま残す（400 などは failed）。 */
+export async function sendOrder(client: AgencyClient, orderId: number, db: Db = getDb(), now: Date = new Date()): Promise<CalibrationOrder | undefined> {
+  if (!claim(db, orderId, now)) return getOrder(orderId, db);
+  const order = getOrder(orderId, db)!;
+  const instrument = getInstrument(order.instrumentId, db)!;
+  const result = await client.order({
+    clientReference: order.clientReference,
+    item: { managementNo: instrument.managementNo, name: instrument.name, model: instrument.model },
+    requestedBy: order.requestedBy,
+    ...(order.note ? { note: order.note } : {}),
+  });
+  const fields = { orderId, instrumentId: instrument.id, managementNo: instrument.managementNo, attempts: result.attempts };
+  if (result.ok) {
+    db.prepare(
+      `UPDATE calibration_orders SET status = 'accepted', agency_order_id = ?, estimated_return_on = ?, attempts = attempts + ?,
+         accepted_at = ?, last_error = NULL, claimed_at = NULL WHERE id = ? AND status = 'pending'`,
+    ).run(result.orderId, result.estimatedReturnOn, result.attempts, new Date().toISOString(), orderId);
+    logger.info("calibration_order.accepted", { ...fields, agencyOrderId: result.orderId, estimatedReturnOn: result.estimatedReturnOn });
+  } else {
+    db.prepare(
+      "UPDATE calibration_orders SET status = ?, attempts = attempts + ?, last_error = ?, claimed_at = NULL WHERE id = ? AND status = 'pending'",
+    ).run(result.retryable ? "pending" : "failed", result.attempts, `${result.status ?? ""} ${result.error}`.trim(), orderId);
+    const log = result.retryable ? logger.warn : logger.error;
+    log("calibration_order.send_failed", { ...fields, status: result.status, retryable: result.retryable, error: result.error });
+  }
+  return getOrder(orderId, db);
+}
+
+export type SendSummary = { pending: number; accepted: number; failed: number; skipped: number };
+
+/** 未送信の発注をすべて送る（毎朝のジョブ）。1 件の失敗で残りを止めない。 */
+export async function sendPendingOrders(client: AgencyClient, db: Db = getDb(), now: Date = new Date()): Promise<SendSummary> {
+  const ids = (db.prepare("SELECT id FROM calibration_orders WHERE status = 'pending' ORDER BY id").all() as { id: number }[]).map((r) => r.id);
+  const summary: SendSummary = { pending: ids.length, accepted: 0, failed: 0, skipped: 0 };
+  for (const id of ids) {
+    const before = getOrder(id, db)!;
+    const after = await sendOrder(client, id, db, now);
+    if (after?.status === "accepted" && before.status === "pending") summary.accepted++;
+    else if (after?.status === "pending" && after.attempts === before.attempts) summary.skipped++;
+    else summary.failed++;
+  }
+  return summary;
+}
+
+/** 校正記録を登録したとき、その計測器の進行中の発注を完了にする。トランザクションの中で呼ぶ。 */
+export function completeOpenOrders(instrumentId: number, db: Db, now: Date = new Date()): number {
+  const { changes } = db
+    .prepare("UPDATE calibration_orders SET status = 'completed', completed_at = ? WHERE instrument_id = ? AND status IN ('pending', 'accepted')")
+    .run(now.toISOString(), instrumentId);
+  return Number(changes);
+}
+
+/** 発注で取り消した予約を、予約した人に知らせる。通知サービスの失敗は記録だけして、発注は止めない。 */
+export async function notifyCancelledReservations(client: NotifyClient | undefined, instrument: Instrument, reservations: Reservation[]): Promise<void> {
+  for (const r of reservations) {
+    if (!client) {
+      logger.error("reservation_cancelled_notice.misconfigured", { reservationId: r.id, missing: "NOTIFY_API_URL / NOTIFY_API_TOKEN" });
+      continue;
+    }
+    const result = await client.send(
+      {
+        recipient: r.userId,
+        category: "general",
+        title: `【予約の取消】${instrument.managementNo} の予約（${r.startOn}〜${r.endOn}）を取り消しました`,
+        body: `${instrument.managementNo} ${instrument.name} を校正に出すため、${r.startOn}〜${r.endOn} の予約を取り消しました。必要なら別の計測器を予約してください。`,
+      },
+      `reservation-cancelled-${r.id}`,
+    );
+    const fields = { reservationId: r.id, instrumentId: instrument.id, managementNo: instrument.managementNo, recipient: r.userId };
+    if (result.ok) logger.info("reservation_cancelled_notice.sent", fields);
+    else logger.error("reservation_cancelled_notice.failed", { ...fields, status: result.status, error: result.error });
+  }
+}
diff --git a/src/lib/calibrations.ts b/src/lib/calibrations.ts
index 9180813..91520d8 100644
--- a/src/lib/calibrations.ts
+++ b/src/lib/calibrations.ts
@@ -1,10 +1,12 @@
 // 校正記録。外部の校正機関での校正結果を登録する。
 // - 合格: 計測器の前回校正日を校正日に更新し、校正中だった計測器は使用中に戻す。
