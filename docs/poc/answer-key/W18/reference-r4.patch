+++ b/tests/calibration-orders.test.ts
@@ -0,0 +1,131 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import type { AgencyClient, AgencyOrder, AgencyResult } from "../src/lib/agency-client.ts";
+import { createAgencyClient } from "../src/lib/agency-client.ts";
+import { recordCalibration } from "../src/lib/calibrations.ts";
+import { createOrder, listOrders, sendOrder, sendPendingOrders, validateOrderInput } from "../src/lib/calibration-orders.ts";
+import { openDb } from "../src/lib/db/index.ts";
+import { getInstrument, listInstruments, updateInstrument } from "../src/lib/instruments.ts";
+import { lendInstrument } from "../src/lib/loans.ts";
+import { createReservation, listReservations } from "../src/lib/reservations.ts";
+
+const NOW = new Date("2026-11-10T01:00:00Z"); // 日本時間 2026-11-10
+const byNo = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+
+function agency(results: AgencyResult[]) {
+  const sent: AgencyOrder[] = [];
+  const client: AgencyClient = {
+    async order(o) {
+      sent.push(o);
+      return results.shift() ?? { ok: true, orderId: `AG-${sent.length}`, estimatedReturnOn: "2026-11-24", attempts: 1 };
+    },
+  };
+  return { client, sent };
+}
+
+describe("createOrder", () => {
+  it("records a pending order, puts the instrument into calibration and cancels upcoming reservations", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    const r = createReservation(inst.id, "suzuki", { startOn: "2026-11-20", endOn: "2026-11-21" }, db, NOW);
+    assert.ok(r.ok);
+    const o = createOrder(inst.id, "sato", { note: "" }, db, NOW);
+    assert.ok(o.ok);
+    assert.equal(o.order.status, "pending");
+    assert.equal(getInstrument(inst.id, db)?.status, "calibrating");
+    assert.deepEqual(o.cancelledReservations.map((x) => x.userId), ["suzuki"]);
+    assert.equal(listReservations(inst.id, db)[0].status, "cancelled");
+  });
+
+  it("allows only in-use or suspended instruments and one open order per instrument", () => {
+    const db = openDb();
+    assert.deepEqual(createOrder(byNo(db, "MI-0002").id, "sato", { note: "" }, db, NOW), { ok: false, reason: "not_orderable" }); // 貸出中
+    assert.deepEqual(createOrder(byNo(db, "MI-0005").id, "sato", { note: "" }, db, NOW), { ok: false, reason: "not_orderable" }); // 校正中
+    assert.deepEqual(createOrder(byNo(db, "MI-0008").id, "sato", { note: "" }, db, NOW), { ok: false, reason: "not_orderable" }); // 廃棄
+    const suspended = byNo(db, "MI-0007");
+    assert.equal(createOrder(suspended.id, "sato", { note: "" }, db, NOW).ok, true);
+    updateInstrument(suspended.id, { status: "suspended" }, db);
+    assert.deepEqual(createOrder(suspended.id, "sato", { note: "" }, db, NOW), { ok: false, reason: "already_ordered" });
+  });
+
+  it("validates the note", () => {
+    assert.deepEqual(validateOrderInput(undefined), { ok: true, value: { note: "" } });
+    assert.equal(validateOrderInput({ note: "x".repeat(501) }).ok, false);
+  });
+});
+
+describe("sendOrder / sendPendingOrders", () => {
+  it("marks the order accepted with the agency's number and return date", async () => {
+    const db = openDb();
+    const o = createOrder(byNo(db, "MI-0001").id, "sato", { note: "" }, db, NOW);
+    assert.ok(o.ok);
+    const a = agency([]);
+    const sent = await sendOrder(a.client, o.order.id, db, NOW);
+    assert.equal(sent?.status, "accepted");
+    assert.equal(sent?.agencyOrderId, "AG-1");
+    assert.equal(sent?.estimatedReturnOn, "2026-11-24");
+    assert.deepEqual(a.sent[0].item, { managementNo: "MI-0001", name: "デジタルマルチメータ", model: "DMM-7510" });
+    assert.equal(a.sent[0].requestedBy, "sato");
+  });
+
+  it("keeps a failed order pending and resends it later with the same client reference", async () => {
+    const db = openDb();
+    const o = createOrder(byNo(db, "MI-0001").id, "sato", { note: "" }, db, NOW);
+    assert.ok(o.ok);
+    const a = agency([{ ok: false, retryable: true, status: 503, error: "maintenance", attempts: 5 }]);
+    assert.equal((await sendOrder(a.client, o.order.id, db, NOW))?.status, "pending");
+    const summary = await sendPendingOrders(a.client, db, NOW);
+    assert.deepEqual(summary, { pending: 1, accepted: 1, failed: 0, skipped: 0 });
+    assert.equal(a.sent[0].clientReference, a.sent[1].clientReference);
+    assert.equal(listOrders(o.order.instrumentId, db)[0].attempts, 6);
+  });
+
+  it("marks orders refused by the agency as failed and does not resend them", async () => {
+    const db = openDb();
+    const o = createOrder(byNo(db, "MI-0001").id, "sato", { note: "" }, db, NOW);
+    assert.ok(o.ok);
+    const a = agency([{ ok: false, retryable: false, status: 400, error: "bad", attempts: 1 }]);
+    assert.equal((await sendOrder(a.client, o.order.id, db, NOW))?.status, "failed");
+    assert.equal((await sendPendingOrders(a.client, db, NOW)).pending, 0);
+  });
+
+  it("completes the open order when a calibration is recorded", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    const o = createOrder(inst.id, "sato", { note: "" }, db, NOW);
+    assert.ok(o.ok);
+    recordCalibration(inst.id, { calibratedOn: "2026-11-20", result: "pass", agency: "東日本計測サービス", certificateNo: "" }, "sato", db, NOW);
+    assert.equal(listOrders(inst.id, db)[0].status, "completed");
+    assert.equal(getInstrument(inst.id, db)?.status, "in_use");
+    assert.equal(createOrder(inst.id, "sato", { note: "" }, db, NOW).ok, true);
+  });
+
+  it("does not order an instrument on loan", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0003");
+    lendInstrument(inst.id, { borrowerId: "suzuki", dueOn: "2026-11-12" }, db, NOW);
+    assert.deepEqual(createOrder(inst.id, "sato", { note: "" }, db, NOW), { ok: false, reason: "not_orderable" });
+  });
+});
+
+describe("agency client", () => {
+  const json = (status: number, body: unknown = {}) => new Response(JSON.stringify(body), { status });
+  it("sends the API key and uses the client reference as the idempotency key; treats 409 duplicate as accepted", async () => {
+    const calls: { url: string; headers: Record<string, string> }[] = [];
+    const responses = [json(503), json(409, { error: "duplicate", orderId: "AG-9" })];
+    const c = createAgencyClient({
+      url: "http://agency.test",
+      apiKey: "k3y",
+      sleep: async () => {},
+      fetch: (async (url: string, init: RequestInit) => {
+        calls.push({ url, headers: init.headers as Record<string, string> });
+        return responses.shift()!;
+      }) as unknown as typeof fetch,
+    });
+    const r = await c.order({ clientReference: "ref-1", item: { managementNo: "MI-0001", name: "x", model: "" }, requestedBy: "sato" });
+    assert.deepEqual(r, { ok: true, orderId: "AG-9", estimatedReturnOn: null, attempts: 2 });
+    assert.equal(calls[0].url, "http://agency.test/v1/orders");
+    assert.equal(calls[0].headers["x-api-key"], "k3y");
+    assert.equal(calls[1].headers["idempotency-key"], "ref-1");
+  });
+});
