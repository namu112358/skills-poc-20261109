+// 計測器の変更履歴（監査用）。誰が（利用者 ID。定期ジョブなど人以外は null =「システム」）・いつ・何を（項目ごとの変更前・変更後）。
+// - 台帳を変える処理（instruments・loans・calibrations・reservations・calibration-orders）が、同じトランザクションの中で recordHistory を呼ぶ。
+//   失敗した操作はロールバックされるので履歴も残らない。
+// - 履歴は追記だけ。DB のトリガー（マイグレーション version 9）で更新・削除を拒否する。API にも更新・削除は無い。
+// - 設置場所は名前で残す（後で場所の名前を変えても、当時の名前のまま）。
+import { getDb, type Db } from "./db/index.ts";
+
+export type HistoryChange = { field: string; from: unknown; to: unknown };
+
+export type HistoryEntry = {
+  id: number;
+  instrumentId: number;
+  at: string; // ISO 8601（UTC）
+  actorId: string | null; // null = システム（定期ジョブなど）
+  action: string;
+  summary: string;
+  changes: HistoryChange[];
+};
+
+/** 履歴の項目名の表示名（画面用）。 */
+export const FIELD_LABELS: Record<string, string> = {
+  managementNo: "管理番号",
+  name: "名称",
+  model: "型式",
+  location: "設置場所",
+  managerId: "管理者",
+  intervalMonths: "校正周期（月）",
+  lastCalibratedOn: "前回校正日",
+  status: "状態",
+  importance: "重要度",
+  note: "備考",
+};
+
+export function recordHistory(
+  db: Db,
+  entry: { instrumentId: number; actorId: string | null; action: string; summary: string; changes?: HistoryChange[] },
+  now: Date = new Date(),
+): void {
+  db.prepare("INSERT INTO instrument_history (instrument_id, at, actor_id, action, summary, changes) VALUES (?, ?, ?, ?, ?, ?)").run(
+    entry.instrumentId,
+    now.toISOString(),
+    entry.actorId,
+    entry.action,
+    entry.summary,
+    JSON.stringify(entry.changes ?? []),
+  );
+}
+
+/** 2 つの値の組で、変わった項目だけを changes にする。 */
+export function diffFields<T extends Record<string, unknown>>(before: T, after: T, fields: readonly (keyof T & string)[]): HistoryChange[] {
+  return fields.filter((f) => before[f] !== after[f]).map((f) => ({ field: f, from: before[f], to: after[f] }));
+}
+
+type Row = { id: number; instrument_id: number; at: string; actor_id: string | null; action: string; summary: string; changes: string };
+
+/** 計測器の履歴を新しい順に返す。 */
+export function listHistory(instrumentId: number, db: Db = getDb()): HistoryEntry[] {
+  const rows = db
+    .prepare("SELECT id, instrument_id, at, actor_id, action, summary, changes FROM instrument_history WHERE instrument_id = ? ORDER BY at DESC, id DESC")
+    .all(instrumentId) as Row[];
+  return rows.map((r) => ({
+    id: r.id,
+    instrumentId: r.instrument_id,
+    at: r.at,
+    actorId: r.actor_id,
+    action: r.action,
+    summary: r.summary,
+    changes: JSON.parse(r.changes) as HistoryChange[],
+  }));
+}
