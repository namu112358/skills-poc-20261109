diff --git a/tests/history.test.ts b/tests/history.test.ts
new file mode 100644
index 0000000..7f4696e
--- /dev/null
+++ b/tests/history.test.ts
@@ -0,0 +1,96 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import type { AgencyClient } from "../src/lib/agency-client.ts";
+import { recordCalibration } from "../src/lib/calibrations.ts";
+import { createOrder, sendOrder } from "../src/lib/calibration-orders.ts";
+import { openDb } from "../src/lib/db/index.ts";
+import { listHistory } from "../src/lib/history.ts";
+import { createInstrument, listInstruments, updateInstrument } from "../src/lib/instruments.ts";
+import { lendInstrument, returnLoan } from "../src/lib/loans.ts";
+import { createLocation, renameLocation } from "../src/lib/locations.ts";
+import { cancelReservation, createReservation } from "../src/lib/reservations.ts";
+
+const NOW = new Date("2026-11-10T01:00:00Z");
+const byNo = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+
+describe("instrument history", () => {
+  it("records who changed which field from what to what, newest first", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    updateInstrument(inst.id, { name: "DMM 新", importance: "A" }, db, "sato", new Date("2026-11-10T01:00:00Z"));
+    updateInstrument(inst.id, { note: "棚 3" }, db, "kimura", new Date("2026-11-10T02:00:00Z"));
+    const h = listHistory(inst.id, db);
+    assert.equal(h.length, 2);
+    assert.equal(h[0].actorId, "kimura");
+    assert.deepEqual(h[1].changes, [
+      { field: "name", from: "デジタルマルチメータ", to: "DMM 新" },
+      { field: "importance", from: "B", to: "A" },
+    ]);
+  });
+
+  it("does not record an update that changes nothing", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    updateInstrument(inst.id, { name: inst.name }, db, "sato");
+    assert.equal(listHistory(inst.id, db).length, 0);
+  });
+
+  it("keeps the location name at the time of the change", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    const loc = createLocation("第 2 測定室", db);
+    assert.ok(loc.ok);
+    updateInstrument(inst.id, { locationId: loc.location.id }, db, "sato");
+    renameLocation(loc.location.id, "第 3 測定室", db);
+    assert.deepEqual(listHistory(inst.id, db)[0].changes, [{ field: "location", from: "品質保証部 測定室", to: "第 2 測定室" }]);
+  });
+
+  it("records registration, loans, returns, calibrations, reservations and orders", async () => {
+    const db = openDb();
+    const inst = createInstrument(
+      { managementNo: "HS-0001", name: "x", model: "", locationId: null, note: "", managerId: "sato", intervalMonths: 12, lastCalibratedOn: "2026-01-01", status: "in_use", importance: "B" },
+      db,
+      "sato",
+      NOW,
+    );
+    const loan = lendInstrument(inst.id, { borrowerId: "suzuki", dueOn: "2026-11-12" }, db, NOW, "kimura");
+    assert.ok(loan.ok);
+    returnLoan(inst.id, loan.loan.id, db, NOW, "kimura");
+    const r = createReservation(inst.id, "tanaka", { startOn: "2026-11-20", endOn: "2026-11-21" }, db, NOW);
+    assert.ok(r.ok);
+    cancelReservation(inst.id, r.reservation.id, "tanaka", db, NOW);
+    createReservation(inst.id, "tanaka", { startOn: "2026-11-22", endOn: "2026-11-23" }, db, NOW);
+    const o = createOrder(inst.id, "sato", { note: "" }, db, NOW);
+    assert.ok(o.ok);
+    const client: AgencyClient = { order: async () => ({ ok: true, orderId: "AG-1", estimatedReturnOn: "2026-11-24", attempts: 1 }) };
+    await sendOrder(client, o.order.id, db, NOW);
+    recordCalibration(inst.id, { calibratedOn: "2026-11-20", result: "fail", agency: "東日本計測サービス", certificateNo: "" }, "kato", db, NOW);
+    const actions = listHistory(inst.id, db).map((h) => `${h.action}:${h.actorId ?? "system"}`).reverse();
+    assert.deepEqual(actions, [
+      "instrument.created:sato",
+      "loan.lent:kimura",
+      "loan.returned:kimura",
+      "reservation.created:tanaka",
+      "reservation.cancelled:tanaka",
+      "reservation.created:tanaka",
+      "order.requested:sato",
+      "reservation.cancelled:sato",
+      "order.accepted:system",
+      "calibration.recorded:kato",
+      "order.completed:kato",
+    ]);
+    const cal = listHistory(inst.id, db).find((h) => h.action === "calibration.recorded")!;
+    assert.ok(cal.changes.some((c) => c.field === "status" && c.from === "calibrating" && c.to === "suspended"));
+  });
+
+  it("does not record failed operations and refuses to change or delete history", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0002"); // 貸出中
+    assert.equal(lendInstrument(inst.id, { borrowerId: "suzuki", dueOn: "2026-11-30" }, db, NOW, "sato").ok, false);
+    assert.equal(listHistory(inst.id, db).length, 0);
+    updateInstrument(inst.id, { note: "x" }, db, "sato");
+    assert.throws(() => db.prepare("UPDATE instrument_history SET actor_id = 'kato'").run());
+    assert.throws(() => db.prepare("DELETE FROM instrument_history").run());
+    assert.equal(listHistory(inst.id, db).length, 1);
+  });
+});
