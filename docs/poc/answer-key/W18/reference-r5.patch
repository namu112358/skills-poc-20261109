+/** 指定した項目だけを更新する。計測器が無ければ undefined。変わった項目を履歴に残す（actorId は変更した人）。 */
+export function updateInstrument(
+  id: number,
+  changes: Partial<InstrumentInput>,
+  db: Db = getDb(),
+  actorId: string | null = null,
+  now: Date = new Date(),
+): Instrument | undefined {
+  return transaction(db, () => {
+    const current = getInstrument(id, db);
+    if (!current) return undefined;
+    const next = { ...current, ...changes };
+    db.prepare(
+      `UPDATE instruments SET management_no = ?, name = ?, model = ?, location_id = ?, manager_id = ?, interval_months = ?,
+         last_calibrated_on = ?, status = ?, importance = ?, note = ? WHERE id = ?`,
+    ).run(
+      next.managementNo,
+      next.name,
+      next.model,
+      next.locationId,
+      next.managerId,
+      next.intervalMonths,
+      next.lastCalibratedOn,
+      next.status,
+      next.importance,
+      next.note,
+      id,
+    );
+    const updated = getInstrument(id, db)!;
+    const diff = diffFields(current, updated, HISTORY_FIELDS);
