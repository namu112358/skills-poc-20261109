+++ b/src/app/api/locations/route.ts
@@ -0,0 +1,17 @@
+import { NextResponse } from "next/server";
+import { readJson, requireApiUser } from "@/lib/api";
+import { getDb } from "@/lib/db";
+
+export async function GET() {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  return NextResponse.json({ locations: getDb().prepare("SELECT id, name FROM locations").all() });
+}
+
+export async function POST(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const b = (await readJson(request)) as { name: string };
+  const r = getDb().prepare("INSERT INTO locations (name) VALUES (?)").run(b.name);
+  return NextResponse.json({ location: { id: Number(r.lastInsertRowid), name: b.name } }, { status: 201 });
+}
