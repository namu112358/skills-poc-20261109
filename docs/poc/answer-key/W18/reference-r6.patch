diff --git a/src/lib/permissions.ts b/src/lib/permissions.ts
new file mode 100644
index 0000000..49963f4
--- /dev/null
+++ b/src/lib/permissions.ts
@@ -0,0 +1,34 @@
+// 部署ごとの権限。API Route は src/lib/api.ts の requirePermission() で確かめる（画面に出さないことを制限の代わりにしない）。
+// - 品質保証部の人は、すべての操作ができる。
+// - 計測器の台帳の編集（重要度・設置場所・状態を含む）・校正記録の登録・校正の発注・貸出・返却は、
+//   その計測器の管理部署（管理者が所属する部署。管理者が無効になっていても、その人の部署）の人もできる。
+// - 計測器の登録と、設置場所の一覧の管理は、品質保証部だけ。
+// - 閲覧と予約（自分の予約の作成・取消。管理者による取消は reservations.ts）は、全員ができる（ここでは確かめない）。
+// - 定期実行のジョブは利用者ではなく JOBS_TOKEN で認証する（requireJobAuth）。
+import { getDb, type Db } from "./db/index.ts";
+import type { Instrument } from "./instruments.ts";
+import { getUserDetail } from "./users.ts";
+
+/** 品質保証部（計測器の台帳を取りまとめる部署） */
+export const QA_DEPARTMENT_ID = "qa";
+
+/** 管理部署の人と品質保証部ができる、計測器ごとの操作 */
+export type InstrumentAction = "instrument.edit" | "calibration.record" | "order.create" | "loan.lend" | "loan.return";
+
+/** 品質保証部だけができる操作 */
+export type QaAction = "instrument.create" | "location.manage";
+
+export type Action = InstrumentAction | QaAction;
+
+/** 計測器の管理部署（管理者が所属する部署）。管理者が見つからなければ undefined。 */
+export function managingDepartment(instrument: Pick<Instrument, "managerId">, db: Db = getDb()): string | undefined {
+  return getUserDetail(instrument.managerId, db)?.departmentId;
+}
+
+export function can(userId: string, action: Action, instrument?: Pick<Instrument, "managerId">, db: Db = getDb()): boolean {
+  const user = getUserDetail(userId, db);
+  if (!user?.active) return false;
+  if (user.departmentId === QA_DEPARTMENT_ID) return true;
+  if (action === "instrument.create" || action === "location.manage") return false;
+  return instrument !== undefined && managingDepartment(instrument, db) === user.departmentId;
+}
diff --git a/tests/permissions.test.ts b/tests/permissions.test.ts
new file mode 100644
index 0000000..dc82e63
--- /dev/null
+++ b/tests/permissions.test.ts
@@ -0,0 +1,45 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { listInstruments } from "../src/lib/instruments.ts";
+import { can, managingDepartment } from "../src/lib/permissions.ts";
+
+const byNo = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+
+describe("permissions", () => {
+  it("lets the quality assurance department do everything", () => {
+    const db = openDb();
+    const tool = byNo(db, "MI-0003"); // 管理者 suzuki（製造部）
+    for (const a of ["instrument.create", "location.manage", "instrument.edit", "calibration.record", "order.create", "loan.lend", "loan.return"] as const) {
+      assert.equal(can("takahashi", a, tool, db), true, a);
+    }
+  });
+
+  it("lets the managing department edit, calibrate, order, lend and return its own instruments only", () => {
+    const db = openDb();
+    const mfg = byNo(db, "MI-0003"); // 製造部
+    const field = byNo(db, "MI-0002"); // 工事部（tanaka）
+    for (const a of ["instrument.edit", "calibration.record", "order.create", "loan.lend", "loan.return"] as const) {
+      assert.equal(can("watanabe", a, mfg, db), true, a); // 製造部の別の人
+      assert.equal(can("watanabe", a, field, db), false, a);
+    }
+    assert.equal(can("watanabe", "instrument.create", undefined, db), false);
+    assert.equal(can("watanabe", "location.manage", undefined, db), false);
+  });
+
+  it("uses the manager's department even when the manager is inactive", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0004"); // 管理者 inoue（製造部・退職）
+    assert.equal(managingDepartment(inst, db), "mfg");
+    assert.equal(can("yoshida", "instrument.edit", inst, db), true);
+    assert.equal(can("matsumoto", "instrument.edit", inst, db), false);
+  });
+
+  it("follows the manager when the manager changes and refuses inactive or unknown users", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0003");
+    assert.equal(can("kobayashi", "instrument.edit", { ...inst, managerId: "tanaka" }, db), true);
+    assert.equal(can("inoue", "instrument.edit", inst, db), false);
+    assert.equal(can("nobody", "instrument.edit", inst, db), false);
+  });
+});
