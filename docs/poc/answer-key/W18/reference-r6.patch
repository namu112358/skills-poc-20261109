+/** 権限が無ければ 403 の応答を返す（src/lib/permissions.ts）。計測器ごとの操作は instrument を渡す。 */
+export function requirePermission(user: User, action: Action, instrument?: Pick<Instrument, "id" | "managerId">): NextResponse | undefined {
