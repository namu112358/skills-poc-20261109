diff --git a/tests/sub-manager.test.ts b/tests/sub-manager.test.ts
new file mode 100644
index 0000000..a7f035b
--- /dev/null
+++ b/tests/sub-manager.test.ts
@@ -0,0 +1,34 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { recipientsFor } from "../src/lib/calibration-reminders.ts";
+import { openDb } from "../src/lib/db/index.ts";
+import { listHistory } from "../src/lib/history.ts";
+import { getInstrument, listInstruments, managerPairError, updateInstrument, validateInstrumentInput } from "../src/lib/instruments.ts";
+import { cancelReservation, createReservation } from "../src/lib/reservations.ts";
+
+const NOW = new Date("2026-11-10T01:00:00Z");
+const byNo = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+
+describe("sub manager", () => {
+  it("accepts active users only and not the manager", () => {
+    const db = openDb();
+    assert.deepEqual(validateInstrumentInput({ subManagerId: "kimura" }, { partial: true }, db), { ok: true, value: { subManagerId: "kimura" } });
+    assert.deepEqual(validateInstrumentInput({ subManagerId: null }, { partial: true }, db), { ok: true, value: { subManagerId: null } });
+    assert.equal(validateInstrumentInput({ subManagerId: "inoue" }, { partial: true }, db).ok, false);
+    assert.equal(managerPairError("sato", "sato") !== undefined, true);
+    assert.equal(managerPairError("sato", null), undefined);
+  });
+
+  it("receives reminders unless inactive, can cancel reservations, and is recorded in the history", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    updateInstrument(inst.id, { subManagerId: "tanaka" }, db, "kimura", NOW);
+    assert.deepEqual(recipientsFor(getInstrument(inst.id, db)!, db), ["sato", "tanaka"]);
+    db.prepare("UPDATE users SET active = 0 WHERE id = 'tanaka'").run();
+    assert.deepEqual(recipientsFor(getInstrument(inst.id, db)!, db), ["sato"]);
+    const r = createReservation(inst.id, "suzuki", { startOn: "2026-11-20", endOn: "2026-11-21" }, db, NOW);
+    assert.ok(r.ok);
+    assert.equal(cancelReservation(inst.id, r.reservation.id, "tanaka", db, NOW).ok, true);
+    assert.deepEqual(listHistory(inst.id, db).at(-1)?.changes, [{ field: "subManagerId", from: null, to: "tanaka" }]);
+  });
+});
