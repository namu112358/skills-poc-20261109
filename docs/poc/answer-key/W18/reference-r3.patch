+// 設置場所の一覧（マスタ）。計測器の設置場所は、この一覧から選ぶ。
+// - 名前の比較は「空白（半角・全角）の有無」と「数字の全角・半角」の違いを無視する（normalizeLocationKey）。
+//   同じキーになる名前は 1 つしか登録できない。ハンディ端末アプリ（旧 API）が名前で送ってきたときも、このキーで照合する。
+// - 計測器が置かれている場所は削除できない。
+// - 既存の自由入力の値は、マイグレーション（version 7）で同じキーごとにまとめて移した。キーは location-key.ts。
+import { getDb, type Db } from "./db/index.ts";
+import type { ValidationResult } from "./instruments.ts";
+import { cleanLocationName, normalizeLocationKey } from "./location-key.ts";
+
+export { cleanLocationName, normalizeLocationKey };
+
+export type Location = { id: number; name: string };
+
+export type LocationWithCount = Location & { instrumentCount: number };
+
+export function listLocations(db: Db = getDb()): LocationWithCount[] {
+  const rows = db
+    .prepare(
+      `SELECT l.id, l.name, COUNT(i.id) AS instrument_count
+       FROM locations l LEFT JOIN instruments i ON i.location_id = l.id
+       GROUP BY l.id ORDER BY l.name, l.id`,
+    )
+    .all() as { id: number; name: string; instrument_count: number }[];
+  return rows.map((r) => ({ id: r.id, name: r.name, instrumentCount: r.instrument_count }));
+}
+
+export function getLocation(id: number, db: Db = getDb()): Location | undefined {
+  return db.prepare("SELECT id, name FROM locations WHERE id = ?").get(id) as Location | undefined;
+}
+
+/** 名前（表記ゆれを無視して）で場所を探す。 */
+export function findLocationByName(name: string, db: Db = getDb()): Location | undefined {
+  return db.prepare("SELECT id, name FROM locations WHERE name_key = ?").get(normalizeLocationKey(name)) as Location | undefined;
+}
+
+/** 場所の名前の入力を検証する（1〜100 文字）。 */
+export function validateLocationName(body: unknown): ValidationResult<string> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const name = (body as Record<string, unknown>).name;
+  if (typeof name !== "string" || cleanLocationName(name) === "" || name.length > 100) {
+    return { ok: false, errors: ["場所の名前は 1〜100 文字で入力してください"] };
+  }
+  return { ok: true, value: cleanLocationName(name) };
+}
+
+export type LocationResult = { ok: true; location: Location } | { ok: false; reason: "not_found" | "duplicate" | "in_use" };
+
+export function createLocation(name: string, db: Db = getDb()): LocationResult {
+  if (findLocationByName(name, db)) return { ok: false, reason: "duplicate" };
+  const { lastInsertRowid } = db
+    .prepare("INSERT INTO locations (name, name_key) VALUES (?, ?)")
+    .run(cleanLocationName(name), normalizeLocationKey(name));
+  return { ok: true, location: getLocation(Number(lastInsertRowid), db)! };
+}
+
+/** 名前を変える。計測器の設置場所の表示も新しい名前になる（計測器は場所の ID を持つため）。 */
+export function renameLocation(id: number, name: string, db: Db = getDb()): LocationResult {
+  if (!getLocation(id, db)) return { ok: false, reason: "not_found" };
+  const same = findLocationByName(name, db);
+  if (same && same.id !== id) return { ok: false, reason: "duplicate" };
+  db.prepare("UPDATE locations SET name = ?, name_key = ? WHERE id = ?").run(cleanLocationName(name), normalizeLocationKey(name), id);
+  return { ok: true, location: getLocation(id, db)! };
+}
+
+/** 計測器が置かれていない場所だけを削除する。 */
+export function deleteLocation(id: number, db: Db = getDb()): LocationResult {
+  const location = getLocation(id, db);
+  if (!location) return { ok: false, reason: "not_found" };
+  if (db.prepare("SELECT 1 FROM instruments WHERE location_id = ? LIMIT 1").get(id)) return { ok: false, reason: "in_use" };
+  db.prepare("DELETE FROM locations WHERE id = ?").run(id);
+  return { ok: true, location };
+}
+
+/** 名前の場所を探し、無ければ作る（初期データの投入用）。 */
+export function ensureLocation(name: string, db: Db = getDb()): Location {
+  return findLocationByName(name, db) ?? (createLocation(name, db) as { ok: true; location: Location }).location;
+}
