diff --git a/src/lib/location-key.ts b/src/lib/location-key.ts
new file mode 100644
index 0000000..810826d
--- /dev/null
+++ b/src/lib/location-key.ts
@@ -0,0 +1,25 @@
+// 設置場所の名前の照合キー（locations.ts と、既存の値をまとめるマイグレーション version 7 の両方で使う）。
+// 空白（半角・全角）の有無と、数字の全角・半角の違いを無視する。JS 版と SQL 版は同じキーを作る。
+const FULLWIDTH_DIGITS = "０１２３４５６７８９";
+
+/** 名前の照合用のキー。空白（半角・全角）を除き、全角数字を半角にする。 */
+export function normalizeLocationKey(name: string): string {
+  return name.replace(/[\s　]/g, "").replace(/[０-９]/g, (c) => String(FULLWIDTH_DIGITS.indexOf(c)));
+}
+
+/** 表示用の名前。前後の空白を除き、全角の空白を半角にする。 */
+export function cleanLocationName(name: string): string {
+  return name.replace(/　/g, " ").trim();
+}
+
+/** normalizeLocationKey と同じキーを SQL で作る式。 */
+export function sqlLocationKey(column: string): string {
+  let expr = `REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(${column}, ' ', ''), '　', ''), char(9), ''), char(10), ''), char(13), '')`;
+  for (let d = 0; d <= 9; d++) expr = `REPLACE(${expr}, '${FULLWIDTH_DIGITS[d]}', '${d}')`;
+  return expr;
+}
+
+/** cleanLocationName と同じ名前を SQL で作る式。 */
+export function sqlCleanLocationName(column: string): string {
+  return `TRIM(REPLACE(${column}, '　', ' '))`;
+}
