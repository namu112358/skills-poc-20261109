diff --git a/tests/locations.test.ts b/tests/locations.test.ts
new file mode 100644
index 0000000..67dc4dd
--- /dev/null
+++ b/tests/locations.test.ts
@@ -0,0 +1,112 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { DatabaseSync } from "node:sqlite";
+import { migrate, openDb } from "../src/lib/db/index.ts";
+import { MIGRATIONS } from "../src/lib/db/migrations.ts";
+import { createInstrument, getInstrument, listInstruments, updateInstrument, validateInstrumentInput } from "../src/lib/instruments.ts";
+import {
+  createLocation,
+  deleteLocation,
+  findLocationByName,
+  listLocations,
+  normalizeLocationKey,
+  renameLocation,
+  validateLocationName,
+} from "../src/lib/locations.ts";
+
+const byNo = (db: DatabaseSync, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+
+describe("normalizeLocationKey", () => {
+  it("ignores spaces and full-width digits only", () => {
+    assert.equal(normalizeLocationKey("製造部 第1ライン"), normalizeLocationKey("製造部　第１ライン"));
+    assert.equal(normalizeLocationKey("製造部第1ライン"), normalizeLocationKey(" 製造部 第 1 ライン "));
+    assert.notEqual(normalizeLocationKey("製造部 第一ライン"), normalizeLocationKey("製造部 第1ライン"));
+  });
+});
+
+describe("migration 7 (locations)", () => {
+  it("merges free-text locations that differ only in spaces or digit width, keeping each instrument's place", () => {
+    const db = new DatabaseSync(":memory:");
+    db.exec("PRAGMA foreign_keys = ON");
+    migrate(db, MIGRATIONS.filter((m) => m.version < 7));
+    db.exec(`INSERT INTO departments (id, name) VALUES ('qa', '品質保証部');
+      INSERT INTO users (id, name, department_id) VALUES ('sato', '佐藤', 'qa');`);
+    const add = db.prepare(
+      "INSERT INTO instruments (management_no, name, location, manager_id, interval_months, last_calibrated_on) VALUES (?, 'x', ?, 'sato', 12, '2026-01-01')",
+    );
+    for (const [no, loc] of [["AA-0001", "製造部 第1ライン"], ["AA-0002", "製造部　第１ライン"], ["AA-0003", "製造部第1ライン"], ["AA-0004", "倉庫A"], ["AA-0005", ""]]) {
+      add.run(no, loc);
+    }
+    migrate(db);
+    const names = listLocations(db).map((l) => l.name).sort();
+    assert.deepEqual(names, ["倉庫A", "製造部 第1ライン"]);
+    const [a, b, c, d, e] = ["AA-0001", "AA-0002", "AA-0003", "AA-0004", "AA-0005"].map((no) => byNo(db, no));
+    assert.equal(a.locationId, b.locationId);
+    assert.equal(a.locationId, c.locationId);
+    assert.notEqual(a.locationId, d.locationId);
+    assert.equal(a.location, "製造部 第1ライン");
+    assert.equal(e.locationId, null);
+    assert.equal(e.location, "");
+  });
+
+  it("places the seed instruments in the seed locations", () => {
+    const db = openDb();
+    assert.equal(byNo(db, "MI-0001").location, "品質保証部 測定室");
+    assert.equal(listLocations(db).find((l) => l.name === "工事部 倉庫")?.instrumentCount, 3);
+  });
+});
+
+describe("locations", () => {
+  it("refuses duplicate names, including spelling variants", () => {
+    const db = openDb();
+    assert.equal(createLocation("検査室 2", db).ok, true);
+    assert.deepEqual(createLocation("検査室２", db), { ok: false, reason: "duplicate" });
+    assert.deepEqual(validateLocationName({ name: "　" }).ok, false);
+  });
+
+  it("renames a location and the instruments show the new name", () => {
+    const db = openDb();
+    const loc = findLocationByName("品質保証部 測定室", db)!;
+    assert.equal(renameLocation(loc.id, "品質保証部 第 1 測定室", db).ok, true);
+    assert.equal(byNo(db, "MI-0001").location, "品質保証部 第 1 測定室");
+    assert.deepEqual(renameLocation(loc.id, "工事部　倉庫", db), { ok: false, reason: "duplicate" });
+    assert.equal(renameLocation(loc.id, "品質保証部第1測定室", db).ok, true); // 自分自身との重なりはよい
+  });
+
+  it("deletes only locations without instruments", () => {
+    const db = openDb();
+    const used = findLocationByName("工事部 倉庫", db)!;
+    assert.deepEqual(deleteLocation(used.id, db), { ok: false, reason: "in_use" });
+    const empty = createLocation("予備室", db);
+    assert.ok(empty.ok);
+    assert.equal(deleteLocation(empty.location.id, db).ok, true);
+    assert.deepEqual(deleteLocation(empty.location.id, db), { ok: false, reason: "not_found" });
+  });
+});
+
+describe("instrument location input", () => {
+  it("accepts locationId, or a known name from the old API, and refuses unknown names", () => {
+    const db = openDb();
+    const loc = findLocationByName("工事部 倉庫", db)!;
+    assert.deepEqual(validateInstrumentInput({ locationId: loc.id }, { partial: true }, db), { ok: true, value: { locationId: loc.id } });
+    assert.deepEqual(validateInstrumentInput({ location: "工事部　倉庫" }, { partial: true }, db), { ok: true, value: { locationId: loc.id } });
+    assert.deepEqual(validateInstrumentInput({ location: "" }, { partial: true }, db), { ok: true, value: { locationId: null } });
+    assert.equal(validateInstrumentInput({ location: "どこか" }, { partial: true }, db).ok, false);
+    assert.equal(validateInstrumentInput({ locationId: 9999 }, { partial: true }, db).ok, false);
+  });
+
+  it("filters instruments by location", () => {
+    const db = openDb();
+    const loc = findLocationByName("工事部 倉庫", db)!;
+    const inst = createInstrument(
+      { managementNo: "LC-0001", name: "x", model: "", locationId: null, note: "", managerId: "sato", intervalMonths: 12, lastCalibratedOn: "2026-01-01", status: "in_use", importance: "B" },
+      db,
+    );
+    updateInstrument(inst.id, { locationId: loc.id }, db);
+    assert.equal(getInstrument(inst.id, db)?.location, "工事部 倉庫");
+    assert.deepEqual(
+      listInstruments({ locationId: loc.id }, db).map((i) => i.managementNo),
+      ["LC-0001", "MI-0002", "MI-0005", "MI-0006"],
+    );
+  });
+});
