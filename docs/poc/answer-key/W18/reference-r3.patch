@@ -0,0 +1,20 @@
+// GET /api/locations — 設置場所の一覧（置かれている計測器の数つき） / POST /api/locations — 場所を追加する（本文 { name }）。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { createLocation, listLocations, validateLocationName } from "@/lib/locations";
+
+export async function GET() {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  return NextResponse.json({ locations: listLocations() });
+}
+
+export async function POST(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const name = validateLocationName(await readJson(request));
+  if (!name.ok) return jsonError(400, "入力内容に誤りがあります", name.errors);
+  const result = createLocation(name.value);
+  if (!result.ok) return jsonError(409, "同じ名前の場所がすでにあります");
+  return NextResponse.json({ location: result.location }, { status: 201 });
+}
