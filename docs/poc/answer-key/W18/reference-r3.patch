@@ -0,0 +1,33 @@
+// PATCH /api/locations/:id — 場所の名前を変える（本文 { name }） / DELETE — 計測器が置かれていない場所を削除する。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { parseId } from "@/lib/instruments";
+import { deleteLocation, renameLocation, validateLocationName, type LocationResult } from "@/lib/locations";
+
+type Context = { params: Promise<{ id: string }> };
+
+function failure(result: Exclude<LocationResult, { ok: true }>) {
+  if (result.reason === "not_found") return jsonError(404, "場所が見つかりません");
+  if (result.reason === "duplicate") return jsonError(409, "同じ名前の場所がすでにあります");
+  return jsonError(409, "計測器が置かれている場所は削除できません");
+}
+
+export async function PATCH(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  if (id === undefined) return jsonError(404, "場所が見つかりません");
+  const name = validateLocationName(await readJson(request));
+  if (!name.ok) return jsonError(400, "入力内容に誤りがあります", name.errors);
+  const result = renameLocation(id, name.value);
+  return result.ok ? NextResponse.json({ location: result.location }) : failure(result);
+}
+
+export async function DELETE(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  if (id === undefined) return jsonError(404, "場所が見つかりません");
+  const result = deleteLocation(id);
+  return result.ok ? NextResponse.json({ location: result.location }) : failure(result);
+}
