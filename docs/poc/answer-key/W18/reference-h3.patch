diff --git a/tests/repairing.test.ts b/tests/repairing.test.ts
new file mode 100644
index 0000000..39a2397
--- /dev/null
+++ b/tests/repairing.test.ts
@@ -0,0 +1,41 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { DatabaseSync } from "node:sqlite";
+import { createOrder } from "../src/lib/calibration-orders.ts";
+import { migrate, openDb, seed } from "../src/lib/db/index.ts";
+import { MIGRATIONS } from "../src/lib/db/migrations.ts";
+import { listInstruments, updateInstrument } from "../src/lib/instruments.ts";
+import { lendInstrument } from "../src/lib/loans.ts";
+import { createReservation, listReservations } from "../src/lib/reservations.ts";
+
+const NOW = new Date("2026-11-10T01:00:00Z");
+const byNo = (db: DatabaseSync, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+
+describe("repairing", () => {
+  it("keeps all data and references when the instruments table is rebuilt (migration 10)", () => {
+    const db = new DatabaseSync(":memory:");
+    db.exec("PRAGMA foreign_keys = ON");
+    migrate(db, MIGRATIONS.filter((m) => m.version < 10));
+    seed(db);
+    const before = db.prepare("SELECT * FROM instruments ORDER BY id").all();
+    const loans = db.prepare("SELECT COUNT(*) AS n FROM loans").get();
+    migrate(db);
+    assert.deepEqual(db.prepare("SELECT * FROM instruments ORDER BY id").all(), before);
+    assert.deepEqual(db.prepare("SELECT COUNT(*) AS n FROM loans").get(), loans);
+    assert.equal((db.prepare("PRAGMA foreign_keys").get() as { foreign_keys: number }).foreign_keys, 1);
+    db.prepare("UPDATE instruments SET status = 'repairing' WHERE management_no = 'MI-0001'").run();
+  });
+
+  it("cancels upcoming reservations and blocks loans, reservations and orders while repairing", () => {
+    const db = openDb();
+    const id = byNo(db, "MI-0001").id;
+    assert.ok(createReservation(id, "suzuki", { startOn: "2026-11-20", endOn: "2026-11-21" }, db, NOW).ok);
+    updateInstrument(id, { status: "repairing" }, db, "sato", NOW);
+    assert.equal(listReservations(id, db)[0].status, "cancelled");
+    assert.deepEqual(createReservation(id, "suzuki", { startOn: "2026-11-25", endOn: "2026-11-26" }, db, NOW), { ok: false, reason: "not_reservable" });
+    assert.equal(lendInstrument(id, { borrowerId: "suzuki", dueOn: "2026-11-12" }, db, NOW).ok, false);
+    assert.deepEqual(createOrder(id, "sato", { note: "" }, db, NOW), { ok: false, reason: "not_orderable" });
+    updateInstrument(id, { status: "in_use" }, db, "sato", NOW);
+    assert.equal(createReservation(id, "suzuki", { startOn: "2026-11-25", endOn: "2026-11-26" }, db, NOW).ok, true);
+  });
+});
