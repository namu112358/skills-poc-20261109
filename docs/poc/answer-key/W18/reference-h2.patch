+describe("ledger edits that make an instrument unusable", () => {
+  it("cancel upcoming reservations when the status becomes suspended or disposed, but not for other edits", () => {
+    for (const status of ["suspended", "disposed"] as const) {
+      const db = openDb();
+      const id = byNo(db, "MI-0001").id;
+      const r = createReservation(id, "suzuki", { startOn: "2026-11-20", endOn: "2026-11-22" }, db, NOW);
+      assert.ok(r.ok);
+      updateInstrument(id, { note: "x" }, db, "sato", NOW);
+      assert.equal(listReservations(id, db)[0].status, "active");
+      updateInstrument(id, { status }, db, "sato", NOW);
+      assert.equal(listReservations(id, db)[0].status, "cancelled");
+    }
+  });
+});
