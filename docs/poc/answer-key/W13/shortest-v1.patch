diff --git a/src/lib/reservations.ts b/src/lib/reservations.ts
new file mode 100644
index 0000000..c75eca8
--- /dev/null
+++ b/src/lib/reservations.ts
@@ -0,0 +1,23 @@
+import { getDb } from "./db/index.ts";
+
+export function listReservations(instrumentId: number) {
+  return getDb()
+    .prepare("SELECT id, user_id AS userId, start_on AS startOn, end_on AS endOn, status FROM reservations WHERE instrument_id = ?")
+    .all(instrumentId);
+}
+
+export function reserve(instrumentId: number, userId: string, startOn: string, endOn: string) {
+  const db = getDb();
+  const hit = db
+    .prepare("SELECT 1 FROM reservations WHERE instrument_id = ? AND status = 'reserved' AND start_on <= ? AND end_on >= ?")
+    .get(instrumentId, endOn, startOn);
+  if (hit) return undefined;
+  const r = db
+    .prepare("INSERT INTO reservations (instrument_id, user_id, start_on, end_on) VALUES (?, ?, ?, ?)")
+    .run(instrumentId, userId, startOn, endOn);
+  return Number(r.lastInsertRowid);
+}
+
+export function cancel(id: number) {
+  getDb().prepare("UPDATE reservations SET status = 'cancelled' WHERE id = ?").run(id);
+}
