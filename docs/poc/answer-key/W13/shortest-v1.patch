+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { listReservations, reserve } from "@/lib/reservations";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function GET(_r: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  return NextResponse.json({ reservations: listReservations(Number((await params).id)) });
+}
+
+export async function POST(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const b = (await readJson(request)) as { startOn: string; endOn: string };
+  const id = reserve(Number((await params).id), user.id, b.startOn, b.endOn);
+  if (id === undefined) return jsonError(409, "重なる予約があります");
+  return NextResponse.json({ reservation: { id } }, { status: 201 });
+}
