@@ -0,0 +1,23 @@
+// POST /api/instruments/:id/reservations/:reservationId/cancel — 予約を取り消す（予約した本人か、計測器の管理者）。
+import { NextResponse } from "next/server";
+import { jsonError, requireApiUser } from "@/lib/api";
+import { parseId } from "@/lib/instruments";
+import { cancelReservation } from "@/lib/reservations";
+
+type Context = { params: Promise<{ id: string; reservationId: string }> };
+
+export async function POST(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const p = await params;
+  const id = parseId(p.id);
+  const reservationId = parseId(p.reservationId);
+  if (id === undefined || reservationId === undefined) return jsonError(404, "予約が見つかりません");
+  const result = cancelReservation(id, reservationId, user.id);
+  if (!result.ok) {
+    if (result.reason === "not_found") return jsonError(404, "予約が見つかりません");
+    if (result.reason === "forbidden") return jsonError(403, "予約を取り消せるのは、予約した本人と計測器の管理者です");
+    return jsonError(409, "この予約はすでに取り消されています");
+  }
+  return NextResponse.json({ reservation: result.reservation });
+}
