+++ b/tests/reservations.test.ts
@@ -0,0 +1,99 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { recordCalibration } from "../src/lib/calibrations.ts";
+import { listInstruments, updateInstrument } from "../src/lib/instruments.ts";
+import { lendInstrument } from "../src/lib/loans.ts";
+import {
+  cancelReservation,
+  createReservation,
+  listReservations,
+  validateReservationInput,
+} from "../src/lib/reservations.ts";
+
+const byNo = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+const NOW = new Date("2026-11-10T01:00:00Z"); // 日本時間 2026-11-10
+
+describe("validateReservationInput", () => {
+  it("accepts today and later, and rejects past or reversed periods", () => {
+    assert.equal(validateReservationInput({ startOn: "2026-11-10", endOn: "2026-11-10" }, "2026-11-10").ok, true);
+    assert.equal(validateReservationInput({ startOn: "2026-11-09", endOn: "2026-11-12" }, "2026-11-10").ok, false);
+    assert.equal(validateReservationInput({ startOn: "2026-11-12", endOn: "2026-11-11" }, "2026-11-10").ok, false);
+    assert.equal(validateReservationInput({ startOn: "2026-11-31", endOn: "2026-12-01" }, "2026-11-10").ok, false);
+  });
+});
+
+describe("createReservation", () => {
+  it("refuses periods that overlap even by one day, including the boundary day", () => {
+    const db = openDb();
+    const id = byNo(db, "MI-0001").id;
+    assert.equal(createReservation(id, "suzuki", { startOn: "2026-11-20", endOn: "2026-11-22" }, db, NOW).ok, true);
+    assert.deepEqual(createReservation(id, "tanaka", { startOn: "2026-11-22", endOn: "2026-11-24" }, db, NOW), { ok: false, reason: "conflict" });
+    assert.deepEqual(createReservation(id, "tanaka", { startOn: "2026-11-18", endOn: "2026-11-20" }, db, NOW), { ok: false, reason: "conflict" });
+    assert.equal(createReservation(id, "tanaka", { startOn: "2026-11-23", endOn: "2026-11-24" }, db, NOW).ok, true);
+  });
+
+  it("frees the period when a reservation is cancelled", () => {
+    const db = openDb();
+    const id = byNo(db, "MI-0001").id;
+    const r = createReservation(id, "suzuki", { startOn: "2026-11-20", endOn: "2026-11-22" }, db, NOW);
+    assert.ok(r.ok);
+    assert.equal(cancelReservation(id, r.reservation.id, "suzuki", db).ok, true);
+    assert.equal(createReservation(id, "tanaka", { startOn: "2026-11-20", endOn: "2026-11-22" }, db, NOW).ok, true);
+  });
+
+  it("allows reserving an instrument on loan only from the day after its due date", () => {
+    const db = openDb();
+    const id = byNo(db, "MI-0002").id; // 返却予定日 2026-11-13
