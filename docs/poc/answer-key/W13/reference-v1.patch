diff --git a/src/lib/reservations.ts b/src/lib/reservations.ts
new file mode 100644
index 0000000..b4687c2
--- /dev/null
+++ b/src/lib/reservations.ts
@@ -0,0 +1,173 @@
+// 計測器の貸出の予約。予約は日単位（開始日・終了日を含む。日本時間の暦日）。
+// - 同じ計測器で期間が 1 日でも重なる有効な予約は作れない。貸出中なら返却予定日の翌日から予約できる。
+// - 使用停止・廃棄の計測器は予約できない。
+// - 取り消せるのは予約した本人と、その計測器の管理者。
+// - 他人の予約の期間にかかる貸出はしない（loans.ts の lendInstrument が conflictingReservation で確かめる）。
+import { getDb, transaction, type Db } from "./db/index.ts";
+import { isValidDate, todayJst } from "./dates.ts";
+import { getInstrument, type ValidationResult } from "./instruments.ts";
+import { currentLoan } from "./loans.ts";
+
+export type ReservationStatus = "active" | "cancelled";
+
+export const RESERVATION_STATUS_LABELS: Record<ReservationStatus, string> = {
+  active: "予約中",
+  cancelled: "取消",
+};
+
+export type Reservation = {
+  id: number;
+  instrumentId: number;
+  userId: string;
+  startOn: string;
+  endOn: string;
+  status: ReservationStatus;
+  createdAt: string;
+  cancelledAt: string | null;
+  cancelledBy: string | null;
+};
+
+type Row = {
+  id: number;
+  instrument_id: number;
+  user_id: string;
+  start_on: string;
+  end_on: string;
+  status: ReservationStatus;
+  created_at: string;
+  cancelled_at: string | null;
+  cancelled_by: string | null;
+};
+
+const COLUMNS = "id, instrument_id, user_id, start_on, end_on, status, created_at, cancelled_at, cancelled_by";
+
+function toReservation(r: Row): Reservation {
+  return {
+    id: r.id,
+    instrumentId: r.instrument_id,
+    userId: r.user_id,
+    startOn: r.start_on,
+    endOn: r.end_on,
+    status: r.status,
+    createdAt: r.created_at,
+    cancelledAt: r.cancelled_at,
+    cancelledBy: r.cancelled_by,
+  };
+}
+
+/** 計測器の予約（取消を含む）を開始日の順に返す。 */
+export function listReservations(instrumentId: number, db: Db = getDb()): Reservation[] {
+  const rows = db
+    .prepare(`SELECT ${COLUMNS} FROM reservations WHERE instrument_id = ? ORDER BY start_on, id`)
+    .all(instrumentId) as Row[];
+  return rows.map(toReservation);
+}
+
+export function getReservation(instrumentId: number, id: number, db: Db = getDb()): Reservation | undefined {
+  const row = db.prepare(`SELECT ${COLUMNS} FROM reservations WHERE id = ? AND instrument_id = ?`).get(id, instrumentId) as
+    | Row
+    | undefined;
+  return row && toReservation(row);
+}
+
+/** [from, to] と 1 日でも重なる有効な予約（except の利用者のものは除く）。 */
+export function conflictingReservation(
+  instrumentId: number,
+  from: string,
+  to: string,
+  db: Db = getDb(),
+  except?: { userId?: string },
+): Reservation | undefined {
+  const row = db
+    .prepare(
+      `SELECT ${COLUMNS} FROM reservations
+       WHERE instrument_id = ? AND status = 'active' AND start_on <= ? AND end_on >= ?
+         AND (? IS NULL OR user_id <> ?)
+       ORDER BY start_on LIMIT 1`,
+    )
+    .get(instrumentId, to, from, except?.userId ?? null, except?.userId ?? null) as Row | undefined;
+  return row && toReservation(row);
+}
+
+export type ReservationInput = { startOn: string; endOn: string };
+
+export function validateReservationInput(body: unknown, today: string): ValidationResult<ReservationInput> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const b = body as Record<string, unknown>;
+  const errors: string[] = [];
+  if (!isValidDate(b.startOn)) errors.push("開始日は YYYY-MM-DD 形式で入力してください");
+  if (!isValidDate(b.endOn)) errors.push("終了日は YYYY-MM-DD 形式で入力してください");
+  if (errors.length === 0) {
+    if ((b.startOn as string) < today) errors.push("過去の日からは予約できません");
+    if ((b.endOn as string) < (b.startOn as string)) errors.push("終了日は開始日以降にしてください");
+  }
+  return errors.length > 0
+    ? { ok: false, errors }
+    : { ok: true, value: { startOn: b.startOn as string, endOn: b.endOn as string } };
+}
+
+export type ReserveResult =
+  | { ok: true; reservation: Reservation }
+  | { ok: false; reason: "not_found" | "not_reservable" | "on_loan" | "conflict" };
+
+/** 予約を作る。期間の検証（validateReservationInput）は済んでいること。 */
+export function createReservation(
+  instrumentId: number,
+  userId: string,
+  input: ReservationInput,
+  db: Db = getDb(),
+  now: Date = new Date(),
+): ReserveResult {
+  return transaction(db, () => {
+    const instrument = getInstrument(instrumentId, db);
+    if (!instrument) return { ok: false, reason: "not_found" } as const;
+    if (instrument.status === "suspended" || instrument.status === "disposed") {
+      return { ok: false, reason: "not_reservable" } as const;
+    }
+    const loan = currentLoan(instrumentId, db);
+    if (loan && input.startOn <= loan.dueOn) return { ok: false, reason: "on_loan" } as const;
+    if (conflictingReservation(instrumentId, input.startOn, input.endOn, db)) return { ok: false, reason: "conflict" } as const;
+    const { lastInsertRowid } = db
+      .prepare("INSERT INTO reservations (instrument_id, user_id, start_on, end_on, created_at) VALUES (?, ?, ?, ?, ?)")
+      .run(instrumentId, userId, input.startOn, input.endOn, now.toISOString());
+    const row = db.prepare(`SELECT ${COLUMNS} FROM reservations WHERE id = ?`).get(Number(lastInsertRowid)) as Row;
+    return { ok: true, reservation: toReservation(row) } as const;
+  });
+}
+
+export type CancelResult = { ok: true; reservation: Reservation } | { ok: false; reason: "not_found" | "forbidden" | "not_active" };
+
+/** 予約を取り消す。取り消せるのは予約した本人と、その計測器の管理者。 */
+export function cancelReservation(
+  instrumentId: number,
+  id: number,
+  userId: string,
+  db: Db = getDb(),
+  now: Date = new Date(),
+): CancelResult {
+  return transaction(db, () => {
+    const r = getReservation(instrumentId, id, db);
+    const instrument = getInstrument(instrumentId, db);
+    if (!r || !instrument) return { ok: false, reason: "not_found" } as const;
+    if (r.userId !== userId && instrument.managerId !== userId) return { ok: false, reason: "forbidden" } as const;
+    if (r.status !== "active") return { ok: false, reason: "not_active" } as const;
+    db.prepare("UPDATE reservations SET status = 'cancelled', cancelled_at = ?, cancelled_by = ? WHERE id = ?").run(
+      now.toISOString(),
+      userId,
+      id,
+    );
+    return { ok: true, reservation: getReservation(instrumentId, id, db)! } as const;
+  });
+}
+
+/** 使用停止になった計測器の、これから（終了日が今日以降）の予約を取り消す。トランザクションの中で呼ぶ。 */
+export function cancelUpcomingReservations(instrumentId: number, cancelledBy: string, db: Db, now: Date = new Date()): number {
+  const { changes } = db
+    .prepare(
+      "UPDATE reservations SET status = 'cancelled', cancelled_at = ?, cancelled_by = ? WHERE instrument_id = ? AND status = 'active' AND end_on >= ?",
+    )
+    .run(now.toISOString(), cancelledBy, instrumentId, todayJst(now));
+  return Number(changes);
+}
