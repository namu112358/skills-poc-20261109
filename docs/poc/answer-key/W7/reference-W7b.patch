+// DELETE /api/tasks/:id/worklogs/:worklogId — 自分の作業記録を削除する。ログインが必要。
+import { NextResponse } from "next/server";
+import { currentApiUser, withApi } from "@/lib/api";
+import { NotFoundError } from "@/lib/errors";
+import { parseTaskId } from "@/lib/tasks";
+import { deleteWorklog } from "@/lib/worklogs";
+
+type Context = { params: Promise<{ id: string; worklogId: string }> };
+
+export const DELETE = withApi(async (_request, { params }: Context) => {
+  const user = await currentApiUser();
+  const p = await params;
+  const taskId = parseTaskId(p.id);
+  const worklogId = parseTaskId(p.worklogId);
+  if (taskId === undefined || worklogId === undefined) throw new NotFoundError("作業記録が見つかりません");
+  deleteWorklog(taskId, worklogId, user.id);
+  return new NextResponse(null, { status: 204 });
+});
