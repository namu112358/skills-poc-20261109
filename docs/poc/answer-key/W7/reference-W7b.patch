+// GET /api/tasks/:id/worklogs — 作業記録（新しい順）と合計 / POST — 作業記録を追加する。ログインが必要。
+import { NextResponse } from "next/server";
+import { currentApiUser, readJson, withApi } from "@/lib/api";
+import { NotFoundError, ValidationError } from "@/lib/errors";
+import { getTask, parseTaskId } from "@/lib/tasks";
+import { createWorklog, listWorklogs, totalMinutes, validateWorklogInput } from "@/lib/worklogs";
+
+type Context = { params: Promise<{ id: string }> };
+
+export const GET = withApi(async (_request, { params }: Context) => {
+  await currentApiUser();
+  const taskId = parseTaskId((await params).id);
+  if (taskId === undefined || !getTask(taskId)) throw new NotFoundError("タスクが見つかりません");
+  const worklogs = listWorklogs(taskId);
+  return NextResponse.json({ worklogs, totalMinutes: totalMinutes(worklogs) });
+});
+
+export const POST = withApi(async (request, { params }: Context) => {
+  const user = await currentApiUser();
+  const taskId = parseTaskId((await params).id);
+  if (taskId === undefined || !getTask(taskId)) throw new NotFoundError("タスクが見つかりません");
+  const result = validateWorklogInput(await readJson(request));
+  if (!result.ok) throw new ValidationError(result.errors);
+  return NextResponse.json({ worklog: createWorklog({ taskId, author: user.id, ...result.value }) }, { status: 201 });
+});
