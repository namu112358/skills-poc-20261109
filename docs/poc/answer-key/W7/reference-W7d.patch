diff --git a/src/lib/schedules.ts b/src/lib/schedules.ts
new file mode 100644
index 0000000..e1632f9
--- /dev/null
+++ b/src/lib/schedules.ts
@@ -0,0 +1,67 @@
+import { jstLocalToUtcIso, toUtcIso } from "./datetime.ts";
+import { getDb, type Db } from "./db/index.ts";
+import { ConflictError, ForbiddenError, NotFoundError } from "./errors.ts";
+import { getTask, type ValidationResult } from "./tasks.ts";
+
+export type Schedule = {
+  id: number;
+  taskId: number;
+  createdBy: string;
+  createdByName: string;
+  title: string;
+  startsAt: string; // ISO 8601（UTC）
+  createdAt: string; // ISO 8601（UTC）
+};
+
+export const SCHEDULE_TITLE_MAX_LENGTH = 100;
+
+type Row = { id: number; task_id: number; created_by: string; created_by_name: string; title: string; starts_at: string; created_at: string };
+
+const SELECT =
+  "SELECT s.id, s.task_id, s.created_by, u.name AS created_by_name, s.title, s.starts_at, s.created_at FROM schedules s JOIN users u ON u.id = s.created_by";
+
+function toSchedule(r: Row): Schedule {
+  return { id: r.id, taskId: r.task_id, createdBy: r.created_by, createdByName: r.created_by_name, title: r.title, startsAt: r.starts_at, createdAt: r.created_at };
+}
+
+/** 開始日時の早い順（同じなら ID の小さい順）。 */
+export function listSchedules(taskId: number, db: Db = getDb()): Schedule[] {
+  return (db.prepare(`${SELECT} WHERE s.task_id = ? ORDER BY s.starts_at, s.id`).all(taskId) as Row[]).map(toSchedule);
+}
+
+export function getSchedule(id: number, db: Db = getDb()): Schedule | undefined {
+  const r = db.prepare(`${SELECT} WHERE s.id = ?`).get(id) as Row | undefined;
+  return r && toSchedule(r);
+}
+
+/** startsAt は日時入力欄の値（日本時間の YYYY-MM-DDTHH:mm）。保存用の UTC に変換して返す。 */
+export function validateScheduleInput(body: unknown): ValidationResult<{ title: string; startsAt: string }> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const b = body as Record<string, unknown>;
+  const errors: string[] = [];
+  const title = typeof b.title === "string" ? b.title.trim() : "";
+  if (title.length < 1 || title.length > SCHEDULE_TITLE_MAX_LENGTH) {
+    errors.push(`件名は 1〜${SCHEDULE_TITLE_MAX_LENGTH} 文字で入力してください`);
+  }
+  const startsAt = jstLocalToUtcIso(b.startsAt);
+  if (!startsAt) errors.push("開始日時は YYYY-MM-DDTHH:mm 形式で入力してください");
+  if (errors.length > 0) return { ok: false, errors };
+  return { ok: true, value: { title, startsAt: startsAt! } };
+}
+
+export function createSchedule(
+  input: { taskId: number; userId: string; title: string; startsAt: string },
+  db: Db = getDb(),
+  now: Date = new Date(),
+): Schedule {
+  const task = getTask(input.taskId, db);
+  if (!task) throw new NotFoundError("タスクが見つかりません");
+  if (task.assignee !== input.userId) throw new ForbiddenError("予定を登録できるのはタスクの担当者だけです");
+  if (task.status === "done") throw new ConflictError("完了したタスクには予定を登録できません");
+  const { lastInsertRowid } = db
+    .prepare("INSERT INTO schedules (task_id, created_by, title, starts_at, created_at) VALUES (?, ?, ?, ?, ?)")
+    .run(input.taskId, input.userId, input.title, input.startsAt, toUtcIso(now));
+  return getSchedule(Number(lastInsertRowid), db)!;
+}
diff --git a/tests/schedules.test.ts b/tests/schedules.test.ts
new file mode 100644
index 0000000..98bb719
--- /dev/null
+++ b/tests/schedules.test.ts
@@ -0,0 +1,30 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { jstLocalToUtcIso } from "../src/lib/datetime.ts";
+import { openDb } from "../src/lib/db/index.ts";
+import { createSchedule, listSchedules, validateScheduleInput } from "../src/lib/schedules.ts";
+
+test("jstLocalToUtcIso は日本時間の入力を UTC にする", () => {
+  assert.equal(jstLocalToUtcIso("2026-11-20T10:00"), "2026-11-20T01:00:00.000Z");
+  assert.equal(jstLocalToUtcIso("2026-11-20T08:30"), "2026-11-19T23:30:00.000Z");
+  assert.equal(jstLocalToUtcIso("2026-02-30T10:00"), undefined);
+  assert.equal(jstLocalToUtcIso("2026-11-20T24:00"), undefined);
+  assert.equal(jstLocalToUtcIso("2026-11-20 10:00"), undefined);
+});
+
+test("validateScheduleInput は件名と開始日時を検証する", () => {
+  assert.equal(validateScheduleInput({ title: " ", startsAt: "2026-11-20T10:00" }).ok, false);
+  assert.deepEqual(validateScheduleInput({ title: " レビュー ", startsAt: "2026-11-20T10:00" }), {
+    ok: true,
+    value: { title: "レビュー", startsAt: "2026-11-20T01:00:00.000Z" },
+  });
+});
+
+test("createSchedule は担当者だけが登録でき、開始日時の早い順に並ぶ", () => {
+  const db = openDb();
+  const late = createSchedule({ taskId: 3, userId: "sato", title: "B", startsAt: "2026-11-20T05:00:00.000Z" }, db);
+  const early = createSchedule({ taskId: 3, userId: "sato", title: "A", startsAt: "2026-11-20T01:00:00.000Z" }, db);
+  assert.deepEqual(listSchedules(3, db).map((s) => s.id), [early.id, late.id]);
+  assert.throws(() => createSchedule({ taskId: 3, userId: "suzuki", title: "X", startsAt: early.startsAt }, db), /担当者/);
+  assert.throws(() => createSchedule({ taskId: 1, userId: "sato", title: "X", startsAt: early.startsAt }, db), /完了/);
+});
