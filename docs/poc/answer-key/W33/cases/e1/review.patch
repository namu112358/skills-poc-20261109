+/** YYYY-MM-DD に月数を足す。翌月に同じ日がなければ月末に丸める（1/31 + 1 か月 = 2/28 または 2/29）。 */
+export function addMonths(date: string, months: number): string {
+  const [y, m, d] = date.split("-").map(Number);
+  const index = y * 12 + (m - 1) + months;
+  const year = Math.floor(index / 12);
+  const month = index % 12;
+  const lastDay = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
+  const pad = (n: number, w: number) => String(n).padStart(w, "0");
+  return `${pad(year, 4)}-${pad(month + 1, 2)}-${pad(Math.min(d, lastDay), 2)}`;
+}
+
+const ERA_BASE: Record<string, number> = { R: 2018, 令和: 2018, H: 1988, 平成: 1988, S: 1925, 昭和: 1925 };
+
+/**
+ * 旧台帳の自由記述の日付を YYYY-MM-DD にする。読める書き方は
+ * 「2026-09-01」「2026/8/20」「2026年8月20日」「R8.9.10」「令和8年9月10日」。読めなければ undefined。
+ */
+export function parseLegacyDate(text: unknown): string | undefined {
+  if (typeof text !== "string") return undefined;
+  const t = text.trim().replace(/[０-９]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0));
+  let y: number, m: number, d: number;
+  let match = /^(\d{4})[-/.年](\d{1,2})[-/.月](\d{1,2})日?$/.exec(t);
+  if (match) {
+    [y, m, d] = [Number(match[1]), Number(match[2]), Number(match[3])];
+  } else if ((match = /^(令和|平成|昭和|[RHS])(\d{1,2}|元)[-/.年](\d{1,2})[-/.月](\d{1,2})日?$/i.exec(t))) {
+    const era = ERA_BASE[match[1]] ?? ERA_BASE[match[1].toUpperCase()];
+    y = era + (match[2] === "元" ? 1 : Number(match[2]));
+    [m, d] = [Number(match[3]), Number(match[4])];
+  } else return undefined;
+  const iso = `${String(y).padStart(4, "0")}-${String(m).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
+  return isValidDate(iso) ? iso : undefined;
+}
+
 /** 日本時間での今日の日付（YYYY-MM-DD）。利用者は全員日本国内にいる。 */
 export function todayJst(now: Date = new Date()): string {
   return new Date(now.getTime() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);
