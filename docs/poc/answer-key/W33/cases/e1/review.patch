index 0000000..55c582e
--- /dev/null
+++ b/src/lib/inspections.ts
@@ -0,0 +1,127 @@
+// 定期点検の記録。計測器ごとに何回分も履歴として残す。
+// - 結果が「要修理」なら、計測器は使用停止になる（校正の不合格と同じ扱い。廃棄済みの計測器は変えない）。
+// - 次の点検予定日 = 最後の点検日 + 点検周期（計算は src/lib/instruments.ts の nextInspectionOn）。
+import { getDb, transaction, type Db } from "./db/index.ts";
+import { isValidDate, todayJst } from "./dates.ts";
+import { getInstrument, type Instrument, type ValidationResult } from "./instruments.ts";
+import { logger } from "./logger.ts";
+import { isActiveUser } from "./users.ts";
+
+export type InspectionResult = "good" | "needs_repair";
+
+export const INSPECTION_RESULT_LABELS: Record<InspectionResult, string> = { good: "良好", needs_repair: "要修理" };
+
+export type Inspection = {
+  id: number;
+  instrumentId: number;
+  inspectedOn: string; // YYYY-MM-DD
+  inspectedBy: string; // 点検した人（users.id）
+  result: InspectionResult;
+  note: string;
+  recordedBy: string; // 登録した人（users.id）
+  recordedAt: string; // ISO 8601（UTC）
+};
+
+type Row = {
+  id: number;
+  instrument_id: number;
+  inspected_on: string;
+  inspected_by: string;
+  result: InspectionResult;
+  note: string;
+  recorded_by: string;
+  recorded_at: string;
+};
+
+const COLUMNS = "id, instrument_id, inspected_on, inspected_by, result, note, recorded_by, recorded_at";
+
+function toInspection(r: Row): Inspection {
+  return {
+    id: r.id,
+    instrumentId: r.instrument_id,
+    inspectedOn: r.inspected_on,
+    inspectedBy: r.inspected_by,
+    result: r.result,
+    note: r.note,
+    recordedBy: r.recorded_by,
+    recordedAt: r.recorded_at,
+  };
+}
+
+/** 計測器の点検記録を、点検日の新しい順に返す。 */
+export function listInspections(instrumentId: number, db: Db = getDb()): Inspection[] {
+  const rows = db
+    .prepare(`SELECT ${COLUMNS} FROM inspections WHERE instrument_id = ? ORDER BY inspected_on DESC, id DESC`)
+    .all(instrumentId) as Row[];
+  return rows.map(toInspection);
+}
+
+export type InspectionInput = { inspectedOn: string; inspectedBy?: string; result: InspectionResult; note: string };
+
+/**
+ * 点検記録の入力を検証する。点検日は今日（日本時間）以前。点検した人は在籍中の利用者で、省略すると登録した人になる。
+ */
+export function validateInspectionInput(
+  body: unknown,
+  db: Db = getDb(),
+  now: Date = new Date(),
+): ValidationResult<InspectionInput> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const b = body as Record<string, unknown>;
+  const errors: string[] = [];
+  if (!isValidDate(b.inspectedOn)) errors.push("点検日は YYYY-MM-DD 形式で入力してください");
+  else if (b.inspectedOn > todayJst(now)) errors.push("点検日は今日以前の日付を入力してください");
+  if (b.result !== "good" && b.result !== "needs_repair") {
+    errors.push("結果は good（良好）か needs_repair（要修理）で指定してください");
+  }
+  if ("inspectedBy" in b && !(typeof b.inspectedBy === "string" && isActiveUser(b.inspectedBy, db))) {
+    errors.push("点検した人は、在籍中の利用者から選んでください");
+  }
+  const note = b.note ?? "";
+  if (typeof note !== "string" || note.length > 1000) errors.push("メモは 1000 文字以内で入力してください");
+  if (errors.length > 0) return { ok: false, errors };
+  return {
+    ok: true,
+    value: {
+      inspectedOn: b.inspectedOn as string,
+      ...("inspectedBy" in b ? { inspectedBy: b.inspectedBy as string } : {}),
+      result: b.result as InspectionResult,
+      note: (note as string).trim(),
+    },
+  };
+}
+
+/** 点検記録を登録する。要修理なら計測器を使用停止にする。計測器が無ければ undefined。 */
+export function recordInspection(
+  instrumentId: number,
+  input: InspectionInput,
+  recordedBy: string,
+  db: Db = getDb(),
+  now: Date = new Date(),
+): { inspection: Inspection; instrument: Instrument } | undefined {
+  const result = transaction(db, () => {
+    if (!getInstrument(instrumentId, db)) return undefined;
+    const { lastInsertRowid } = db
+      .prepare(
+        `INSERT INTO inspections (instrument_id, inspected_on, inspected_by, result, note, recorded_by, recorded_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?)`,
+      )
+      .run(instrumentId, input.inspectedOn, input.inspectedBy ?? recordedBy, input.result, input.note, recordedBy, now.toISOString());
+    if (input.result === "needs_repair") {
+      db.prepare("UPDATE instruments SET status = 'suspended' WHERE id = ? AND status != 'disposed'").run(instrumentId);
+    }
+    const inspection = toInspection(db.prepare(`SELECT ${COLUMNS} FROM inspections WHERE id = ?`).get(Number(lastInsertRowid)) as Row);
+    return { inspection, instrument: getInstrument(instrumentId, db)! };
+  });
+  if (result?.inspection.result === "needs_repair") {
+    logger.warn("inspection.needs_repair", {
+      instrumentId,
+      managementNo: result.instrument.managementNo,
+      inspectionId: result.inspection.id,
+      status: result.instrument.status,
+    });
+  }
+  return result;
+}
