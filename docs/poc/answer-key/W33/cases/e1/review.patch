+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { DatabaseSync } from "node:sqlite";
+import { addMonths, parseLegacyDate } from "../src/lib/dates.ts";
+import { migrate, openDb } from "../src/lib/db/index.ts";
+import { MIGRATIONS } from "../src/lib/db/migrations.ts";
+import { listInspections, recordInspection, validateInspectionInput } from "../src/lib/inspections.ts";
+import { createInstrument, getInstrument, listInstruments, updateInstrument, validateInstrumentInput } from "../src/lib/instruments.ts";
+
+const byNo = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+const GOOD = { inspectedOn: "2026-11-05", result: "good", note: "" } as const;
+
+describe("addMonths", () => {
+  it("adds months and clamps to the end of the month", () => {
+    assert.equal(addMonths("2026-09-01", 3), "2026-12-01");
+    assert.equal(addMonths("2026-11-30", 3), "2027-02-28");
+    assert.equal(addMonths("2027-11-30", 3), "2028-02-29");
+    assert.equal(addMonths("2026-01-31", 1), "2026-02-28");
+    assert.equal(addMonths("2026-12-15", 1), "2027-01-15");
+  });
+});
+
+describe("parseLegacyDate", () => {
+  it("reads the common ways of writing a date", () => {
+    assert.equal(parseLegacyDate("2026-09-01"), "2026-09-01");
+    assert.equal(parseLegacyDate("2026/8/20"), "2026-08-20");
+    assert.equal(parseLegacyDate("2026年8月20日"), "2026-08-20");
+    assert.equal(parseLegacyDate("R8.9.10"), "2026-09-10");
+    assert.equal(parseLegacyDate("令和元年5月1日"), "2019-05-01");
+    assert.equal(parseLegacyDate("H30.4.1"), "2018-04-01");
+  });
+  it("returns undefined for what cannot be read", () => {
+    for (const v of ["先月", "2026/13/1", "2027/2/29", "", "R8.9", undefined, 20260901]) {
+      assert.equal(parseLegacyDate(v), undefined, String(v));
+    }
+  });
+});
+
+describe("migration 6 (legacy inspector / last inspected date)", () => {
+  function legacyDb(rows: [string, string][]) {
+    const db = new DatabaseSync(":memory:");
+    db.exec("PRAGMA foreign_keys = ON");
+    migrate(db, MIGRATIONS.slice(0, 5));
+    db.exec("INSERT INTO departments (id, name) VALUES ('d', '部');");
+    for (const [id, name] of [["sato", "佐藤"], ["suzuki", "鈴木"], ["ito1", "伊藤"], ["ito2", "伊藤"]]) {
+      db.prepare("INSERT INTO users (id, name, department_id, active) VALUES (?, ?, 'd', 1)").run(id, name);
+    }
+    rows.forEach(([no, extra]) => {
+      db.prepare(
+        "INSERT INTO instruments (management_no, name, manager_id, interval_months, last_calibrated_on, extra) VALUES (?, 'x', 'sato', 12, '2026-01-01', ?)",
+      ).run(no, extra);
+    });
+    migrate(db);
+    return db;
+  }
+
+  it("carries over readable values and keeps extra untouched", () => {
+    const extra = (o: object) => JSON.stringify(o);
+    const db = legacyDb([
+      ["MI-0001", extra({ inspector: "佐藤", last_inspected: "2026-09-01" })],
+      ["MI-0002", extra({ inspector: "鈴木さん", last_inspected: "R8.9.10" })],
+      ["MI-0003", extra({ inspector: "外部委託", last_inspected: "先月" })],
+      ["MI-0004", extra({ inspector: "伊藤", last_inspected: "2026/8/20" })], // 同名が 2 人
+      ["MI-0005", "{}"],
+      ["MI-0006", "not json"],
+    ]);
+    const get = (no: string) => getInstrument((db.prepare("SELECT id FROM instruments WHERE management_no = ?").get(no) as { id: number }).id, db)!;
+    assert.equal(get("MI-0001").inspectorId, "sato");
+    assert.equal(get("MI-0001").lastInspectedOn, "2026-09-01");
+    assert.equal(get("MI-0001").nextInspectionOn, "2026-12-01");
+    assert.equal(get("MI-0002").inspectorId, "suzuki");
+    assert.equal(get("MI-0002").lastInspectedOn, "2026-09-10");
+    assert.equal(get("MI-0003").inspectorId, null);
+    assert.equal(get("MI-0003").lastInspectedOn, null);
+    assert.equal(get("MI-0003").extra.inspector, "外部委託");
+    assert.equal(get("MI-0003").extra.last_inspected, "先月");
+    assert.equal(get("MI-0004").inspectorId, null);
+    assert.equal(get("MI-0004").lastInspectedOn, "2026-08-20");
+    assert.equal(get("MI-0005").inspectionIntervalMonths, 3);
+    assert.equal(get("MI-0006").inspectorId, null);
+  });
+
+  it("matches seeded legacy data, including a user who has left", () => {
+    const db = openDb();
+    assert.equal(byNo(db, "MI-0003").inspectorId, "suzuki"); // 鈴木さん
+    assert.equal(byNo(db, "MI-0004").inspectorId, "inoue"); // 退職済みでも引き継ぐ
+    assert.equal(byNo(db, "MI-0006").lastInspectedOn, "2026-09-10"); // R8.9.10
+    assert.equal(byNo(db, "MI-0009").inspectorId, null); // 外部委託
+    assert.equal(byNo(db, "MI-0009").extra.inspector, "外部委託");
+  });
+});
+
+describe("recordInspection", () => {
+  it("records history and moves the next inspection date", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    assert.equal(inst.lastInspectedOn, "2026-09-01");
+    const r = recordInspection(inst.id, GOOD, "sato", db, new Date("2026-11-06T00:00:00Z"));
+    assert.equal(r?.inspection.inspectedBy, "sato");
+    assert.equal(r?.instrument.status, "in_use");
+    assert.equal(r?.instrument.lastInspectedOn, "2026-11-05");
+    assert.equal(r?.instrument.nextInspectionOn, "2027-02-05");
+    recordInspection(inst.id, { ...GOOD, inspectedOn: "2026-11-10", inspectedBy: "kimura" }, "sato", db);
+    const list = listInspections(inst.id, db);
+    assert.deepEqual(list.map((i) => [i.inspectedOn, i.inspectedBy]), [["2026-11-10", "kimura"], ["2026-11-05", "sato"]]);
+  });
+
+  it("does not move the last inspected date backwards", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    const r = recordInspection(inst.id, { ...GOOD, inspectedOn: "2026-01-01" }, "sato", db);
+    assert.equal(r?.instrument.lastInspectedOn, "2026-09-01");
+  });
+
+  it("suspends the instrument when it needs repair", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    const r = recordInspection(inst.id, { ...GOOD, result: "needs_repair", note: "ガタあり" }, "sato", db);
+    assert.equal(r?.instrument.status, "suspended");
+    assert.equal(listInspections(inst.id, db)[0].note, "ガタあり");
+  });
+
+  it("does not revive a disposed instrument", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    updateInstrument(inst.id, { status: "disposed" }, db);
+    const r = recordInspection(inst.id, { ...GOOD, result: "needs_repair" }, "sato", db);
+    assert.equal(r?.instrument.status, "disposed");
+  });
+
+  it("returns undefined for unknown instruments", () => {
+    assert.equal(recordInspection(9999, GOOD, "sato", openDb()), undefined);
+  });
+
+  it("treats an instrument with no inspection at all as not inspected", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0009");
+    assert.equal(inst.lastInspectedOn, "2026-10-02"); // 旧台帳の日付は引き継がれる
+    const created = createInstrument(
+      { managementNo: "ZZ-0001", name: "新規", model: "", location: "", managerId: "sato", intervalMonths: 12, lastCalibratedOn: "2026-11-01", status: "in_use", note: "" },
+      db,
+    );
+    assert.equal(created.lastInspectedOn, null);
+    assert.equal(created.nextInspectionOn, null);
+    assert.equal(created.inspectionIntervalMonths, 3);
+    assert.equal(created.inspectorId, null);
+  });
+});
+
+describe("validateInspectionInput", () => {
+  const now = new Date("2026-11-11T03:00:00Z");
+  it("accepts a valid input and trims the note", () => {
+    const v = validateInspectionInput({ inspectedOn: "2026-11-11", result: "good", note: " 異常なし " }, openDb(), now);
+    assert.deepEqual(v.ok && v.value, { inspectedOn: "2026-11-11", result: "good", note: "異常なし" });
+  });
+  it("rejects a future date (JST), a bad result, a long note and a non-object", () => {
+    const db = openDb();
+    assert.equal(validateInspectionInput({ ...GOOD, inspectedOn: "2026-11-12" }, db, now).ok, false);
+    assert.equal(validateInspectionInput({ ...GOOD, inspectedOn: "2026-11-31" }, db, now).ok, false);
+    assert.equal(validateInspectionInput({ ...GOOD, result: "pass" }, db, now).ok, false);
+    assert.equal(validateInspectionInput({ ...GOOD, note: "あ".repeat(1001) }, db, now).ok, false);
+    assert.equal(validateInspectionInput(null, db, now).ok, false);
+  });
+  it("uses Japan time for today (UTC evening is already tomorrow in Japan)", () => {
+    const late = new Date("2026-11-11T20:00:00Z"); // 日本時間 11/12 5:00
+    assert.equal(validateInspectionInput({ ...GOOD, inspectedOn: "2026-11-12" }, openDb(), late).ok, true);
+  });
+  it("accepts only active users as the inspector", () => {
+    const db = openDb();
+    assert.equal(validateInspectionInput({ ...GOOD, inspectedBy: "kimura" }, db, now).ok, true);
+    assert.equal(validateInspectionInput({ ...GOOD, inspectedBy: "inoue" }, db, now).ok, false); // 退職
+    assert.equal(validateInspectionInput({ ...GOOD, inspectedBy: "kondo" }, db, now).ok, false); // 休職
+    assert.equal(validateInspectionInput({ ...GOOD, inspectedBy: "nobody" }, db, now).ok, false);
+    assert.equal(validateInspectionInput({ ...GOOD, inspectedBy: null }, db, now).ok, false);
+  });
+});
+
+describe("点検の担当者・周期の更新", () => {
+  it("selects only active users, but keeps a current inspector who has left", () => {
+    const db = openDb();
+    const mi4 = byNo(db, "MI-0004"); // 担当者は退職した井上
+    const chk = (body: object, current: string | null) => validateInstrumentInput(body, { partial: true, currentInspectorId: current }, db);
+    assert.equal(chk({ inspectorId: "kimura" }, mi4.inspectorId).ok, true);
+    assert.equal(chk({ inspectorId: "kondo" }, mi4.inspectorId).ok, false);
+    assert.equal(chk({ inspectorId: "inoue" }, mi4.inspectorId).ok, true); // 変えない
+    assert.equal(chk({ inspectorId: "inoue" }, null).ok, false);
+    assert.equal(chk({ inspectorId: "nobody" }, null).ok, false);
+    assert.equal(chk({ inspectorId: null }, mi4.inspectorId).ok, true);
+    assert.equal(chk({ inspectorId: 5 }, null).ok, false);
