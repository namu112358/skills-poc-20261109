+// GET/POST /api/instruments/:id/inspections — 点検の記録（その他の項目 extra.inspections に入れる）
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { getInstrument, parseId, updateInstrument } from "@/lib/instruments";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function GET(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  const inst = id === undefined ? undefined : getInstrument(id);
+  if (!inst) return jsonError(404, "計測器が見つかりません");
+  return NextResponse.json({ inspections: (inst.extra.inspections as unknown[]) ?? [] });
+}
+
+export async function POST(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  const inst = id === undefined ? undefined : getInstrument(id);
+  if (!inst) return jsonError(404, "計測器が見つかりません");
+  const body = (await readJson(request)) as Record<string, unknown> | undefined;
+  if (!body || typeof body.inspectedOn !== "string") return jsonError(400, "点検日を入れてください");
+  const list = Array.isArray(inst.extra.inspections) ? inst.extra.inspections : [];
+  const record = { inspectedOn: body.inspectedOn, inspectorId: body.inspectorId, result: body.result, note: body.note ?? "" };
+  const updated = updateInstrument(inst.id, {
+    extra: { inspections: [record, ...list], last_inspected: body.inspectedOn },
+    ...(body.result === "needs_repair" ? { status: "suspended" as const } : {}),
+  });
+  return NextResponse.json({ inspection: record, instrument: updated }, { status: 201 });
+}
