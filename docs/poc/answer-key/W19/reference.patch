+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { legacyName, parseLegacyDate } from "../src/lib/db/backfill-inspections.ts";
+import { inspectionSummary, listInspections, nextInspectionDue, recordInspection, validateInspectionInput } from "../src/lib/inspections.ts";
+import { getInstrument, listInstruments, updateInstrument, validateInstrumentInput } from "../src/lib/instruments.ts";
+
+const NOW = new Date("2026-11-10T03:00:00Z");
+const idOf = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!.id;
+
+describe("その他の項目からの引き継ぎ", () => {
+  it("reads legacy dates in several formats and rejects impossible ones", () => {
+    assert.equal(parseLegacyDate("2026-09-01"), "2026-09-01");
+    assert.equal(parseLegacyDate("2026/8/20"), "2026-08-20");
+    assert.equal(parseLegacyDate("R8.9.10"), "2026-09-10");
+    assert.equal(parseLegacyDate("2026-02-30"), undefined);
+    assert.equal(parseLegacyDate("先月"), undefined);
+    assert.equal(legacyName("鈴木さん"), "鈴木");
+  });
+
+  it("links known names, keeps unknown text, and turns readable dates into records", () => {
+    const db = openDb();
+    const mi3 = getInstrument(idOf(db, "MI-0003"), db)!;
+    assert.equal(mi3.inspectorId, "suzuki");
+    assert.equal(mi3.lastInspectedOn, "2026-08-20");
+    const mi9 = getInstrument(idOf(db, "MI-0009"), db)!;
+    assert.equal(mi9.inspectorId, null);
+    assert.match(mi9.inspectionLegacy, /外部委託/);
+    assert.equal(getInstrument(idOf(db, "MI-0006"), db)!.lastInspectedOn, "2026-09-10");
+    assert.equal(mi3.extra.dept, "製造部"); // 担当部署は extra のまま（経理の集計が読む）
+  });
+});
+
+describe("点検の担当者", () => {
+  it("accepts active users, rejects retired ones, and keeps an existing retired assignee", () => {
+    const db = openDb();
+    assert.ok(validateInstrumentInput({ inspectorId: "sato" }, { partial: true }, db).ok);
+    assert.equal(validateInstrumentInput({ inspectorId: "inoue" }, { partial: true }, db).ok, false);
+    assert.ok(validateInstrumentInput({ inspectorId: "inoue" }, { partial: true, currentInspectorId: "inoue" }, db).ok);
+    assert.ok(validateInstrumentInput({ inspectorId: null }, { partial: true }, db).ok);
+  });
+
+  it("filters by inspector and stores the assignment outside extra", () => {
+    const db = openDb();
+    const id = idOf(db, "MI-0002");
+    updateInstrument(id, { inspectorId: "kato" }, db);
+    assert.deepEqual(listInstruments({ inspectorId: "kato" }, db).map((i) => i.managementNo), ["MI-0002"]);
+    assert.ok(!("inspectorId" in getInstrument(id, db)!.extra));
+  });
+});
+
+describe("点検の記録", () => {
+  it("computes the next due date from the last inspection and the interval, clamping month ends", () => {
+    assert.equal(nextInspectionDue("2026-08-20", 3), "2026-11-20");
+    assert.equal(nextInspectionDue("2026-11-30", 3), "2027-02-28");
+    assert.equal(nextInspectionDue(null, 3), null);
+  });
+
+  it("validates input: active inspector, result values, no future dates", () => {
+    const db = openDb();
+    const ok = { inspectedOn: "2026-11-09", inspectorId: "sato", result: "good" };
+    assert.ok(validateInspectionInput(ok, NOW, db).ok);
+    assert.equal(validateInspectionInput({ ...ok, inspectorId: "kondo" }, NOW, db).ok, false);
+    assert.equal(validateInspectionInput({ ...ok, result: "ok" }, NOW, db).ok, false);
+    assert.equal(validateInspectionInput({ ...ok, inspectedOn: "2026-11-11" }, NOW, db).ok, false);
+  });
+
+  it("keeps history, suspends on needs_repair, and corrections add a record instead of deleting", () => {
+    const db = openDb();
+    const id = idOf(db, "MI-0010");
+    const first = recordInspection(id, { inspectedOn: "2026-11-01", inspectorId: "ito", result: "needs_repair", note: "表示がちらつく" }, "sato", db, NOW)!;
+    assert.equal(getInstrument(id, db)!.status, "suspended");
+    recordInspection(id, { inspectedOn: "2026-10-31", inspectorId: "ito", result: "good", note: "日付の誤り", correctsId: first.id }, "sato", db, NOW);
+    const list = listInspections(id, db);
+    assert.ok(list.some((r) => r.id === first.id));
+    assert.equal(getInstrument(id, db)!.lastInspectedOn, "2026-10-31");
+    assert.equal(recordInspection(id, { inspectedOn: "2026-11-01", inspectorId: "ito", result: "good", note: "", correctsId: 99999 }, "sato", db, NOW), undefined);
+  });
+
+  it("summarizes overdue and never-inspected counts per inspector", () => {
+    const db = openDb();
+    const s = inspectionSummary(db, NOW);
+    const sato = s.find((x) => x.inspectorId === "sato")!; // MI-0001: 2026-09-01 + 3 か月 = 2026-12-01（遅れていない）
+    assert.equal(sato.overdue, 0);
+    const suzuki = s.find((x) => x.inspectorId === "suzuki")!; // MI-0003: 2026-08-20 + 3 か月 = 2026-11-20
+    assert.equal(suzuki.overdue, 0);
+    const inoue = s.find((x) => x.inspectorId === "inoue")!; // MI-0004: 2026-07-15 + 3 か月 = 2026-10-15（遅れ）
+    assert.equal(inoue.overdue, 1);
+    const none = s.find((x) => x.inspectorId === null)!;
+    assert.ok(none.neverInspected >= 1);
+    assert.ok(listInstruments({ overdueAsOf: "2026-11-10" }, db).some((i) => i.managementNo === "MI-0004"));
+  });
+});
