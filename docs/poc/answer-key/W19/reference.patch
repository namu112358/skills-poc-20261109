diff --git a/src/lib/db/backfill-inspections.ts b/src/lib/db/backfill-inspections.ts
new file mode 100644
index 0000000..7db42b5
--- /dev/null
+++ b/src/lib/db/backfill-inspections.ts
@@ -0,0 +1,54 @@
+// マイグレーション 6 の移し替え: その他の項目（extra）の点検者・最終点検日を、専用の列と点検の記録に引き継ぐ。
+// - 点検者の名前が利用者の名前と一致すれば（敬称の「さん」「様」は除く）、その人を担当者にする。
+// - 一致しない名前・読めない日付は、元の書き方を inspection_legacy に残す（黙って捨てない）。
+// - 最終点検日が読めれば、結果の分からない点検の記録として残す（次の点検予定日の計算に使う）。
+import type { DatabaseSync } from "node:sqlite";
+
+const ERA_REIWA = 2018; // 令和元年 = 2019
+
+/** 「2026-09-01」「2026/9/1」「R8.9.10」を YYYY-MM-DD にする。読めなければ undefined。 */
+export function parseLegacyDate(text: string): string | undefined {
+  const t = text.trim();
+  let m = /^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})$/.exec(t);
+  let y: number, mo: number, d: number;
+  if (m) [y, mo, d] = [Number(m[1]), Number(m[2]), Number(m[3])];
+  else if ((m = /^R(\d{1,2})\.(\d{1,2})\.(\d{1,2})$/i.exec(t))) [y, mo, d] = [ERA_REIWA + Number(m[1]), Number(m[2]), Number(m[3])];
+  else return undefined;
+  const date = new Date(Date.UTC(y, mo - 1, d));
+  if (date.getUTCFullYear() !== y || date.getUTCMonth() !== mo - 1 || date.getUTCDate() !== d) return undefined;
+  return `${y}-${String(mo).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
+}
+
+export function legacyName(text: string): string {
+  return text.trim().replace(/(さん|様|氏)$/, "").trim();
+}
+
+export function backfillInspectionsFromExtra(db: DatabaseSync): void {
+  const users = new Map<string, string>();
+  for (const u of db.prepare("SELECT id, name FROM users").all() as { id: string; name: string }[]) users.set(u.name, u.id);
+  const rows = db
+    .prepare("SELECT id, extra FROM instruments WHERE extra LIKE '%inspector%' OR extra LIKE '%last_inspected%'")
+    .all() as { id: number; extra: string }[];
+  const setInspector = db.prepare("UPDATE instruments SET inspector_id = ?, inspection_legacy = ? WHERE id = ?");
+  const addRecord = db.prepare(
+    "INSERT INTO inspection_records (instrument_id, inspected_on, inspector_id, result, note, recorded_at) VALUES (?, ?, ?, NULL, ?, ?)",
+  );
+  const now = new Date().toISOString();
+  for (const row of rows) {
+    let extra: Record<string, unknown>;
+    try {
+      extra = JSON.parse(row.extra);
+    } catch {
+      continue;
+    }
+    const name = typeof extra.inspector === "string" ? extra.inspector : "";
+    const last = typeof extra.last_inspected === "string" ? extra.last_inspected : "";
+    const inspectorId = name ? users.get(legacyName(name)) : undefined;
+    const date = last ? parseLegacyDate(last) : undefined;
+    const legacy: string[] = [];
+    if (name && !inspectorId) legacy.push(`点検者: ${name}`);
+    if (last && !date) legacy.push(`最終点検日: ${last}`);
+    setInspector.run(inspectorId ?? null, legacy.join(" / "), row.id);
+    if (date) addRecord.run(row.id, date, inspectorId ?? null, "その他の項目から引き継いだ記録（結果は記録なし）", now);
+  }
+}
