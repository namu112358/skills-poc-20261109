@@ -91,4 +95,31 @@ export const MIGRATIONS: readonly Migration[] = [
     name: "instrument_extra",
     sql: `ALTER TABLE instruments ADD COLUMN extra TEXT NOT NULL DEFAULT '{}';`,
   },
+  {
+    // 点検の担当者・周期・記録を、その他の項目（extra）ではなく専用の列と表で持つ。
+    // extra の点検者・最終点検日は新しい列と表に引き継ぐ（extra 自体は変えない。前の版に戻しても表示が崩れないように）。
+    version: 6,
+    name: "inspections",
+    sql: `
+      ALTER TABLE instruments ADD COLUMN inspector_id TEXT REFERENCES users(id);
+      ALTER TABLE instruments ADD COLUMN inspection_interval_months INTEGER NOT NULL DEFAULT 3
+        CHECK (inspection_interval_months BETWEEN 1 AND 120);
+      ALTER TABLE instruments ADD COLUMN inspection_legacy TEXT NOT NULL DEFAULT ''; -- 引き継げなかった元の書き方
+      CREATE INDEX instruments_inspector ON instruments(inspector_id);
+      CREATE TABLE inspection_records (
+        id           INTEGER PRIMARY KEY AUTOINCREMENT,
+        instrument_id INTEGER NOT NULL REFERENCES instruments(id),
+        inspected_on TEXT NOT NULL, -- YYYY-MM-DD
+        inspector_id TEXT REFERENCES users(id), -- 引き継ぎで分からなかったときは NULL
+        result       TEXT CHECK (result IS NULL OR result IN ('good', 'needs_repair')), -- 引き継ぎで分からなかったときは NULL
+        note         TEXT NOT NULL DEFAULT '',
+        corrects_id  INTEGER REFERENCES inspection_records(id), -- 訂正の記録なら、訂正する元の記録
+        recorded_by  TEXT REFERENCES users(id),
+        recorded_at  TEXT NOT NULL -- ISO 8601（UTC）
+      );
+      CREATE INDEX inspection_records_instrument ON inspection_records(instrument_id, inspected_on);
+      CREATE INDEX inspection_records_corrects ON inspection_records(corrects_id);
+    `,
+    run: backfillInspectionsFromExtra,
+  },
 ];
diff --git a/src/lib/inspections.ts b/src/lib/inspections.ts
new file mode 100644
index 0000000..bcf3c7d
--- /dev/null
+++ b/src/lib/inspections.ts
@@ -0,0 +1,159 @@
+// 定期点検（校正とは別の、社内で行う日常の点検）の記録。
+// - 記録は消さない。間違えたら、訂正の記録（corrects_id で元の記録を指す）を足す。
+// - 結果が要修理なら、計測器を使用停止にする（校正の不合格と同じ扱い）。
+// - 点検した人は在籍している利用者に限る（担当者以外でもよい）。
+import { getDb, transaction, type Db } from "./db/index.ts";
+import { isValidDate, todayJst } from "./dates.ts";
+import { logger } from "./logger.ts";
+import { isActiveUser } from "./users.ts";
+import type { ValidationResult } from "./instruments.ts";
+
+export type InspectionResult = "good" | "needs_repair";
+export const INSPECTION_RESULT_LABELS: Record<InspectionResult, string> = { good: "良好", needs_repair: "要修理" };
+
+export type InspectionRecord = {
+  id: number;
+  instrumentId: number;
+  inspectedOn: string;
+  inspectorId: string | null;
+  result: InspectionResult | null; // 引き継いだ記録で結果が分からないときは null
+  note: string;
+  correctsId: number | null;
+  recordedBy: string | null;
+  recordedAt: string;
+};
+
+export type InspectionInput = {
+  inspectedOn: string;
+  inspectorId: string;
+  result: InspectionResult;
+  note: string;
+  correctsId?: number;
+};
+
+type Row = {
+  id: number;
+  instrument_id: number;
+  inspected_on: string;
+  inspector_id: string | null;
+  result: InspectionResult | null;
+  note: string;
+  corrects_id: number | null;
+  recorded_by: string | null;
+  recorded_at: string;
+};
+
+const COLUMNS = "id, instrument_id, inspected_on, inspector_id, result, note, corrects_id, recorded_by, recorded_at";
+
+function toRecord(r: Row): InspectionRecord {
+  return {
+    id: r.id,
+    instrumentId: r.instrument_id,
+    inspectedOn: r.inspected_on,
+    inspectorId: r.inspector_id,
+    result: r.result,
+    note: r.note,
+    correctsId: r.corrects_id,
+    recordedBy: r.recorded_by,
+    recordedAt: r.recorded_at,
+  };
+}
+
+/** 新しい順。訂正された元の記録も履歴として残す。 */
+export function listInspections(instrumentId: number, db: Db = getDb()): InspectionRecord[] {
+  return (
+    db.prepare(`SELECT ${COLUMNS} FROM inspection_records WHERE instrument_id = ? ORDER BY inspected_on DESC, id DESC`).all(instrumentId) as Row[]
+  ).map(toRecord);
+}
+
+export function validateInspectionInput(body: unknown, now: Date = new Date(), db: Db = getDb()): ValidationResult<InspectionInput> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  const b = body as Record<string, unknown>;
+  const errors: string[] = [];
+  if (!isValidDate(b.inspectedOn)) errors.push("点検日は YYYY-MM-DD 形式で入力してください");
+  else if (b.inspectedOn > todayJst(now)) errors.push("点検日に未来の日付は指定できません");
+  if (typeof b.inspectorId !== "string" || !isActiveUser(b.inspectorId, db)) errors.push("点検した人は在籍している利用者から選んでください");
+  if (b.result !== "good" && b.result !== "needs_repair") errors.push("結果は good（良好）か needs_repair（要修理）で指定してください");
+  const note = b.note === undefined ? "" : b.note;
+  if (typeof note !== "string" || note.length > 1000) errors.push("メモは 1000 文字以内で入力してください");
+  if (b.correctsId !== undefined && !(Number.isInteger(b.correctsId) && (b.correctsId as number) > 0)) errors.push("訂正する記録の指定が正しくありません");
+  if (errors.length > 0) return { ok: false, errors };
+  return {
+    ok: true,
+    value: {
+      inspectedOn: b.inspectedOn as string,
+      inspectorId: b.inspectorId as string,
+      result: b.result as InspectionResult,
+      note: (note as string).trim(),
+      ...(b.correctsId !== undefined ? { correctsId: b.correctsId as number } : {}),
+    },
+  };
+}
+
+/** 点検の記録を足す。要修理なら計測器を使用停止にする。計測器・訂正の元が無ければ undefined。 */
+export function recordInspection(
+  instrumentId: number,
+  input: InspectionInput,
+  recordedBy: string,
+  db: Db = getDb(),
+  now: Date = new Date(),
+): InspectionRecord | undefined {
+  const record = transaction(db, () => {
+    const inst = db.prepare("SELECT status FROM instruments WHERE id = ?").get(instrumentId) as { status: string } | undefined;
+    if (!inst) return undefined;
+    if (input.correctsId !== undefined) {
+      const target = db.prepare("SELECT 1 FROM inspection_records WHERE id = ? AND instrument_id = ?").get(input.correctsId, instrumentId);
+      if (!target) return undefined;
+    }
+    const { lastInsertRowid } = db
+      .prepare(
+        `INSERT INTO inspection_records (instrument_id, inspected_on, inspector_id, result, note, corrects_id, recorded_by, recorded_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
+      )
+      .run(instrumentId, input.inspectedOn, input.inspectorId, input.result, input.note, input.correctsId ?? null, recordedBy, now.toISOString());
+    if (input.result === "needs_repair" && inst.status !== "disposed") {
+      db.prepare("UPDATE instruments SET status = 'suspended' WHERE id = ?").run(instrumentId);
+    }
+    return toRecord(db.prepare(`SELECT ${COLUMNS} FROM inspection_records WHERE id = ?`).get(Number(lastInsertRowid)) as Row);
+  });
+  if (record) logger.info("inspection.recorded", { instrumentId, result: record.result, corrects: record.correctsId });
+  return record;
+}
+
+/** 次の点検予定日（最後の点検日 + 周期）。点検の記録が無ければ null（未点検）。 */
+export function nextInspectionDue(lastInspectedOn: string | null, intervalMonths: number): string | null {
+  if (!lastInspectedOn) return null;
+  const [y, m, d] = lastInspectedOn.split("-").map(Number);
+  const target = new Date(Date.UTC(y, m - 1 + intervalMonths, 1));
+  const last = new Date(Date.UTC(target.getUTCFullYear(), target.getUTCMonth() + 1, 0)).getUTCDate();
+  target.setUTCDate(Math.min(d, last));
+  return target.toISOString().slice(0, 10);
+}
+
+export type InspectorSummary = { inspectorId: string | null; name: string | null; assigned: number; overdue: number; neverInspected: number };
+
+/** 担当者ごとの、担当の台数・点検が遅れている台数・未点検の台数（毎朝の確認用）。 */
+export function inspectionSummary(db: Db = getDb(), now: Date = new Date()): InspectorSummary[] {
+  const today = todayJst(now);
+  const rows = db
+    .prepare(
+      `SELECT i.inspector_id AS inspector_id, u.name AS name, i.inspection_interval_months AS months, ${LAST_INSPECTED_SQL} AS last
+       FROM instruments i LEFT JOIN users u ON u.id = i.inspector_id WHERE i.status != 'disposed'`,
+    )
+    .all() as { inspector_id: string | null; name: string | null; months: number; last: string | null }[];
+  const by = new Map<string, InspectorSummary>();
+  for (const r of rows) {
+    const key = r.inspector_id ?? "";
+    const s = by.get(key) ?? { inspectorId: r.inspector_id, name: r.name, assigned: 0, overdue: 0, neverInspected: 0 };
+    s.assigned++;
+    const due = nextInspectionDue(r.last, r.months);
+    if (due === null) s.neverInspected++;
+    else if (due < today) s.overdue++;
+    by.set(key, s);
+  }
+  return [...by.values()].sort((a, b) => b.overdue - a.overdue || (a.inspectorId ?? "").localeCompare(b.inspectorId ?? ""));
+}
+
+/** 計測器の最後の点検日（訂正された元の記録は除く）を求める SQL の式。instruments の別名は i。 */
+export const LAST_INSPECTED_SQL = `(SELECT MAX(r.inspected_on) FROM inspection_records r
+  WHERE r.instrument_id = i.id AND NOT EXISTS (SELECT 1 FROM inspection_records c WHERE c.corrects_id = r.id))`;
