+"use client";
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+import type { Comment } from "@/lib/comments";
+
+type Props = { taskId: number; currentUserId: string; comments: Comment[] };
+
+export function Comments({ taskId, currentUserId, comments }: Props) {
+  const router = useRouter();
+  const [body, setBody] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  async function submit(e: React.FormEvent) {
+    e.preventDefault();
+    setBusy(true);
+    setError(null);
+    const res = await fetch(`/api/tasks/${taskId}/comments`, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ body }),
+    });
+    setBusy(false);
+    if (!res.ok) {
+      const data = (await res.json().catch(() => ({}))) as { error?: string; details?: string[] };
+      setError(data.details?.join(" ") || data.error || "投稿できませんでした");
+      return;
+    }
+    setBody("");
+    router.refresh();
+  }
+
+  async function remove(id: number) {
+    const res = await fetch(`/api/tasks/${taskId}/comments/${id}`, { method: "DELETE" });
+    if (!res.ok) setError("削除できませんでした");
+    router.refresh();
+  }
+
+  return (
+    <section>
+      <h2>コメント</h2>
+      {comments.length === 0 ? (
+        <p>コメントはまだありません。</p>
+      ) : (
+        <ul>
+          {comments.map((c) => (
+            <li key={c.id} data-testid="comment">
+              <strong>{c.authorName}</strong> <time dateTime={c.createdAt}>{new Date(c.createdAt).toLocaleString("ja-JP")}</time>
+              <p style={{ whiteSpace: "pre-wrap" }}>{c.body}</p>
+              {c.author === currentUserId && (
+                <button type="button" onClick={() => remove(c.id)}>
+                  削除
+                </button>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+      <form aria-label="コメント" onSubmit={submit}>
+        <textarea name="body" value={body} onChange={(e) => setBody(e.target.value)} rows={3} />
+        {error && <p role="alert">{error}</p>}
+        <button type="submit" disabled={busy}>
+          投稿する
+        </button>
+      </form>
+    </section>
+  );
+}
