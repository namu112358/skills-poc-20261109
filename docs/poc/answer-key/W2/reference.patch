+// DELETE /api/tasks/:id/comments/:commentId — 自分のコメントを削除する。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, requireApiUser } from "@/lib/api";
+import { deleteComment } from "@/lib/comments";
+import { parseTaskId } from "@/lib/tasks";
+
+type Context = { params: Promise<{ id: string; commentId: string }> };
+
+export async function DELETE(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const p = await params;
+  const taskId = parseTaskId(p.id);
+  const commentId = parseTaskId(p.commentId);
+  if (taskId === undefined || commentId === undefined) return jsonError(404, "コメントが見つかりません");
+  const result = deleteComment(taskId, commentId, user.id);
+  if (result === "not_found") return jsonError(404, "コメントが見つかりません");
+  if (result === "forbidden") return jsonError(403, "自分のコメントだけを削除できます");
+  return new NextResponse(null, { status: 204 });
+}
