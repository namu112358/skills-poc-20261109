diff --git a/src/lib/job-lock.ts b/src/lib/job-lock.ts
new file mode 100644
index 0000000..62ae347
--- /dev/null
+++ b/src/lib/job-lock.ts
@@ -0,0 +1,40 @@
+// 定期実行のジョブの多重起動を防ぐロック（DB の job_locks）。
+// 運用の cron は応答が遅いと呼び直すため（docs/operations.md）、前の実行が終わる前に同じジョブが来ることがある。
+// ロックには期限があり、期限を過ぎたロック（途中でプロセスが止まったなど）は次の実行が引き継ぐ。
+import { randomUUID } from "node:crypto";
+import { getDb, type Db } from "./db/index.ts";
+
+/** ロックの期限。ジョブがこれより長く動くことは想定しない（通知サービスが遅くても 1 件あたり 1 分程度）。 */
+export const JOB_LOCK_TTL_MS = 60 * 60 * 1000;
+
+export type JobLock = { job: string; runId: string; release(): void };
+
+/** ロックを取れれば返す。ほかの実行が持っていれば undefined（その実行の run_id は heldBy で返す）。 */
+export function acquireJobLock(
+  job: string,
+  db: Db = getDb(),
+  now: Date = new Date(),
+  ttlMs: number = JOB_LOCK_TTL_MS,
+): { lock: JobLock } | { lock: undefined; heldBy: string } {
+  const runId = randomUUID();
+  const { changes } = db
+    .prepare(
+      `INSERT INTO job_locks (job, run_id, acquired_at, expires_at) VALUES (?, ?, ?, ?)
+       ON CONFLICT (job) DO UPDATE SET run_id = excluded.run_id, acquired_at = excluded.acquired_at, expires_at = excluded.expires_at
+       WHERE job_locks.expires_at <= excluded.acquired_at`,
+    )
+    .run(job, runId, now.toISOString(), new Date(now.getTime() + ttlMs).toISOString());
+  if (changes === 0) {
+    const held = db.prepare("SELECT run_id FROM job_locks WHERE job = ?").get(job) as { run_id: string } | undefined;
+    return { lock: undefined, heldBy: held?.run_id ?? "" };
+  }
+  return {
+    lock: {
+      job,
+      runId,
+      release: () => {
+        db.prepare("DELETE FROM job_locks WHERE job = ? AND run_id = ?").run(job, runId);
+      },
+    },
+  };
+}
