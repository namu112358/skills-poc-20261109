+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { addDays, calibrationDueOn, dueState } from "../src/lib/calibration-due.ts";
+
+describe("calibrationDueOn", () => {
+  it("is the last day of the month after adding the interval", () => {
+    assert.equal(calibrationDueOn("2026-02-10", 12), "2027-02-28");
+    assert.equal(calibrationDueOn("2026-01-31", 1), "2026-02-28");
+    assert.equal(calibrationDueOn("2027-08-01", 6), "2028-02-29");
+    assert.equal(calibrationDueOn("2026-11-30", 2), "2027-01-31");
+  });
+});
+
+describe("dueState", () => {
+  it("is due_soon from 30 days before the due date through the due date, then overdue", () => {
+    assert.equal(addDays("2027-01-31", -30), "2027-01-01");
+    assert.equal(dueState("2027-01-31", "2026-12-31"), "ok");
+    assert.equal(dueState("2027-01-31", "2027-01-01"), "due_soon");
+    assert.equal(dueState("2027-01-31", "2027-01-31"), "due_soon");
+    assert.equal(dueState("2027-01-31", "2027-02-01"), "overdue");
+  });
+});
diff --git a/tests/calibration-reminders.test.ts b/tests/calibration-reminders.test.ts
new file mode 100644
index 0000000..a42cf72
--- /dev/null
+++ b/tests/calibration-reminders.test.ts
@@ -0,0 +1,170 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { managerRecipient, message, recipientsFor, runCalibrationReminders } from "../src/lib/calibration-reminders.ts";
+import { recordCalibration } from "../src/lib/calibrations.ts";
+import { openDb, type Db } from "../src/lib/db/index.ts";
+import { createInstrument, updateInstrument, type InstrumentInput } from "../src/lib/instruments.ts";
+import { lendInstrument } from "../src/lib/loans.ts";
+import type { Notification, NotifyClient, SendResult } from "../src/lib/notify-client.ts";
+
+function recorder(result: (n: Notification) => SendResult = () => ({ ok: true, id: "ntf", attempts: 1 })) {
+  const sent: { n: Notification; key: string }[] = [];
+  const client: NotifyClient = {
+    async send(n, key) {
+      sent.push({ n, key });
+      return result(n);
+    },
+  };
+  return { client, sent };
+}
+
+let seq = 0;
+function add(db: Db, over: Partial<InstrumentInput> = {}) {
+  seq++;
+  return createInstrument(
+    {
+      managementNo: `TS-${String(seq).padStart(4, "0")}`,
+      name: "抵抗計",
+      model: "",
+      location: "",
+      note: "",
+      managerId: "sato",
+      intervalMonths: 12,
+      lastCalibratedOn: "2026-01-31", // 期限 2027-01-31、お知らせは 2027-01-01 から
+      status: "in_use",
+      importance: "A",
+      ...over,
+    },
+    db,
+  );
+}
+
+const at = (jstDate: string) => new Date(`${jstDate}T07:30:00+09:00`);
+function fresh() {
+  const db = openDb();
+  db.exec("UPDATE instruments SET status = 'disposed'"); // 初期データの計測器は対象にしない
+  return db;
+}
+
+describe("runCalibrationReminders", () => {
+  it("notifies once from 30 days before the due date, in Japan time", async () => {
+    const db = fresh();
+    const inst = add(db);
+    const r = recorder();
+    await runCalibrationReminders(r.client, db, at("2026-12-31"));
+    assert.equal(r.sent.length, 0);
+    await runCalibrationReminders(r.client, db, new Date("2026-12-31T15:30:00Z")); // 日本時間 2027-01-01 00:30
+    assert.equal(r.sent.length, 1);
+    assert.equal(r.sent[0].n.recipient, "sato");
+    assert.match(r.sent[0].n.title, new RegExp(inst.managementNo));
+    await runCalibrationReminders(r.client, db, at("2027-01-02"));
+    assert.equal(r.sent.length, 1);
+  });
+
+  it("skips importance B/C and instruments that are calibrating, suspended or disposed", async () => {
+    const db = fresh();
+    add(db, { importance: "B" });
+    add(db, { importance: "C" });
+    for (const status of ["calibrating", "suspended", "disposed"] as const) add(db, { status });
+    const r = recorder();
+    const s = await runCalibrationReminders(r.client, db, at("2027-01-10"));
+    assert.equal(r.sent.length, 0);
+    assert.equal(s.candidates, 0);
+  });
+
+  it("sends an overdue notice once after the due date, and again for a new due date", async () => {
+    const db = fresh();
+    const inst = add(db);
+    const r = recorder();
+    await runCalibrationReminders(r.client, db, at("2027-01-10"));
+    await runCalibrationReminders(r.client, db, at("2027-02-01"));
+    await runCalibrationReminders(r.client, db, at("2027-02-02"));
+    assert.match(r.sent[0].n.title, /校正期限/);
+    assert.doesNotMatch(r.sent[0].n.title, /期限切れ/);
+    assert.match(r.sent[1].n.title, /期限切れ/);
+    recordCalibration(inst.id, { calibratedOn: "2027-02-05", result: "pass", agency: "x", certificateNo: "" }, "sato", db);
+    await runCalibrationReminders(r.client, db, at("2027-02-06"));
+    assert.equal(r.sent.length, 2);
+    await runCalibrationReminders(r.client, db, at("2028-02-01")); // 新しい期限 2028-02-29 の 30 日前から
+    assert.equal(r.sent.length, 3);
+    assert.match(r.sent[2].n.title, /2028-02-29/);
+  });
+
+  it("does not notify after a failed calibration suspends the instrument", async () => {
+    const db = fresh();
+    const inst = add(db);
+    recordCalibration(inst.id, { calibratedOn: "2027-01-05", result: "fail", agency: "x", certificateNo: "" }, "sato", db);
+    const r = recorder();
+    await runCalibrationReminders(r.client, db, at("2027-01-10"));
+    assert.equal(r.sent.length, 0);
+  });
+
+  it("notifies the borrower too, and the department representative when the manager is inactive", async () => {
+    const db = fresh();
+    const lent = add(db, { managerId: "tanaka" });
+    lendInstrument(lent.id, { borrowerId: "matsumoto", dueOn: "2027-01-20" }, db);
+    const orphan = add(db, { managerId: "inoue" }); // 退職した製造部の利用者 → 代表者 yamada
+    assert.deepEqual(recipientsFor({ ...lent, status: "on_loan" }, db), ["tanaka", "matsumoto"]);
+    const r = recorder();
+    await runCalibrationReminders(r.client, db, at("2027-01-10"));
+    const to = (no: string) => r.sent.filter((x) => x.n.title.includes(no)).map((x) => x.n.recipient).sort();
+    assert.deepEqual(to(lent.managementNo), ["matsumoto", "tanaka"]);
+    assert.deepEqual(to(orphan.managementNo), ["yamada"]);
+  });
+
+  it("retries failed sends on the next run and keeps going after a failure", async () => {
+    const db = fresh();
+    const a = add(db, { managerId: "kato" });
+    const b = add(db, { managerId: "ito" });
+    let fail = true;
+    const r = recorder((n) => (n.recipient === "kato" && fail ? { ok: false, retryable: true, status: 503, error: "x", attempts: 3 } : { ok: true, id: "n", attempts: 1 }));
+    const s1 = await runCalibrationReminders(r.client, db, at("2027-01-10"));
+    assert.deepEqual([s1.sent, s1.failed], [1, 1]);
+    fail = false;
+    const s2 = await runCalibrationReminders(r.client, db, at("2027-01-11"));
+    assert.deepEqual([s2.sent, s2.skipped], [1, 1]);
+    assert.equal(r.sent.filter((x) => x.n.title.includes(a.managementNo)).length, 2);
+    assert.ok(r.sent.some((x) => x.n.title.includes(b.managementNo)));
+    const rows = db.prepare("SELECT status FROM calibration_notifications WHERE instrument_id = ? ORDER BY id").all(a.id) as { status: string }[];
+    assert.deepEqual(rows.map((x) => x.status), ["failed", "sent"]);
+  });
+
+  it("keeps the importance when other fields are updated", () => {
+    const db = fresh();
+    const inst = add(db);
+    assert.equal(updateInstrument(inst.id, { location: "倉庫" }, db)?.importance, "A");
+  });
+
+  it("skips inactive representatives and inactive borrowers", () => {
+    const db = fresh();
+    db.prepare("UPDATE users SET active = 0 WHERE id = 'yamada'").run();
+    assert.equal(managerRecipient("inoue", db), undefined);
+    assert.equal(managerRecipient("nobody", db), undefined);
+    assert.equal(managerRecipient("sato", db), "sato");
+    const inst = add(db, { managerId: "tanaka" });
+    lendInstrument(inst.id, { borrowerId: "matsumoto", dueOn: "2027-01-20" }, db);
+    db.prepare("UPDATE users SET active = 0 WHERE id = 'matsumoto'").run();
+    assert.deepEqual(recipientsFor({ ...inst, status: "on_loan" }, db), ["tanaka"]);
+  });
+
+  it("writes the due date and an overdue title", () => {
+    const db = fresh();
+    const inst = add(db, { location: "測定室" });
+    const soon = message(inst, "due_soon", "2027-01-31");
+    const over = message(inst, "overdue", "2027-01-31");
+    assert.match(soon.title, /2027-01-31/);
+    assert.doesNotMatch(soon.title, /期限切れ/);
+    assert.match(over.title, /期限切れ/);
+    assert.match(soon.body, /測定室/);
+    assert.match(over.body, /過ぎています/);
+  });
+
+  it("records the notification id of a sent notice", async () => {
+    const db = fresh();
+    const inst = add(db);
+    const r = recorder(() => ({ ok: true, id: "ntf_42", attempts: 2 }));
+    await runCalibrationReminders(r.client, db, at("2027-01-10"));
+    const row = db.prepare("SELECT status, attempts, notification_id FROM calibration_notifications WHERE instrument_id = ?").get(inst.id) as Record<string, unknown>;
+    assert.deepEqual({ ...row }, { status: "sent", attempts: 2, notification_id: "ntf_42" });
+  });
+});
diff --git a/tests/calibrations.test.ts b/tests/calibrations.test.ts
new file mode 100644
index 0000000..47c724e
--- /dev/null
+++ b/tests/calibrations.test.ts
@@ -0,0 +1,47 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { listCalibrations, recordCalibration, validateCalibrationInput } from "../src/lib/calibrations.ts";
+import { openDb } from "../src/lib/db/index.ts";
+import { listInstruments } from "../src/lib/instruments.ts";
+
+const byNo = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+const PASS = { calibratedOn: "2026-11-05", result: "pass", agency: "東日本計測サービス", certificateNo: "EJ-1" } as const;
+
+describe("recordCalibration", () => {
+  it("updates the last calibration date and returns calibrating instruments to use when passed", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0005");
+    const r = recordCalibration(inst.id, PASS, "tanaka", db);
+    assert.equal(r?.instrument.lastCalibratedOn, "2026-11-05");
+    assert.equal(r?.instrument.status, "in_use");
+    assert.equal(listCalibrations(inst.id, db)[0].certificateNo, "EJ-1");
+  });
+
+  it("does not move the last calibration date backwards", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0003");
+    const r = recordCalibration(inst.id, { ...PASS, calibratedOn: "2026-01-01" }, "suzuki", db);
+    assert.equal(r?.instrument.lastCalibratedOn, "2026-06-03");
+  });
+
+  it("suspends the instrument when failed and keeps the last calibration date", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    const r = recordCalibration(inst.id, { ...PASS, result: "fail" }, "sato", db);
+    assert.equal(r?.instrument.status, "suspended");
+    assert.equal(r?.instrument.lastCalibratedOn, "2026-01-20");
+  });
+
+  it("returns undefined for unknown instruments", () => {
+    assert.equal(recordCalibration(9999, PASS, "sato", openDb()), undefined);
+  });
+});
+
+describe("validateCalibrationInput", () => {
+  it("checks the date, result and agency", () => {
+    assert.equal(validateCalibrationInput(PASS).ok, true);
+    const r = validateCalibrationInput({ calibratedOn: "2026-02-30", result: "ok", agency: " " });
+    assert.equal(r.ok, false);
+    if (!r.ok) assert.equal(r.errors.length, 3);
+  });
+});
