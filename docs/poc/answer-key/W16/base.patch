@@ -0,0 +1,110 @@
+// 社内通知サービス（docs/notify-api.md）のクライアント。
+// - 503・429・通信エラー・タイムアウトは、指数バックオフ（ジッター付き）で決まった回数まで再試行する。429 は Retry-After を守る。
+// - 400・401 などは再試行しない（送り直しても結果が変わらないため）。
+// fetch・待ち時間・乱数は差し替えられる（テスト用）。
+import { logger } from "./logger.ts";
+
+export type Notification = { recipient: string; title: string; body: string; category?: string };
+
+export type SendResult =
+  | { ok: true; id: string; attempts: number }
+  | { ok: false; retryable: boolean; status?: number; error: string; attempts: number };
+
+export type NotifyClientOptions = {
+  url: string;
+  token: string;
+  timeoutMs?: number; // 1 回の要求のタイムアウト
+  maxAttempts?: number; // 最初の 1 回を含む試行回数
+  baseDelayMs?: number; // 再試行の待ち時間の基準（1 回目）
+  maxDelayMs?: number; // 再試行の待ち時間の上限
+  fetch?: typeof fetch;
+  sleep?: (ms: number) => Promise<void>;
+  random?: () => number;
+};
+
+export type NotifyClient = { send(n: Notification, idempotencyKey: string): Promise<SendResult> };
+
+const defaultSleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+/** Retry-After（秒、または HTTP 日付）をミリ秒にする。読めなければ undefined。 */
+export function parseRetryAfter(value: string | null, now: number = Date.now()): number | undefined {
+  if (!value) return undefined;
+  if (/^\d+$/.test(value.trim())) return Number(value.trim()) * 1000;
+  const at = Date.parse(value);
+  return Number.isNaN(at) ? undefined : Math.max(0, at - now);
+}
+
+/** n 回目（1 始まり）の失敗の後の待ち時間。base × 2^(n-1) を上限で切り、50〜100% のジッターをかける。 */
+export function backoffDelay(n: number, base: number, max: number, random: () => number = Math.random): number {
+  const exp = Math.min(max, base * 2 ** (n - 1));
+  return Math.round(exp * (0.5 + random() * 0.5));
+}
+
+export function createNotifyClient(options: NotifyClientOptions): NotifyClient {
+  const {
+    url,
+    token,
+    timeoutMs = 10_000,
+    maxAttempts = 5,
+    baseDelayMs = 500,
+    maxDelayMs = 8_000,
+    fetch: doFetch = fetch,
+    sleep = defaultSleep,
+    random = Math.random,
+  } = options;
+  const endpoint = new URL("/v1/notifications", url).toString();
+
+  return {
+    async send(n, idempotencyKey) {
+      let last: SendResult = { ok: false, retryable: true, error: "未送信", attempts: 0 };
+      for (let attempt = 1; attempt <= maxAttempts; attempt++) {
+        let retryAfterMs: number | undefined;
+        try {
+          const res = await doFetch(endpoint, {
+            method: "POST",
+            headers: {
+              authorization: `Bearer ${token}`,
+              "content-type": "application/json",
+              "idempotency-key": `${idempotencyKey}-${attempt}`,
+            },
+            body: JSON.stringify({ category: "calibration", ...n }),
+            signal: AbortSignal.timeout(timeoutMs),
+          });
+          if (res.ok) {
+            const data = (await res.json().catch(() => ({}))) as { id?: unknown };
+            return { ok: true, id: typeof data.id === "string" ? data.id : "", attempts: attempt };
+          }
+          const text = (await res.text().catch(() => "")).slice(0, 200);
+          const retryable = res.status === 429 || res.status >= 500;
+          last = { ok: false, retryable, status: res.status, error: text || `HTTP ${res.status}`, attempts: attempt };
+          if (!retryable) return last;
+          if (res.status === 429) retryAfterMs = parseRetryAfter(res.headers.get("retry-after"));
+        } catch (e) {
+          const name = e instanceof Error ? e.name : "";
+          last = {
+            ok: false,
+            retryable: true,
+            error: name === "TimeoutError" ? `タイムアウト（${timeoutMs}ms）` : String(e instanceof Error ? e.message : e),
+            attempts: attempt,
+          };
+        }
+        if (attempt < maxAttempts) {
+          const waitMs = Math.max(retryAfterMs ?? 0, backoffDelay(attempt, baseDelayMs, maxDelayMs, random));
+          if (!last.ok) logger.warn("notify.retry", { recipient: n.recipient, attempt, status: last.status, error: last.error, waitMs });
+          await sleep(waitMs);
+        }
+      }
+      return last;
+    },
+  };
+}
+
+/** 環境変数（NOTIFY_API_URL・NOTIFY_API_TOKEN）からクライアントを作る。未設定なら undefined。 */
+export function notifyClientFromEnv(env: NodeJS.ProcessEnv = process.env): NotifyClient | undefined {
+  if (!env.NOTIFY_API_URL || !env.NOTIFY_API_TOKEN) return undefined;
+  return createNotifyClient({
+    url: env.NOTIFY_API_URL,
+    token: env.NOTIFY_API_TOKEN,
+    timeoutMs: Number(env.NOTIFY_API_TIMEOUT_MS) || undefined,
+  });
+}
