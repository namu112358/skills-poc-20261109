+// GET /api/instruments/:id — 計測器を 1 件取得 / PATCH /api/instruments/:id — 送った項目だけを更新する。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { getInstrument, managementNoExists, parseId, updateInstrument, validateInstrumentInput } from "@/lib/instruments";
+import { currentLoan } from "@/lib/loans";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function GET(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  const instrument = id === undefined ? undefined : getInstrument(id);
+  if (!instrument) return jsonError(404, "計測器が見つかりません");
+  return NextResponse.json({ instrument, currentLoan: currentLoan(instrument.id) ?? null });
+}
+
+export async function PATCH(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  const current = id === undefined ? undefined : getInstrument(id);
+  if (!current) return jsonError(404, "計測器が見つかりません");
+  const result = validateInstrumentInput(await readJson(request), { partial: true });
+  if (!result.ok) return jsonError(400, "入力内容に誤りがあります", result.errors);
+  const changes = result.value;
+  if (changes.status !== undefined && current.status === "on_loan") {
+    return jsonError(409, "貸出中の計測器の状態は、返却してから変更してください");
+  }
+  if (changes.managementNo !== undefined && changes.managementNo !== current.managementNo && managementNoExists(changes.managementNo)) {
+    return jsonError(409, "その管理番号はすでに登録されています");
+  }
+  return NextResponse.json({ instrument: updateInstrument(current.id, changes) });
+}
