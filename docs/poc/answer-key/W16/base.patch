+            <option value="">すべて</option>
+            {INSTRUMENT_STATUSES.map((s) => (
+              <option key={s} value={s}>
+                {STATUS_LABELS[s]}
+              </option>
+            ))}
+          </select>
+        </label>{" "}
+        <label>
+          重要度{" "}
+          <select name="importance" defaultValue={importance ?? ""}>
+            <option value="">すべて</option>
+            {IMPORTANCES.map((v) => (
+              <option key={v} value={v}>
+                {IMPORTANCE_LABELS[v]}
+              </option>
+            ))}
+          </select>
+        </label>{" "}
+        <button type="submit">絞り込む</button>
+      </form>
+      <table>
+        <thead>
+          <tr>
