+import { notFound } from "next/navigation";
+import { RESULT_LABELS, listCalibrations } from "@/lib/calibrations";
+import { calibrationDueOn } from "@/lib/calibration-due";
+import { IMPORTANCE_LABELS, STATUS_LABELS, getInstrument, parseId } from "@/lib/instruments";
+import { listLoans } from "@/lib/loans";
+import { requireUser } from "@/lib/session";
+import { getUser } from "@/lib/users";
+
+type Props = {
+  params: Promise<{ id: string }>;
+};
+
+export default async function InstrumentDetailPage({ params }: Props) {
+  await requireUser();
+  const id = parseId((await params).id);
+  const instrument = id === undefined ? undefined : getInstrument(id);
+  if (!instrument) notFound();
+  const manager = getUser(instrument.managerId);
+  const loans = listLoans(instrument.id);
+  const calibrations = listCalibrations(instrument.id);
+  const nameOf = (userId: string) => getUser(userId)?.name ?? userId;
+
+  return (
+    <main>
+      <p>
+        <a href="/instruments">← 計測器一覧へ戻る</a>
+      </p>
+      <h1 data-testid="instrument-title">
+        {instrument.managementNo} {instrument.name}
+      </h1>
+      <dl>
+        <dt>型式</dt>
+        <dd>{instrument.model || "—"}</dd>
+        <dt>設置場所</dt>
+        <dd>{instrument.location || "—"}</dd>
+        <dt>管理者</dt>
+        <dd data-testid="instrument-manager">{manager?.name ?? instrument.managerId}</dd>
+        <dt>校正周期</dt>
+        <dd>{instrument.intervalMonths} か月</dd>
+        <dt>前回校正日</dt>
+        <dd data-testid="instrument-last-calibrated">{instrument.lastCalibratedOn}</dd>
+        <dt>重要度</dt>
+        <dd data-testid="instrument-importance">{IMPORTANCE_LABELS[instrument.importance]}</dd>
+        <dt>校正期限</dt>
+        <dd data-testid="instrument-due">{calibrationDueOn(instrument.lastCalibratedOn, instrument.intervalMonths)}</dd>
+        <dt>状態</dt>
+        <dd data-testid="instrument-status">{STATUS_LABELS[instrument.status]}</dd>
+        {instrument.note && (
+          <>
+            <dt>備考</dt>
+            <dd>{instrument.note}</dd>
+          </>
+        )}
+      </dl>
+
+      <h2>校正記録</h2>
+      {calibrations.length === 0 ? (
+        <p>校正記録はありません。</p>
+      ) : (
+        <table>
+          <thead>
+            <tr>
+              <th>校正日</th>
+              <th>結果</th>
+              <th>校正機関</th>
+              <th>証明書番号</th>
+              <th>登録者</th>
+            </tr>
+          </thead>
+          <tbody>
+            {calibrations.map((c) => (
+              <tr key={c.id}>
+                <td>{c.calibratedOn}</td>
+                <td>{RESULT_LABELS[c.result]}</td>
+                <td>{c.agency}</td>
+                <td>{c.certificateNo || "—"}</td>
+                <td>{nameOf(c.recordedBy)}</td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      )}
+
+      <h2>貸出の記録</h2>
+      {loans.length === 0 ? (
+        <p>貸出の記録はありません。</p>
+      ) : (
+        <table>
+          <thead>
+            <tr>
+              <th>借りた人</th>
+              <th>貸出日時（UTC）</th>
+              <th>返却予定日</th>
+              <th>返却</th>
+            </tr>
+          </thead>
+          <tbody>
+            {loans.map((l) => (
+              <tr key={l.id}>
+                <td>{nameOf(l.borrowerId)}</td>
+                <td>{l.borrowedAt}</td>
+                <td>{l.dueOn}</td>
+                <td>{l.returnedAt ? "返却済み" : "貸出中"}</td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      )}
+    </main>
+  );
+}
