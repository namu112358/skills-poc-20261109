@@ -0,0 +1,12 @@
+// 定期実行のジョブ（運用チームの cron が POST /api/jobs/<ジョブ名> を呼ぶ）の認証。
+// 利用者のログインではなく、環境変数 JOBS_TOKEN と一致する Bearer トークンで認証する（docs/operations.md）。
+// API Route からは src/lib/api.ts の requireJobAuth() を使う。
+import { timingSafeEqual } from "node:crypto";
+
+/** ヘッダーのトークンが JOBS_TOKEN と一致すれば true。JOBS_TOKEN が未設定なら常に false。 */
+export function isAuthorizedJobRequest(authorization: string | null, expected = process.env.JOBS_TOKEN): boolean {
+  if (!expected || !authorization?.startsWith("Bearer ")) return false;
+  const given = Buffer.from(authorization.slice("Bearer ".length));
+  const want = Buffer.from(expected);
+  return given.length === want.length && timingSafeEqual(given, want);
+}
diff --git a/src/lib/loans.ts b/src/lib/loans.ts
new file mode 100644
index 0000000..4d3009e
--- /dev/null
+++ b/src/lib/loans.ts
@@ -0,0 +1,111 @@
+// 計測器の貸出と返却。貸し出すと計測器の状態は「貸出中」、返却すると「使用中」に戻る。
+import { getDb, transaction, type Db } from "./db/index.ts";
+import { isValidDate } from "./dates.ts";
+import { getInstrument } from "./instruments.ts";
+import { isActiveUser } from "./users.ts";
+import type { ValidationResult } from "./instruments.ts";
+
+export type Loan = {
+  id: number;
+  instrumentId: number;
+  borrowerId: string;
+  borrowedAt: string; // ISO 8601（UTC）
+  dueOn: string; // 返却予定日 YYYY-MM-DD
+  returnedAt: string | null;
+};
+
+type LoanRow = {
+  id: number;
+  instrument_id: number;
+  borrower_id: string;
+  borrowed_at: string;
+  due_on: string;
+  returned_at: string | null;
+};
+
+function toLoan(r: LoanRow): Loan {
+  return {
+    id: r.id,
+    instrumentId: r.instrument_id,
+    borrowerId: r.borrower_id,
+    borrowedAt: r.borrowed_at,
+    dueOn: r.due_on,
+    returnedAt: r.returned_at,
+  };
+}
+
+const COLUMNS = "id, instrument_id, borrower_id, borrowed_at, due_on, returned_at";
+
+/** 計測器の貸出の記録を、新しい順に返す。 */
+export function listLoans(instrumentId: number, db: Db = getDb()): Loan[] {
+  const rows = db
+    .prepare(`SELECT ${COLUMNS} FROM loans WHERE instrument_id = ? ORDER BY borrowed_at DESC, id DESC`)
+    .all(instrumentId) as LoanRow[];
+  return rows.map(toLoan);
+}
+
+/** 返却されていない貸出（無ければ undefined）。 */
+export function currentLoan(instrumentId: number, db: Db = getDb()): Loan | undefined {
+  const row = db
+    .prepare(`SELECT ${COLUMNS} FROM loans WHERE instrument_id = ? AND returned_at IS NULL ORDER BY id DESC LIMIT 1`)
+    .get(instrumentId) as LoanRow | undefined;
+  return row && toLoan(row);
+}
+
+export type LoanInput = { borrowerId: string; dueOn: string };
+
+export function validateLoanInput(body: unknown, db: Db = getDb()): ValidationResult<LoanInput> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const b = body as Record<string, unknown>;
+  const errors: string[] = [];
+  if (typeof b.borrowerId !== "string" || !isActiveUser(b.borrowerId, db)) errors.push("借りる人が存在しません");
+  if (!isValidDate(b.dueOn)) errors.push("返却予定日は YYYY-MM-DD 形式で入力してください");
+  return errors.length > 0
+    ? { ok: false, errors }
+    : { ok: true, value: { borrowerId: b.borrowerId as string, dueOn: b.dueOn as string } };
+}
+
+export type LendResult = { ok: true; loan: Loan } | { ok: false; reason: "not_found" | "not_available" };
+
+/** 使用中の計測器を貸し出す。使用中でなければ貸し出せない。 */
+export function lendInstrument(instrumentId: number, input: LoanInput, db: Db = getDb(), now: Date = new Date()): LendResult {
+  return transaction(db, () => {
+    const instrument = getInstrument(instrumentId, db);
+    if (!instrument) return { ok: false, reason: "not_found" } as const;
+    if (instrument.status !== "in_use") return { ok: false, reason: "not_available" } as const;
+    const { lastInsertRowid } = db
+      .prepare("INSERT INTO loans (instrument_id, borrower_id, borrowed_at, due_on) VALUES (?, ?, ?, ?)")
+      .run(instrumentId, input.borrowerId, now.toISOString(), input.dueOn);
+    db.prepare("UPDATE instruments SET status = 'on_loan' WHERE id = ?").run(instrumentId);
+    const loan = db.prepare(`SELECT ${COLUMNS} FROM loans WHERE id = ?`).get(Number(lastInsertRowid)) as LoanRow;
+    return { ok: true, loan: toLoan(loan) } as const;
+  });
+}
+
+/** 貸出を返却済みにし、計測器を使用中に戻す。対象の貸出が無い・返却済みなら undefined。 */
+export function returnLoan(instrumentId: number, loanId: number, db: Db = getDb(), now: Date = new Date()): Loan | undefined {
+  return transaction(db, () => {
+    const { changes } = db
+      .prepare("UPDATE loans SET returned_at = ? WHERE id = ? AND instrument_id = ? AND returned_at IS NULL")
+      .run(now.toISOString(), loanId, instrumentId);
+    if (changes === 0) return undefined;
+    db.prepare("UPDATE instruments SET status = 'in_use' WHERE id = ? AND status = 'on_loan'").run(instrumentId);
+    return toLoan(db.prepare(`SELECT ${COLUMNS} FROM loans WHERE id = ?`).get(loanId) as LoanRow);
+  });
+}
+
+export type OverdueLoan = Loan & { managementNo: string };
+
+/** 返却予定日（日本時間の日付）を過ぎても返却されていない貸出。 */
+export function listOverdueLoans(today: string, db: Db = getDb()): OverdueLoan[] {
+  const rows = db
+    .prepare(
+      `SELECT l.id, l.instrument_id, l.borrower_id, l.borrowed_at, l.due_on, l.returned_at, i.management_no
+       FROM loans l JOIN instruments i ON i.id = l.instrument_id
+       WHERE l.returned_at IS NULL AND l.due_on < ? ORDER BY l.due_on, l.id`,
+    )
+    .all(today) as (LoanRow & { management_no: string })[];
+  return rows.map((r) => ({ ...toLoan(r), managementNo: r.management_no }));
+}
