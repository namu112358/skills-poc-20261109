+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { isValidDate, todayJst } from "../src/lib/dates.ts";
+import { isAuthorizedJobRequest } from "../src/lib/jobs.ts";
+
+describe("dates", () => {
+  it("validates real calendar dates", () => {
+    assert.equal(isValidDate("2028-02-29"), true);
+    for (const v of ["2027-02-29", "2026-04-31", "2026-13-01", "2026-1-1", 20260101]) assert.equal(isValidDate(v), false);
+  });
+
+  it("returns today's date in Japan", () => {
+    assert.equal(todayJst(new Date("2026-11-09T14:59:59Z")), "2026-11-09");
+    assert.equal(todayJst(new Date("2026-11-09T15:00:00Z")), "2026-11-10");
+  });
+});
+
+describe("isAuthorizedJobRequest", () => {
+  it("accepts only the configured bearer token", () => {
+    assert.equal(isAuthorizedJobRequest("Bearer s3cret", "s3cret"), true);
+    assert.equal(isAuthorizedJobRequest("Bearer wrong", "s3cret"), false);
+    assert.equal(isAuthorizedJobRequest("s3cret", "s3cret"), false);
+    assert.equal(isAuthorizedJobRequest(null, "s3cret"), false);
+    assert.equal(isAuthorizedJobRequest("Bearer ", ""), false);
+    assert.equal(isAuthorizedJobRequest("Bearer x", undefined), false);
+  });
+});
