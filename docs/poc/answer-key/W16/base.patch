diff --git a/src/lib/calibration-due.ts b/src/lib/calibration-due.ts
new file mode 100644
index 0000000..d7803ea
--- /dev/null
+++ b/src/lib/calibration-due.ts
@@ -0,0 +1,28 @@
+// 校正期限の計算。期限 = 前回校正日に校正周期（月）を足した月の末日（日本時間の暦日）。
+// 例: 前回 2026-02-10、周期 12 か月 → 2027-02-28。
+
+/** 校正期限（YYYY-MM-DD）。 */
+export function calibrationDueOn(lastCalibratedOn: string, intervalMonths: number): string {
+  const [y, m] = lastCalibratedOn.split("-").map(Number);
+  const monthIndex = m - 1 + intervalMonths; // 0 始まりの月
+  // Date.UTC(年, 翌月, 0) はその月の末日
+  return new Date(Date.UTC(y, monthIndex + 1, 0)).toISOString().slice(0, 10);
+}
+
+/** YYYY-MM-DD に日数を足す（負の数なら引く）。 */
+export function addDays(date: string, days: number): string {
+  const [y, m, d] = date.split("-").map(Number);
+  return new Date(Date.UTC(y, m - 1, d + days)).toISOString().slice(0, 10);
+}
+
+/** 期限が近いお知らせを出し始める日数（期限の何日前から）。外部の校正機関への手配に時間がかかるため 30 日。 */
+export const NOTICE_DAYS_BEFORE = 30;
+
+export type DueState = "ok" | "due_soon" | "overdue";
+
+/** 今日（日本時間の日付）から見た期限の状態。期限当日までは due_soon、翌日から overdue。 */
+export function dueState(dueOn: string, today: string, daysBefore = NOTICE_DAYS_BEFORE): DueState {
+  if (today > dueOn) return "overdue";
+  if (today >= addDays(dueOn, -daysBefore)) return "due_soon";
+  return "ok";
+}
diff --git a/src/lib/calibration-reminders.ts b/src/lib/calibration-reminders.ts
new file mode 100644
index 0000000..d34925c
--- /dev/null
+++ b/src/lib/calibration-reminders.ts
@@ -0,0 +1,124 @@
+// 校正期限のお知らせ（運用の cron が POST /api/jobs/calibration-reminders で毎朝呼ぶ）。
+// - 対象: 重要度 A で、使用中・貸出中の計測器（校正中・使用停止・廃棄は対象外）。
+// - 期限の 30 日前から期限当日までに「期限が近い」、期限を過ぎたら「期限切れ」を、それぞれ 1 つの期限につき 1 回送る。
+//   校正記録の登録で期限が変わったら、新しい期限について改めて送る。
+// - 送り先: 管理者（無効なら管理者の部署の代表者）。貸出中なら借りている人にも送る。
+// - 送った記録は calibration_notifications に残し、送信済み（sent）の期限・種類・送り先には二度送らない。
+//   1 件の失敗で残りを止めず、失敗したもの（failed）は次の実行で送り直す。
+import { calibrationDueOn, dueState } from "./calibration-due.ts";
+import { getDb, type Db } from "./db/index.ts";
+import { todayJst } from "./dates.ts";
+import { listInstruments, type Instrument } from "./instruments.ts";
+import { currentLoan } from "./loans.ts";
+import { logger } from "./logger.ts";
+import type { NotifyClient } from "./notify-client.ts";
+import { getDepartment, getUserDetail } from "./users.ts";
+
+export type ReminderKind = "due_soon" | "overdue";
+
+export type ReminderSummary = { today: string; candidates: number; sent: number; skipped: number; failed: number };
+
+/** 管理者の代わりの送り先。管理者が無効なら、管理者の部署の代表者（有効な人）。見つからなければ undefined。 */
+export function managerRecipient(managerId: string, db: Db = getDb()): string | undefined {
+  const manager = getUserDetail(managerId, db);
+  if (!manager) return undefined;
+  if (manager.active) return manager.id;
+  const rep = getDepartment(manager.departmentId, db)?.representativeId;
+  return rep && getUserDetail(rep, db)?.active ? rep : undefined;
+}
+
+/** お知らせの送り先（重複なし）。 */
+export function recipientsFor(instrument: Instrument, db: Db = getDb()): string[] {
+  const out: string[] = [];
+  const manager = managerRecipient(instrument.managerId, db);
+  if (manager) out.push(manager);
+  else logger.warn("calibration_reminder.no_manager", { instrumentId: instrument.id, managerId: instrument.managerId });
+  if (instrument.status === "on_loan") {
+    const borrower = currentLoan(instrument.id, db)?.borrowerId;
+    if (borrower && getUserDetail(borrower, db)?.active && !out.includes(borrower)) out.push(borrower);
+  }
+  return out;
+}
+
+/** 通知サービスに渡す Idempotency-Key（送信記録の行ごと）。 */
+export function idempotencyKey(notificationRowId: number): string {
+  return `calibration-notification-${notificationRowId}`;
+}
+
+export function message(instrument: Instrument, kind: ReminderKind, dueOn: string) {
+  const what = `${instrument.managementNo} ${instrument.name}${instrument.model ? `（${instrument.model}）` : ""}`;
+  const title =
+    kind === "overdue" ? `【校正期限切れ】${instrument.managementNo} の校正期限（${dueOn}）を過ぎています` : `【校正期限】${instrument.managementNo} の校正期限は ${dueOn} です`;
+  const body = [
+    kind === "overdue"
+      ? `重要度 A の計測器 ${what} の校正期限（${dueOn}）を過ぎています。使用を止め、校正の手配を確認してください。`
+      : `重要度 A の計測器 ${what} の校正期限が ${dueOn} に迫っています。校正機関への手配をお願いします。`,
+    `設置場所: ${instrument.location || "—"}`,
+    `前回校正日: ${instrument.lastCalibratedOn}（校正周期 ${instrument.intervalMonths} か月）`,
+  ].join("\n");
+  return { title, body };
+}
+
+type Target = { instrumentId: number; kind: ReminderKind; dueOn: string; recipient: string };
+
+/** 同じ期限・種類・送り先のお知らせを、もう送ったか。 */
+function alreadySent(db: Db, t: Target): boolean {
+  return !!db
+    .prepare(
+      `SELECT 1 FROM calibration_notifications
+       WHERE instrument_id = ? AND kind = ? AND due_on = ? AND recipient_id = ? AND status = 'sent' LIMIT 1`,
+    )
+    .get(t.instrumentId, t.kind, t.dueOn, t.recipient);
+}
+
+/** 送信記録を「送信中」で作り、行の id を返す。 */
+function createRecord(db: Db, t: Target, now: Date): number {
+  const { lastInsertRowid } = db
+    .prepare(
+      `INSERT INTO calibration_notifications (instrument_id, kind, due_on, recipient_id, status, created_at)
+       VALUES (?, ?, ?, ?, 'pending', ?)`,
+    )
+    .run(t.instrumentId, t.kind, t.dueOn, t.recipient, now.toISOString());
+  return Number(lastInsertRowid);
+}
+
+export async function runCalibrationReminders(
+  client: NotifyClient,
+  db: Db = getDb(),
+  now: Date = new Date(),
+): Promise<ReminderSummary> {
+  const today = todayJst(now);
+  const summary: ReminderSummary = { today, candidates: 0, sent: 0, skipped: 0, failed: 0 };
+  const targets = listInstruments({ importance: "A" }, db).filter((i) => i.status === "in_use" || i.status === "on_loan");
+  for (const instrument of targets) {
+    const dueOn = calibrationDueOn(instrument.lastCalibratedOn, instrument.intervalMonths);
+    const state = dueState(dueOn, today);
+    if (state === "ok") continue;
+    const kind: ReminderKind = state;
+    for (const recipient of recipientsFor(instrument, db)) {
+      summary.candidates++;
+      const target: Target = { instrumentId: instrument.id, kind, dueOn, recipient };
+      if (alreadySent(db, target)) {
+        summary.skipped++;
+        continue;
+      }
+      const rowId = createRecord(db, target, now);
+      const result = await client.send({ recipient, ...message(instrument, kind, dueOn) }, idempotencyKey(rowId));
+      const fields = { instrumentId: instrument.id, managementNo: instrument.managementNo, kind, dueOn, recipient, attempts: result.attempts };
+      if (result.ok) {
+        db.prepare(
+          "UPDATE calibration_notifications SET status = 'sent', attempts = ?, notification_id = ?, sent_at = ? WHERE id = ?",
+        ).run(result.attempts, result.id, new Date().toISOString(), rowId);
+        summary.sent++;
+        logger.info("calibration_reminder.sent", { ...fields, notificationId: result.id });
+      } else {
+        db.prepare(
+          "UPDATE calibration_notifications SET status = 'failed', attempts = ?, last_error = ? WHERE id = ?",
+        ).run(result.attempts, `${result.status ?? ""} ${result.error}`.trim(), rowId);
+        summary.failed++;
+        logger.error("calibration_reminder.failed", { ...fields, status: result.status, retryable: result.retryable, error: result.error });
+      }
+    }
+  }
+  return summary;
+}
diff --git a/src/lib/calibrations.ts b/src/lib/calibrations.ts
new file mode 100644
index 0000000..68049fb
--- /dev/null
+++ b/src/lib/calibrations.ts
@@ -0,0 +1,124 @@
+// 校正記録。外部の校正機関での校正結果を登録する。
+// - 合格: 計測器の前回校正日を校正日に更新し、校正中だった計測器は使用中に戻す。
+// - 不合格: 計測器を使用停止にする（前回校正日は変えない）。
+import { getDb, transaction, type Db } from "./db/index.ts";
+import { isValidDate } from "./dates.ts";
+import { getInstrument, type Instrument, type ValidationResult } from "./instruments.ts";
+import { logger } from "./logger.ts";
+
+export type CalibrationResult = "pass" | "fail";
+
+export const RESULT_LABELS: Record<CalibrationResult, string> = { pass: "合格", fail: "不合格" };
+
+export type CalibrationRecord = {
+  id: number;
+  instrumentId: number;
+  calibratedOn: string; // YYYY-MM-DD
+  result: CalibrationResult;
+  agency: string;
+  certificateNo: string;
+  recordedBy: string;
+  recordedAt: string; // ISO 8601（UTC）
+};
+
+type Row = {
+  id: number;
+  instrument_id: number;
+  calibrated_on: string;
+  result: CalibrationResult;
+  agency: string;
+  certificate_no: string;
+  recorded_by: string;
+  recorded_at: string;
+};
+
+const COLUMNS = "id, instrument_id, calibrated_on, result, agency, certificate_no, recorded_by, recorded_at";
+
+function toRecord(r: Row): CalibrationRecord {
+  return {
+    id: r.id,
+    instrumentId: r.instrument_id,
+    calibratedOn: r.calibrated_on,
+    result: r.result,
+    agency: r.agency,
+    certificateNo: r.certificate_no,
+    recordedBy: r.recorded_by,
+    recordedAt: r.recorded_at,
+  };
+}
+
+/** 計測器の校正記録を、校正日の新しい順に返す。 */
+export function listCalibrations(instrumentId: number, db: Db = getDb()): CalibrationRecord[] {
+  const rows = db
+    .prepare(`SELECT ${COLUMNS} FROM calibration_records WHERE instrument_id = ? ORDER BY calibrated_on DESC, id DESC`)
+    .all(instrumentId) as Row[];
+  return rows.map(toRecord);
+}
+
+export type CalibrationInput = { calibratedOn: string; result: CalibrationResult; agency: string; certificateNo: string };
+
+export function validateCalibrationInput(body: unknown): ValidationResult<CalibrationInput> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const b = body as Record<string, unknown>;
+  const errors: string[] = [];
+  if (!isValidDate(b.calibratedOn)) errors.push("校正日は YYYY-MM-DD 形式で入力してください");
+  if (b.result !== "pass" && b.result !== "fail") errors.push("結果は pass（合格）か fail（不合格）で指定してください");
+  if (typeof b.agency !== "string" || b.agency.trim() === "" || b.agency.length > 100) {
+    errors.push("校正機関は 1〜100 文字で入力してください");
+  }
+  const cert = b.certificateNo ?? "";
+  if (typeof cert !== "string" || cert.length > 50) errors.push("証明書番号は 50 文字以内で入力してください");
+  if (errors.length > 0) return { ok: false, errors };
+  return {
+    ok: true,
+    value: {
+      calibratedOn: b.calibratedOn as string,
+      result: b.result as CalibrationResult,
+      agency: (b.agency as string).trim(),
+      certificateNo: (cert as string).trim(),
+    },
+  };
+}
+
+/** 校正記録を登録し、計測器の前回校正日・状態を更新する。計測器が無ければ undefined。 */
+export function recordCalibration(
+  instrumentId: number,
+  input: CalibrationInput,
+  recordedBy: string,
+  db: Db = getDb(),
+  now: Date = new Date(),
+): { record: CalibrationRecord; instrument: Instrument } | undefined {
+  const result = transaction(db, () => {
+    const instrument = getInstrument(instrumentId, db);
+    if (!instrument) return undefined;
+    const { lastInsertRowid } = db
+      .prepare(
+        `INSERT INTO calibration_records (instrument_id, calibrated_on, result, agency, certificate_no, recorded_by, recorded_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?)`,
+      )
+      .run(instrumentId, input.calibratedOn, input.result, input.agency, input.certificateNo, recordedBy, now.toISOString());
+    if (input.result === "pass") {
+      // 古い校正日の記録を後から登録しても、前回校正日は戻さない
+      db.prepare(
+        `UPDATE instruments SET last_calibrated_on = MAX(last_calibrated_on, ?),
+           status = CASE WHEN status = 'calibrating' THEN 'in_use' ELSE status END
+         WHERE id = ?`,
+      ).run(input.calibratedOn, instrumentId);
+    } else {
+      db.prepare("UPDATE instruments SET status = 'suspended' WHERE id = ?").run(instrumentId);
+    }
+    const record = toRecord(db.prepare(`SELECT ${COLUMNS} FROM calibration_records WHERE id = ?`).get(Number(lastInsertRowid)) as Row);
+    return { record, instrument: getInstrument(instrumentId, db)! };
+  });
+  if (result?.record.result === "fail") {
+    logger.warn("calibration.failed", {
+      instrumentId,
+      managementNo: result.instrument.managementNo,
+      recordId: result.record.id,
+      status: result.instrument.status,
+    });
+  }
+  return result;
+}
diff --git a/src/lib/dates.ts b/src/lib/dates.ts
new file mode 100644
index 0000000..9a73424
--- /dev/null
+++ b/src/lib/dates.ts
@@ -0,0 +1,16 @@
+// 日付の扱い。日付（YYYY-MM-DD）は日本時間の暦日で、日時は UTC の ISO 8601 で扱う。
+const DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+/** YYYY-MM-DD 形式で、実在する日付なら true（2027-02-29 などは false）。 */
+export function isValidDate(value: unknown): value is string {
+  if (typeof value !== "string") return false;
+  const m = DATE_RE.exec(value);
+  if (!m) return false;
+  const d = new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3])));
+  return d.getUTCFullYear() === Number(m[1]) && d.getUTCMonth() === Number(m[2]) - 1 && d.getUTCDate() === Number(m[3]);
+}
+
+/** 日本時間での今日の日付（YYYY-MM-DD）。利用者は全員日本国内にいる。 */
+export function todayJst(now: Date = new Date()): string {
+  return new Date(now.getTime() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);
+}
