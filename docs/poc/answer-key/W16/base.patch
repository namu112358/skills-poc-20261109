diff --git a/tests/instruments.test.ts b/tests/instruments.test.ts
new file mode 100644
index 0000000..f599ed5
--- /dev/null
+++ b/tests/instruments.test.ts
@@ -0,0 +1,104 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import {
+  createInstrument,
+  getInstrument,
+  isInstrumentStatus,
+  listInstruments,
+  parseId,
+  updateInstrument,
+  validateInstrumentInput,
+} from "../src/lib/instruments.ts";
+
+const VALID = {
+  managementNo: "MI-0100",
+  name: "抵抗計",
+  managerId: "sato",
+  intervalMonths: 12,
+  lastCalibratedOn: "2026-04-01",
+};
+
+describe("listInstruments", () => {
+  it("returns instruments ordered by management number and filters by status and manager", () => {
+    const db = openDb();
+    const all = listInstruments({}, db);
+    assert.equal(all.length, 10);
+    assert.deepEqual(
+      all.map((i) => i.managementNo),
+      [...all.map((i) => i.managementNo)].sort(),
+    );
+    assert.ok(listInstruments({ status: "on_loan" }, db).every((i) => i.status === "on_loan"));
+    assert.deepEqual(
+      listInstruments({ managerId: "tanaka" }, db).map((i) => i.managementNo),
+      ["MI-0002", "MI-0005"],
+    );
+  });
+});
+
+describe("parseId / isInstrumentStatus", () => {
+  it("accepts only positive integers and known statuses", () => {
+    assert.equal(parseId("12"), 12);
+    for (const v of ["0", "-1", "1.5", "abc", "", "12345678901", undefined]) assert.equal(parseId(v), undefined);
+    assert.equal(isInstrumentStatus("suspended"), true);
+    assert.equal(isInstrumentStatus("lost"), false);
+  });
+});
+
+describe("validateInstrumentInput", () => {
+  it("fills defaults for a new instrument", () => {
+    const db = openDb();
+    const r = validateInstrumentInput(VALID, {}, db);
+    assert.equal(r.ok, true);
+    if (r.ok) assert.deepEqual(r.value, { ...VALID, model: "", location: "", note: "", status: "in_use", importance: "B" });
+  });
+
+  it("rejects invalid values", () => {
+    const db = openDb();
+    const r = validateInstrumentInput(
+      { ...VALID, managementNo: "0100", managerId: "nobody", intervalMonths: 0, lastCalibratedOn: "2027-02-29", status: "on_loan" },
+      {},
+      db,
+    );
+    assert.equal(r.ok, false);
+    if (!r.ok) assert.equal(r.errors.length, 5);
+    assert.equal(validateInstrumentInput([], {}, db).ok, false);
+  });
+
+  it("validates only the given fields when partial", () => {
+    const db = openDb();
+    const r = validateInstrumentInput({ location: " 倉庫 " }, { partial: true }, db);
+    assert.deepEqual(r, { ok: true, value: { location: "倉庫" } });
+  });
+});
+
+describe("createInstrument / updateInstrument", () => {
+  it("creates and updates only the given fields", () => {
+    const db = openDb();
+    const created = createInstrument(
+      { ...VALID, model: "", location: "", note: "", status: "in_use", importance: "A" },
+      db,
+    );
+    assert.equal(getInstrument(created.id, db)?.managementNo, "MI-0100");
+    const updated = updateInstrument(created.id, { status: "calibrating" }, db);
+    assert.equal(updated?.status, "calibrating");
+    assert.equal(updated?.name, "抵抗計");
+    assert.equal(updateInstrument(9999, { status: "in_use" }, db), undefined);
+  });
+});
+
+describe("importance", () => {
+  it("defaults existing instruments to B and filters by importance", () => {
+    const db = openDb();
+    assert.ok(listInstruments({}, db).every((i) => i.importance === "B"));
+    const first = listInstruments({}, db)[0];
+    updateInstrument(first.id, { importance: "A" }, db);
+    assert.deepEqual(listInstruments({ importance: "A" }, db).map((i) => i.id), [first.id]);
+  });
+
+  it("accepts only A, B and C", () => {
+    const db = openDb();
+    assert.deepEqual(validateInstrumentInput({ importance: "A" }, { partial: true }, db), { ok: true, value: { importance: "A" } });
+    for (const v of ["D", "a", 1, null]) assert.equal(validateInstrumentInput({ importance: v }, { partial: true }, db).ok, false);
+  });
+});
diff --git a/tests/loans.test.ts b/tests/loans.test.ts
new file mode 100644
index 0000000..d96697e
--- /dev/null
+++ b/tests/loans.test.ts
@@ -0,0 +1,53 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { getInstrument, listInstruments } from "../src/lib/instruments.ts";
+import { currentLoan, lendInstrument, listOverdueLoans, returnLoan, validateLoanInput } from "../src/lib/loans.ts";
+
+const byNo = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+
+describe("lendInstrument / returnLoan", () => {
+  it("marks the instrument on loan and back in use", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    const r = lendInstrument(inst.id, { borrowerId: "yamamoto", dueOn: "2026-11-20" }, db, new Date("2026-11-10T01:00:00Z"));
+    assert.equal(r.ok, true);
+    assert.equal(getInstrument(inst.id, db)?.status, "on_loan");
+    assert.equal(currentLoan(inst.id, db)?.borrowerId, "yamamoto");
+    if (!r.ok) return;
+    assert.equal(returnLoan(inst.id, r.loan.id, db)?.id, r.loan.id);
+    assert.equal(getInstrument(inst.id, db)?.status, "in_use");
+    assert.equal(returnLoan(inst.id, r.loan.id, db), undefined);
+  });
+
+  it("refuses instruments that are not in use", () => {
+    const db = openDb();
+    for (const no of ["MI-0002", "MI-0005", "MI-0007"]) {
+      assert.deepEqual(lendInstrument(byNo(db, no).id, { borrowerId: "sato", dueOn: "2026-11-20" }, db), {
+        ok: false,
+        reason: "not_available",
+      });
+    }
+    assert.deepEqual(lendInstrument(9999, { borrowerId: "sato", dueOn: "2026-11-20" }, db), { ok: false, reason: "not_found" });
+  });
+});
+
+describe("validateLoanInput", () => {
+  it("requires an active borrower and a real date", () => {
+    const db = openDb();
+    assert.equal(validateLoanInput({ borrowerId: "sato", dueOn: "2026-11-20" }, db).ok, true);
+    assert.equal(validateLoanInput({ borrowerId: "inoue", dueOn: "2026-11-20" }, db).ok, false);
+    assert.equal(validateLoanInput({ borrowerId: "sato", dueOn: "2026-11-31" }, db).ok, false);
+  });
+});
+
+describe("listOverdueLoans", () => {
+  it("lists unreturned loans whose due date is before today", () => {
+    const db = openDb();
+    assert.deepEqual(listOverdueLoans("2026-11-13", db), []);
+    assert.deepEqual(
+      listOverdueLoans("2026-11-14", db).map((l) => l.managementNo),
+      ["MI-0002"],
+    );
+  });
+});
diff --git a/tests/notify-client.test.ts b/tests/notify-client.test.ts
new file mode 100644
index 0000000..0283b97
--- /dev/null
+++ b/tests/notify-client.test.ts
@@ -0,0 +1,131 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { backoffDelay, createNotifyClient, notifyClientFromEnv, parseRetryAfter } from "../src/lib/notify-client.ts";
+
+type Call = { url: string; headers: Record<string, string>; body: unknown };
+
+function fakeFetch(responses: (Response | Error)[]) {
+  const calls: Call[] = [];
+  const fn = (async (url: string, init: RequestInit) => {
+    calls.push({ url, headers: init.headers as Record<string, string>, body: JSON.parse(String(init.body)) });
+    const r = responses.shift() ?? new Response("{}", { status: 202 });
+    if (r instanceof Error) throw r;
+    return r;
+  }) as unknown as typeof fetch;
+  return { fn, calls };
+}
+
+function client(responses: (Response | Error)[], sleeps: number[] = []) {
+  const f = fakeFetch(responses);
+  const c = createNotifyClient({
+    url: "http://notify.test",
+    token: "t0ken",
+    fetch: f.fn,
+    sleep: async (ms) => {
+      sleeps.push(ms);
+    },
+    random: () => 1,
+    maxAttempts: 4,
+    baseDelayMs: 100,
+    maxDelayMs: 1000,
+  });
+  return { c, calls: f.calls, sleeps };
+}
+
+const N = { recipient: "sato", title: "t", body: "b" };
+const json = (status: number, body: unknown = {}, headers: Record<string, string> = {}) =>
+  new Response(JSON.stringify(body), { status, headers });
+
+describe("notify client", () => {
+  it("sends with the token, the idempotency key and the calibration category", async () => {
+    const { c, calls } = client([json(202, { id: "ntf_1" })]);
+    assert.deepEqual(await c.send(N, "k1"), { ok: true, id: "ntf_1", attempts: 1 });
+    assert.equal(calls[0].url, "http://notify.test/v1/notifications");
+    assert.equal(calls[0].headers.authorization, "Bearer t0ken");
+    assert.equal(calls[0].headers["idempotency-key"], "k1-1");
+    assert.deepEqual(calls[0].body, { category: "calibration", ...N });
+  });
+
+  it("retries 503 and network errors with growing delays", async () => {
+    const sleeps: number[] = [];
+    const { c, calls } = client([json(503), new TypeError("fetch failed"), json(202, { id: "x" })], sleeps);
+    const r = await c.send(N, "k2");
+    assert.equal(r.ok, true);
+    assert.deepEqual(sleeps, [100, 200]);
+    assert.deepEqual(
+      calls.map((x) => x.headers["idempotency-key"]),
+      ["k2-1", "k2-2", "k2-3"],
+    );
+  });
+
+  it("waits at least Retry-After on 429", async () => {
+    const sleeps: number[] = [];
+    const { c } = client([json(429, {}, { "retry-after": "3" }), json(202)], sleeps);
+    assert.equal((await c.send(N, "k3")).ok, true);
+    assert.deepEqual(sleeps, [3000]);
+  });
+
+  it("does not retry 400", async () => {
+    const { c, calls } = client([json(400, { error: "unknown recipient" })]);
+    const r = await c.send(N, "k4");
+    assert.equal(r.ok, false);
+    assert.equal(calls.length, 1);
+    if (!r.ok) assert.equal(r.retryable, false);
+  });
+
+  it("gives up after the maximum number of attempts", async () => {
+    const sleeps: number[] = [];
+    const { c, calls } = client([json(503), json(503), json(503), json(503), json(202)], sleeps);
+    const r = await c.send(N, "k5");
+    assert.equal(r.ok, false);
+    assert.equal(calls.length, 4);
+    assert.deepEqual(sleeps, [100, 200, 400]);
+  });
+});
+
+describe("backoff helpers", () => {
+  it("caps the delay and applies jitter", () => {
+    assert.equal(backoffDelay(10, 100, 1000, () => 1), 1000);
+    assert.equal(backoffDelay(1, 100, 1000, () => 0), 50);
+  });
+
+  it("parses Retry-After seconds and dates", () => {
+    assert.equal(parseRetryAfter("5"), 5000);
+    assert.equal(parseRetryAfter("Wed, 01 Jan 2031 00:00:10 GMT", Date.parse("2031-01-01T00:00:00Z")), 10000);
+    assert.equal(parseRetryAfter(null), undefined);
+    assert.equal(parseRetryAfter("soon"), undefined);
+  });
+});
+
+describe("notify client details", () => {
+  it("retries 500 but not other 4xx, and reports the status when the body is empty", async () => {
+    const r1 = client([new Response("", { status: 500 }), json(202)]);
+    assert.equal((await r1.c.send(N, "k6")).ok, true);
+    const r2 = client([new Response("", { status: 404 })]);
+    const res = await r2.c.send(N, "k7");
+    assert.deepEqual(res, { ok: false, retryable: false, status: 404, error: "HTTP 404", attempts: 1 });
+  });
+
+  it("reports timeouts and network errors as retryable", async () => {
+    const timeout = Object.assign(new Error("t"), { name: "TimeoutError" });
+    const { c } = client([timeout, timeout, timeout, timeout]);
+    const r = await c.send(N, "k8");
+    assert.equal(r.ok, false);
+    if (!r.ok) {
+      assert.equal(r.retryable, true);
+      assert.match(r.error, /タイムアウト/);
+      assert.equal(r.attempts, 4);
+    }
+  });
+
+  it("parses padded seconds and past dates", () => {
+    assert.equal(parseRetryAfter(" 7 "), 7000);
+    assert.equal(parseRetryAfter("Wed, 01 Jan 2031 00:00:00 GMT", Date.parse("2031-01-01T00:00:10Z")), 0);
+  });
+
+  it("is created from the documented environment variables only when both are set", () => {
+    assert.equal(notifyClientFromEnv({ NOTIFY_API_URL: "http://x" } as unknown as NodeJS.ProcessEnv), undefined);
+    assert.equal(notifyClientFromEnv({ NOTIFY_API_TOKEN: "t" } as unknown as NodeJS.ProcessEnv), undefined);
+    assert.ok(notifyClientFromEnv({ NOTIFY_API_URL: "http://x", NOTIFY_API_TOKEN: "t" } as unknown as NodeJS.ProcessEnv));
+  });
+});
