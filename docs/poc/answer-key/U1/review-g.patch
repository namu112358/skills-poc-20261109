   return rows.map(toTask);
 }
 
+/** 担当者のタスクを期限の近い順（同じ期限なら ID 順）に返す。 */
+export function listTasksByAssignee(assignee: string, db: Db = getDb()): Task[] {
+  const rows = db
+    .prepare("SELECT id, title, status, assignee, due_date FROM tasks WHERE assignee = ? ORDER BY due_date, id")
+    .all(assignee) as TaskRow[];
+  return rows.map(toTask);
+}
+
 export function getTask(id: number, db: Db = getDb()): Task | undefined {
   const row = db.prepare("SELECT id, title, status, assignee, due_date FROM tasks WHERE id = ?").get(id) as
     | TaskRow
