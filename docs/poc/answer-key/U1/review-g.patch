+"use client";
+import { useState, type FormEvent } from "react";
+import type { Task, TaskStatus } from "@/lib/tasks";
+
+const TASK_STATUSES: TaskStatus[] = ["todo", "in_progress", "done"];
+const STATUS_LABELS: Record<TaskStatus, string> = { todo: "未着手", in_progress: "進行中", done: "完了" };
+
+const ADD_FAILED = "追加できませんでした。時間をおいてもう一度お試しください。";
+
+function sortTasks(tasks: Task[]): Task[] {
+  return [...tasks].sort((a, b) => a.dueDate.localeCompare(b.dueDate) || a.id - b.id);
+}
+
+export function MyTasks({ initialTasks, userId }: { initialTasks: Task[]; userId: string }) {
+  const [tasks, setTasks] = useState(initialTasks);
+  const [title, setTitle] = useState("");
+  const [dueDate, setDueDate] = useState("");
+  const [submitting, setSubmitting] = useState(false);
+  const [addErrors, setAddErrors] = useState<string[]>([]);
+  const [statusErrors, setStatusErrors] = useState<Record<number, boolean>>({});
+  const [justAdded, setJustAdded] = useState<number | null>(null);
+
+  async function add(e: FormEvent) {
+    e.preventDefault();
+    if (submitting) return;
+    setSubmitting(true);
+    try {
+      const res = await fetch("/api/tasks", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ title, dueDate, assignee: userId, status: "todo" }),
+      });
+      const data = await res.json().catch(() => undefined);
+      if (res.status === 400) setAddErrors(data?.details ?? [data?.error ?? ADD_FAILED]);
+      else if (!res.ok || !data?.task) setAddErrors([ADD_FAILED]);
+      else {
+        setTasks((t) => sortTasks([...t, data.task]));
+        setTitle("");
+        setDueDate("");
+        setAddErrors([]);
+        setJustAdded(data.task.id);
+      }
+    } catch {
+      setAddErrors([ADD_FAILED]);
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  async function changeStatus(task: Task, status: TaskStatus) {
+    const previous = task.status;
+    setTasks((ts) => ts.map((t) => (t.id === task.id ? { ...t, status } : t)));
+    let ok = false;
+    try {
+      const res = await fetch(`/api/tasks/${task.id}`, {
+        method: "PATCH",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ status }),
+      });
+      ok = res.ok;
+    } catch {
+      ok = false;
+    }
+    setStatusErrors((s) => ({ ...s, [task.id]: !ok }));
+    if (!ok) setTasks((ts) => ts.map((t) => (t.id === task.id ? { ...t, status: previous } : t)));
+  }
+
+  return (
+    <>
+      <style>{`
+        @keyframes my-task-added { from { background: #fff3b0; transform: translateX(-12px); } to { background: transparent; transform: none; } }
+        .my-task-added { animation: my-task-added 900ms ease-out; }
+      `}</style>
+      {tasks.length === 0 ? (
+        <p>担当しているタスクはありません。</p>
+      ) : (
+        <ul style={{ listStyle: "none", padding: 0, display: "grid", gap: 8 }}>
+          {tasks.map((task) => (
+            <li
+              key={task.id}
+              data-testid="my-task"
+              className={task.id === justAdded ? "my-task-added" : undefined}
+              onClick={() => (window.location.href = `/tasks/${task.id}`)}
+              style={{ border: "1px solid #ccc", borderRadius: 6, padding: 8, cursor: "pointer" }}
+            >
+              <span style={{ overflowWrap: "anywhere", fontWeight: 600 }}>{task.title}</span>
+              <div style={{ display: "flex", flexWrap: "wrap", gap: 12, marginTop: 4 }} onClick={(e) => e.stopPropagation()}>
+                <label>
+                  ステータス{" "}
+                  <select value={task.status} onChange={(e) => changeStatus(task, e.target.value as TaskStatus)}>
+                    {TASK_STATUSES.map((s) => (
+                      <option key={s} value={s}>
+                        {STATUS_LABELS[s]}
+                      </option>
+                    ))}
+                  </select>
+                </label>
+                <span>期限 {task.dueDate}</span>
+              </div>
+              {statusErrors[task.id] && <p role="alert">ステータスを変更できませんでした。</p>}
+            </li>
+          ))}
+        </ul>
+      )}
+      <h3>タスクを追加</h3>
+      <form aria-label="タスクの追加" onSubmit={add} style={{ display: "grid", gap: 8, maxWidth: 480 }}>
+        <label>
+          タイトル <input name="title" value={title} onChange={(e) => setTitle(e.target.value)} style={{ width: "100%", boxSizing: "border-box" }} />
+        </label>
+        <label>
+          期限 <input name="dueDate" type="date" value={dueDate} onChange={(e) => setDueDate(e.target.value)} />
+        </label>
+        <button type="submit" disabled={submitting} tabIndex={1}>
+          {submitting ? "追加中…" : "追加する"}
+        </button>
+        {addErrors.length > 0 && (
+          <div role="alert">
+            {addErrors.map((m) => (
+              <p key={m}>{m}</p>
+            ))}
+          </div>
+        )}
+      </form>
+    </>
+  );
+}
