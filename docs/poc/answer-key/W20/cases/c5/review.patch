diff --git a/src/lib/calibration-import/csv.ts b/src/lib/calibration-import/csv.ts
new file mode 100644
index 0000000..bbf3184
--- /dev/null
+++ b/src/lib/calibration-import/csv.ts
@@ -0,0 +1,55 @@
+// 校正機関の CSV に共通の読み取り: 文字コード、行の分割、管理番号の整形。
+
+/**
+ * バイト列を文字列にする。BOM つきなら UTF-8。BOM がなければ、まず UTF-8 として厳密に読み、
+ * 読めなければ Shift_JIS とする（東日本計測サービスは Shift_JIS、西日本校正センターは BOM なしの UTF-8）。
+ */
+export function decodeCsv(data: Uint8Array): string {
+  if (data.length >= 3 && data[0] === 0xef && data[1] === 0xbb && data[2] === 0xbf) {
+    return new TextDecoder("utf-8").decode(data.subarray(3));
+  }
+  try {
+    return new TextDecoder("utf-8", { fatal: true }).decode(data);
+  } catch {
+    return new TextDecoder("shift_jis").decode(data);
+  }
+}
+
+export function splitLines(text: string): string[] {
+  return text.split(/\r\n|\n|\r/);
+}
+
+/** カンマ区切りの 1 行を値に分ける（"..." の中のカンマと "" に対応）。各値の前後の空白は取り除く。 */
+export function splitCsvLine(raw: string): string[] {
+  const cols: string[] = [];
+  let cur = "";
+  let quoted = false;
+  for (let i = 0; i < raw.length; i++) {
+    const ch = raw[i];
+    if (quoted) {
+      if (ch === '"') {
+        if (raw[i + 1] === '"') {
+          cur += '"';
+          i++;
+        } else quoted = false;
+      } else cur += ch;
+    } else if (ch === '"') quoted = true;
+    else if (ch === ",") {
+      cols.push(cur);
+      cur = "";
+    } else cur += ch;
+  }
+  cols.push(cur);
+  return cols.map((c) => c.trim());
+}
+
+/** pattern に合う全角の文字を半角にする（全角の英数字・ハイフンは半角より 0xFEE0 大きい）。 */
+export function toHalfWidth(value: string, pattern: RegExp): string {
+  return value.replace(pattern, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0));
+}
+
+/** 管理番号を台帳の表記（MI-0001）にそろえる。全角・小文字・ハイフンなしを吸収する。 */
+export function normalizeManagementNo(value: string): string {
+  const no = toHalfWidth(value, /[Ａ-Ｚａ-ｚ０-９－]/g).toUpperCase();
+  return /^[A-Z]{2}\d{4}$/.test(no) ? no.substring(0, 2) + "-" + no.substring(2) : no;
+}
diff --git a/src/lib/calibration-import/higashi-nihon.ts b/src/lib/calibration-import/higashi-nihon.ts
new file mode 100644
index 0000000..aec2458
--- /dev/null
+++ b/src/lib/calibration-import/higashi-nihon.ts
@@ -0,0 +1,93 @@
+// 東日本計測サービスの CSV（2024-03 から。形式は docs/calibration-import.md）の読み取り。
+// 列: 管理番号,機器名,校正日,判定,証明書番号,備考。日付は西暦・和暦、判定は合格/不合格など。
+import type { CalibrationResult } from "../calibrations.ts";
+import { normalizeManagementNo, splitCsvLine, toHalfWidth } from "./csv.ts";
+import type { LineOutcome, ParsedFile } from "./types.ts";
+
+export const HIGASHI_NIHON = "東日本計測サービス";
+
+const toHalfWidthDigits = (s: string) => toHalfWidth(s, /[０-９]/g);
+
+/** 西暦（2026-01-20, 2026/1/20）か和暦（R8.1.20, 令和8年1月20日）の日付を YYYY-MM-DD にする。読めなければ undefined。 */
+function parseDate(d: string): string | undefined {
+  let y = 0;
+  let m = 0;
+  let day = 0;
+  let mt = d.match(/^(\d{4})[/\-.](\d{1,2})[/\-.](\d{1,2})$/);
+  if (mt) {
+    y = +mt[1];
+    m = +mt[2];
+    day = +mt[3];
+  } else {
+    mt = d.match(/^(R|H|令和|平成)\s*(\d{1,2}|元)[.年](\d{1,2})[.月](\d{1,2})日?$/);
+    if (mt) {
+      const eraYear = mt[2] === "元" ? 1 : +mt[2];
+      const reiwa = mt[1] === "R" || mt[1] === "令和";
+      y = (reiwa ? 2018 : 1988) + eraYear;
+      m = +mt[3];
+      day = +mt[4];
+      // 平成は 2019-04 まで、令和は 2019-05 から
+      if (!reiwa && (y > 2019 || (y === 2019 && m > 4))) return undefined;
+      if (reiwa && y === 2019 && m < 5) return undefined;
+    }
+  }
+  const dt = new Date(Date.UTC(y, m - 1, day));
+  if (!y || dt.getUTCFullYear() !== y || dt.getUTCMonth() !== m - 1 || dt.getUTCDate() !== day) return undefined;
+  return `${y}-${String(m).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
+}
+
+const PASS_WORDS = ["合格", "○", "〇", "OK", "良"];
+const FAIL_WORDS = ["不合格", "×", "NG", "否"];
+
+export function parseHigashiNihon(lines: string[]): ParsedFile {
+  const outcomes: LineOutcome[] = [];
+  const parsed: ParsedFile = { agency: HIGASHI_NIHON, outcomes };
+  let header: string[] | null = null;
+  for (let n = 0; n < lines.length; n++) {
+    const line = n + 1;
+    const raw = lines[n];
+    if (raw.trim() === "") continue;
+    const cols = splitCsvLine(raw);
+    if (header === null) {
+      if (!cols.includes("管理番号")) {
+        outcomes.push({ line, kind: "error", message: "CSV の形式が違います（1 行目に「管理番号」の列がありません）" });
+        return parsed;
+      }
+      header = cols;
+      continue;
+    }
+    const get = (name: string) => {
+      const i = header!.indexOf(name);
+      return i >= 0 && i < cols.length ? cols[i] : "";
+    };
+    const rawNo = get("管理番号");
+    if (rawNo === "" || rawNo.charAt(0) === "#" || rawNo.charAt(0) === "＃" || rawNo === "合計") continue;
+    const rawDate = toHalfWidthDigits(get("校正日"));
+    const calibratedOn = parseDate(rawDate);
+    if (calibratedOn === undefined) {
+      outcomes.push({ line, kind: "error", message: `校正日が正しくありません: ${rawDate}` });
+      continue;
+    }
+    const verdict = get("判定");
+    let result: CalibrationResult;
+    if (PASS_WORDS.includes(verdict)) result = "pass";
+    else if (FAIL_WORDS.includes(verdict)) result = "fail";
+    else if (verdict === "保留") {
+      outcomes.push({ line, kind: "skipped", reason: "判定が保留" });
+      continue;
+    } else {
+      outcomes.push({ line, kind: "error", message: `判定が読めません: ${verdict}` });
+      continue;
+    }
+    if (get("備考").includes("参考")) {
+      outcomes.push({ line, kind: "skipped", reason: "参考校正" });
+      continue;
+    }
+    outcomes.push({
+      line,
+      kind: "row",
+      row: { managementNo: normalizeManagementNo(rawNo), calibratedOn, result, certificateNo: get("証明書番号") },
+    });
+  }
+  return parsed;
+}
diff --git a/src/lib/calibration-import/index.ts b/src/lib/calibration-import/index.ts
new file mode 100644
index 0000000..8608c19
--- /dev/null
+++ b/src/lib/calibration-import/index.ts
@@ -0,0 +1,99 @@
+// 校正結果 CSV の取込。外部の校正機関から届く CSV を、校正記録として台帳に登録する（品質保証部が月初に行う）。
+// 形式は最初の空でない行で見分ける（「#」で始まれば西日本校正センター、そうでなければ東日本計測サービス）。
+// 機関ごとの読み取りは higashi-nihon.ts / nishinihon.ts、台帳への登録（照合・重複の確認・記録）はこのファイルに 1 つだけ置く。
+import { getDb, type Db } from "../db/index.ts";
+import { recordCalibration } from "../calibrations.ts";
+import { logger } from "../logger.ts";
+import { decodeCsv, splitLines } from "./csv.ts";
+import { parseHigashiNihon } from "./higashi-nihon.ts";
+import { parseNishinihon } from "./nishinihon.ts";
+import type { ParsedFile } from "./types.ts";
+
+export type ImportResult = {
+  imported: number;
+  skipped: { line: number; reason: string }[];
+  errors: { line: number; message: string }[];
+  /** ファイル全体を取り込まなかったときの理由。あるときは API が 400 を返す。 */
+  fileError?: string;
+};
+
+function parse(lines: string[]): ParsedFile {
+  const first = lines.find((l) => l.trim() !== "");
+  return first !== undefined && first.trim().startsWith("#") ? parseNishinihon(lines) : parseHigashiNihon(lines);
+}
+
+export function importCalibrationCsv(data: Uint8Array, recordedBy: string, db: Db = getDb(), now: Date = new Date()): ImportResult {
+  const res: ImportResult = { imported: 0, skipped: [], errors: [] };
+  const parsed = parse(splitLines(decodeCsv(data)));
+  if (parsed.fileError !== undefined) {
+    res.fileError = parsed.fileError;
+    logger.warn("calibration.import_rejected", { agency: parsed.agency, reason: parsed.fileError });
+    return res;
+  }
+
+  const seen = new Set<string>();
+  for (const outcome of parsed.outcomes) {
+    if (outcome.kind === "error") {
+      res.errors.push({ line: outcome.line, message: outcome.message });
+      continue;
+    }
+    if (outcome.kind === "skipped") {
+      res.skipped.push({ line: outcome.line, reason: outcome.reason });
+      continue;
+    }
+    const { row } = outcome;
+    const key = `${row.managementNo}|${row.calibratedOn}`;
+    if (seen.has(key)) {
+      res.skipped.push({ line: outcome.line, reason: "同じファイルの中で重複" });
+      continue;
+    }
+    seen.add(key);
+    const inst = db.prepare("SELECT id FROM instruments WHERE management_no = ?").get(row.managementNo) as { id: number } | undefined;
+    if (!inst) {
+      res.errors.push({ line: outcome.line, message: `管理番号が台帳にありません: ${row.managementNo}` });
+      continue;
+    }
+    const dup = db
+      .prepare("SELECT 1 FROM calibration_records WHERE instrument_id = ? AND calibrated_on = ? AND certificate_no = ?")
+      .get(inst.id, row.calibratedOn, row.certificateNo);
+    if (dup) {
+      res.skipped.push({ line: outcome.line, reason: "取込済み" });
+      continue;
+    }
+    recordCalibration(
+      inst.id,
+      { calibratedOn: row.calibratedOn, result: row.result, agency: parsed.agency, certificateNo: row.certificateNo },
+      recordedBy,
+      db,
+      now,
+      { noteAddendum: row.conditionalNote },
+    );
+    if (row.conditionalNote !== undefined) {
+      logger.warn("calibration.conditional", {
+        instrumentId: inst.id,
+        managementNo: row.managementNo,
+        calibratedOn: row.calibratedOn,
+        certificateNo: row.certificateNo,
+      });
+    }
+    res.imported++;
+  }
+  logger.info("calibration.imported", {
+    agency: parsed.agency,
+    imported: res.imported,
+    skipped: res.skipped.length,
+    errors: res.errors.length,
+  });
+  return res;
+}
+
+/**
+ * 取込の結果が、ファイル全体を受け付けない（API は 400）ものならその理由を返す。受け付けるなら undefined。
+ * 東日本の CSV は、1 行目の見出しが読めなかったとき（誤りが 1 件だけで 1 行目、登録も読み飛ばしもなし）。
+ */
+export function importRejection(result: ImportResult): string | undefined {
+  if (result.fileError !== undefined) return result.fileError;
+  const [only] = result.errors;
+  if (result.imported === 0 && result.errors.length === 1 && only.line === 1 && result.skipped.length === 0) return only.message;
+  return undefined;
+}
diff --git a/src/lib/calibration-import/nishinihon.ts b/src/lib/calibration-import/nishinihon.ts
new file mode 100644
index 0000000..65003eb
--- /dev/null
+++ b/src/lib/calibration-import/nishinihon.ts
@@ -0,0 +1,82 @@
+// 西日本校正センターの CSV（2026-12 から。仕様は docs/agencies/nishinihon-csv-spec.md 第 2.1 版）の読み取り。
+// 1 行目は「#」で始まる案内、2 行目は見出し、最終行は「END,<データの行数>」。
+// 判定は PASS（合格）・FAIL（不合格）・COND（条件付き合格。合格として登録し、備考に経緯を残す）。
+// 有効期限（先方推奨の次回校正日）は使わない。次回の校正は台帳の校正周期で決める。
+import { isValidDate } from "../dates.ts";
+import { normalizeManagementNo, splitCsvLine } from "./csv.ts";
+import type { LineOutcome, ParsedFile } from "./types.ts";
+
+export const NISHINIHON = "西日本校正センター";
+
+const REQUIRED_COLUMNS = ["機器番号", "校正実施日", "判定結果", "成績書番号", "コメント"] as const;
+
+/** 条件付き合格の経緯として計測器の備考に書き足す文。 */
+function conditionalNote(calibratedOn: string, comment: string): string {
+  return `条件付き合格（${calibratedOn}）` + (comment === "" ? "" : `: ${comment}`);
+}
+
+export function parseNishinihon(lines: string[]): ParsedFile {
+  const outcomes: LineOutcome[] = [];
+  const reject = (fileError: string): ParsedFile => ({ agency: NISHINIHON, outcomes: [], fileError });
+
+  // 1 行目の案内（#）を読み飛ばし、次の空でない行を見出しにする
+  const nonBlank = lines.map((raw, n) => ({ raw, line: n + 1 })).filter((l) => l.raw.trim() !== "");
+  const headerLine = nonBlank[1];
+  if (headerLine === undefined) return reject("CSV の形式が違います（見出しの行がありません）");
+  const header = splitCsvLine(headerLine.raw);
+  const missing = REQUIRED_COLUMNS.filter((name) => !header.includes(name));
+  if (missing.length > 0) {
+    return reject(`CSV の形式が違います（見出しに「${missing.join("」「")}」の列がありません）`);
+  }
+  const col = (cols: string[], name: (typeof REQUIRED_COLUMNS)[number]) => cols[header.indexOf(name)] ?? "";
+
+  let dataRows = 0;
+  let declared: number | undefined;
+  for (const { raw, line } of nonBlank.slice(2)) {
+    const cols = splitCsvLine(raw);
+    if (declared !== undefined) {
+      return reject(`最終行の「END」の後ろに行があります（${line} 行目）。ファイルが正しいか先方に確認してください`);
+    }
+    if (cols[0] === "END") {
+      declared = /^\d+$/.test(cols[1] ?? "") ? Number(cols[1]) : NaN;
+      continue;
+    }
+    dataRows++;
+
+    const rawNo = col(cols, "機器番号");
+    if (rawNo === "") {
+      outcomes.push({ line, kind: "error", message: "機器番号が空です" });
+      continue;
+    }
+    const calibratedOn = col(cols, "校正実施日");
+    if (!isValidDate(calibratedOn)) {
+      outcomes.push({ line, kind: "error", message: `校正実施日が正しくありません: ${calibratedOn}` });
+      continue;
+    }
+    const verdict = col(cols, "判定結果");
+    if (verdict !== "PASS" && verdict !== "FAIL" && verdict !== "COND") {
+      outcomes.push({ line, kind: "error", message: `判定結果が読めません: ${verdict}` });
+      continue;
+    }
+    outcomes.push({
+      line,
+      kind: "row",
+      row: {
+        managementNo: normalizeManagementNo(rawNo),
+        calibratedOn,
+        result: verdict === "FAIL" ? "fail" : "pass",
+        certificateNo: col(cols, "成績書番号"),
+        ...(verdict === "COND" ? { conditionalNote: conditionalNote(calibratedOn, col(cols, "コメント")) } : {}),
+      },
+    });
+  }
+
+  if (declared === undefined) {
+    return reject("最終行の「END」がありません。ファイルが途中で切れている可能性があるため、1 件も取り込んでいません。先方に再送を依頼してください");
+  }
+  if (declared !== dataRows) {
+    const shown = Number.isNaN(declared) ? "数値ではありません" : `${declared} 件`;
+    return reject(`「END」の件数（${shown}）と実際のデータの行数（${dataRows} 件）が合いません。1 件も取り込んでいません。先方に再送を依頼してください`);
+  }
+  return { agency: NISHINIHON, outcomes };
+}
