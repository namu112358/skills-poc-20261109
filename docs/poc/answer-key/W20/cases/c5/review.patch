+const csv = (...rows: string[]) => [COMMENT_LINE, HEADER, ...rows].join("\n") + "\n";
+const run = (db: ReturnType<typeof openDb>, text: string) => importCalibrationCsv(new TextEncoder().encode(text), "sato", db, NOW);
