+++ b/src/lib/calibration-import/types.ts
@@ -0,0 +1,25 @@
+// 校正結果 CSV の取込で、機関ごとの読み取り（解析）と台帳への登録の間で受け渡す型。
+import type { CalibrationResult } from "../calibrations.ts";
+
+/** 台帳に登録する 1 行（解析済み）。 */
+export type ParsedRow = {
+  managementNo: string; // 整形済み（例: MI-0001）
+  calibratedOn: string; // YYYY-MM-DD
+  result: CalibrationResult;
+  certificateNo: string;
+  /** 条件付き合格のとき、計測器の備考の末尾に書き足す文。 */
+  conditionalNote?: string;
+};
+
+/** CSV の 1 行の読み取り結果。line は 1 始まりの行番号。 */
+export type LineOutcome =
+  | { line: number; kind: "row"; row: ParsedRow }
+  | { line: number; kind: "skipped"; reason: string }
+  | { line: number; kind: "error"; message: string };
+
+export type ParsedFile = {
