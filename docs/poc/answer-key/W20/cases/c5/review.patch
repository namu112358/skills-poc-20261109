+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { importCalibrationCsv } from "../src/lib/calibration-import/index.ts";
+import { listCalibrations } from "../src/lib/calibrations.ts";
+import { openDb } from "../src/lib/db/index.ts";
+import { listInstruments } from "../src/lib/instruments.ts";
+
+const HEADER = "管理番号,機器名,校正日,判定,証明書番号,備考";
+const bom = [0xef, 0xbb, 0xbf];
+const utf8Bom = (text: string) => new Uint8Array([...bom, ...new TextEncoder().encode(text)]);
+const byNo = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+// Node に Shift_JIS のエンコーダーが無いため、見出しと判定の語だけバイト列で書く（確認は上のテストの TextDecoder）。
+const SJIS = {
+  管理番号: [0x8a, 0xc7, 0x97, 0x9d, 0x94, 0xd4, 0x8d, 0x86],
+  校正日: [0x8d, 0x5a, 0x90, 0xb3, 0x93, 0xfa],
+  判定: [0x94, 0xbb, 0x92, 0xe8],
+  証明書番号: [0x8f, 0xd8, 0x96, 0xbe, 0x8f, 0x91, 0x94, 0xd4, 0x8d, 0x86],
+  備考: [0x94, 0xf5, 0x8d, 0x6c],
+  合格: [0x8d, 0x87, 0x8a, 0x69],
+  不合格: [0x95, 0x73, 0x8d, 0x87, 0x8a, 0x69],
+};
+const ascii = (s: string) => [...new TextEncoder().encode(s)];
+function shiftJisFile(): Uint8Array {
+  const comma = ascii(",");
+  const row = (...cols: number[][]) => cols.flatMap((c, i) => (i === 0 ? c : [...comma, ...c]));
+  const crlf = ascii("\r\n");
+  return new Uint8Array([
+    ...row(SJIS.管理番号, ascii("x"),SJIS.校正日, SJIS.判定, SJIS.証明書番号, SJIS.備考),
+    ...crlf,
+    ...row(ascii("MI-0001"), ascii("x"), ascii("R8.11.04"), SJIS.合格, ascii("EJ-26-00200"), []),
+    ...crlf,
+    ...row(ascii("MI-0007"), ascii("x"), ascii("R8.11.05"), SJIS.不合格, ascii("EJ-26-00201"), []),
+    ...crlf,
+  ]);
+}
+const NOW = new Date("2026-11-10T00:00:00.000Z");
+const run = (db: ReturnType<typeof openDb>, text: string) => importCalibrationCsv(utf8Bom(text), "sato", db, NOW);
+
+describe("importCalibrationCsv (東日本計測サービスの形式)", () => {
+  it("reads a Shift_JIS file, registers a pass and suspends the instrument on a fail", () => {
+    const db = openDb();
+    const data = shiftJisFile();
+    assert.equal(new TextDecoder("shift_jis").decode(data).split("\r\n")[0], "管理番号,x,校正日,判定,証明書番号,備考");
+    const res = importCalibrationCsv(data, "sato", db, NOW);
+    assert.equal(res.imported, 2);
+    assert.deepEqual(res.errors, []);
+    assert.equal(byNo(db, "MI-0001").lastCalibratedOn, "2026-11-04");
+    assert.equal(byNo(db, "MI-0007").status, "suspended");
+    const rec = listCalibrations(byNo(db, "MI-0001").id, db)[0];
+    assert.equal(rec.agency, "東日本計測サービス");
+    assert.equal(rec.certificateNo, "EJ-26-00200");
+  });
+
+  it("reads a UTF-8 file with a BOM", () => {
+    const db = openDb();
+    const res = run(db, `${HEADER}\r\nMI-0003,トルクレンチ,2026-11-04,合格,EJ-1,\r\n`);
+    assert.equal(res.imported, 1);
+    assert.equal(byNo(db, "MI-0003").lastCalibratedOn, "2026-11-04");
+  });
+
+  it("converts Japanese-era dates", () => {
+    const db = openDb();
+    run(db, `${HEADER}\nMI-0003,x,R8.11.04,合格,EJ-1,\n`);
+    assert.equal(byNo(db, "MI-0003").lastCalibratedOn, "2026-11-04");
+  });
+
+  it("skips 保留 rows and 参考 calibrations, reporting the reason", () => {
+    const db = openDb();
+    const res = run(db, `${HEADER}\nMI-0003,x,2026-11-04,保留,EJ-1,\nMI-0004,x,2026-11-04,合格,EJ-2,参考校正\n`);
+    assert.equal(res.imported, 0);
+    assert.deepEqual(res.skipped, [
+      { line: 2, reason: "判定が保留" },
+      { line: 3, reason: "参考校正" },
+    ]);
+  });
+
+  it("reports bad verdicts, bad dates and unknown instruments by line and keeps importing the rest", () => {
+    const db = openDb();
+    const res = run(
+      db,
+      `${HEADER}\nMI-0003,x,2026-11-04,??,EJ-1,\nMI-0004,x,2026-02-30,合格,EJ-2,\nMI-0099,x,2026-11-04,合格,EJ-3,\nMI-0010,x,2026-11-05,合格,EJ-4,\n`,
+    );
+    assert.equal(res.imported, 1);
+    assert.deepEqual(
+      res.errors.map((e) => e.line),
+      [2, 3, 4],
+    );
+    assert.match(res.errors[2].message, /台帳にありません/);
+  });
+
+  it("skips a repeated instrument and date inside one file", () => {
+    const db = openDb();
+    const res = run(db, `${HEADER}\nMI-0003,x,2026-11-04,合格,EJ-1,\nMI-0003,x,2026-11-04,合格,EJ-2,\n`);
+    assert.equal(res.imported, 1);
+    assert.deepEqual(res.skipped, [{ line: 3, reason: "同じファイルの中で重複" }]);
+  });
+
+  it("skips rows that were already imported", () => {
+    const db = openDb();
+    const csv = `${HEADER}\nMI-0003,x,2026-11-04,合格,EJ-1,\n`;
+    run(db, csv);
+    const res = run(db, csv);
+    assert.equal(res.imported, 0);
+    assert.deepEqual(res.skipped, [{ line: 2, reason: "取込済み" }]);
+    assert.equal(listCalibrations(byNo(db, "MI-0003").id, db).length, 1);
+  });
+
+  it("normalizes management numbers written without a hyphen or in full-width characters", () => {
+    const db = openDb();
+    const res = run(db, `${HEADER}\nｍｉ０００３,x,2026-11-04,合格,EJ-1,\n`);
+    assert.equal(res.imported, 1);
+  });
+
+  it("rejects a file whose first line has no 管理番号 column", () => {
+    const res = run(openDb(), "a,b,c\n1,2,3\n");
+    assert.equal(res.imported, 0);
+    assert.equal(res.errors.length, 1);
+    assert.equal(res.errors[0].line, 1);
+  });
+
+  it("keeps commas inside quotes as part of the value", () => {
+    const db = openDb();
+    const res = run(db, `${HEADER}\nMI-0003,x,2026-11-04,合格,"EJ-1,a",\n`);
+    assert.equal(res.imported, 1);
+    assert.equal(listCalibrations(byNo(db, "MI-0003").id, db)[0].certificateNo, "EJ-1,a");
+  });
+
+  it("reads UTF-8 without a BOM as UTF-8 instead of Shift_JIS", () => {
+    const db = openDb();
+    const res = importCalibrationCsv(new TextEncoder().encode(`${HEADER}\nMI-0003,トルクレンチ,2026-11-04,合格,EJ-1,\n`), "sato", db, NOW);
+    assert.equal(res.imported, 1);
+    assert.deepEqual(res.errors, []);
+  });
+
+  it("imports nothing from a header-only file", () => {
+    const res = run(openDb(), `${HEADER}\n`);
+    assert.equal(res.imported, 0);
+    assert.deepEqual(res.errors, []);
+  });
+});
