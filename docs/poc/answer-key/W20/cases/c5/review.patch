+    const res = run(db, "管理番号,機器名,校正日,判定,証明書番号,備考\nMI-0001,x,2026-11-06,合格,EJ-1,\n");
+    assert.equal(res.imported, 1);
+    const agencies = listCalibrations(byNo(db, "MI-0001").id, db).map((r) => r.agency);
+    assert.ok(agencies.includes("東日本計測サービス"));
+  });
+});
+
+describe("importRejection", () => {
+  it("returns the reason for a rejected file", () => {
+    assert.equal(importRejection({ imported: 0, skipped: [], errors: [], fileError: "件数が合いません" }), "件数が合いません");
+  });
+
+  it("keeps the rule that an unreadable first line of a Higashi-Nihon file is rejected", () => {
+    const res = run(openDb(), "a,b,c\n1,2,3\n");
+    assert.match(importRejection(res) ?? "", /1 行目に「管理番号」の列がありません/);
+  });
+
+  it("does not reject a normal result, even one with row errors", () => {
+    assert.equal(importRejection({ imported: 1, skipped: [], errors: [{ line: 3, message: "x" }] }), undefined);
+    assert.equal(importRejection({ imported: 0, skipped: [{ line: 2, reason: "取込済み" }], errors: [] }), undefined);
