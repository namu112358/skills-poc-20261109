diff --git a/tests/comments.test.ts b/tests/comments.test.ts
new file mode 100644
index 0000000..b4e17ef
--- /dev/null
+++ b/tests/comments.test.ts
@@ -0,0 +1,30 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { addComment, deleteComment, listComments, renderBody, updateComment, validateCommentBody } from "../src/lib/comments.ts";
+import { openDb } from "../src/lib/db/index.ts";
+
+describe("comments", () => {
+  it("adds, lists, updates and deletes comments", () => {
+    const db = openDb();
+    const a = addComment(1, "sato", "最初", db, new Date("2026-11-11T01:00:00Z"));
+    const b = addComment(1, "suzuki", "次", db, new Date("2026-11-11T02:00:00Z"));
+    assert.deepEqual(listComments(1, db).map((c) => c.id), [a.id, b.id]);
+    assert.equal(updateComment(a.id, "直した", db)?.body, "直した");
+    assert.equal(deleteComment(b.id, db), true);
+    assert.deepEqual(listComments(1, db).map((c) => c.body), ["直した"]);
+  });
+
+  it("validates the body", () => {
+    assert.equal(validateCommentBody("  ").ok, false);
+    assert.equal(validateCommentBody("x".repeat(2001)).ok, false);
+    assert.deepEqual(validateCommentBody(" よろしく "), { ok: true, value: "よろしく" });
+  });
+
+  it("escapes HTML and renders links and line breaks", () => {
+    assert.equal(renderBody("<b>注意</b>\n次へ"), "&lt;b&gt;注意&lt;/b&gt;<br>次へ");
+    assert.equal(
+      renderBody("[手順書](https://example.com/doc)"),
+      '<a href="https://example.com/doc" rel="noopener noreferrer">手順書</a>',
+    );
+  });
+});
