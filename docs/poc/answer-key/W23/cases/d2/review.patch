+// PATCH /api/comments/:commentId — コメントを編集する / DELETE — コメントを削除する。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { deleteComment, getComment, updateComment, validateCommentBody } from "@/lib/comments";
+import { parseTaskId } from "@/lib/tasks";
+
+type Context = { params: Promise<{ commentId: string }> };
+
+export async function PATCH(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).commentId);
+  const comment = id === undefined ? undefined : getComment(id);
+  if (!comment) return jsonError(404, "コメントが見つかりません");
+  const body = (await readJson(request)) as { body?: unknown } | undefined;
+  const result = validateCommentBody(body?.body);
+  if (!result.ok) return jsonError(400, "入力内容に誤りがあります", [result.error]);
+  return NextResponse.json({ comment: updateComment(comment.id, result.value) });
+}
+
+export async function DELETE(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).commentId);
+  const comment = id === undefined ? undefined : getComment(id);
+  if (!comment) return jsonError(404, "コメントが見つかりません");
+  if (comment.authorId !== user.id) return jsonError(403, "自分のコメントだけを削除できます");
+  deleteComment(comment.id);
+  return new NextResponse(null, { status: 204 });
+}
