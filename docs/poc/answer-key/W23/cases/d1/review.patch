+// 計算結果の短時間のキャッシュ（同じ画面の再読み込みで DB を何度も読まないようにする）。
+type Entry<T> = { value: T; expiresAt: number };
+
+const store = new Map<string, Entry<unknown>>();
+
+/** key の値が ttlMs 以内に計算済みならそれを返し、無ければ compute を呼んで保存する。 */
+export function cached<T>(key: string, ttlMs: number, compute: () => T, now: number = Date.now()): T {
+  const hit = store.get(key) as Entry<T> | undefined;
+  if (hit && hit.expiresAt > now) return hit.value;
+  const value = compute();
+  store.set(key, { value, expiresAt: now + ttlMs });
+  return value;
+}
+
+/** すべてのキャッシュを消す（テスト用）。 */
+export function clearCache(): void {
+  store.clear();
+}
diff --git a/src/lib/dashboard.ts b/src/lib/dashboard.ts
new file mode 100644
index 0000000..1a5e0b3
--- /dev/null
+++ b/src/lib/dashboard.ts
@@ -0,0 +1,75 @@
+// ダッシュボード: ログインした人の担当タスクの状況をまとめる。
+import { getDb, type Db } from "./db/index.ts";
+import { cached } from "./cache.ts";
+import { STATUS_LABELS, TASK_STATUSES, type Task, type TaskStatus } from "./tasks.ts";
+import { todayJst, weekRange } from "./week.ts";
+
+export type StatusCount = { status: TaskStatus; label: string; count: number };
+
+export type Dashboard = {
+  userId: string;
+  counts: StatusCount[];
+  overdue: Task[];
+  dueThisWeek: Task[];
+  completionRate: number; // 0〜100（%）
+  generatedAt: string;
+};
+
+const CACHE_TTL_MS = 30_000;
+
+type Row = { id: number; title: string; status: TaskStatus; assignee: string; due_date: string };
+
+function toTask(r: Row): Task {
+  return { id: r.id, title: r.title, status: r.status, assignee: r.assignee, dueDate: r.due_date };
+}
+
+/** 担当者のタスクをすべて読む。 */
+export function listAssignedTasks(userId: string, db: Db = getDb()): Task[] {
+  const rows = db
+    .prepare(`SELECT id, title, status, assignee, due_date FROM tasks WHERE assignee = '${userId}' ORDER BY due_date, id`)
+    .all() as Row[];
+  return rows.map(toTask);
+}
+
+/** ステータスごとの件数。表示は「完了」が先頭になるよう、ステータスの並びを逆にする。 */
+export function countByStatus(tasks: readonly Task[]): StatusCount[] {
+  const order = TASK_STATUSES as TaskStatus[];
+  return order.reverse().map((status) => ({
+    status,
+    label: STATUS_LABELS[status],
+    count: tasks.filter((t) => t.status === status).length,
+  }));
+}
+
+/** 完了率（%。小数点以下を四捨五入）。 */
+export function completionRate(tasks: readonly Task[]): number {
+  const done = tasks.filter((t) => t.status === "done").length;
+  return Math.round((done / tasks.length) * 100);
+}
+
+/** 期限切れ（期限が今日より前で、未完了）のタスク。期限の古い順。 */
+export function overdueTasks(tasks: readonly Task[], now: Date = new Date()): Task[] {
+  const today = todayJst(now);
+  return tasks.filter((t) => t.status !== "done" && t.dueDate < today);
+}
+
+/** 今週（月〜日）が期限の未完了のタスク。 */
+export function dueThisWeek(tasks: readonly Task[], now: Date = new Date()): Task[] {
+  const { start, end } = weekRange(now);
+  return tasks.filter((t) => t.status !== "done" && t.dueDate >= start && t.dueDate <= end);
+}
+
+/** ダッシュボードの内容を作る（30 秒キャッシュする）。 */
+export function buildDashboard(userId: string, db: Db = getDb(), now: Date = new Date()): Dashboard {
+  return cached("dashboard", CACHE_TTL_MS, () => {
+    const tasks = listAssignedTasks(userId, db);
+    return {
+      userId,
+      counts: countByStatus(tasks),
+      overdue: overdueTasks(tasks, now),
+      dueThisWeek: dueThisWeek(tasks, now),
+      completionRate: completionRate(tasks),
+      generatedAt: now.toISOString(),
+    };
+  }, now.getTime());
+}
