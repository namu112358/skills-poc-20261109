{
  "create": {
    "method": "POST",
    "path": "/api/instruments/{instrumentId}/reservations",
    "body": {
      "startOn": "{start}",
      "endOn": "{end}"
    },
    "id": "reservation.id"
  },
  "list": {
    "method": "GET",
    "path": "/api/instruments/{instrumentId}/reservations",
    "items": "reservations"
  },
  "cancel": {
    "method": "POST",
    "path": "/api/instruments/{instrumentId}/reservations/{reservationId}/cancel"
  },
  "approve": {
    "method": "POST",
    "path": "/api/instruments/{instrumentId}/reservations/{reservationId}/approve"
  },
  "reject": {
    "method": "POST",
    "path": "/api/instruments/{instrumentId}/reservations/{reservationId}/reject",
    "body": {
      "reason": "検証のため"
    }
  },
  "fields": {
    "id": "id",
    "status": [
      "status",
      "approvedAt",
      "rejectedAt"
    ],
    "start": "startOn",
    "end": "endOn",
    "user": "userId"
  },
  "status": {
    "pending": [
      "\"active\"|null|null"
    ],
    "approved": [
      "\"active\"|@notnull|null"
    ],
    "rejected": [
      "\"cancelled\"|*|@notnull"
    ],
    "cancelled": [
      "\"cancelled\"|*|null"
    ],
    "consumed": [
      "\"consumed\"|*|*"
    ]
  },
  "jobs": []
}