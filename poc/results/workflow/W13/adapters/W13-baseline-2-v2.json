{
  "create": {
    "method": "POST",
    "path": "/api/instruments/{instrumentId}/reservations",
    "body": {
      "startOn": "{start}",
      "endOn": "{end}"
    },
    "id": "reservation.id"
  },
  "list": {
    "method": "GET",
    "path": "/api/instruments/{instrumentId}/reservations",
    "items": "reservations"
  },
  "cancel": {
    "method": "POST",
    "path": "/api/instruments/{instrumentId}/reservations/{reservationId}/cancel"
  },
  "approve": {
    "method": "POST",
    "path": "/api/instruments/{instrumentId}/reservations/{reservationId}/approve"
  },
  "reject": {
    "method": "POST",
    "path": "/api/instruments/{instrumentId}/reservations/{reservationId}/reject",
    "body": {
      "reason": "検証のため"
    }
  },
  "fields": {
    "id": "id",
    "status": "status",
    "start": "startOn",
    "end": "endOn",
    "user": "reserverId"
  },
  "status": {
    "pending": [
      "pending"
    ],
    "approved": [
      "active"
    ],
    "rejected": [
      "rejected"
    ],
    "cancelled": [
      "cancelled"
    ],
    "consumed": [
      "fulfilled"
    ]
  },
  "jobs": []
}