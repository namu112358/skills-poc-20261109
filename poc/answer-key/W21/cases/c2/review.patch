+export type TaskSort = "id" | "due";
+
+export const TASK_SORTS: readonly TaskSort[] = ["id", "due"];
+
+export const SORT_LABELS: Record<TaskSort, string> = {
+  id: "登録順",
+  due: "期限の近い順",
+};
+
+export function isTaskSort(value: unknown): value is TaskSort {
+  return typeof value === "string" && (TASK_SORTS as readonly string[]).includes(value);
+}
+
+// 並べ替えの列。利用者の値は isTaskSort で検証した後、この表を引いた結果だけを SQL に入れる。
+const SORT_COLUMNS: Record<TaskSort, string> = {
+  id: "id",
+  due: "due_date",
+};
+
 export type TaskFilter = {
   status?: TaskStatus;
+  sort?: TaskSort;
 };
 
 type TaskRow = { id: number; title: string; status: TaskStatus; assignee: string; due_date: string };
@@ -34,7 +54,9 @@ function toTask(row: TaskRow): Task {
 
 export function listTasks(filter: TaskFilter = {}, db: Db = getDb()): Task[] {
   const rows = db
-    .prepare("SELECT id, title, status, assignee, due_date FROM tasks WHERE (:status IS NULL OR status = :status) ORDER BY id")
+    .prepare(
+      `SELECT id, title, status, assignee, due_date FROM tasks WHERE (:status IS NULL OR status = :status) ORDER BY ${SORT_COLUMNS[filter.sort ?? "id"]}, id`,
+    )
     .all({ status: filter.status ?? null }) as TaskRow[];
   return rows.map(toTask);
 }
