+describe("listTasks の並べ替え", () => {
+  it("sorts by id by default", () => {
+    const ids = listTasks({}, openDb()).map((t) => t.id);
+    assert.deepEqual(ids, [1, 2, 3, 4, 5, 6, 7]);
+  });
+
+  it("sorts by due date, then by id", () => {
+    const db = openDb();
+    createTask({ title: "同じ期限", status: "todo", assignee: "sato", dueDate: "2026-11-12" }, db);
+    const tasks = listTasks({ sort: "due" }, db);
+    const keys = tasks.map((t) => `${t.dueDate}#${String(t.id).padStart(3, "0")}`);
+    assert.deepEqual(keys, [...keys].sort());
+    assert.deepEqual(
+      tasks.filter((t) => t.dueDate === "2026-11-12").map((t) => t.id),
+      [2, 8],
+    );
+  });
