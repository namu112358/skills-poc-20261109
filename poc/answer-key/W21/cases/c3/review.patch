+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { toCsv } from "../src/lib/export.ts";
+import { listTasks, type Task } from "../src/lib/tasks.ts";
+
+describe("toCsv", () => {
+  it("writes a header and one line per task", () => {
+    const lines = toCsv(listTasks({}, openDb())).split("\r\n");
+    assert.equal(lines[0], '"ID","タイトル","ステータス","担当者","期限"');
+    assert.equal(lines.length, 9); // 見出し + 7 件 + 末尾の空文字列
+    assert.equal(lines[1], '"1","要件定義書のレビュー","完了","sato","2026-11-02"');
+  });
+
+  it("escapes quotes and commas in titles", () => {
+    const task: Task = { id: 9, title: "週次 定例の準備", status: "todo", assignee: "sato", dueDate: "2026-12-01" };
+    assert.equal(toCsv([task]).split("\r\n")[1], '"9","週次 定例の準備","未着手","sato","2026-12-01"');
+  });
+
+  it("returns only the header for an empty list", () => {
+    assert.equal(toCsv([]), '"ID","タイトル","ステータス","担当者","期限"\r\n');
+  });
+});
