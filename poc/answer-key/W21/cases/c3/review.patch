+// タスクの CSV 出力。
+import { STATUS_LABELS, type Task } from "./tasks.ts";
+
+/** Excel で開いたときに文字化けしないよう、先頭に付ける UTF-8 の BOM。 */
+export const CSV_BOM = "﻿";
+
+const HEADER = ["ID", "タイトル", "ステータス", "担当者", "期限"];
+
+/** 1 つの値を CSV の項目にする。カンマや改行を含んでもよいよう、必ずダブルクォートで囲む。 */
+function field(value: string | number): string {
+  return `"${value}"`;
+}
+
+/** タスクの一覧を CSV（CRLF 区切り）にする。先頭は見出しの行。 */
+export function toCsv(tasks: readonly Task[]): string {
+  const rows = [HEADER, ...tasks.map((t) => [t.id, t.title, STATUS_LABELS[t.status], t.assignee, t.dueDate])];
+  return rows.map((row) => row.map(field).join(",")).join("\r\n") + "\r\n";
+}
