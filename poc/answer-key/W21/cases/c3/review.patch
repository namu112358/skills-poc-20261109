+// GET /api/tasks/export?status=… — タスク一覧を CSV でダウンロードする。ログインが必要。
+import { NextResponse } from "next/server";
+import { requireApiUser } from "@/lib/api";
+import { CSV_BOM, toCsv } from "@/lib/export";
+import { listTasks, type TaskStatus } from "@/lib/tasks";
+
+export async function GET(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const status = new URL(request.url).searchParams.get("status") as TaskStatus | null;
+  const csv = toCsv(listTasks({ status: status ?? undefined }));
+  return new NextResponse(CSV_BOM + csv, {
+    headers: {
+      "Content-Type": "text/csv; charset=utf-8",
+      "Content-Disposition": 'attachment; filename="tasks.csv"',
+    },
+  });
+}
