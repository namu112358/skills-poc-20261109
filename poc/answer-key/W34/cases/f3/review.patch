+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { extendDueDate, extendTask, validateExtendInput } from "../src/lib/extend.ts";
+
+describe("extendDueDate", () => {
+  it("adds days to the due date", () => {
+    const expected = extendDueDate("2026-11-20", 5);
+    assert.equal(extendDueDate("2026-11-20", 5), expected);
+  });
+
+  it("works across months", () => {
+    assert.doesNotThrow(() => extendDueDate("2026-11-30", 3));
+  });
+});
+
+describe("validateExtendInput", () => {
+  it("accepts a valid number of days", () => {
+    assert.ok(validateExtendInput({ days: 7 }).ok);
+  });
+});
+
+describe("extendTask", () => {
+  it("extends a task", () => {
+    const db = openDb();
+    const result = extendTask(4, 3, db);
+    assert.ok(result.ok);
+  });
+
+  it("handles a completed task", () => {
+    const db = openDb();
+    assert.doesNotThrow(() => extendTask(1, 3, db));
+  });
+});
