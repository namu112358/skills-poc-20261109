+// タスクの期限の延長。
+import { getDb, type Db } from "./db/index.ts";
+import { getTask, updateTask, type Task } from "./tasks.ts";
+
+export const MAX_EXTEND_DAYS = 30;
+
+/** 期限（YYYY-MM-DD）に days 日を足した日付。月・年をまたいでもよい。 */
+export function extendDueDate(dueDate: string, days: number): string {
+  const d = new Date(`${dueDate}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + days);
+  return d.toISOString().slice(0, 10);
+}
+
+/** 延長の日数を検証する。1〜30 の整数だけを受け付ける。 */
+export function validateExtendInput(body: unknown): { ok: true; days: number } | { ok: false; error: string } {
+  const days = (body as { days?: unknown } | null)?.days;
+  if (typeof days !== "number" || !Number.isInteger(days) || days < 1 || days > MAX_EXTEND_DAYS) {
+    return { ok: false, error: `延長の日数は 1〜${MAX_EXTEND_DAYS} の整数で指定してください` };
+  }
+  return { ok: true, days };
+}
+
+export type ExtendResult = { ok: true; task: Task } | { ok: false; reason: "not_found" | "done" };
+
+/** タスクの期限を延長する。完了したタスクは延長できない。 */
+export function extendTask(id: number, days: number, db: Db = getDb()): ExtendResult {
+  const task = getTask(id, db);
+  if (!task) return { ok: false, reason: "not_found" };
+  if (task.status === "done") return { ok: false, reason: "done" };
+  const updated = updateTask(id, { dueDate: extendDueDate(task.dueDate, days) }, db)!;
+  return { ok: true, task: updated };
+}
