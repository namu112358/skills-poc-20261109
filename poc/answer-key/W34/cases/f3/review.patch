+// POST /api/tasks/:id/extend — タスクの期限を { days } 日延長する。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { extendTask, validateExtendInput } from "@/lib/extend";
+import { parseTaskId } from "@/lib/tasks";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function POST(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).id);
+  if (id === undefined) return jsonError(404, "タスクが見つかりません");
+  const input = validateExtendInput(await readJson(request));
+  if (!input.ok) return jsonError(400, "入力内容に誤りがあります", [input.error]);
+  const result = extendTask(id, input.days);
+  if (!result.ok) {
+    return result.reason === "done"
+      ? jsonError(400, "完了したタスクの期限は延長できません")
+      : jsonError(404, "タスクが見つかりません");
+  }
+  return NextResponse.json({ task: result.task });
+}
