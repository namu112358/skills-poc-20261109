+// 優先度の属性の定義。
+import { attributeRegistry, type AttributeDefinition } from "./registry.ts";
+
+export type TaskPriority = "high" | "medium" | "low";
+
+export const priorityAttribute: AttributeDefinition<TaskPriority> = {
+  key: "priority",
+  column: "priority",
+  values: ["high", "medium", "low"],
+  labels: { high: "高", medium: "中", low: "低" },
+  defaultValue: "medium",
+};
+
+attributeRegistry.register(priorityAttribute);
diff --git a/src/lib/attributes/registry.ts b/src/lib/attributes/registry.ts
new file mode 100644
index 0000000..398c19c
--- /dev/null
+++ b/src/lib/attributes/registry.ts
@@ -0,0 +1,53 @@
+// タスクの属性（列）の定義を登録する仕組み。属性を足すときは、定義を作って registry に登録するだけでよい。
+export type AttributeDefinition<T extends string = string> = {
+  /** API・画面での項目名 */
+  key: string;
+  /** DB の列名 */
+  column: string;
+  /** 取りうる値（並び順は表示順） */
+  values: readonly T[];
+  /** 表示名 */
+  labels: Record<T, string>;
+  /** 未指定のときの値 */
+  defaultValue: T;
+};
+
+export class AttributeRegistry {
+  private readonly definitions = new Map<string, AttributeDefinition>();
+
+  register<T extends string>(definition: AttributeDefinition<T>): void {
+    if (this.definitions.has(definition.key)) throw new Error(`属性 ${definition.key} は登録済みです`);
+    this.definitions.set(definition.key, definition as unknown as AttributeDefinition);
+  }
+
+  get(key: string): AttributeDefinition | undefined {
+    return this.definitions.get(key);
+  }
+
+  all(): AttributeDefinition[] {
+    return [...this.definitions.values()];
+  }
+
+  /** 値が属性の取りうる値かを確かめる。 */
+  isValid(key: string, value: unknown): boolean {
+    const d = this.get(key);
+    return d !== undefined && typeof value === "string" && (d.values as readonly string[]).includes(value);
+  }
+
+  /** 絞り込みの条件（登録した属性のうち、filter に値があるもの）を SQL の断片とパラメータにする。 */
+  whereClause(filter: Record<string, string | undefined>): { sql: string; params: Record<string, string> } {
+    const parts: string[] = [];
+    const params: Record<string, string> = {};
+    for (const d of this.all()) {
+      const v = filter[d.key];
+      if (v !== undefined && this.isValid(d.key, v)) {
+        parts.push(`${d.column} = :attr_${d.key}`);
+        params[`attr_${d.key}`] = v;
+      }
+    }
+    return { sql: parts.length > 0 ? ` AND ${parts.join(" AND ")}` : "", params };
+  }
+}
+
+/** アプリ全体で 1 つの登録先。 */
+export const attributeRegistry = new AttributeRegistry();
