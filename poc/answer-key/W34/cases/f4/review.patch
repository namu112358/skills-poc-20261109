+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { createTask } from "../src/lib/tasks.ts";
+import { parseSoonDays, summarizeTasks } from "../src/lib/summary.ts";
+
+describe("summarizeTasks", () => {
+  it("summarizes the seed data", () => {
+    const summary = summarizeTasks(openDb());
+    assert.deepEqual(summary, { total: 7, overdue: 0, dueToday: 1, dueSoon: 2 });
+  });
+
+  it("counts a new task that is due today", () => {
+    const db = openDb();
+    const today = new Date().toISOString().slice(0, 10);
+    createTask({ title: "今日まで", status: "todo", assignee: "sato", dueDate: today }, db);
+    assert.equal(summarizeTasks(db).total, 8);
+    assert.equal(summarizeTasks(db).dueToday, 2);
+  });
+
+  it("is fast enough for the dashboard", () => {
+    const start = Date.now();
+    summarizeTasks(openDb());
+    assert.ok(Date.now() - start < 300, "300 ms 以内に集計できること");
+  });
+});
+
+describe("parseSoonDays", () => {
+  it("uses 7 days by default and validates the value", () => {
+    assert.deepEqual(parseSoonDays(null), { ok: true, days: 7 });
+    assert.deepEqual(parseSoonDays("0"), { ok: false, error: "日数は 1〜90 の整数で指定してください" });
+    assert.deepEqual(parseSoonDays("abc"), { ok: false, error: "日数は 1〜90 の整数で指定してください" });
+  });
+});
