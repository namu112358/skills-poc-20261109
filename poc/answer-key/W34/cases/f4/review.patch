+// GET /api/tasks/summary?soonDays=… — タスクの集計。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, requireApiUser } from "@/lib/api";
+import { parseSoonDays, summarizeTasks } from "@/lib/summary";
+
+export async function GET(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const soon = parseSoonDays(new URL(request.url).searchParams.get("soonDays"));
+  if (!soon.ok) return jsonError(400, "入力内容に誤りがあります", [soon.error]);
+  return NextResponse.json({ summary: summarizeTasks(undefined, new Date(), soon.days) });
+}
