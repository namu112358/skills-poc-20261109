+// タスクの集計（合計・期限切れ・今日が期限・期限が近い）。
+import { getDb, type Db } from "./db/index.ts";
+
+export type TaskSummary = { total: number; overdue: number; dueToday: number; dueSoon: number };
+
+const JST_DATE = new Intl.DateTimeFormat("sv-SE", { timeZone: "Asia/Tokyo" });
+
+function addDays(date: string, days: number): string {
+  const d = new Date(`${date}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + days);
+  return d.toISOString().slice(0, 10);
+}
+
+/** 期限が近いとみなす日数の既定値。 */
+export const DEFAULT_SOON_DAYS = 7;
+
+/** soonDays（1〜90 の整数）を検証する。未指定なら既定値。 */
+export function parseSoonDays(value: string | null): { ok: true; days: number } | { ok: false; error: string } {
+  if (value === null) return { ok: true, days: DEFAULT_SOON_DAYS };
+  if (!/^[1-9][0-9]?$/.test(value) || Number(value) > 90) {
+    return { ok: false, error: "日数は 1〜90 の整数で指定してください" };
+  }
+  return { ok: true, days: Number(value) };
+}
+
+/**
+ * 未完了のタスクを、日本時間の今日を基準に数える。dueSoon は明日から soonDays 日後まで。
+ * now を渡すと、その時刻を「今」として数える（テスト用）。
+ */
+export function summarizeTasks(db: Db = getDb(), now: Date = new Date(), soonDays: number = DEFAULT_SOON_DAYS): TaskSummary {
+  const today = JST_DATE.format(now);
+  const row = db
+    .prepare(
+      `SELECT
+         COUNT(*) AS total,
+         SUM(CASE WHEN status != 'done' AND due_date < :today THEN 1 ELSE 0 END) AS overdue,
+         SUM(CASE WHEN status != 'done' AND due_date = :today THEN 1 ELSE 0 END) AS dueToday,
+         SUM(CASE WHEN status != 'done' AND due_date > :today AND due_date <= :soon THEN 1 ELSE 0 END) AS dueSoon
+       FROM tasks`,
+    )
+    .get({ today, soon: addDays(today, soonDays) }) as Record<keyof TaskSummary, number | null>;
+  return { total: row.total ?? 0, overdue: row.overdue ?? 0, dueToday: row.dueToday ?? 0, dueSoon: row.dueSoon ?? 0 };
+}
