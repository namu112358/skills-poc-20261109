+// GET /api/teams — 所属するチームの一覧 / POST /api/teams — チームを作る（作った人が管理者）。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { createTeam, listTeams, validateTeamName } from "@/lib/teams";
+
+export async function GET() {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  return NextResponse.json({ teams: listTeams(user.id) });
+}
+
+export async function POST(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const result = validateTeamName(await readJson(request));
+  if (!result.ok) return jsonError(400, "入力内容に誤りがあります", result.errors);
+  return NextResponse.json({ team: createTeam(result.value, user.id) }, { status: 201 });
+}
