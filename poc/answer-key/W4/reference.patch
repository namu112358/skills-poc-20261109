@@ -0,0 +1,43 @@
+import { notFound } from "next/navigation";
+import { requireUser } from "@/lib/session";
+import { parseTaskId } from "@/lib/tasks";
+import { ROLE_LABELS, getTeam, listMembers } from "@/lib/teams";
+import { listUsers } from "@/lib/users";
+import { AddMemberForm, RemoveMemberButton } from "./members.tsx";
+
+type Props = {
+  params: Promise<{ id: string }>;
+};
+
+export default async function TeamDetailPage({ params }: Props) {
+  const user = await requireUser();
+  const id = parseTaskId((await params).id);
+  const team = id === undefined ? undefined : getTeam(id, user.id);
+  if (!team) notFound();
+  const members = listMembers(team.id);
+  const isAdmin = team.role === "admin";
+  // クライアント部品に渡すので、DB の行（null プロトタイプ）をふつうのオブジェクトにする
+  const candidates = isAdmin
+    ? listUsers()
+        .filter((u) => !members.some((m) => m.userId === u.id))
+        .map((u) => ({ id: u.id, name: u.name }))
+    : [];
+
+  return (
+    <main>
+      <p>
+        <a href="/teams">← チーム一覧へ戻る</a>
+      </p>
+      <h1>{team.name}</h1>
+      <h2>メンバー</h2>
+      <ul>
+        {members.map((m) => (
+          <li key={m.userId} data-testid="member">
+            {m.name}（{ROLE_LABELS[m.role]}）{isAdmin && <RemoveMemberButton teamId={team.id} userId={m.userId} />}
+          </li>
+        ))}
+      </ul>
+      {isAdmin && <AddMemberForm teamId={team.id} candidates={candidates} />}
+    </main>
+  );
+}
