@@ -0,0 +1,21 @@
+// DELETE /api/teams/:id/members/:userId — メンバーをチームから外す（管理者だけ）。最後の管理者は外せない。
+import { NextResponse } from "next/server";
+import { jsonError, requireApiUser } from "@/lib/api";
+import { parseTaskId } from "@/lib/tasks";
+import { getRole, removeMember } from "@/lib/teams";
+
+type Context = { params: Promise<{ id: string; userId: string }> };
+
+export async function DELETE(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const p = await params;
+  const id = parseTaskId(p.id);
+  const role = id === undefined ? undefined : getRole(id, user.id);
+  if (id === undefined || !role) return jsonError(404, "チームが見つかりません");
+  if (role !== "admin") return jsonError(403, "メンバーを外せるのは管理者だけです");
+  const result = removeMember(id, p.userId);
+  if (result === "not_found") return jsonError(404, "メンバーが見つかりません");
+  if (result === "last_admin") return jsonError(400, "最後の管理者は外せません");
+  return new NextResponse(null, { status: 204 });
+}
