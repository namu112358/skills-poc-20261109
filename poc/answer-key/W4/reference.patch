+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { MIGRATIONS } from "../src/lib/db/migrations.ts";
+import { migrate } from "../src/lib/db/index.ts";
+import { DatabaseSync } from "node:sqlite";
+import { getTask, listTasks } from "../src/lib/tasks.ts";
+import {
+  addMember,
+  createTeam,
+  getRole,
+  listMembers,
+  listTeams,
+  removeMember,
+  validateMemberInput,
+  validateTeamName,
+} from "../src/lib/teams.ts";
+
+describe("listTeams / listMembers", () => {
+  it("returns the user's teams with their role", () => {
+    const db = openDb();
+    assert.deepEqual(listTeams("suzuki", db), [
+      { id: 1, name: "開発チーム", role: "member" },
+      { id: 2, name: "デザインチーム", role: "admin" },
+    ]);
+    assert.deepEqual(listMembers(1, db), [
+      { userId: "sato", name: "佐藤", role: "admin" },
+      { userId: "suzuki", name: "鈴木", role: "member" },
+    ]);
+  });
+});
+
+describe("createTeam", () => {
+  it("makes the creator an admin", () => {
+    const db = openDb();
+    const team = createTeam("新チーム", "tanaka", db);
+    assert.deepEqual(team, { id: 3, name: "新チーム", role: "admin" });
+    assert.equal(getRole(3, "tanaka", db), "admin");
+  });
+
+  it("validates the name", () => {
+    assert.deepEqual(validateTeamName({ name: "  営業  " }), { ok: true, value: "営業" });
+    for (const name of ["", "   ", "あ".repeat(51), 1, undefined]) assert.equal(validateTeamName({ name }).ok, false);
+    assert.equal(validateTeamName("x").ok, false);
+  });
+});
+
+describe("addMember / removeMember", () => {
+  it("validates the input", () => {
+    const db = openDb();
+    assert.deepEqual(validateMemberInput({ userId: "tanaka" }, db), { ok: true, value: { userId: "tanaka", role: "member" } });
+    assert.equal(validateMemberInput({ userId: "nobody" }, db).ok, false);
+    assert.equal(validateMemberInput({ userId: "tanaka", role: "owner" }, db).ok, false);
+  });
+
+  it("adds a member once and gives access to the team's tasks", () => {
+    const db = openDb();
+    assert.equal(getTask(1, "tanaka", db), undefined);
+    assert.deepEqual(addMember(1, { userId: "tanaka", role: "member" }, db), { userId: "tanaka", name: "田中", role: "member" });
+    assert.equal(addMember(1, { userId: "tanaka", role: "member" }, db), "exists");
+    assert.ok(getTask(1, "tanaka", db));
+  });
+
+  it("removes a member and revokes access, but keeps the last admin", () => {
+    const db = openDb();
+    assert.equal(removeMember(2, "tanaka", db), "ok");
+    assert.equal(getTask(4, "tanaka", db), undefined); // 担当者のままでも見えなくなる
+    assert.deepEqual(listTasks("tanaka", {}, db).map((t) => t.id), [7]);
+    assert.equal(removeMember(2, "tanaka", db), "not_found");
+    assert.equal(removeMember(2, "suzuki", db), "last_admin");
+    addMember(2, { userId: "sato", role: "admin" }, db);
+    assert.equal(removeMember(2, "suzuki", db), "ok");
+  });
+});
+
+describe("migration 3", () => {
+  it("turns existing tasks into personal tasks of their assignee", () => {
+    const db = new DatabaseSync(":memory:");
+    db.exec("PRAGMA foreign_keys = ON");
+    migrate(db, MIGRATIONS.filter((m) => m.version < 3));
+    db.exec("INSERT INTO users (id, name) VALUES ('sato', '佐藤')");
+    db.exec("INSERT INTO tasks (title, status, assignee, due_date) VALUES ('既存', 'todo', 'sato', '2026-12-01')");
+    migrate(db);
+    assert.deepEqual({ ...db.prepare("SELECT team_id, owner FROM tasks").get() }, { team_id: null, owner: "sato" });
+  });
+});
