+            <a href={`/teams/${team.id}`}>{team.name}</a>（{ROLE_LABELS[team.role]}）
+          </li>
+        ))}
+      </ul>
+      {teams.length === 0 && <p>所属しているチームはありません。</p>}
+    </main>
+  );
+}
