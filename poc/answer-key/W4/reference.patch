+"use client";
+
+import { useRouter } from "next/navigation";
+import { useState, type FormEvent } from "react";
+import type { User } from "@/lib/users";
+
+async function errorMessage(res: Response): Promise<string> {
+  try {
+    const data = (await res.json()) as { error?: string; details?: string[] };
+    return [data.error, ...(data.details ?? [])].filter(Boolean).join(" ") || "操作に失敗しました";
+  } catch {
+    return "操作に失敗しました";
+  }
+}
+
+export function AddMemberForm({ teamId, candidates }: { teamId: number; candidates: User[] }) {
+  const router = useRouter();
+  const [error, setError] = useState("");
+
+  async function onSubmit(e: FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    const form = e.currentTarget;
+    const userId = new FormData(form).get("userId");
+    const res = await fetch(`/api/teams/${teamId}/members`, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ userId, role: "member" }),
+    });
+    if (!res.ok) return setError(await errorMessage(res));
+    setError("");
+    form.reset();
+    router.refresh();
+  }
+
+  return (
+    <form aria-label="メンバーの追加" onSubmit={onSubmit}>
+      <label>
+        ユーザー{" "}
+        <select name="userId" defaultValue="">
+          <option value="" disabled>
+            選択してください
+          </option>
+          {candidates.map((u) => (
+            <option key={u.id} value={u.id}>
+              {u.name}（{u.id}）
+            </option>
+          ))}
+        </select>
+      </label>{" "}
+      <button type="submit">追加する</button>
+      {error && <p role="alert">{error}</p>}
+    </form>
+  );
+}
+
+export function RemoveMemberButton({ teamId, userId }: { teamId: number; userId: string }) {
+  const router = useRouter();
+  const [error, setError] = useState("");
+
+  async function onClick() {
+    const res = await fetch(`/api/teams/${teamId}/members/${encodeURIComponent(userId)}`, { method: "DELETE" });
+    if (!res.ok) return setError(await errorMessage(res));
+    setError("");
+    router.refresh();
+  }
+
+  return (
+    <>
+      {" "}
+      <button type="button" onClick={onClick}>
+        外す
+      </button>
+      {error && <span role="alert">{error}</span>}
+    </>
+  );
+}
