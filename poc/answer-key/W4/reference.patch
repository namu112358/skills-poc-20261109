+// GET /api/teams/:id/members — メンバー一覧 / POST — メンバーを追加する（管理者だけ）。所属していないチームは 404。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { parseTaskId } from "@/lib/tasks";
+import { addMember, getRole, listMembers, validateMemberInput } from "@/lib/teams";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function GET(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).id);
+  if (id === undefined || !getRole(id, user.id)) return jsonError(404, "チームが見つかりません");
+  return NextResponse.json({ members: listMembers(id) });
+}
+
+export async function POST(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).id);
+  const role = id === undefined ? undefined : getRole(id, user.id);
+  if (id === undefined || !role) return jsonError(404, "チームが見つかりません");
+  if (role !== "admin") return jsonError(403, "メンバーを追加できるのは管理者だけです");
+  const result = validateMemberInput(await readJson(request));
+  if (!result.ok) return jsonError(400, "入力内容に誤りがあります", result.errors);
+  const member = addMember(id, result.value);
+  if (member === "exists") return jsonError(409, "既にチームに所属しています");
+  return NextResponse.json({ member }, { status: 201 });
+}
