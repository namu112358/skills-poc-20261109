diff --git a/src/lib/teams.ts b/src/lib/teams.ts
new file mode 100644
index 0000000..d9c9f2f
--- /dev/null
+++ b/src/lib/teams.ts
@@ -0,0 +1,109 @@
+import { getDb, transaction, type Db } from "./db/index.ts";
+import type { ValidationResult } from "./tasks.ts";
+
+export type TeamRole = "admin" | "member";
+
+export const TEAM_ROLES: readonly TeamRole[] = ["admin", "member"];
+
+export const ROLE_LABELS: Record<TeamRole, string> = {
+  admin: "管理者",
+  member: "メンバー",
+};
+
+export function isTeamRole(value: unknown): value is TeamRole {
+  return typeof value === "string" && (TEAM_ROLES as readonly string[]).includes(value);
+}
+
+/** 自分から見たチーム（自分の役割つき）。 */
+export type Team = { id: number; name: string; role: TeamRole };
+
+export type Member = { userId: string; name: string; role: TeamRole };
+
+/** userId が所属するチームを ID 順に返す。 */
+export function listTeams(userId: string, db: Db = getDb()): Team[] {
+  return db
+    .prepare(
+      "SELECT t.id, t.name, m.role FROM teams t JOIN team_members m ON m.team_id = t.id WHERE m.user_id = ? ORDER BY t.id",
+    )
+    .all(userId)
+    .map((r) => ({ ...r }) as Team);
+}
+
+/** userId が所属していればそのチームを返す。所属していない・存在しないなら undefined。 */
+export function getTeam(teamId: number, userId: string, db: Db = getDb()): Team | undefined {
+  const row = db
+    .prepare(
+      "SELECT t.id, t.name, m.role FROM teams t JOIN team_members m ON m.team_id = t.id WHERE t.id = ? AND m.user_id = ?",
+    )
+    .get(teamId, userId);
+  return row && ({ ...row } as Team);
+}
+
+export function getRole(teamId: number, userId: string, db: Db = getDb()): TeamRole | undefined {
+  return getTeam(teamId, userId, db)?.role;
+}
+
+export function listMembers(teamId: number, db: Db = getDb()): Member[] {
+  return db
+    .prepare(
+      "SELECT u.id AS userId, u.name, m.role FROM team_members m JOIN users u ON u.id = m.user_id WHERE m.team_id = ? ORDER BY u.id",
+    )
+    .all(teamId)
+    .map((r) => ({ ...r }) as Member);
+}
+
+export function validateTeamName(body: unknown): ValidationResult<string> {
+  const name = typeof body === "object" && body !== null && !Array.isArray(body) ? (body as Record<string, unknown>).name : undefined;
+  if (typeof name !== "string" || name.trim().length < 1 || name.trim().length > 50) {
+    return { ok: false, errors: ["チーム名は 1〜50 文字で入力してください"] };
+  }
+  return { ok: true, value: name.trim() };
+}
+
+/** チームを作り、作った人を管理者にする。 */
+export function createTeam(name: string, userId: string, db: Db = getDb()): Team {
+  return transaction(db, () => {
+    const { lastInsertRowid } = db.prepare("INSERT INTO teams (name) VALUES (?)").run(name);
+    const id = Number(lastInsertRowid);
+    db.prepare("INSERT INTO team_members (team_id, user_id, role) VALUES (?, ?, 'admin')").run(id, userId);
+    return getTeam(id, userId, db)!;
+  });
+}
+
+export type MemberInput = { userId: string; role: TeamRole };
+
+export function validateMemberInput(body: unknown, db: Db = getDb()): ValidationResult<MemberInput> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const b = body as Record<string, unknown>;
+  const errors: string[] = [];
+  const exists = typeof b.userId === "string" && db.prepare("SELECT 1 FROM users WHERE id = ?").get(b.userId) !== undefined;
+  if (!exists) errors.push("ユーザーが存在しません");
+  const role = b.role ?? "member";
+  if (!isTeamRole(role)) errors.push("役割が正しくありません");
+  return errors.length > 0 ? { ok: false, errors } : { ok: true, value: { userId: b.userId as string, role: role as TeamRole } };
+}
+
+/** メンバーを追加する。既に所属していれば "exists"。 */
+export function addMember(teamId: number, input: MemberInput, db: Db = getDb()): Member | "exists" {
+  if (getRole(teamId, input.userId, db)) return "exists";
+  db.prepare("INSERT INTO team_members (team_id, user_id, role) VALUES (?, ?, ?)").run(teamId, input.userId, input.role);
+  return listMembers(teamId, db).find((m) => m.userId === input.userId)!;
+}
+
+/** メンバーを外す。所属していなければ "not_found"、最後の管理者なら "last_admin"。 */
+export function removeMember(teamId: number, userId: string, db: Db = getDb()): "ok" | "not_found" | "last_admin" {
+  return transaction(db, () => {
+    const role = getRole(teamId, userId, db);
+    if (!role) return "not_found";
+    if (role === "admin") {
+      const { n } = db
+        .prepare("SELECT COUNT(*) AS n FROM team_members WHERE team_id = ? AND role = 'admin'")
+        .get(teamId) as { n: number };
+      if (n <= 1) return "last_admin";
+    }
+    db.prepare("DELETE FROM team_members WHERE team_id = ? AND user_id = ?").run(teamId, userId);
+    return "ok";
+  });
+}
