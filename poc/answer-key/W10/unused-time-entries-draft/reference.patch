+// GET /api/tasks/:id/time-entries — 作業時間の記録の一覧と合計 / POST — 記録する。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { getTask, parseTaskId } from "@/lib/tasks";
+import { createTimeEntry, listTimeEntries, validateTimeEntryInput } from "@/lib/time-entries";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function GET(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).id);
+  if (id === undefined || !getTask(id)) return jsonError(404, "タスクが見つかりません");
+  return NextResponse.json(listTimeEntries(id));
+}
+
+export async function POST(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).id);
+  if (id === undefined || !getTask(id)) return jsonError(404, "タスクが見つかりません");
+  const input = validateTimeEntryInput(await readJson(request));
+  if (!input.ok) return jsonError(400, "入力内容に誤りがあります", input.errors);
+  const result = createTimeEntry(id, user.id, input.value);
+  if (!result.ok) return jsonError(400, "入力内容に誤りがあります", [result.error]);
+  return NextResponse.json({ entry: result.entry }, { status: 201 });
+}
