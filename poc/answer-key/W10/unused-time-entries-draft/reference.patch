@@ -0,0 +1,119 @@
+"use client";
+// タスク詳細画面の「作業時間」欄（一覧・合計・記録フォーム・削除）。記録と削除は API を呼ぶ。
+import { useState, type FormEvent } from "react";
+import { formatMinutes } from "@/lib/time-format";
+import type { TimeEntry } from "@/lib/time-entries";
+
+type Props = {
+  taskId: number;
+  currentUserId: string;
+  today: string;
+  initialEntries: TimeEntry[];
+  initialTotal: number;
+};
+
+async function errorMessage(res: Response): Promise<string> {
+  try {
+    const body = (await res.json()) as { error?: string; details?: string[] };
+    return [body.error, ...(body.details ?? [])].filter(Boolean).join(" ") || "記録できませんでした";
+  } catch {
+    return "記録できませんでした。時間をおいてもう一度お試しください。";
+  }
+}
+
+export function TimeEntries({ taskId, currentUserId, today, initialEntries, initialTotal }: Props) {
+  const [entries, setEntries] = useState(initialEntries);
+  const [total, setTotal] = useState(initialTotal);
+  const [workDate, setWorkDate] = useState(today);
+  const [minutes, setMinutes] = useState("");
+  const [note, setNote] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [submitting, setSubmitting] = useState(false);
+
+  async function reload() {
+    const res = await fetch(`/api/tasks/${taskId}/time-entries`);
+    if (res.ok) {
+      const body = (await res.json()) as { entries: TimeEntry[]; totalMinutes: number };
+      setEntries(body.entries);
+      setTotal(body.totalMinutes);
+    }
+  }
+
+  async function onSubmit(e: FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    if (submitting) return;
+    setSubmitting(true);
+    setError(null);
+    try {
+      const res = await fetch(`/api/tasks/${taskId}/time-entries`, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ workDate, minutes: minutes.trim() === "" ? undefined : Number(minutes), note }),
+      });
+      if (!res.ok) {
+        setError(await errorMessage(res));
+        return;
+      }
+      setMinutes("");
+      setNote("");
+      await reload();
+    } catch {
+      setError("記録できませんでした。通信状態を確認してください。");
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  async function onDelete(id: number) {
+    setError(null);
+    try {
+      const res = await fetch(`/api/tasks/${taskId}/time-entries/${id}`, { method: "DELETE" });
+      if (!res.ok && res.status !== 404) {
+        setError(await errorMessage(res));
+        return;
+      }
+      await reload();
+    } catch {
+      setError("削除できませんでした。通信状態を確認してください。");
+    }
+  }
+
+  return (
+    <section>
+      <h2>作業時間</h2>
+      {entries.length === 0 ? (
+        <p>作業時間の記録はまだありません。</p>
+      ) : (
+        <ul>
+          {entries.map((entry) => (
+            <li key={entry.id} data-testid="time-entry">
+              <span>{entry.workDate}</span> <span>{entry.userName}</span> <span>{formatMinutes(entry.minutes)}</span>{" "}
+              <span>{entry.note}</span>
+              {entry.userId === currentUserId && (
+                <button type="button" onClick={() => onDelete(entry.id)}>
+                  削除
+                </button>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+      <p data-testid="time-total">合計 {formatMinutes(total)}</p>
+      <form aria-label="作業時間" onSubmit={onSubmit}>
+        <label>
+          作業日 <input type="date" name="workDate" value={workDate} max={today} onChange={(e) => setWorkDate(e.target.value)} />
+        </label>
+        <label>
+          作業時間（分） <input name="minutes" inputMode="numeric" value={minutes} onChange={(e) => setMinutes(e.target.value)} />
+        </label>
+        <label>
+          メモ <input name="note" value={note} onChange={(e) => setNote(e.target.value)} />
+        </label>
+        <button type="submit" disabled={submitting}>
+          記録する
+        </button>
+        {error && <p role="alert">{error}</p>}
+      </form>
+    </section>
+  );
+}
