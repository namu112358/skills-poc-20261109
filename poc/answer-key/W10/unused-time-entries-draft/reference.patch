+// DELETE /api/tasks/:id/time-entries/:entryId — 自分の記録を削除する。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, requireApiUser } from "@/lib/api";
+import { getTask, parseTaskId } from "@/lib/tasks";
+import { deleteTimeEntry, parseEntryId } from "@/lib/time-entries";
+
+type Context = { params: Promise<{ id: string; entryId: string }> };
+
+export async function DELETE(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const p = await params;
+  const id = parseTaskId(p.id);
+  if (id === undefined || !getTask(id)) return jsonError(404, "タスクが見つかりません");
+  const entryId = parseEntryId(p.entryId);
+  const result = entryId === undefined ? "not_found" : deleteTimeEntry(id, entryId, user.id);
+  if (result === "not_found") return jsonError(404, "記録が見つかりません");
+  if (result === "forbidden") return jsonError(403, "自分の記録だけを削除できます");
+  return new NextResponse(null, { status: 204 });
+}
