@@ -0,0 +1,9 @@
+// 作業時間の表示（画面のクライアント部品からも使うため、DB に依存しないファイルに置く）。
+
+/** 分を「1時間30分」の形にする（60 分未満は「45分」、ちょうどの時間は「2時間」）。 */
+export function formatMinutes(minutes: number): string {
+  const h = Math.floor(minutes / 60);
+  const m = minutes % 60;
+  if (h === 0) return `${m}分`;
+  return m === 0 ? `${h}時間` : `${h}時間${m}分`;
+}
diff --git a/tests/time-entries.test.ts b/tests/time-entries.test.ts
new file mode 100644
index 0000000..c00d566
--- /dev/null
+++ b/tests/time-entries.test.ts
@@ -0,0 +1,146 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import {
+  createTimeEntry,
+  deleteTimeEntry,
+  isValidDate,
+  jstToday,
+  listTimeEntries,
+  parseEntryId,
+  validateTimeEntryInput,
+} from "../src/lib/time-entries.ts";
+import { formatMinutes } from "../src/lib/time-format.ts";
+
+// 2026-11-09T15:30Z は日本時間の 2026-11-10 00:30（UTC ではまだ 11/09）
+const NOW = new Date("2026-11-09T15:30:00.000Z");
+
+describe("jstToday", () => {
+  it("returns the date in Japan time", () => {
+    assert.equal(jstToday(NOW), "2026-11-10");
+    assert.equal(jstToday(new Date("2026-11-09T14:59:59.999Z")), "2026-11-09");
+  });
+});
+
+describe("isValidDate", () => {
+  it("accepts real dates only", () => {
+    assert.equal(isValidDate("2026-02-28"), true);
+    assert.equal(isValidDate("2028-02-29"), true);
+    for (const v of ["2026-02-29", "2026-02-30", "2026-13-01", "2026-00-10", "2026/11/09", "20261109", "", 20261109]) {
+      assert.equal(isValidDate(v), false, String(v));
+    }
+  });
+});
+
+describe("formatMinutes", () => {
+  it("formats hours and minutes", () => {
+    assert.equal(formatMinutes(0), "0分");
+    assert.equal(formatMinutes(45), "45分");
+    assert.equal(formatMinutes(60), "1時間");
+    assert.equal(formatMinutes(90), "1時間30分");
+    assert.equal(formatMinutes(150), "2時間30分");
+  });
+});
+
+describe("validateTimeEntryInput", () => {
+  const ok = (body: unknown) => {
+    const r = validateTimeEntryInput(body, NOW);
+    assert.ok(r.ok, JSON.stringify(r));
+    return r.value;
+  };
+  const ng = (body: unknown) => assert.equal(validateTimeEntryInput(body, NOW).ok, false, JSON.stringify(body));
+
+  it("defaults workDate to today in Japan time and note to empty", () => {
+    assert.deepEqual(ok({ minutes: 30 }), { workDate: "2026-11-10", minutes: 30, note: "" });
+  });
+
+  it("trims the note and accepts 200 characters", () => {
+    assert.equal(ok({ minutes: 1, note: "  メモ  " }).note, "メモ");
+    assert.equal(ok({ minutes: 1, note: ` ${"あ".repeat(200)} ` }).note.length, 200);
+    ng({ minutes: 1, note: "あ".repeat(201) });
+    ng({ minutes: 1, note: 123 });
+  });
+
+  it("accepts minutes from 1 to 1440 as integers", () => {
+    assert.equal(ok({ minutes: 1 }).minutes, 1);
+    assert.equal(ok({ minutes: 1440 }).minutes, 1440);
+    for (const minutes of [undefined, null, "", 0, -30, 1.5, 1441, "30", true]) ng({ minutes });
+  });
+
+  it("accepts today and past dates in Japan time, rejects future and invalid dates", () => {
+    assert.equal(ok({ minutes: 1, workDate: "2026-11-10" }).workDate, "2026-11-10");
+    assert.equal(ok({ minutes: 1, workDate: "2025-01-01" }).workDate, "2025-01-01");
+    ng({ minutes: 1, workDate: "2026-11-11" });
+    ng({ minutes: 1, workDate: "2026-02-30" });
+    ng({ minutes: 1, workDate: "2026/11/09" });
+  });
+
+  it("rejects bodies that are not objects", () => {
+    for (const body of [undefined, null, [], "x", 1]) ng(body);
+  });
+});
+
+describe("createTimeEntry / listTimeEntries", () => {
+  it("creates an entry for the given user", () => {
+    const db = openDb();
+    const r = createTimeEntry(3, "sato", { workDate: "2026-11-09", minutes: 90, note: "設計" }, db, NOW);
+    assert.ok(r.ok);
+    assert.deepEqual(r.entry, {
+      id: r.entry.id,
+      taskId: 3,
+      userId: "sato",
+      userName: "佐藤",
+      workDate: "2026-11-09",
+      minutes: 90,
+      note: "設計",
+      createdAt: NOW.toISOString(),
+    });
+  });
+
+  it("lists entries of the task, newest work date first, then newest record first, with the total", () => {
+    const db = openDb();
+    const at = (iso: string) => new Date(iso);
+    createTimeEntry(1, "sato", { workDate: "2026-11-01", minutes: 10, note: "a" }, db, at("2026-11-05T00:00:00Z"));
+    createTimeEntry(1, "suzuki", { workDate: "2026-11-03", minutes: 20, note: "b" }, db, at("2026-11-04T00:00:00Z"));
+    createTimeEntry(1, "sato", { workDate: "2026-11-03", minutes: 30, note: "c" }, db, at("2026-11-06T00:00:00Z"));
+    createTimeEntry(2, "sato", { workDate: "2026-11-03", minutes: 40, note: "other" }, db, at("2026-11-06T00:00:00Z"));
+    const { entries, totalMinutes } = listTimeEntries(1, db);
+    assert.deepEqual(entries.map((e) => e.note), ["c", "b", "a"]);
+    assert.equal(totalMinutes, 60);
+    assert.deepEqual(listTimeEntries(4, db), { entries: [], totalMinutes: 0 });
+  });
+
+  it("rejects entries over 24 hours per user per day across tasks", () => {
+    const db = openDb();
+    const input = (minutes: number, workDate = "2026-11-02") => ({ workDate, minutes, note: "" });
+    assert.ok(createTimeEntry(1, "sato", input(1000), db, NOW).ok);
+    assert.equal(createTimeEntry(2, "sato", input(441), db, NOW).ok, false);
+    assert.ok(createTimeEntry(2, "sato", input(440), db, NOW).ok);
+    assert.equal(createTimeEntry(3, "sato", input(1), db, NOW).ok, false);
+    // 別の人・別の日には影響しない
+    assert.ok(createTimeEntry(1, "suzuki", input(1440), db, NOW).ok);
+    assert.ok(createTimeEntry(1, "sato", input(1440, "2026-11-03"), db, NOW).ok);
+    assert.equal(listTimeEntries(2, db).totalMinutes, 440);
+  });
+});
+
+describe("deleteTimeEntry", () => {
+  it("deletes only the owner's entry of the given task", () => {
+    const db = openDb();
+    const r = createTimeEntry(1, "sato", { workDate: "2026-11-09", minutes: 30, note: "" }, db, NOW);
+    assert.ok(r.ok);
+    assert.equal(deleteTimeEntry(1, r.entry.id, "suzuki", db), "forbidden");
+    assert.equal(deleteTimeEntry(2, r.entry.id, "sato", db), "not_found");
+    assert.equal(listTimeEntries(1, db).entries.length, 1);
+    assert.equal(deleteTimeEntry(1, r.entry.id, "sato", db), "deleted");
+    assert.equal(deleteTimeEntry(1, r.entry.id, "sato", db), "not_found");
+    assert.equal(listTimeEntries(1, db).entries.length, 0);
+  });
+});
+
+describe("parseEntryId", () => {
+  it("accepts positive integers only", () => {
+    assert.equal(parseEntryId("12"), 12);
+    for (const v of ["0", "-1", "1.5", "abc", "01", "", undefined]) assert.equal(parseEntryId(v), undefined, String(v));
