diff --git a/src/lib/time-entries.ts b/src/lib/time-entries.ts
new file mode 100644
index 0000000..89f22c6
--- /dev/null
+++ b/src/lib/time-entries.ts
@@ -0,0 +1,151 @@
+// タスクの作業時間の記録。日付は日本時間（Asia/Tokyo）で扱う（サーバーの時刻は UTC）。
+import { getDb, transaction, type Db } from "./db/index.ts";
+import type { ValidationResult } from "./tasks.ts";
+import { formatMinutes } from "./time-format.ts";
+
+export type TimeEntry = {
+  id: number;
+  taskId: number;
+  userId: string;
+  userName: string;
+  workDate: string; // YYYY-MM-DD（日本時間）
+  minutes: number;
+  note: string;
+  createdAt: string; // ISO 8601（UTC）
+};
+
+export type TimeEntryInput = { workDate: string; minutes: number; note: string };
+
+/** 1 件・1 人 1 日あたりの上限（24 時間）。 */
+export const MAX_MINUTES_PER_DAY = 24 * 60;
+export const MAX_NOTE_LENGTH = 200;
+
+const JST_OFFSET_MS = 9 * 60 * 60 * 1000;
+const DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+/** 日本時間での今日の日付（YYYY-MM-DD）。 */
+export function jstToday(now: Date = new Date()): string {
+  return new Date(now.getTime() + JST_OFFSET_MS).toISOString().slice(0, 10);
+}
+
+/** 実在する日付の YYYY-MM-DD か（2026-02-30 などは不可）。 */
+export function isValidDate(value: unknown): value is string {
+  if (typeof value !== "string") return false;
+  const m = DATE_RE.exec(value);
+  if (!m) return false;
+  const d = new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3])));
+  return d.toISOString().slice(0, 10) === value;
+}
+
+/** API に送られた記録の内容を検証する。作業日を省略したら日本時間の今日。未来の日付は不可。 */
+export function validateTimeEntryInput(body: unknown, now: Date = new Date()): ValidationResult<TimeEntryInput> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const b = body as Record<string, unknown>;
+  const errors: string[] = [];
+  const today = jstToday(now);
+
+  let workDate = today;
+  if (b.workDate !== undefined) {
+    if (!isValidDate(b.workDate)) errors.push("作業日は YYYY-MM-DD 形式の正しい日付で入力してください");
+    else if (b.workDate > today) errors.push("未来の日付には記録できません");
+    else workDate = b.workDate;
+  }
+
+  const minutes = b.minutes;
+  if (minutes === undefined || minutes === null || minutes === "") {
+    errors.push("作業時間（分）を入力してください");
+  } else if (typeof minutes !== "number" || !Number.isInteger(minutes) || minutes < 1 || minutes > MAX_MINUTES_PER_DAY) {
+    errors.push(`作業時間は 1〜${MAX_MINUTES_PER_DAY} の整数（分）で入力してください`);
+  }
+
+  let note = "";
+  if (b.note !== undefined && b.note !== null) {
+    if (typeof b.note !== "string") errors.push("メモは文字列で入力してください");
+    else if (b.note.trim().length > MAX_NOTE_LENGTH) errors.push(`メモは ${MAX_NOTE_LENGTH} 文字以内で入力してください`);
+    else note = b.note.trim();
+  }
+
+  return errors.length > 0 ? { ok: false, errors } : { ok: true, value: { workDate, minutes: minutes as number, note } };
+}
+
+type Row = {
+  id: number;
+  task_id: number;
+  user_id: string;
+  user_name: string;
+  work_date: string;
+  minutes: number;
+  note: string;
+  created_at: string;
+};
+
+const SELECT = `SELECT e.id, e.task_id, e.user_id, u.name AS user_name, e.work_date, e.minutes, e.note, e.created_at
+  FROM time_entries e JOIN users u ON u.id = e.user_id`;
+
+function toEntry(r: Row): TimeEntry {
+  return {
+    id: r.id,
+    taskId: r.task_id,
+    userId: r.user_id,
+    userName: r.user_name,
+    workDate: r.work_date,
+    minutes: r.minutes,
+    note: r.note,
+    createdAt: r.created_at,
+  };
+}
+
+/** タスクの記録（作業日の新しい順、同じ日は記録日時の新しい順）と合計。 */
+export function listTimeEntries(taskId: number, db: Db = getDb()): { entries: TimeEntry[]; totalMinutes: number } {
+  const rows = db
+    .prepare(`${SELECT} WHERE e.task_id = ? ORDER BY e.work_date DESC, e.created_at DESC, e.id DESC`)
+    .all(taskId) as Row[];
+  const entries = rows.map(toEntry);
+  return { entries, totalMinutes: entries.reduce((sum, e) => sum + e.minutes, 0) };
+}
+
+export type CreateResult = { ok: true; entry: TimeEntry } | { ok: false; error: string };
+
+/** 記録する。同じ人の同じ作業日の合計（全タスク）が 24 時間を超えるなら記録しない。 */
+export function createTimeEntry(
+  taskId: number,
+  userId: string,
+  input: TimeEntryInput,
+  db: Db = getDb(),
+  now: Date = new Date(),
+): CreateResult {
+  return transaction(db, () => {
+    const { used } = db
+      .prepare("SELECT COALESCE(SUM(minutes), 0) AS used FROM time_entries WHERE user_id = ? AND work_date = ?")
+      .get(userId, input.workDate) as { used: number };
+    if (used + input.minutes > MAX_MINUTES_PER_DAY) {
+      return { ok: false, error: `1 日の作業時間の合計は ${formatMinutes(MAX_MINUTES_PER_DAY)} までです（記録済み ${formatMinutes(used)}）` };
+    }
+    const { lastInsertRowid } = db
+      .prepare("INSERT INTO time_entries (task_id, user_id, work_date, minutes, note, created_at) VALUES (?, ?, ?, ?, ?, ?)")
+      .run(taskId, userId, input.workDate, input.minutes, input.note, now.toISOString());
+    const row = db.prepare(`${SELECT} WHERE e.id = ?`).get(Number(lastInsertRowid)) as Row;
+    return { ok: true as const, entry: toEntry(row) };
+  });
+}
+
+/** URL の ID（正の整数）を検証する。不正なら undefined。 */
+export function parseEntryId(value: unknown): number | undefined {
+  if (typeof value !== "string" || !/^[1-9][0-9]{0,9}$/.test(value)) return undefined;
+  return Number(value);
+}
+
+export type DeleteResult = "deleted" | "not_found" | "forbidden";
+
+/** 記録を削除する。URL のタスクの記録でなければ not_found、本人の記録でなければ forbidden。 */
+export function deleteTimeEntry(taskId: number, entryId: number, userId: string, db: Db = getDb()): DeleteResult {
+  const row = db.prepare("SELECT user_id FROM time_entries WHERE id = ? AND task_id = ?").get(entryId, taskId) as
+    | { user_id: string }
+    | undefined;
+  if (!row) return "not_found";
+  if (row.user_id !== userId) return "forbidden";
+  db.prepare("DELETE FROM time_entries WHERE id = ?").run(entryId);
+  return "deleted";
+}
