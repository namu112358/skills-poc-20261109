@@ -0,0 +1,27 @@
+// GET /api/tasks/:id/extensions — 延長申請の一覧 / POST — 延長を申請する。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { listExtensions, requestExtension } from "@/lib/extensions";
+import { getTask, parseTaskId } from "@/lib/tasks";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function GET(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).id);
+  const task = id === undefined ? undefined : getTask(id);
+  if (!task) return jsonError(404, "タスクが見つかりません");
+  return NextResponse.json({ extensions: listExtensions(task.id) });
+}
+
+export async function POST(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).id);
+  const task = id === undefined ? undefined : getTask(id);
+  if (!task) return jsonError(404, "タスクが見つかりません");
+  const result = requestExtension(task, user, await readJson(request));
+  if (!result.ok) return jsonError(result.error.status, result.error.message, result.error.details);
+  return NextResponse.json({ extension: result.value }, { status: 201 });
+}
