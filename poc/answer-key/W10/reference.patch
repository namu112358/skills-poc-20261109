+// POST /api/tasks/:id/extensions/:extensionId/approve — 延長申請を承認する。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, requireApiUser } from "@/lib/api";
+import { decideExtension } from "@/lib/extensions";
+import { parseTaskId } from "@/lib/tasks";
+
+type Context = { params: Promise<{ id: string; extensionId: string }> };
+
+export async function POST(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const p = await params;
+  const taskId = parseTaskId(p.id);
+  const extensionId = parseTaskId(p.extensionId);
+  if (taskId === undefined || extensionId === undefined) return jsonError(404, "延長申請が見つかりません");
+  const result = decideExtension(taskId, extensionId, user, "approved");
+  if (!result.ok) return jsonError(result.error.status, result.error.message, result.error.details);
+  return NextResponse.json(result.value);
+}
