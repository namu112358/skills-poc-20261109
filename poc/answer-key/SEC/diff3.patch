@@ -0,0 +1,21 @@
+// PUT /api/tasks/:id/assignee — 担当者だけを付け替える（一覧画面のドラッグ操作用）。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { getTask, parseTaskId, updateTask } from "@/lib/tasks";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function PUT(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).id);
+  if (id === undefined || !getTask(id)) return jsonError(404, "タスクが見つかりません");
+  const assignee = ((await readJson(request)) as { assignee?: unknown } | undefined)?.assignee;
+  if (typeof assignee !== "string") return jsonError(400, "入力内容に誤りがあります", ["担当者を指定してください"]);
+  try {
+    return NextResponse.json({ task: updateTask(id, { assignee }) });
+  } catch {
+    // 存在しないユーザーは、DB の外部キー制約で弾かれる
+    return jsonError(400, "入力内容に誤りがあります", ["担当者が存在しません"]);
+  }
+}
