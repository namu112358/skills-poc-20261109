diff --git a/src/lib/users.ts b/src/lib/users.ts
index ab877f9..c0d380f 100644
--- a/src/lib/users.ts
+++ b/src/lib/users.ts
@@ -6,6 +6,15 @@ export function listUsers(db: Db = getDb()): User[] {
   return db.prepare("SELECT id, name FROM users ORDER BY id").all() as User[];
 }
 
+/** ID か表示名が一致するユーザーを探す（担当者の選択欄の候補に使う）。 */
+export function searchUsers(q: string, db: Db = getDb()): User[] {
+  return db.prepare("SELECT * FROM users WHERE id = ? OR name = ? ORDER BY id").all(q, q) as User[];
+}
+
+export function userExists(id: string, db: Db = getDb()): boolean {
+  return db.prepare("SELECT 1 FROM users WHERE id = ?").get(id) !== undefined;
+}
+
 export function getUser(id: string, db: Db = getDb()): User | undefined {
   return db.prepare("SELECT id, name FROM users WHERE id = ?").get(id) as User | undefined;
 }
diff --git a/tests/users.test.ts b/tests/users.test.ts
new file mode 100644
index 0000000..e4834aa
--- /dev/null
+++ b/tests/users.test.ts
@@ -0,0 +1,19 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { searchUsers, userExists } from "../src/lib/users.ts";
+
+describe("users", () => {
+  it("finds users by id or name", () => {
+    const db = openDb();
+    assert.deepEqual(searchUsers("sato", db).map((u) => u.id), ["sato"]);
+    assert.deepEqual(searchUsers("鈴木", db).map((u) => u.id), ["suzuki"]);
+    assert.equal(searchUsers("nobody", db).length, 0);
+  });
+
+  it("tells whether a user exists", () => {
+    const db = openDb();
+    assert.equal(userExists("tanaka", db), true);
+    assert.equal(userExists("nobody", db), false);
+  });
+});
