@@ -0,0 +1,15 @@
+// GET /api/shared/:token?task=… — 共有リンクのタスクを返す。ログインは不要（リンクを知っていることが権限）。
+import { NextResponse } from "next/server";
+import { jsonError } from "@/lib/api";
+import { getSharedTask, isValidShareToken } from "@/lib/share";
+import { parseTaskId } from "@/lib/tasks";
+
+type Context = { params: Promise<{ token: string }> };
+
+export async function GET(request: Request, { params }: Context) {
+  const { token } = await params;
+  if (!isValidShareToken(token)) return jsonError(404, "共有リンクが見つかりません");
+  const taskId = parseTaskId(new URL(request.url).searchParams.get("task"));
+  const task = taskId === undefined ? undefined : getSharedTask(taskId);
+  return task ? NextResponse.json({ task }) : jsonError(404, "タスクが見つかりません");
+}
