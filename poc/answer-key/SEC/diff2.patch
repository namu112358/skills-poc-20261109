--- /dev/null
+++ b/tests/share.test.ts
@@ -0,0 +1,14 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { createShareLink, getSharedTask, isValidShareToken } from "../src/lib/share.ts";
+
+describe("share links", () => {
+  it("creates a valid link for a task", () => {
+    const db = openDb();
+    const token = createShareLink(1, "sato", db);
+    assert.equal(isValidShareToken(token, db), true);
+    assert.equal(isValidShareToken("unknown", db), false);
+    assert.equal(getSharedTask(1, db)?.title, "要件定義書のレビュー");
+  });
+});
