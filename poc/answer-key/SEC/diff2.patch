@@ -0,0 +1,17 @@
+// POST /api/tasks/:id/share — タスクの共有リンクを作る。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, requireApiUser } from "@/lib/api";
+import { createShareLink } from "@/lib/share";
+import { getTask, parseTaskId } from "@/lib/tasks";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function POST(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).id);
+  if (id === undefined || !getTask(id)) return jsonError(404, "タスクが見つかりません");
+  const token = createShareLink(id, user.id);
+  const url = new URL(`/shared/${encodeURIComponent(token)}?task=${id}`, request.url);
+  return NextResponse.json({ url: url.toString() }, { status: 201 });
+}
