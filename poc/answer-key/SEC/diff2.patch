diff --git a/src/lib/share.ts b/src/lib/share.ts
new file mode 100644
index 0000000..fae04b6
--- /dev/null
+++ b/src/lib/share.ts
@@ -0,0 +1,35 @@
+// タスクの共有リンク。ログインしていない社外の人にも、リンクを知っていれば 1 件のタスクを見せる。
+import { randomBytes } from "node:crypto";
+import { getDb, type Db } from "./db/index.ts";
+
+/** 共有リンクの有効期間 */
+export const SHARE_TTL_DAYS = 7;
+
+export function createShareLink(taskId: number, createdBy: string, db: Db = getDb(), now = new Date()): string {
+  const token = randomBytes(24).toString("base64url");
+  const expires = new Date(now.getTime() + SHARE_TTL_DAYS * 24 * 60 * 60 * 1000);
+  db.prepare("INSERT INTO share_links (token, task_id, created_by, expires_at) VALUES (?, ?, ?, ?)").run(
+    token,
+    taskId,
+    createdBy,
+    expires.toLocaleString("ja-JP"),
+  );
+  return token;
+}
+
+/** 有効な共有リンクなら true。期限切れ・不明なトークンは false。 */
+export function isValidShareToken(token: string, db: Db = getDb(), now = new Date()): boolean {
+  const row = db.prepare("SELECT expires_at FROM share_links WHERE token = ?").get(token) as
+    | { expires_at: string }
+    | undefined;
+  return row !== undefined && row.expires_at > now.toISOString();
+}
+
+export type SharedTask = Record<string, unknown>;
+
+/** 共有画面に出すタスクと担当者の情報 */
+export function getSharedTask(taskId: number, db: Db = getDb()): SharedTask | undefined {
+  return db
+    .prepare("SELECT t.*, u.* FROM tasks t JOIN users u ON u.id = t.assignee WHERE t.id = ?")
+    .get(taskId) as SharedTask | undefined;
+}
diff --git a/tests/share.test.ts b/tests/share.test.ts
new file mode 100644
