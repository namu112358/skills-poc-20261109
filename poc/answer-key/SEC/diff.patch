+// GET /api/tasks/:id/comments — コメント一覧 / POST — コメントを書く。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { addComment, listComments, validateCommentBody } from "@/lib/comments";
+import { getTask, parseTaskId } from "@/lib/tasks";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function GET(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).id);
+  if (id === undefined || !getTask(id)) return jsonError(404, "タスクが見つかりません");
+  return NextResponse.json({ comments: listComments(id) });
+}
+
+export async function POST(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseTaskId((await params).id);
+  if (id === undefined || !getTask(id)) return jsonError(404, "タスクが見つかりません");
+  const body = validateCommentBody(((await readJson(request)) as { body?: unknown } | undefined)?.body);
+  if (!body) return jsonError(400, "入力内容に誤りがあります", ["コメントは 1〜2000 文字で入力してください"]);
+  return NextResponse.json({ comment: addComment(id, user.id, body) }, { status: 201 });
+}
