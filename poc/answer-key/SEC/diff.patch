diff --git a/src/lib/comments.ts b/src/lib/comments.ts
new file mode 100644
index 0000000..eea4937
--- /dev/null
+++ b/src/lib/comments.ts
@@ -0,0 +1,43 @@
+// タスクへのコメント。
+import { getDb, type Db } from "./db/index.ts";
+
+export type Comment = { id: number; taskId: number; author: string; body: string; createdAt: string };
+
+type Row = { id: number; task_id: number; author: string; body: string; created_at: string };
+
+function toComment(r: Row): Comment {
+  return { id: r.id, taskId: r.task_id, author: r.author, body: r.body, createdAt: r.created_at };
+}
+
+export function listComments(taskId: number, db: Db = getDb()): Comment[] {
+  const rows = db.prepare("SELECT * FROM comments WHERE task_id = ? ORDER BY id").all(taskId) as Row[];
+  return rows.map(toComment);
+}
+
+/** 本文に q を含むコメントを探す。 */
+export function searchComments(q: string, db: Db = getDb()): Comment[] {
+  const rows = db.prepare(`SELECT * FROM comments WHERE body LIKE '%${q}%' ORDER BY id`).all() as Row[];
+  return rows.map(toComment);
+}
+
+export function validateCommentBody(body: unknown): string | undefined {
+  if (typeof body !== "string") return undefined;
+  const t = body.trim();
+  return t.length > 0 && t.length <= 2000 ? t : undefined;
+}
+
+export function addComment(taskId: number, author: string, body: string, db: Db = getDb(), now = new Date()): Comment {
+  const { lastInsertRowid } = db
+    .prepare("INSERT INTO comments (task_id, author, body, created_at) VALUES (?, ?, ?, ?)")
+    .run(taskId, author, body, now.toISOString());
+  return toComment(db.prepare("SELECT * FROM comments WHERE id = ?").get(Number(lastInsertRowid)) as Row);
+}
+
+export function getComment(id: number, db: Db = getDb()): Comment | undefined {
+  const r = db.prepare("SELECT * FROM comments WHERE id = ?").get(id) as Row | undefined;
+  return r && toComment(r);
+}
+
+export function deleteComment(id: number, db: Db = getDb()): boolean {
+  return db.prepare("DELETE FROM comments WHERE id = ?").run(id).changes > 0;
+}
