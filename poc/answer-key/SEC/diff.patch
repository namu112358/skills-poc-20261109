diff --git a/tests/comments.test.ts b/tests/comments.test.ts
new file mode 100644
index 0000000..9ad111e
--- /dev/null
+++ b/tests/comments.test.ts
@@ -0,0 +1,20 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { addComment, deleteComment, getComment, listComments, validateCommentBody } from "../src/lib/comments.ts";
+
+describe("comments", () => {
+  it("adds, lists and deletes comments", () => {
+    const db = openDb();
+    const c = addComment(1, "sato", "確認しました", db);
+    assert.deepEqual(listComments(1, db).map((x) => x.body), ["確認しました"]);
+    assert.equal(deleteComment(c.id, db), true);
+    assert.equal(getComment(c.id, db), undefined);
+  });
+
+  it("validates the body", () => {
+    assert.equal(validateCommentBody("  "), undefined);
+    assert.equal(validateCommentBody(" ok "), "ok");
+    assert.equal(validateCommentBody("x".repeat(2001)), undefined);
+  });
+});
