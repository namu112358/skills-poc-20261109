diff --git a/src/app/api/locations/route.ts b/src/app/api/locations/route.ts
new file mode 100644
index 0000000..7855cd0
--- /dev/null
+++ b/src/app/api/locations/route.ts
@@ -0,0 +1,17 @@
+import { NextResponse } from "next/server";
+import { requireApiUser } from "@/lib/api";
+import { getDb } from "@/lib/db";
+
+export async function GET() {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  return NextResponse.json({ locations: getDb().prepare("SELECT id, name FROM locations ORDER BY name").all() });
+}
+
+export async function POST(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const { name } = (await request.json()) as { name: string };
+  const r = getDb().prepare("INSERT INTO locations (name) VALUES (?)").run(name);
+  return NextResponse.json({ location: { id: Number(r.lastInsertRowid), name } }, { status: 201 });
+}
