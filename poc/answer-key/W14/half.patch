@@ -0,0 +1,69 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { getInstrument, listInstruments, recordInventory, updateInstrument } from "../src/lib/instruments.ts";
+import {
+  backfillLocations,
+  createLocation,
+  locationKey,
+  listLocations,
+  resolveLocationText,
+  updateLocation,
+  validateLocationInput,
+} from "../src/lib/locations.ts";
+
+describe("locationKey", () => {
+  it("normalizes width and spaces", () => {
+    assert.equal(locationKey("工事部　倉庫"), locationKey("工事部 倉庫"));
+  });
+});
+
+describe("resolveLocationText", () => {
+  it("resolves known places, leaves ambiguous text unresolved and blank as unset", () => {
+    const db = openDb();
+    assert.deepEqual(resolveLocationText("工事部　倉庫", db), { status: "resolved", locationId: 3, name: "工事部 倉庫" });
+    assert.deepEqual(resolveLocationText(" 倉庫 ", db), { status: "unresolved", locationId: null, name: "倉庫" });
+    assert.deepEqual(resolveLocationText("　", db), { status: "unset", locationId: null, name: "" });
+  });
+});
+
+describe("backfillLocations", () => {
+  it("links pending instruments in batches and keeps the original text when it cannot", () => {
+    const db = openDb();
+    db.prepare("UPDATE instruments SET location = '不明' WHERE management_no = 'MI-0010'").run();
+    const r = backfillLocations(db, { batchSize: 3 });
+    assert.equal(r.processed, 10);
+    assert.equal(r.remaining, 0);
+    const byNo = new Map(listInstruments({}, db).map((i) => [i.managementNo, i]));
+    assert.deepEqual([byNo.get("MI-0010")?.locationStatus, byNo.get("MI-0010")?.location], ["unresolved", "不明"]);
+    assert.equal(backfillLocations(db).processed, 0); // 2 回目は何もしない
+  });
+
+  it("can stop after a number of batches", () => {
+    const db = openDb();
+    const r = backfillLocations(db, { batchSize: 4, maxBatches: 1 });
+    assert.deepEqual([r.processed, r.remaining], [4, 6]);
+  });
+});
+
+describe("locations", () => {
+
+  it("retires a place without deleting it and rejects duplicates", () => {
+    const db = openDb();
+    updateLocation(16, { active: false }, db);
+    assert.equal(listLocations({}, db).length, 15);
+    assert.equal(listLocations({ includeInactive: true }, db).length, 16);
+    assert.equal(validateLocationInput({ name: "工事部　倉庫" }, {}, db).ok, false);
+    assert.equal(createLocation("技術部 3D プリンタ室", db).active, true);
+  });
+
+  it("keeps the handheld free-text input working", () => {
+    const db = openDb();
+    const a = recordInventory({ managementNo: "MI-0003", location: "製造部 第３ライン" }, db);
+    assert.deepEqual([a?.locationId, a?.location, a?.locationStatus], [9, "製造部 第 3 ライン", "resolved"]);
+    const b = recordInventory({ managementNo: "MI-0003", location: "A社 貸出中" }, db);
+    assert.deepEqual([b?.locationId, b?.location, b?.locationStatus], [null, "A社 貸出中", "unresolved"]);
+    assert.equal(updateInstrument(b!.id, { locationId: 1 }, db)?.locationId, 1);
+    assert.equal(getInstrument(b!.id, db)?.locationStatus, "resolved");
+  });
+});
