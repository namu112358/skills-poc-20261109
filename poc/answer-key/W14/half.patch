+// GET /api/locations?all=1 — 場所マスタの一覧（既定は使用中だけ。all=1 で使用終了も含む）/ POST /api/locations — 場所を追加する。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { createLocation, listLocations, validateLocationInput } from "@/lib/locations";
+
+export async function GET(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const all = new URL(request.url).searchParams.get("all") === "1";
+  return NextResponse.json({ locations: listLocations({ includeInactive: all }) });
+}
+
+export async function POST(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const result = validateLocationInput(await readJson(request));
+  if (!result.ok) return jsonError(400, "入力内容に誤りがあります", result.errors);
+  return NextResponse.json({ location: createLocation(result.value.name!) }, { status: 201 });
+}
