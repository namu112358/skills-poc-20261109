+++ b/src/lib/locations.ts
@@ -0,0 +1,165 @@
+// 場所マスタと、自由入力の設置場所からの移行。
+// - 計測器の設置場所は locations.id（instruments.location_id）で持つ。
+// - 移行の間は古い列 instruments.location（場所の名前）も残して書き続ける（経理の集計が読む・前の版のアプリに戻せるように）。
+//   古い列を消すのは、経理の集計の切り替え（来期）の後に別のマイグレーションで行う。
+// - 自由入力の値は表記ゆれを寄せて場所に結びつける。寄せられない値は元の文字列を残し「確認中」（unresolved）にする。
+import { getDb, transaction, type Db } from "./db/index.ts";
+import { logger } from "./logger.ts";
+
+export type LocationStatus = "resolved" | "unresolved" | "unset" | "pending";
+
+export type Location = { id: number; name: string; active: boolean };
+
+type LocationRow = { id: number; name: string; active: number };
+const toLocation = (r: LocationRow): Location => ({ id: r.id, name: r.name, active: r.active === 1 });
+
+const KANJI_DIGITS: Record<string, string> = { 一: "1", 二: "2", 三: "3", 四: "4", 五: "5", 六: "6", 七: "7", 八: "8", 九: "9" };
+const DEPT_ABBREVIATIONS: [RegExp, string][] = [
+  [/^(品証|品保|品質保証)(?!部)/, "品質保証部"],
+  [/^工事(?!部)/, "工事部"],
+  [/^製造(?!部)/, "製造部"],
+  [/^技術(?!部)/, "技術部"],
+];
+
+/**
+ * 設置場所の文字列を比べるための鍵にする。全角・半角（NFKC）、空白、漢数字（第一・三号）、「号車」、部署名の略を寄せる。
+ * 例: "製造部　第１ライン" / "製造 第一ﾗｲﾝ" / "製造部第 1 ライン" → "製造部第1ライン"
+ */
+export function locationKey(text: string): string {
+  void KANJI_DIGITS;
+  void DEPT_ABBREVIATIONS;
+  return text.normalize("NFKC").replace(/\s+/g, "");
+}
+
+export function listLocations(options: { includeInactive?: boolean } = {}, db: Db = getDb()): Location[] {
+  const rows = db
+    .prepare(`SELECT id, name, active FROM locations WHERE (:all = 1 OR active = 1) ORDER BY id`)
+    .all({ all: options.includeInactive ? 1 : 0 }) as LocationRow[];
+  return rows.map(toLocation);
+}
+
+export function getLocation(id: number, db: Db = getDb()): Location | undefined {
+  const row = db.prepare("SELECT id, name, active FROM locations WHERE id = ?").get(id) as LocationRow | undefined;
+  return row && toLocation(row);
+}
+
+export type ValidationResult<T> = { ok: true; value: T } | { ok: false; errors: string[] };
+
+/** 場所の追加・変更の内容を検証する（名前は 1〜100 文字、正式名称の重複は不可）。 */
+export function validateLocationInput(
+  body: unknown,
+  options: { partial?: boolean; id?: number } = {},
+  db: Db = getDb(),
+): ValidationResult<{ name?: string; active?: boolean }> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const b = body as Record<string, unknown>;
+  const errors: string[] = [];
+  const value: { name?: string; active?: boolean } = {};
+  if (!options.partial || "name" in b) {
+    const name = typeof b.name === "string" ? b.name.trim().replace(/\s+/g, " ") : "";
+    if (name === "" || name.length > 100) errors.push("場所の名前は 1〜100 文字で入力してください");
+    else if (findLocationByKey(locationKey(name), db, { exceptId: options.id })) errors.push("同じ場所がすでに登録されています");
+    else value.name = name;
+  }
+  if ("active" in b) {
+    if (typeof b.active !== "boolean") errors.push("使用中かどうか（active）は true か false で指定してください");
+    else value.active = b.active;
+  }
+  return errors.length > 0 ? { ok: false, errors } : { ok: true, value };
+}
+
+export function createLocation(name: string, db: Db = getDb()): Location {
+  const { lastInsertRowid } = db.prepare("INSERT INTO locations (name, active) VALUES (?, 1)").run(name);
+  logger.info("location.created", { locationId: Number(lastInsertRowid) });
+  return getLocation(Number(lastInsertRowid), db)!;
+}
+
+/** 名前の変更・使用終了。名前を変えたら、その場所の計測器の古い列（場所の名前）も書き換える。場所は消さない。 */
+export function updateLocation(id: number, changes: { name?: string; active?: boolean }, db: Db = getDb()): Location | undefined {
+  const current = getLocation(id, db);
+  if (!current) return undefined;
+  transaction(db, () => {
+    if (changes.name !== undefined && changes.name !== current.name) {
+      db.prepare("UPDATE locations SET name = ? WHERE id = ?").run(changes.name, id);
+    }
+    if (changes.active !== undefined) db.prepare("UPDATE locations SET active = ? WHERE id = ?").run(changes.active ? 1 : 0, id);
+  });
+  logger.info("location.updated", { locationId: id, renamed: changes.name !== undefined, active: changes.active });
+  return getLocation(id, db);
+}
+
+function findLocationByKey(key: string, db: Db, options: { exceptId?: number } = {}): Location | undefined {
+  // 場所は数十件なので、全件の鍵を作って比べる
+  return listLocations({ includeInactive: true }, db).find((l) => l.id !== options.exceptId && locationKey(l.name) === key);
+}
+
+export type Resolution =
+  | { status: "resolved"; locationId: number; name: string }
+  | { status: "unresolved"; locationId: null; name: string }
+  | { status: "unset"; locationId: null; name: "" };
+
+/** 自由入力の設置場所を場所マスタに照らす。空欄は未設定、寄せられなければ確認中（元の文字列を残す）。 */
+export function resolveLocationText(text: string, db: Db = getDb(), cache?: Map<string, Location | null>): Resolution {
+  const raw = text.trim();
+  if (raw.normalize("NFKC").trim() === "") return { status: "unset", locationId: null, name: "" };
+  const key = locationKey(raw);
+  let hit = cache?.get(key);
+  if (hit === undefined) {
+    hit = findLocationByKey(key, db) ?? null;
+    cache?.set(key, hit);
+  }
+  return hit ? { status: "resolved", locationId: hit.id, name: hit.name } : { status: "unresolved", locationId: null, name: raw };
+}
+
+/**
+ * 移行前の計測器（location_status = 'pending'）を、batchSize 件ずつのトランザクションで場所に結びつける。
+ * 1 回のトランザクションを短くして、移行中もほかの書き込みを止めない。maxBatches で 1 回の呼び出しの量を区切れる。
+ */
+export function backfillLocations(
+  db: Db = getDb(),
+  options: { batchSize?: number; maxBatches?: number } = {},
+): { processed: number; resolved: number; unresolved: number; unset: number; remaining: number } {
+  const batchSize = options.batchSize ?? 1000;
+  const counts = { processed: 0, resolved: 0, unresolved: 0, unset: 0 };
+  const cache = new Map<string, Location | null>();
+  const select = db.prepare("SELECT id, location FROM instruments WHERE location_status = 'pending' ORDER BY id LIMIT ?");
+  const update = db.prepare("UPDATE instruments SET location_id = ?, location = ?, location_status = ? WHERE id = ? AND location_status = 'pending'");
+  for (let batch = 0; options.maxBatches === undefined || batch < options.maxBatches; batch++) {
+    const rows = select.all(batchSize) as { id: number; location: string }[];
+    if (rows.length === 0) break;
+    transaction(db, () => {
+      for (const row of rows) {
+        const r = resolveLocationText(row.location, db, cache);
+        // 寄せたものは正式名称、確認中は元の文字列、未設定は空欄を古い列に入れる
+        update.run(r.locationId, r.status === "resolved" ? r.name : row.location, r.status, row.id);
+        counts[r.status]++;
+      }
+    });
+    counts.processed += rows.length;
+  }
+  const { remaining } = db.prepare("SELECT COUNT(*) AS remaining FROM instruments WHERE location_status = 'pending'").get() as {
+    remaining: number;
+  };
+  return { ...counts, remaining };
+}
+
+/** 起動後に、裏で少しずつ移行を進める（1 回 1000 件、間にほかの要求を挟む）。終わったら件数をログに出す。 */
+export function startLocationBackfill(db: Db): void {
+  const total = { processed: 0, resolved: 0, unresolved: 0, unset: 0 };
+  const step = () => {
+    try {
+      const r = backfillLocations(db, { maxBatches: 1 });
+      for (const k of ["processed", "resolved", "unresolved", "unset"] as const) total[k] += r[k];
+      if (r.remaining > 0) {
+        setTimeout(step, 20);
+      } else if (total.processed > 0) {
+        logger.info("location.backfill_completed", total);
+      }
+    } catch (error) {
+      logger.error("location.backfill_failed", { error, ...total });
+    }
+  };
+  setTimeout(step, 0);
+}
