@@ -0,0 +1,18 @@
+// POST /api/jobs/backfill-locations — 移行前の計測器の設置場所を場所マスタに結びつける（リリース後に運用が 1 回呼ぶ。
+// 起動後に裏でも少しずつ進むので、残りがあるときの念のため）。1 回の呼び出しで最大 50 回 × 1000 件。
+import { NextResponse } from "next/server";
+import { requireJobAuth } from "@/lib/api";
+import { backfillLocations } from "@/lib/locations";
+import { getDb } from "@/lib/db";
+import { logger } from "@/lib/logger";
+
+export async function POST(request: Request) {
+  const denied = requireJobAuth(request, "backfill-locations");
+  if (denied) return denied;
+  const result = backfillLocations(getDb(), { maxBatches: 50 });
+  const { unresolved } = getDb().prepare("SELECT COUNT(*) AS unresolved FROM instruments WHERE location_status = 'unresolved'").get() as {
+    unresolved: number;
+  };
+  logger.info("job.completed", { job: "backfill-locations", ...result, totalUnresolved: unresolved });
+  return NextResponse.json({ ...result, totalUnresolved: unresolved });
+}
diff --git a/src/app/api/locations/[id]/route.ts b/src/app/api/locations/[id]/route.ts
