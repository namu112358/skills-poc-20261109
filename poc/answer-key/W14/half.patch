@@ -0,0 +1,18 @@
+// PATCH /api/locations/:id — 場所の名前の変更・使用終了（active: false）。場所は消さない（過去の計測器で使うため）。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { parseId } from "@/lib/instruments";
+import { getLocation, updateLocation, validateLocationInput } from "@/lib/locations";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function PATCH(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  const current = id === undefined ? undefined : getLocation(id);
+  if (!current) return jsonError(404, "場所が見つかりません");
+  const result = validateLocationInput(await readJson(request), { partial: true, id: current.id });
+  if (!result.ok) return jsonError(400, "入力内容に誤りがあります", result.errors);
+  return NextResponse.json({ location: updateLocation(current.id, result.value) });
+}
