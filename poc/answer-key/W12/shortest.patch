diff --git a/src/app/api/notify-due/route.ts b/src/app/api/notify-due/route.ts
new file mode 100644
index 0000000..caa780f
--- /dev/null
+++ b/src/app/api/notify-due/route.ts
@@ -0,0 +1,23 @@
+// 優先度が高い計測器の校正期限が近いものを管理者に通知する
+import { NextResponse } from "next/server";
+import { listInstruments } from "@/lib/instruments";
+
+export async function POST() {
+  const now = new Date();
+  let sent = 0;
+  for (const i of listInstruments()) {
+    if (i.priority !== "high") continue;
+    const due = new Date(i.lastCalibratedOn);
+    due.setMonth(due.getMonth() + i.intervalMonths);
+    const days = (due.getTime() - now.getTime()) / 86400000;
+    if (days < 0 || days > 14) continue;
+    await fetch(process.env.NOTIFY_API_URL + "/v1/notifications", {
+      method: "POST",
+      headers: { "content-type": "application/json", authorization: "Bearer " + process.env.NOTIFY_API_TOKEN },
+      body: JSON.stringify({ recipient: i.managerId, title: `校正期限が近い: ${i.managementNo}`, body: `${i.name} の校正期限は ${due.toISOString().slice(0, 10)} です` }),
+    });
+    console.log("notified", i.managementNo, process.env.NOTIFY_API_TOKEN);
+    sent++;
+  }
+  return NextResponse.json({ sent });
+}
