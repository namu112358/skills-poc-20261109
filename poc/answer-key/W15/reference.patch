+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { importCalibrationCsv } from "../src/lib/legacy/calib-import.ts";
+import { isNishinihonCsv } from "../src/lib/import/nishinihon.ts";
+
+const HEAD = "機器番号,品名,校正実施日,判定結果,成績書番号,有効期限,コメント";
+const file = (rows: string[], end = rows.length) =>
+  new TextEncoder().encode(["# 西日本校正センター 校正結果", HEAD, ...rows, `END,${end}`].join("\n") + "\n");
+const records = (db: ReturnType<typeof openDb>) =>
+  db
+    .prepare(
+      `SELECT i.management_no AS no, r.calibrated_on AS date, r.result, r.agency FROM calibration_records r
+       JOIN instruments i ON i.id = r.instrument_id WHERE r.agency = '西日本校正センター' ORDER BY 1, 2`,
+    )
+    .all()
+    .map((r) => ({ ...r })) as { no: string; date: string; result: string; agency: string }[];
+
+describe("西日本校正センターの CSV", () => {
+  it("is detected from the header, and the old format is not", () => {
+    assert.equal(isNishinihonCsv(file([])), true);
+    assert.equal(isNishinihonCsv(new TextEncoder().encode("管理番号,機器名,校正日,判定\n")), false);
+  });
+
+  it("imports PASS / FAIL with hyphenless numbers and the agency name", () => {
+    const db = openDb();
+    const r = importCalibrationCsv(file(["MI0003,a,2026-12-01,PASS,W-1,2027-11-30,", "MI-0004,a,2026-12-01,FAIL,W-2,2027-11-30,x"]), "sato", db);
+    assert.deepEqual([r.imported, r.errors], [2, []]);
+    assert.deepEqual(records(db), [
+      { no: "MI-0003", date: "2026-12-01", result: "pass", agency: "西日本校正センター" },
+      { no: "MI-0004", date: "2026-12-01", result: "fail", agency: "西日本校正センター" },
+    ]);
+  });
+
+  it("imports COND as a pass and appends a note to the instrument", () => {
+    const db = openDb();
+    importCalibrationCsv(file(["MI0010,a,2026-12-03,COND,W-3,2027-12-02,湿度レンジ外"]), "sato", db);
+    assert.equal(records(db)[0].result, "pass");
+    const note = (db.prepare("SELECT note FROM instruments WHERE management_no = 'MI-0010'").get() as { note: string }).note;
+    assert.equal(note, "条件付き合格（2026-12-03）: 湿度レンジ外");
+  });
+
+  it("rejects the whole file when the END count does not match", () => {
+    const db = openDb();
+    const r = importCalibrationCsv(file(["MI0001,a,2026-12-04,PASS,W-4,2027-12-03,"], 2), "sato", db);
+    assert.deepEqual([r.imported, r.errors.length, records(db).length], [0, 1, 0]);
+  });
+
+  it("skips duplicates and rows already imported, and keeps going after bad rows", () => {
+    const db = openDb();
+    const f = file(["MI0009,a,2026-12-06,PASS,W-5,2027-12-05,", "MI0009,a,2026-12-06,PASS,W-6,2027-12-05,", "ZZ0001,a,2026-12-06,PASS,W-7,,",
+      "MI0001,a,2026-12-06,MAYBE,W-8,,"]);
+    const r = importCalibrationCsv(f, "sato", db);
+    assert.deepEqual([r.imported, r.skipped.map((s) => s.line), r.errors.map((e) => e.line)], [1, [4], [5, 6]]);
+    assert.equal(importCalibrationCsv(f, "sato", db).imported, 0);
+    assert.equal(records(db).length, 1);
+  });
+});
