+++ b/tests/calib-import.test.ts
@@ -0,0 +1,101 @@
+// 東日本計測サービスの CSV の取込の、今の振る舞いを固定するテスト（変更の前に書いた特性テスト）。
+// 理由の書かれていない分岐（和暦の境目・保留・参考・重複・取込済み・全角の管理番号など）も、今の結果をそのまま期待値にした。
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { importCalibrationCsv } from "../src/lib/legacy/calib-import.ts";
+
+const HEAD = "管理番号,機器名,校正日,判定,証明書番号,備考";
+const sjis = (lines: string[]) => {
+  // テストでは Shift_JIS の代わりに、BOM 付きの UTF-8（取込処理が受け付ける）で作る
+  const body = new TextEncoder().encode(lines.join("\r\n") + "\r\n");
+  return new Uint8Array([0xef, 0xbb, 0xbf, ...body]);
+};
+const recs = (db: ReturnType<typeof openDb>) =>
+  db
+    .prepare(
+      `SELECT i.management_no AS no, r.calibrated_on AS date, r.result, r.agency, r.certificate_no AS cert
+       FROM calibration_records r JOIN instruments i ON i.id = r.instrument_id WHERE r.certificate_no LIKE 'T-%' ORDER BY 1, 2`,
+    )
+    .all() as { no: string; date: string; result: string; agency: string; cert: string }[];
+
+describe("importCalibrationCsv（東日本計測サービスの形式）", () => {
+  it("reads Japanese era and western dates, and the old pass/fail marks", () => {
+    const db = openDb();
+    const r = importCalibrationCsv(
+      sjis([HEAD, "MI-0001,a,R8.1.25,合格,T-1,", "MI-0003,a,2026/6/10,○,T-2,", "MI-0004,a,令和8年3月1日,良,T-3,", "MI-0006,a,R元.5.1,〇,T-4,",
+        "MI-0009,a,平成30年12月3日,×,T-5,", "MI-0010,a,R８.３.５,否,T-6,"]),
+      "sato",
+      db,
+    );
+    assert.deepEqual([r.imported, r.skipped, r.errors], [6, [], []]);
+    assert.deepEqual(recs(db).map((x) => [x.no, x.date, x.result, x.agency]), [
+      ["MI-0001", "2026-01-25", "pass", "東日本計測サービス"],
+      ["MI-0003", "2026-06-10", "pass", "東日本計測サービス"],
+      ["MI-0004", "2026-03-01", "pass", "東日本計測サービス"],
+      ["MI-0006", "2019-05-01", "pass", "東日本計測サービス"],
+      ["MI-0009", "2018-12-03", "fail", "東日本計測サービス"],
+      ["MI-0010", "2026-03-05", "fail", "東日本計測サービス"],
+    ]);
+  });
+
+  it("rejects dates across the era boundary and impossible dates", () => {
+    const db = openDb();
+    const r = importCalibrationCsv(sjis([HEAD, "MI-0001,a,H31.4.30,合格,T-1,", "MI-0003,a,H31.5.1,合格,T-2,", "MI-0004,a,R1.4.30,合格,T-3,",
+      "MI-0006,a,2026-02-30,合格,T-4,"]), "sato", db);
+    assert.equal(r.imported, 1);
+    assert.deepEqual(r.errors.map((e) => e.line), [3, 4, 5]);
+  });
+
+  it("normalizes management numbers and skips comment, total and unknown rows", () => {
+    const db = openDb();
+    const r = importCalibrationCsv(
+      sjis([HEAD, "MI0003,a,R8.6.11,合格,T-1,", "ｍｉ－０００４,a,R8.3.3,合格,T-2,", "#MI-0005,a,R8.3.4,合格,T-3,", "＃MI-0006,a,R8.3.4,合格,T-4,",
+        "ZZ-9999,a,R8.3.5,合格,T-5,", "合計,,,,,"]),
+      "sato",
+      db,
+    );
+    assert.equal(r.imported, 2);
+    assert.deepEqual(r.skipped, []);
+    assert.deepEqual(r.errors.map((e) => e.line), [6]);
+  });
+
+  it("skips pending results and reference calibrations, even when the result is a failure", () => {
+    const db = openDb();
+    const r = importCalibrationCsv(
+      sjis([HEAD, "MI-0001,a,R8.7.1,保留,T-1,", "MI-0003,a,R8.7.2,合格,T-2,参考校正", "MI-0004,a,R8.7.3,△,T-3,", "MI-0009,a,R8.7.5,否,T-4,参考値あり",
+        "MI-0010,a,R8.7.6,NG,T-5,"]),
+      "sato",
+      db,
+    );
+    assert.equal(r.imported, 1);
+    assert.deepEqual(r.skipped.map((s) => [s.line, s.reason]), [[2, "判定が保留"], [3, "参考校正"], [5, "参考校正"]]);
+    assert.deepEqual(r.errors.map((e) => e.line), [4]);
+  });
+
+  it("skips duplicates in the file and rows already imported", () => {
+    const db = openDb();
+    const file = sjis([HEAD, "MI-0003,a,R8.8.1,合格,T-1,", "MI-0003,a,R8.8.1,合格,T-2,", "MI-0004,a,R8.8.2,合格,T-3,"]);
+    assert.deepEqual([importCalibrationCsv(file, "sato", db).imported, importCalibrationCsv(file, "sato", db).imported], [2, 0]);
+    assert.equal(recs(db).length, 2);
+  });
+
+  it("handles quotes, spaces, column order and a missing header", () => {
+    const db = openDb();
+    const r = importCalibrationCsv(sjis(["機器名,管理番号,備考,判定,校正日,証明書番号", '"a,b",MI-0004,"x ""y""",合格, R8.11.5 ,T-1']), "sato", db);
+    assert.equal(r.imported, 1);
+    const bad = importCalibrationCsv(sjis(["機器番号,校正日", "MI-0001,R8.1.1"]), "sato", db);
+    assert.deepEqual([bad.imported, bad.errors.map((e) => e.line)], [0, [1]]);
+  });
+
+  it("decodes Shift_JIS files", () => {
+    const db = openDb();
+    // 「管理番号,機器名,校正日,判定,証明書番号,備考\r\nMI-0001,x,R8.1.2,合格,T-1,\r\n」を Shift_JIS で
+    const enc = (s: string) => Uint8Array.from(Buffer.from(s, "hex"));
+    const head = enc("8ac7979d94d48d862c8b408aed96bc2c8d5a90b393fa2c94bb92e82c8fd896be8f9194d48d862c94f58d6c0d0a");
+    const row = new TextEncoder().encode("MI-0001,x,R8.1.2,");
+    const pass = enc("8d878a692c542d312c0d0a");
+    const r = importCalibrationCsv(new Uint8Array([...head, ...row, ...pass]), "sato", db);
+    assert.equal(r.imported, 1);
+  });
+});
