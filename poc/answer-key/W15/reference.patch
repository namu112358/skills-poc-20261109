@@ -0,0 +1,119 @@
+// 西日本校正センター（2026-12 からの契約）の校正結果 CSV の取込。仕様は docs/agencies/nishinihon-csv-spec.md。
+// - UTF-8。1 行目は「#」で始まる案内、2 行目が見出し、最終行が「END,<データの行数>」。
+// - END の件数とデータの行数が合わないときは、転送が途中で切れたとみなして 1 件も取り込まない。
+// - 判定: PASS = 合格、FAIL = 不合格、COND（条件付き合格）= 合格として取り込み、計測器の備考に書き足す。
+// - 番号の寄せ方・ファイルの中の重複・取込済みの扱いは東日本計測サービスの形式と同じ。
+import { type Db } from "../db/index.ts";
+import { recordCalibration } from "../calibrations.ts";
+import { isValidDate } from "../dates.ts";
+import { logger } from "../logger.ts";
+import { normalizeManagementNo, type ImportResult } from "../legacy/calib-import.ts";
+
+export const NISHINIHON_AGENCY = "西日本校正センター";
+const HEADER = ["機器番号", "品名", "校正実施日", "判定結果", "成績書番号", "有効期限", "コメント"];
+
+function decode(data: Uint8Array): string {
+  const body = data.length >= 3 && data[0] === 0xef && data[1] === 0xbb && data[2] === 0xbf ? data.subarray(3) : data;
+  return new TextDecoder("utf-8").decode(body);
+}
+
+function splitLine(raw: string): string[] {
+  const cols: string[] = [];
+  let cur = "";
+  let quoted = false;
+  for (let i = 0; i < raw.length; i++) {
+    const ch = raw[i];
+    if (quoted) {
+      if (ch === '"' && raw[i + 1] === '"') {
+        cur += '"';
+        i++;
+      } else if (ch === '"') quoted = false;
+      else cur += ch;
+    } else if (ch === '"') quoted = true;
+    else if (ch === ",") {
+      cols.push(cur.trim());
+      cur = "";
+    } else cur += ch;
+  }
+  cols.push(cur.trim());
+  return cols;
+}
+
+/** 見出しの行（「#」の案内の次）が西日本校正センターの形式なら true。 */
+export function isNishinihonCsv(data: Uint8Array): boolean {
+  const lines = decode(data).split(/\r\n|\n|\r/).filter((l) => l.trim() !== "");
+  const head = lines.find((l) => !l.startsWith("#"));
+  return head !== undefined && splitLine(head)[0] === HEADER[0] && splitLine(head).includes("判定結果");
+}
+
+export function importNishinihonCsv(data: Uint8Array, recordedBy: string, db: Db, now: Date = new Date()): ImportResult {
+  const res: ImportResult = { imported: 0, skipped: [], errors: [] };
+  const lines = decode(data).split(/\r\n|\n|\r/);
+  type Row = { line: number; cols: string[] };
+  const rows: Row[] = [];
+  let header: string[] | null = null;
+  let end: { line: number; count: number } | null = null;
+  for (let n = 0; n < lines.length; n++) {
+    const raw = lines[n];
+    if (raw.trim() === "" || (header === null && raw.startsWith("#"))) continue;
+    const cols = splitLine(raw);
+    if (header === null) {
+      header = cols;
+      continue;
+    }
+    if (cols[0] === "END") {
+      end = { line: n + 1, count: Number(cols[1]) };
+      break;
+    }
+    rows.push({ line: n + 1, cols });
+  }
+  // 件数の確認（途中で切れたファイルは全体を止める）
+  if (!end || !Number.isInteger(end.count) || end.count !== rows.length) {
+    res.errors.push({
+      line: end?.line ?? lines.length,
+      message: `END 行の件数（${end?.count ?? "なし"}）とデータの行数（${rows.length}）が合わないため、このファイルは取り込みませんでした`,
+    });
+    logger.warn("calibration.import_rejected", { agency: NISHINIHON_AGENCY, declared: end?.count ?? null, rows: rows.length });
+    return res;
+  }
+  const col = (r: Row, name: string) => r.cols[header!.indexOf(name)] ?? "";
+  const seen = new Set<string>();
+  for (const r of rows) {
+    const no = normalizeManagementNo(col(r, "機器番号"));
+    const date = col(r, "校正実施日");
+    if (!isValidDate(date)) {
+      res.errors.push({ line: r.line, message: `校正実施日が正しくありません: ${date}` });
+      continue;
+    }
+    const judge = col(r, "判定結果").toUpperCase();
+    if (judge !== "PASS" && judge !== "FAIL" && judge !== "COND") {
+      res.errors.push({ line: r.line, message: `判定結果が読めません: ${col(r, "判定結果")}` });
+      continue;
+    }
+    const key = `${no}|${date}`;
+    if (seen.has(key)) {
+      res.skipped.push({ line: r.line, reason: "同じファイルの中で重複" });
+      continue;
+    }
+    seen.add(key);
+    const inst = db.prepare("SELECT id FROM instruments WHERE management_no = ?").get(no) as { id: number } | undefined;
+    if (!inst) {
+      res.errors.push({ line: r.line, message: `機器番号が台帳にありません: ${col(r, "機器番号")}` });
+      continue;
+    }
+    const cert = col(r, "成績書番号");
+    if (db.prepare("SELECT 1 FROM calibration_records WHERE instrument_id = ? AND calibrated_on = ? AND certificate_no = ?").get(inst.id, date, cert)) {
+      res.skipped.push({ line: r.line, reason: "取込済み" });
+      continue;
+    }
+    recordCalibration(inst.id, { calibratedOn: date, result: judge === "FAIL" ? "fail" : "pass", agency: NISHINIHON_AGENCY, certificateNo: cert },
+      recordedBy, db, now);
+    if (judge === "COND") {
+      const memo = `条件付き合格（${date}）: ${col(r, "コメント")}`;
+      db.prepare("UPDATE instruments SET note = CASE WHEN note = '' THEN ? ELSE note || char(10) || ? END WHERE id = ?").run(memo, memo, inst.id);
+    }
+    res.imported++;
+  }
+  logger.info("calibration.imported", { agency: NISHINIHON_AGENCY, imported: res.imported, skipped: res.skipped.length, errors: res.errors.length });
+  return res;
+}
