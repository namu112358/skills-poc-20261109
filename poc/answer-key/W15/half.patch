@@ -0,0 +1,24 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { importCalibrationCsv, parseDate } from "../src/lib/legacy/calib-import.ts";
+
+const B = (rows: string[], end = rows.length) =>
+  new TextEncoder().encode(["# 案内", "機器番号,品名,校正実施日,判定結果,成績書番号,有効期限,コメント", ...rows, `END,${end}`].join("\n"));
+
+describe("importCalibrationCsv", () => {
+  it("imports the new format", () => {
+    const db = openDb();
+    const r = importCalibrationCsv(B(["MI0003,a,2026-12-01,PASS,W-1,,", "MI0004,a,2026-12-01,COND,W-2,,"]), "sato", db);
+    assert.equal(r.imported, 2);
+  });
+  it("rejects a file with a wrong END count", () => {
+    const db = openDb();
+    assert.equal(importCalibrationCsv(B(["MI0003,a,2026-12-01,PASS,W-1,,"], 5), "sato", db).imported, 0);
+  });
+  it("parses dates", () => {
+    assert.equal(parseDate("R8.1.2"), "2026-01-02");
+    assert.equal(parseDate("2026/1/2"), "2026-01-02");
+    assert.equal(parseDate("2026-02-30"), undefined);
+  });
+});
