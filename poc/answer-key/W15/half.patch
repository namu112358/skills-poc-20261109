+function splitCsv(line: string): string[] {
+  const out: string[] = [];
+  let cur = "";
+  let q = false;
+  for (let i = 0; i < line.length; i++) {
+    const c = line[i];
+    if (q) {
+      if (c === '"' && line[i + 1] === '"') { cur += '"'; i++; } else if (c === '"') q = false; else cur += c;
+    } else if (c === '"') q = true;
+    else if (c === ",") { out.push(cur.trim()); cur = ""; } else cur += c;
+  }
+  out.push(cur.trim());
+  return out;
+}
+
+export function parseDate(v: string): string | undefined {
+  const s = v.normalize("NFKC");
+  let m = s.match(/^(\d{4})[\/\-.](\d{1,2})[\/\-.](\d{1,2})$/);
+  let y: number, mo: number, d: number;
+  if (m) [y, mo, d] = [+m[1], +m[2], +m[3]];
+  else {
+    m = s.match(/^(R|H|令和|平成)(\d{1,2})[.年](\d{1,2})[.月](\d{1,2})日?$/);
+    if (!m) return undefined;
+    y = (m[1] === "R" || m[1] === "令和" ? 2018 : 1988) + +m[2];
+    [mo, d] = [+m[3], +m[4]];
+  }
+  const dt = new Date(Date.UTC(y, mo - 1, d));
+  if (dt.getUTCFullYear() !== y || dt.getUTCMonth() !== mo - 1 || dt.getUTCDate() !== d) return undefined;
+  return `${y}-${String(mo).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
+}
+
+export function normalizeNo(v: string): string {
+  let no = v.normalize("NFKC").toUpperCase();
+  if (/^[A-Z]{2}\d{4}$/.test(no)) no = `${no.slice(0, 2)}-${no.slice(2)}`;
+  return no;
+}
