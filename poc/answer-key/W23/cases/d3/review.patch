+import { buildDashboard } from "@/lib/dashboard";
+import { requireUser } from "@/lib/session";
+import type { Task } from "@/lib/tasks";
+
+function TaskList({ title, tasks, empty }: { title: string; tasks: Task[]; empty: string }) {
+  return (
+    <section>
+      <h2>{title}</h2>
+      {tasks.length === 0 ? (
+        <p>{empty}</p>
+      ) : (
+        <ul>
+          {tasks.map((t) => (
+            <li key={t.id}>
+              <a href={`/tasks/${t.id}`}>{t.title}</a>（期限 {t.dueDate}）
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  );
+}
+
+export default async function DashboardPage() {
+  const user = await requireUser();
+  const d = buildDashboard(user.id);
+  return (
+    <main>
+      <h1>{user.name} さんのダッシュボード</h1>
+      <section aria-label="ステータス別の件数">
+        <h2>ステータス別</h2>
+        <table>
+          <tbody>
+            {d.counts.map((c) => (
+              <tr key={c.status}>
+                <th>{c.label}</th>
+                <td data-testid={`count-${c.status}`}>{c.count} 件</td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+        <p data-testid="completion-rate">完了率 {d.completionRate}%</p>
+      </section>
+      <TaskList title="期限切れ" tasks={d.overdue} empty="期限切れのタスクはありません。" />
+      <TaskList title="今週が期限" tasks={d.dueThisWeek} empty="今週が期限のタスクはありません。" />
+      <p>
+        <a href="/tasks">タスク一覧へ</a>
+      </p>
+    </main>
+  );
+}
