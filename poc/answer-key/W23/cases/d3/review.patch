--- /dev/null
+++ b/tests/dashboard.test.ts
@@ -0,0 +1,68 @@
+import { beforeEach, describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { clearCache } from "../src/lib/cache.ts";
+import {
+  buildDashboard,
+  completionRate,
+  countByStatus,
+  dueThisWeek,
+  listAssignedTasks,
+  overdueTasks,
+} from "../src/lib/dashboard.ts";
+import { openDb } from "../src/lib/db/index.ts";
+import type { Task } from "../src/lib/tasks.ts";
+import { addDays, todayJst, weekRange } from "../src/lib/week.ts";
+
+// 日本時間 2026-11-11（水）10:00
+const now = new Date("2026-11-11T10:00:00+09:00");
+const task = (id: number, status: Task["status"], dueDate: string): Task => ({
+  id,
+  title: `t${id}`,
+  status,
+  assignee: "sato",
+  dueDate,
+});
+
+beforeEach(() => clearCache());
+
+describe("week", () => {
+  it("uses the Japanese date", () => {
+    assert.equal(todayJst(new Date("2026-11-10T16:00:00Z")), "2026-11-11");
+  });
+  it("adds days across months", () => {
+    assert.equal(addDays("2026-11-30", 1), "2026-12-01");
+  });
+  it("returns Monday to Sunday of this week", () => {
+    assert.deepEqual(weekRange(now), { start: "2026-11-09", end: "2026-11-15" });
+  });
+});
+
+describe("dashboard", () => {
+  it("lists only the user's tasks", () => {
+    const tasks = listAssignedTasks("sato", openDb());
+    assert.equal(tasks.length, 3);
+    assert.ok(tasks.every((t) => t.assignee === "sato"));
+  });
+
+  it("counts tasks by status with done first", () => {
+    const counts = countByStatus([task(1, "done", "2026-11-01"), task(2, "todo", "2026-11-20")]);
+    assert.equal(counts[0].status, "done");
+    assert.equal(counts.find((c) => c.status === "todo")?.count, 1);
+  });
+
+  it("computes the completion rate", () => {
+    assert.equal(completionRate([task(1, "done", "2026-11-01"), task(2, "todo", "2026-11-20")]), 50);
+  });
+
+  it("finds overdue and this week's tasks", () => {
+    const tasks = [task(1, "todo", "2026-11-10"), task(2, "todo", "2026-11-13"), task(3, "done", "2026-11-09")];
+    assert.deepEqual(overdueTasks(tasks, now).map((t) => t.id), [1]);
+    assert.deepEqual(dueThisWeek(tasks, now).map((t) => t.id), [1, 2]);
+  });
+
+  it("builds the dashboard for a user", () => {
+    const d = buildDashboard("sato", openDb(), now);
+    assert.equal(d.userId, "sato");
+    assert.equal(d.counts.reduce((n, c) => n + c.count, 0), 3);
+  });
+});
