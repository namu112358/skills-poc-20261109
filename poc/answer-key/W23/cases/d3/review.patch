diff --git a/src/lib/week.ts b/src/lib/week.ts
new file mode 100644
index 0000000..8d70f2e
--- /dev/null
+++ b/src/lib/week.ts
@@ -0,0 +1,22 @@
+// 週の範囲（月曜〜日曜）を、日本時間の日付（YYYY-MM-DD）で求める。
+const JST_DATE = new Intl.DateTimeFormat("sv-SE", { timeZone: "Asia/Tokyo" });
+
+/** 日本時間の今日の日付（YYYY-MM-DD）。 */
+export function todayJst(now: Date = new Date()): string {
+  return JST_DATE.format(now);
+}
+
+/** 日付（YYYY-MM-DD）に日数を足す。 */
+export function addDays(date: string, days: number): string {
+  const d = new Date(`${date}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + days);
+  return d.toISOString().slice(0, 10);
+}
+
+/** 今週（月曜はじまり）の月曜と日曜の日付。 */
+export function weekRange(now: Date = new Date()): { start: string; end: string } {
+  const today = todayJst(now);
+  const dow = new Date(`${today}T00:00:00Z`).getUTCDay(); // 0 = 日曜
+  const start = addDays(today, 1 - dow);
+  return { start, end: addDays(start, 6) };
+}
diff --git a/tests/comments.test.ts b/tests/comments.test.ts
new file mode 100644
