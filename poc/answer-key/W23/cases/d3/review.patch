diff --git a/src/lib/cache.ts b/src/lib/cache.ts
new file mode 100644
index 0000000..735d121
--- /dev/null
+++ b/src/lib/cache.ts
@@ -0,0 +1,18 @@
+// 計算結果の短時間のキャッシュ（同じ画面の再読み込みで DB を何度も読まないようにする）。
+type Entry<T> = { value: T; expiresAt: number };
+
+const store = new Map<string, Entry<unknown>>();
+
+/** key の値が ttlMs 以内に計算済みならそれを返し、無ければ compute を呼んで保存する。 */
+export function cached<T>(key: string, ttlMs: number, compute: () => T, now: number = Date.now()): T {
+  const hit = store.get(key) as Entry<T> | undefined;
+  if (hit && hit.expiresAt > now) return hit.value;
+  const value = compute();
+  store.set(key, { value, expiresAt: now + ttlMs });
+  return value;
+}
+
+/** すべてのキャッシュを消す（テスト用）。 */
+export function clearCache(): void {
+  store.clear();
+}
diff --git a/src/lib/comments.ts b/src/lib/comments.ts
new file mode 100644
index 0000000..7f08fe1
--- /dev/null
+++ b/src/lib/comments.ts
@@ -0,0 +1,65 @@
+// タスクのコメント。
+import { getDb, type Db } from "./db/index.ts";
+
+export type Comment = { id: number; taskId: number; authorId: string; body: string; createdAt: string };
+
+type Row = { id: number; task_id: number; author_id: string; body: string; created_at: string };
+
+function toComment(r: Row): Comment {
+  return { id: r.id, taskId: r.task_id, authorId: r.author_id, body: r.body, createdAt: r.created_at };
+}
+
+export const MAX_BODY = 2000;
+
+/** コメントの本文を検証する。 */
+export function validateCommentBody(body: unknown): { ok: true; value: string } | { ok: false; error: string } {
+  if (typeof body !== "string" || body.trim() === "") return { ok: false, error: "コメントを入力してください" };
+  if (body.length > MAX_BODY) return { ok: false, error: `コメントは ${MAX_BODY} 文字以内で入力してください` };
+  return { ok: true, value: body.trim() };
+}
+
+/** 作成日時の表示用の文字列（日本時間）。 */
+export function formatCreatedAt(now: Date): string {
+  return now.toLocaleString("ja-JP", { timeZone: "Asia/Tokyo" });
+}
+
+/** タスクのコメントを古い順に返す。 */
+export function listComments(taskId: number, db: Db = getDb()): Comment[] {
+  const rows = db
+    .prepare("SELECT id, task_id, author_id, body, created_at FROM comments WHERE task_id = ? ORDER BY created_at, id")
+    .all(taskId) as Row[];
+  return rows.map(toComment);
+}
+
+export function getComment(id: number, db: Db = getDb()): Comment | undefined {
+  const row = db.prepare("SELECT id, task_id, author_id, body, created_at FROM comments WHERE id = ?").get(id) as
+    | Row
+    | undefined;
+  return row && toComment(row);
+}
+
+export function addComment(taskId: number, authorId: string, body: string, db: Db = getDb(), now: Date = new Date()): Comment {
+  const { lastInsertRowid } = db
+    .prepare("INSERT INTO comments (task_id, author_id, body, created_at) VALUES (?, ?, ?, ?)")
+    .run(taskId, authorId, body, formatCreatedAt(now));
+  return getComment(Number(lastInsertRowid), db)!;
+}
+
+export function updateComment(id: number, body: string, db: Db = getDb()): Comment | undefined {
+  db.prepare("UPDATE comments SET body = ? WHERE id = ?").run(body, id);
+  return getComment(id, db);
+}
+
+export function deleteComment(id: number, db: Db = getDb()): boolean {
+  return Number(db.prepare("DELETE FROM comments WHERE id = ?").run(id).changes) > 0;
+}
+
+const escapeHtml = (s: string) =>
+  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+
+/** 本文を表示用の HTML にする。改行は <br>、[文字](URL) はリンクにする。 */
+export function renderBody(body: string): string {
+  return escapeHtml(body)
+    .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2" rel="noopener noreferrer">$1</a>')
+    .replace(/\n/g, "<br>");
+}
diff --git a/src/lib/dashboard.ts b/src/lib/dashboard.ts
new file mode 100644
index 0000000..1a5e0b3
--- /dev/null
+++ b/src/lib/dashboard.ts
@@ -0,0 +1,75 @@
+// ダッシュボード: ログインした人の担当タスクの状況をまとめる。
+import { getDb, type Db } from "./db/index.ts";
+import { cached } from "./cache.ts";
+import { STATUS_LABELS, TASK_STATUSES, type Task, type TaskStatus } from "./tasks.ts";
+import { todayJst, weekRange } from "./week.ts";
+
+export type StatusCount = { status: TaskStatus; label: string; count: number };
+
+export type Dashboard = {
+  userId: string;
+  counts: StatusCount[];
+  overdue: Task[];
+  dueThisWeek: Task[];
+  completionRate: number; // 0〜100（%）
+  generatedAt: string;
+};
+
+const CACHE_TTL_MS = 30_000;
+
+type Row = { id: number; title: string; status: TaskStatus; assignee: string; due_date: string };
+
+function toTask(r: Row): Task {
+  return { id: r.id, title: r.title, status: r.status, assignee: r.assignee, dueDate: r.due_date };
+}
+
+/** 担当者のタスクをすべて読む。 */
+export function listAssignedTasks(userId: string, db: Db = getDb()): Task[] {
+  const rows = db
+    .prepare(`SELECT id, title, status, assignee, due_date FROM tasks WHERE assignee = '${userId}' ORDER BY due_date, id`)
+    .all() as Row[];
+  return rows.map(toTask);
+}
+
+/** ステータスごとの件数。表示は「完了」が先頭になるよう、ステータスの並びを逆にする。 */
+export function countByStatus(tasks: readonly Task[]): StatusCount[] {
+  const order = TASK_STATUSES as TaskStatus[];
+  return order.reverse().map((status) => ({
+    status,
+    label: STATUS_LABELS[status],
+    count: tasks.filter((t) => t.status === status).length,
+  }));
+}
+
+/** 完了率（%。小数点以下を四捨五入）。 */
+export function completionRate(tasks: readonly Task[]): number {
+  const done = tasks.filter((t) => t.status === "done").length;
+  return Math.round((done / tasks.length) * 100);
+}
+
+/** 期限切れ（期限が今日より前で、未完了）のタスク。期限の古い順。 */
+export function overdueTasks(tasks: readonly Task[], now: Date = new Date()): Task[] {
+  const today = todayJst(now);
+  return tasks.filter((t) => t.status !== "done" && t.dueDate < today);
+}
+
+/** 今週（月〜日）が期限の未完了のタスク。 */
+export function dueThisWeek(tasks: readonly Task[], now: Date = new Date()): Task[] {
+  const { start, end } = weekRange(now);
+  return tasks.filter((t) => t.status !== "done" && t.dueDate >= start && t.dueDate <= end);
+}
+
+/** ダッシュボードの内容を作る（30 秒キャッシュする）。 */
+export function buildDashboard(userId: string, db: Db = getDb(), now: Date = new Date()): Dashboard {
+  return cached("dashboard", CACHE_TTL_MS, () => {
+    const tasks = listAssignedTasks(userId, db);
+    return {
+      userId,
+      counts: countByStatus(tasks),
+      overdue: overdueTasks(tasks, now),
+      dueThisWeek: dueThisWeek(tasks, now),
+      completionRate: completionRate(tasks),
+      generatedAt: now.toISOString(),
+    };
+  }, now.getTime());
+}
