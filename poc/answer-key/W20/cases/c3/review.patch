@@ -0,0 +1,18 @@
+// GET /api/locations — 設置場所マスタの一覧（使用終了を含む。active で見分ける）/ POST /api/locations — 場所を追加する。いずれもログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { createLocation, listLocations, validateLocationInput } from "@/lib/location-master";
+
+export async function GET() {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  return NextResponse.json({ locations: listLocations() });
+}
+
+export async function POST(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const result = validateLocationInput(await readJson(request));
+  if (!result.ok) return jsonError(result.conflict ? 409 : 400, result.conflict ? result.errors[0] : "入力内容に誤りがあります", result.conflict ? undefined : result.errors);
+  return NextResponse.json({ location: createLocation(result.value.name!) }, { status: 201 });
+}
