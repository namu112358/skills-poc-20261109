+    assert.deepEqual(validateInstrumentInput({ locationId: id }, { partial: true }, db), { ok: true, value: { locationId: id } });
+    assert.deepEqual(validateInstrumentInput({ locationId: null }, { partial: true }, db), {
+      ok: true,
+      value: { locationId: null, locationOriginal: "" },
+    });
+  });
+
+  it("存在しない場所・使用終了の場所・数値でない値はエラー", () => {
+    const db = openDb();
+    const id = kouji(db).id;
+    updateLocation(id, { active: false }, db);
+    for (const v of [id, 9999, "1", 1.5, 0]) {
+      assert.equal(validateInstrumentInput({ locationId: v }, { partial: true }, db).ok, false, String(v));
+    }
+  });
+
+  it("すでに使用終了の場所に結び付いている計測器は、同じ場所のままなら送り直せる", () => {
+    const db = openDb();
+    const id = kouji(db).id;
+    updateLocation(id, { active: false }, db);
+    assert.equal(validateInstrumentInput({ locationId: id }, { partial: true, currentLocationId: id }, db).ok, true);
+  });
+
+  it("従来の location 文字列: 正式な場所と分かれば確定、分からなければ確認中、空なら未設定", () => {
+    const db = openDb();
+    const id = kouji(db).id;
+    assert.deepEqual(validateInstrumentInput({ location: "工事　倉庫" }, { partial: true }, db), {
+      ok: true,
+      value: { locationId: id, locationOriginal: "工事　倉庫" },
+    });
+    assert.deepEqual(validateInstrumentInput({ location: "不明" }, { partial: true }, db), {
+      ok: true,
+      value: { locationId: null, locationOriginal: "不明" },
+    });
+    assert.deepEqual(validateInstrumentInput({ location: "  " }, { partial: true }, db), {
+      ok: true,
+      value: { locationId: null, locationOriginal: "" },
+    });
+    assert.equal(validateInstrumentInput({ location: "x".repeat(101) }, { partial: true }, db).ok, false);
+    assert.equal(validateInstrumentInput({ location: 5 }, { partial: true }, db).ok, false);
+  });
+
+  it("使用終了の場所に結び付いた計測器へ、同じ場所名の location 文字列が来ても確認中に戻さない", () => {
+    const db = openDb();
+    const id = kouji(db).id;
+    updateLocation(id, { active: false }, db);
+    const r = validateInstrumentInput({ location: "工事部 倉庫" }, { partial: true, currentLocationId: id }, db);
+    assert.deepEqual(r, { ok: true, value: { locationId: id, locationOriginal: "工事部 倉庫" } });
+    // 現在の場所でなければ、使用終了の場所には確定しない。
+    const other = validateInstrumentInput({ location: "工事部 倉庫" }, { partial: true }, db);
+    assert.deepEqual(other, { ok: true, value: { locationId: null, locationOriginal: "工事部 倉庫" } });
+  });
+
+  it("locationId と location の両方があるときは locationId を使う", () => {
+    const db = openDb();
+    const id = kouji(db).id;
+    assert.deepEqual(validateInstrumentInput({ locationId: id, location: "不明" }, { partial: true }, db), {
+      ok: true,
+      value: { locationId: id },
+    });
+  });
+
+  it("場所を選ぶと確認中が解消され、他の項目は変わらない", () => {
+    const db = openDb();
+    const { unconfirmed } = withPending(db);
+    const updated = updateInstrument(unconfirmed.id, { locationId: kouji(db).id }, db)!;
+    assert.equal(updated.location, "工事部 倉庫");
+    assert.equal(updated.locationUnconfirmed, false);
+    assert.equal(updated.name, "抵抗計");
+  });
+
+  it("未設定にすると元の文字列も消え、確認中の一覧に出ない", () => {
+    const db = openDb();
+    const { unconfirmed } = withPending(db);
+    updateInstrument(unconfirmed.id, { locationId: null, locationOriginal: "" }, db);
+    assert.equal(listInstruments({ location: "unconfirmed" }, db).length, 0);
+  });
+
+  it("他の項目だけを更新しても、確認中の元の文字列は残る", () => {
+    const db = openDb();
+    const { unconfirmed } = withPending(db);
+    const updated = updateInstrument(unconfirmed.id, { status: "suspended" }, db)!;
+    assert.equal(updated.location, "倉庫");
+    assert.equal(updated.locationUnconfirmed, true);
+  });
+});
