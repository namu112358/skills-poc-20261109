+"use client";
+// 計測器の設置場所を、場所マスタの一覧から選んで保存する。使用終了の場所は選べない。
+import { useState, type FormEvent } from "react";
+
+// disabled = 使用終了の場所。いま結び付いているときだけ、選ばれた状態で表示する（新しくは選べない）。
+type Option = { id: number; name: string; disabled?: boolean };
+
+export function LocationForm({
+  instrumentId,
+  currentLocationId,
+  options,
+}: {
+  instrumentId: number;
+  currentLocationId: number | null;
+  options: Option[];
+}) {
+  const [value, setValue] = useState(currentLocationId === null ? "" : String(currentLocationId));
+  const [message, setMessage] = useState<{ kind: "success" | "error"; text: string } | undefined>();
+
+  async function save(e: FormEvent) {
+    e.preventDefault();
+    try {
+      const res = await fetch(`/api/instruments/${instrumentId}`, {
+        method: "PATCH",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ locationId: value === "" ? null : Number(value) }),
+      });
+      if (res.ok) {
+        setMessage({ kind: "success", text: "設置場所を保存しました。" });
+        // 表示中の設置場所・確認中の表示を最新にする。
+        window.location.reload();
+        return;
+      }
+      const data = await res.json().catch(() => ({}));
+      setMessage({ kind: "error", text: data.details?.join("、") ?? data.error ?? "保存できませんでした。" });
+    } catch {
+      setMessage({ kind: "error", text: "通信に失敗しました。もう一度お試しください。" });
+    }
+  }
+
+  return (
+    <form onSubmit={save} aria-label="設置場所の変更">
+      <label>
+        設置場所を変更{" "}
+        <select value={value} onChange={(e) => setValue(e.target.value)}>
+          <option value="">未設定</option>
+          {options.map((o) => (
+            <option key={o.id} value={o.id} disabled={o.disabled}>
+              {o.disabled ? `${o.name}（使用終了）` : o.name}
+            </option>
+          ))}
+        </select>
+      </label>{" "}
+      <button type="submit">保存する</button>
+      {message && <p role={message.kind === "error" ? "alert" : "status"}>{message.text}</p>}
+    </form>
+  );
+}
