diff --git a/src/lib/location-master.ts b/src/lib/location-master.ts
new file mode 100644
index 0000000..2115a19
--- /dev/null
+++ b/src/lib/location-master.ts
@@ -0,0 +1,90 @@
+// 設置場所マスタの登録・変更。場所は削除しない（過去の記録で使っているため）。使わなくなったら「使用終了」にする。
+import { getDb, type Db } from "./db/index.ts";
+import { normalizeLocationKey } from "./locations.ts";
+
+export type Location = {
+  id: number;
+  name: string;
+  active: boolean; // false = 使用終了
+  instrumentCount: number; // この場所に結び付いた計測器の数
+};
+
+type LocationRow = { id: number; name: string; active: number; instrument_count: number };
+
+const SELECT_LOCATIONS = `
+  SELECT l.id, l.name, l.active, (SELECT COUNT(*) FROM instruments i WHERE i.location_id = l.id) AS instrument_count
+  FROM locations l`;
+
+function toLocation(row: LocationRow): Location {
+  return { id: row.id, name: row.name, active: row.active === 1, instrumentCount: row.instrument_count };
+}
+
+export function listLocations(db: Db = getDb()): Location[] {
+  return (db.prepare(`${SELECT_LOCATIONS} ORDER BY l.id`).all() as LocationRow[]).map(toLocation);
+}
+
+export function getLocation(id: number, db: Db = getDb()): Location | undefined {
+  const row = db.prepare(`${SELECT_LOCATIONS} WHERE l.id = ?`).get(id) as LocationRow | undefined;
+  return row && toLocation(row);
+}
+
+/** 名称の空白（全角を含む）を半角スペース 1 つに揃える。 */
+export function tidyLocationName(name: string): string {
+  return name.replace(/\s+/g, " ").trim();
+}
+
+export type LocationInput = { name?: string; active?: boolean };
+
+export type LocationValidation =
+  | { ok: true; value: LocationInput }
+  | { ok: false; errors: string[]; conflict?: boolean };
+
+/**
+ * 場所の登録・変更の入力を検証する。partial = true（変更）のときは、送られた項目だけを検証する。
+ * 表記だけが違う同じ名称（例: 「製造部第１ライン」）は重複として conflict を返す（currentId の場所自身は除く）。
+ */
+export function validateLocationInput(
+  body: unknown,
+  options: { partial?: boolean; currentId?: number } = {},
+  db: Db = getDb(),
+): LocationValidation {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const b = body as Record<string, unknown>;
+  const value: LocationInput = {};
+  const errors: string[] = [];
+  if (!options.partial || "name" in b) {
+    const name = typeof b.name === "string" ? tidyLocationName(b.name) : "";
+    if (name === "" || name.length > 100) errors.push("場所の名称は 1〜100 文字で入力してください");
+    else value.name = name;
+  }
+  if ("active" in b) {
+    if (typeof b.active !== "boolean") errors.push("使用中か使用終了かが正しくありません");
+    else value.active = b.active;
+  }
+  if (options.partial && !("name" in b) && !("active" in b)) errors.push("変更する項目を指定してください");
+  if (errors.length > 0) return { ok: false, errors };
+  if (value.name !== undefined) {
+    const key = normalizeLocationKey(value.name);
+    const others = listLocations(db).filter((l) => l.id !== options.currentId);
+    if (others.some((l) => normalizeLocationKey(l.name) === key)) {
+      return { ok: false, errors: ["同じ場所がすでに登録されています"], conflict: true };
+    }
+  }
+  return { ok: true, value };
+}
+
+export function createLocation(name: string, db: Db = getDb()): Location {
+  const { lastInsertRowid } = db.prepare("INSERT INTO locations (name) VALUES (?)").run(tidyLocationName(name));
+  return getLocation(Number(lastInsertRowid), db)!;
+}
+
+/** 名称の変更・使用終了（再開）。場所が無ければ undefined。 */
+export function updateLocation(id: number, changes: LocationInput, db: Db = getDb()): Location | undefined {
+  const current = getLocation(id, db);
+  if (!current) return undefined;
+  const next = { ...current, ...changes };
+  db.prepare("UPDATE locations SET name = ?, active = ? WHERE id = ?").run(next.name, next.active ? 1 : 0, id);
+  return getLocation(id, db);
+}
