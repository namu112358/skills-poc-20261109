+// 設置場所マスタ。表記ゆれの正規化と照合は、移行・ハンディ端末・API で共通に使う。
+// 方針: 同じ場所と分かるものだけを正式な場所に寄せる（完全一致のみ）。推測で寄せない。
+
+import type { Db } from "./db/index.ts";
+
+const DEPARTMENTS: [RegExp, string][] = [
+  [/^(製造部|製造)/, "製造部"],
+  [/^(工事部|工事)/, "工事部"],
+  [/^(技術部|技術)/, "技術部"],
+  [/^(品質保証部|品質保証|品証|品保)/, "品質保証部"],
+];
+
+const KANJI_DIGITS: Record<string, string> = { 一: "1", 二: "2", 三: "3" };
+
+// 末尾が切れた表記（現場で多い）。他に該当する場所が無いものだけ。
+const ALIASES: Record<string, string> = { 大阪営: "大阪営業所", 名古屋営: "名古屋営業所" };
+
+/** 表記ゆれをならした照合用のキー。空白だけの文字列は空文字になる。 */
+export function normalizeLocationKey(text: string): string {
+  let key = text.normalize("NFKC").replace(/\s+/g, "");
+  key = key.replace(/(第|車両)([一二三])/g, (_m, head: string, d: string) => head + KANJI_DIGITS[d]);
+  key = key.replace(/号車$/, "号");
+  for (const [re, canonical] of DEPARTMENTS) {
+    if (re.test(key)) {
+      key = key.replace(re, canonical);
+      break;
+    }
+  }
+  return ALIASES[key] ?? key;
+}
+
+export type LinkResult = { total: number; linked: number; unset: number; unconfirmed: number };
+
+/**
+ * 場所が未確定（location_id が NULL）の計測器を、使用中の場所と照合して結び付ける。
+ * 一致したものだけ location_id を設定し、元の文字列（location 列）は変えない。何度実行しても結果は同じ。
+ * 戻り値は全計測器の内訳（確定・未設定・確認中）。
+ */
+export function linkInstrumentsToLocations(db: Db): LinkResult {
+  const locations = db.prepare("SELECT id, name FROM locations WHERE active = 1").all() as { id: number; name: string }[];
+  const pending = db.prepare("SELECT id, location FROM instruments WHERE location_id IS NULL").all() as { id: number; location: string }[];
+  const update = db.prepare("UPDATE instruments SET location_id = ? WHERE id = ?");
+  for (const row of pending) {
+    const locationId = matchLocationName(row.location, locations);
+    if (locationId !== undefined) update.run(locationId, row.id);
+  }
+  const count = (where: string) => (db.prepare(`SELECT COUNT(*) AS n FROM instruments WHERE ${where}`).get() as { n: number }).n;
+  return {
+    total: count("1 = 1"),
+    linked: count("location_id IS NOT NULL"),
+    unset: count("location_id IS NULL AND TRIM(location, ' \t\r\n　') = ''"),
+    unconfirmed: count("location_id IS NULL AND TRIM(location, ' \t\r\n　') <> ''"),
+  };
+}
+
+/** 文字列が正式な場所のどれと同じかを返す。決められなければ undefined。 */
+export function matchLocationName(text: string, locations: readonly { id: number; name: string }[]): number | undefined {
+  const key = normalizeLocationKey(text);
+  if (key === "") return undefined;
+  return locations.find((l) => normalizeLocationKey(l.name) === key)?.id;
+}
