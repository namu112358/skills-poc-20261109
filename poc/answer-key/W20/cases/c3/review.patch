+
+/** マイグレーション 4 までの本番相当の DB に、表記ゆれのある計測器を入れる。 */
+function legacyDb(locations: string[]): DatabaseSync {
+  const db = new DatabaseSync(":memory:");
+  db.exec("PRAGMA foreign_keys = ON");
+  migrate(db, MIGRATIONS.filter((m) => m.version <= 4));
+  db.exec("INSERT INTO departments (id, name) VALUES ('qa', '品質保証部')");
+  db.exec("INSERT INTO users (id, name, department_id) VALUES ('sato', '佐藤', 'qa')");
+  const insert = db.prepare(
+    "INSERT INTO instruments (management_no, name, location, manager_id, interval_months, last_calibrated_on) VALUES (?, 'x', ?, 'sato', 12, '2026-01-01')",
+  );
+  locations.forEach((l, i) => insert.run(`MI-${String(i + 1).padStart(4, "0")}`, l));
+  return db;
+}
+
+function row(db: DatabaseSync, no: string) {
+  const r = db
+    .prepare("SELECT l.name AS name, i.location AS location FROM instruments i LEFT JOIN locations l ON l.id = i.location_id WHERE management_no = ?")
+    .get(no) as { name: string | null; location: string };
+  return { name: r.name, location: r.location };
+}
+
+describe("マイグレーション 5（場所マスタ）", () => {
+  it("正式な 16 か所を登録する", () => {
+    const db = openDb(":memory:", { seed: false });
+    const names = listLocations(db).map((l) => l.name);
+    assert.deepEqual(names.sort(), [...OFFICIAL].sort());
+    assert.ok(listLocations(db).every((l) => l.active));
+  });
+
+  it("既存の計測器を、同じ場所と分かるものだけ場所に結び付け、元の文字列を残す", () => {
+    const db = legacyDb(["製造部第１ライン", "倉庫", "", "　", "不明", "品証 測定室", "A社 貸出中"]);
+    migrate(db);
+    assert.deepEqual(row(db, "MI-0001"), { name: "製造部 第 1 ライン", location: "製造部第１ライン" });
+    assert.deepEqual(row(db, "MI-0002"), { name: null, location: "倉庫" });
+    assert.deepEqual(row(db, "MI-0003"), { name: null, location: "" });
+    assert.deepEqual(row(db, "MI-0004"), { name: null, location: "　" });
+    assert.deepEqual(row(db, "MI-0005"), { name: null, location: "不明" });
+    assert.deepEqual(row(db, "MI-0006"), { name: "品質保証部 測定室", location: "品証 測定室" });
+    assert.deepEqual(row(db, "MI-0007"), { name: null, location: "A社 貸出中" });
+  });
+
+  it("1 回だけ適用され、既存データを失わない（再実行しても結果が同じ）", () => {
+    const db = legacyDb(["製造部第１ライン", "倉庫"]);
+    migrate(db);
+    migrate(db);
+    assert.equal(listLocations(db).length, 16);
+    assert.equal((db.prepare("SELECT COUNT(*) AS n FROM instruments").get() as { n: number }).n, 2);
+  });
+
+  it("初期データの計測器も場所に結び付く", () => {
+    const db = openDb();
+    const unlinked = db.prepare("SELECT COUNT(*) AS n FROM instruments WHERE location_id IS NULL").get() as { n: number };
+    assert.equal(unlinked.n, 0);
+  });
+});
+
+describe("場所マスタの操作", () => {
+  it("追加すると使用中で登録され、名称の空白は 1 つに揃う", () => {
+    const db = openDb();
+    const created = createLocation("  技術部　第２  実験室 ", db);
+    assert.equal(created.name, "技術部 第２ 実験室");
+    assert.equal(created.active, true);
+  });
+
+  it("名称変更は結び付いた計測器の表示に反映される", () => {
+    const db = openDb();
+    const before = listLocations(db).find((l) => l.name === "工事部 倉庫")!;
+    assert.equal(before.instrumentCount, 3);
+    updateLocation(before.id, { name: "工事部 第一倉庫" }, db);
+    assert.equal(row(db, "MI-0002").name, "工事部 第一倉庫");
+  });
+
+  it("使用終了にしても削除されず、計測器との結び付きも残る", () => {
+    const db = openDb();
+    const loc = listLocations(db).find((l) => l.name === "工事部 倉庫")!;
+    const updated = updateLocation(loc.id, { active: false }, db)!;
+    assert.equal(updated.active, false);
+    assert.equal(updated.instrumentCount, 3);
+  });
+
+  it("存在しない ID の更新は undefined", () => {
+    assert.equal(updateLocation(9999, { active: false }, openDb()), undefined);
+  });
+});
+
+describe("validateLocationInput", () => {
+  it("名称は 1〜100 文字", () => {
+    const db = openDb();
+    assert.equal(validateLocationInput({ name: "" }, {}, db).ok, false);
+    assert.equal(validateLocationInput({ name: "　 " }, {}, db).ok, false);
+    assert.equal(validateLocationInput({ name: "あ".repeat(101) }, {}, db).ok, false);
+    assert.equal(validateLocationInput({ name: "あ".repeat(100) }, {}, db).ok, true);
+    assert.equal(validateLocationInput({}, {}, db).ok, false);
+    assert.equal(validateLocationInput(null, {}, db).ok, false);
+  });
+
+  it("表記だけが違う同じ名称は重複（conflict）", () => {
+    const db = openDb();
+    const result = validateLocationInput({ name: "製造部第１ライン" }, {}, db);
+    assert.equal(result.ok, false);
+    assert.equal(!result.ok && result.conflict, true);
+  });
+
+  it("更新では自分自身と同じ名称は重複にならず、使用終了は active で指定する", () => {
+    const db = openDb();
+    const loc = listLocations(db)[0];
+    const same = validateLocationInput({ name: loc.name }, { partial: true, currentId: loc.id }, db);
+    assert.equal(same.ok, true);
+    const active = validateLocationInput({ active: false }, { partial: true, currentId: loc.id }, db);
+    assert.deepEqual(active.ok && active.value, { active: false });
+    assert.equal(validateLocationInput({ active: "no" }, { partial: true, currentId: loc.id }, db).ok, false);
+    assert.equal(validateLocationInput({}, { partial: true, currentId: loc.id }, db).ok, false);
+  });
+});
diff --git a/tests/locations-real-data.test.ts b/tests/locations-real-data.test.ts
