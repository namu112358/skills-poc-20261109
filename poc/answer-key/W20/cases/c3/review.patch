+  getInstrument,
+  listInstruments,
+  locationLabel,
+  parseLocationFilter,
+  updateInstrument,
+  validateInstrumentInput,
+} from "../src/lib/instruments.ts";
+
+type TestDb = ReturnType<typeof openDb>;
+
+const VALID = {
+  managementNo: "MI-0100",
+  name: "抵抗計",
+  model: "",
+  note: "",
+  status: "in_use" as const,
+  managerId: "sato",
+  intervalMonths: 12,
+  lastCalibratedOn: "2026-04-01",
+};
+
+const kouji = (db: TestDb) => listLocations(db).find((l) => l.name === "工事部 倉庫")!;
+
+/** 確認中・未設定の計測器を用意する。 */
+function withPending(db: TestDb) {
+  const unconfirmed = createInstrument(
+    { ...VALID, managementNo: "MI-0101", locationId: null, locationOriginal: "倉庫" },
+    db,
+  );
+  const unset = createInstrument({ ...VALID, managementNo: "MI-0102", locationId: null, locationOriginal: "" }, db);
+  return { unconfirmed, unset };
+}
+
+describe("設置場所の表示と状態", () => {
+  it("確定は場所マスタの現在の名称、確認中は元の文字列、未設定は空", () => {
+    const db = openDb();
+    const { unconfirmed, unset } = withPending(db);
+    const confirmed = getInstrument(2, db)!;
+    assert.equal(confirmed.location, "工事部 倉庫");
+    assert.equal(confirmed.locationId, kouji(db).id);
+    assert.equal(confirmed.locationUnconfirmed, false);
+    assert.equal(unconfirmed.location, "倉庫");
+    assert.equal(unconfirmed.locationUnconfirmed, true);
+    assert.equal(unset.location, "");
+    assert.equal(unset.locationUnconfirmed, false);
+  });
+
+  it("空白だけの元の文字列は確認中ではなく未設定", () => {
+    const db = openDb();
+    const i = createInstrument({ ...VALID, locationId: null, locationOriginal: "　 " }, db);
+    assert.equal(i.locationUnconfirmed, false);
+    assert.equal(listInstruments({ location: "none" }, db).length, 1);
+    assert.equal(listInstruments({ location: "unconfirmed" }, db).length, 0);
+  });
+
+  it("場所の名称を変えると、結び付いた計測器の表示も変わる", () => {
+    const db = openDb();
+    updateLocation(kouji(db).id, { name: "工事部 第一倉庫" }, db);
+    assert.equal(getInstrument(2, db)?.location, "工事部 第一倉庫");
+  });
+});
+
+describe("locationLabel", () => {
+  it("確認中は（確認中）付き、未設定は「未設定」、確定は場所の名称", () => {
+    assert.equal(locationLabel({ location: "倉庫", locationUnconfirmed: true }), "倉庫（確認中）");
+    assert.equal(locationLabel({ location: "", locationUnconfirmed: false }), "未設定");
+    assert.equal(locationLabel({ location: "工事部 倉庫", locationUnconfirmed: false }), "工事部 倉庫");
+  });
+});
+
+describe("設置場所での絞り込み", () => {
+  it("確認中・未設定・場所の ID で絞り込む", () => {
+    const db = openDb();
+    const { unconfirmed, unset } = withPending(db);
+    assert.deepEqual(listInstruments({ location: "unconfirmed" }, db).map((i) => i.id), [unconfirmed.id]);
+    assert.deepEqual(listInstruments({ location: "none" }, db).map((i) => i.id), [unset.id]);
+    assert.deepEqual(
+      listInstruments({ location: kouji(db).id }, db).map((i) => i.managementNo),
+      ["MI-0002", "MI-0005", "MI-0006"],
+    );
+    assert.equal(listInstruments({}, db).length, 12);
+  });
+
+  it("parseLocationFilter は不正な値を指定なしにする", () => {
+    assert.equal(parseLocationFilter("unconfirmed"), "unconfirmed");
+    assert.equal(parseLocationFilter("none"), "none");
+    assert.equal(parseLocationFilter("3"), 3);
+    for (const v of ["0", "-1", "1.5", "abc", "", null, undefined, "3; DROP TABLE instruments"]) {
+      assert.equal(parseLocationFilter(v), undefined);
+    }
+  });
+});
+
+describe("設置場所の入力", () => {
+  it("locationId で場所を選べ、null で未設定になる", () => {
+    const db = openDb();
