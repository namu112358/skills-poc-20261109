@@ -0,0 +1,115 @@
+"use client";
+// 設置場所マスタの追加・名称変更・使用終了。操作は /api/locations を呼び、結果をメッセージで知らせる。
+import { useState, type FormEvent } from "react";
+
+type Location = { id: number; name: string; active: boolean; instrumentCount: number };
+type Message = { kind: "success" | "error"; text: string };
+
+async function call(url: string, method: string, body: unknown): Promise<{ ok: true; location: Location } | { ok: false; error: string }> {
+  try {
+    const res = await fetch(url, { method, headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
+    const data = await res.json().catch(() => ({}));
+    if (res.ok) return { ok: true, location: data.location };
+    const details = Array.isArray(data.details) ? `（${data.details.join("、")}）` : "";
+    return { ok: false, error: `${data.error ?? "保存できませんでした"}${details}` };
+  } catch {
+    return { ok: false, error: "通信に失敗しました。もう一度お試しください。" };
+  }
+}
+
+export function LocationManager({ initial }: { initial: Location[] }) {
+  const [locations, setLocations] = useState(initial);
+  const [message, setMessage] = useState<Message | undefined>();
+  const [newName, setNewName] = useState("");
+  const [editing, setEditing] = useState<{ id: number; name: string } | undefined>();
+
+  function replace(updated: Location) {
+    setLocations((list) => list.map((l) => (l.id === updated.id ? updated : l)));
+  }
+
+  async function add(e: FormEvent) {
+    e.preventDefault();
+    const r = await call("/api/locations", "POST", { name: newName });
+    if (!r.ok) return setMessage({ kind: "error", text: r.error });
+    setLocations((list) => [...list, r.location]);
+    setNewName("");
+    setMessage({ kind: "success", text: `「${r.location.name}」を追加しました。` });
+  }
+
+  async function rename(e: FormEvent) {
+    e.preventDefault();
+    if (!editing) return;
+    const r = await call(`/api/locations/${editing.id}`, "PATCH", { name: editing.name });
+    if (!r.ok) return setMessage({ kind: "error", text: r.error });
+    replace(r.location);
+    setEditing(undefined);
+    setMessage({ kind: "success", text: `名称を「${r.location.name}」に変更しました。` });
+  }
+
+  async function setActive(l: Location, active: boolean) {
+    const r = await call(`/api/locations/${l.id}`, "PATCH", { active });
+    if (!r.ok) return setMessage({ kind: "error", text: r.error });
+    replace(r.location);
