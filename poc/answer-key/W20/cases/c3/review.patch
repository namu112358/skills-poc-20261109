+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { matchLocationName, normalizeLocationKey } from "../src/lib/locations.ts";
+
+const MASTER = [
+  "品質保証部 測定室",
+  "品質保証部 校正待ち棚",
+  "工事部 倉庫",
+  "工事部 車両 1 号",
+  "工事部 車両 2 号",
+  "工事部 車両 3 号",
+  "製造部 第 1 ライン",
+  "製造部 第 2 ライン",
+  "製造部 第 3 ライン",
+  "製造部 恒温室",
+  "製造部 検査室",
+  "製造部 部品倉庫",
+  "技術部 試験室",
+  "技術部 電波暗室",
+  "大阪営業所",
+  "名古屋営業所",
+].map((name, i) => ({ id: i + 1, name }));
+
+const idOf = (name: string) => MASTER.find((m) => m.name === name)!.id;
+
+describe("matchLocationName: 同じ場所と分かる表記ゆれ", () => {
+  const cases: [string, string][] = [
+    ["製造部第１ライン", "製造部 第 1 ライン"],
+    ["製造第1ライン", "製造部 第 1 ライン"],
+    ["製造部 第 2 ライン ", "製造部 第 2 ライン"],
+    ["製造部 第三ライン", "製造部 第 3 ライン"],
+    ["製造部 第3ﾗｲﾝ", "製造部 第 3 ライン"],
+    ["製造部　第　2　ライン", "製造部 第 2 ライン"],
+    ["品証 測定室", "品質保証部 測定室"],
+    ["品保測定室", "品質保証部 測定室"],
+    ["品質保証 校正待ち棚", "品質保証部 校正待ち棚"],
+    ["工事部車両一号", "工事部 車両 1 号"],
+    ["工事部 車両3号車", "工事部 車両 3 号"],
+    ["工事 車両2号", "工事部 車両 2 号"],
+    ["工事倉庫", "工事部 倉庫"],
+    ["技術電波暗室", "技術部 電波暗室"],
+    ["製造部恒温室", "製造部 恒温室"],
+    ["製造部部品倉庫", "製造部 部品倉庫"],
+    ["大阪 営業所", "大阪営業所"],
+    ["大阪営", "大阪営業所"],
+    ["名古屋営", "名古屋営業所"],
+  ];
+  for (const [input, expected] of cases) {
+    it(`「${input}」→「${expected}」`, () => {
+      assert.equal(matchLocationName(input, MASTER), idOf(expected));
+    });
+  }
+});
+
+describe("matchLocationName: 場所を決められないものは寄せない", () => {
+  const cases = [
+    "倉庫",
+    "第2ライン",
+    "測定室",
+    "車両",
+    "工事部 倉庫 棚B",
+    "製造部 第 1 ライン 横",
+    "工事部倉庫（本社）",
+    "工事部 車両 5 号",
+    "大阪事務所",
+    "製造部品倉庫",
+    "名古屋営業所 倉庫",
+    "不明",
+    "?",
+    "-",
+    "A社 貸出中",
+    "東日本計測サービス（校正中）",
+    "品質保証部 測定室→工事部 倉庫",
+    "",
+    "　",
+  ];
+  for (const input of cases) {
+    it(`「${input}」は一致しない`, () => {
+      assert.equal(matchLocationName(input, MASTER), undefined);
+    });
+  }
+});
+
+describe("normalizeLocationKey", () => {
+  it("空白だけの文字列は空のキーになる", () => {
+    assert.equal(normalizeLocationKey(" 　 "), "");
+  });
+});
