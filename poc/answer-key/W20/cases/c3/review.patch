--- /dev/null
+++ b/tests/locations-real-data.test.ts
@@ -0,0 +1,73 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { openDb } from "../src/lib/db/index.ts";
+import { listLocations } from "../src/lib/location-master.ts";
+import { matchLocationName } from "../src/lib/locations.ts";
+
+// 本番の設置場所の値（docs/data/location-values.csv。2026-10 抽出）に対する照合の確認。
+const rows = readFileSync(new URL("../docs/data/location-values.csv", import.meta.url), "utf8")
+  .split(/\r?\n/)
+  .slice(1)
+  .filter((l) => l !== "")
+  .map((line) => {
+    const i = line.lastIndexOf(",");
+    return { value: line.slice(0, i), count: Number(line.slice(i + 1)) };
+  });
+
+describe("本番の設置場所の値との照合", () => {
+  const master = listLocations(openDb(":memory:", { seed: false }));
+  const matched = (value: string) => {
+    const id = matchLocationName(value, master);
+    return id === undefined ? undefined : master.find((m) => m.id === id)!.name;
+  };
+
+  it("CSV を読めている", () => {
+    assert.ok(rows.length > 150);
+    assert.equal(rows.reduce((n, r) => n + r.count, 0) > 40000, true);
+  });
+
+  it("どの場所か決められない値は、どの場所にも寄せない", () => {
+    const mustStay = [
+      "倉庫", "車両", "ライン", "第2ライン", "第 3 ライン", "第 4 ライン", "測定室", "検査室", "恒温室", "電波暗室", "本社", "現場", "不明", "?", "？", "-",
+      "要確認", "社外", "A社 貸出中", "東日本計測サービス（校正中）", "品質保証部 測定室→工事部 倉庫", "工事部 倉庫 棚B", "工事部倉庫（本社）",
+      "製造部 第 1 ライン 横", "品証 測定室 机上", "工事部 車両 5 号", "大阪事務所", "名古屋営業所 倉庫", "製造部品倉庫", "車両1号",
+    ];
+    for (const v of mustStay) {
+      assert.ok(rows.some((r) => r.value === v), `CSV に「${v}」が無い`);
+      assert.equal(matched(v), undefined, v);
+    }
+    for (const r of rows.filter((r) => r.value.trim() === "")) assert.equal(matched(r.value), undefined);
+  });
+
+  it("寄せた値は、すべて正式な場所の言い換えとして読める（誤って別の場所に寄せていない）", () => {
+    // 正式な場所ごとに、CSV で寄せた値に含まれる「場所を示す語」が一致していること。
+    const mustContain: Record<string, string[]> = {
+      "製造部 第 1 ライン": ["1", "１", "一"],
+      "製造部 第 2 ライン": ["2", "２", "二"],
+      "製造部 第 3 ライン": ["3", "３", "三"],
+      "工事部 車両 1 号": ["1", "１", "一"],
+      "工事部 車両 2 号": ["2", "２", "二"],
+      "工事部 車両 3 号": ["3", "３", "三"],
+    };
+    for (const r of rows) {
+      const name = matched(r.value);
+      if (!name) continue;
+      const tokens = mustContain[name];
+      if (tokens) assert.ok(tokens.some((t) => r.value.includes(t) || r.value.normalize("NFKC").includes(t)), `${r.value} → ${name}`);
+      const word = name.split(" ").pop()!.replace(/第 \d ライン|車両 \d 号/, "");
+      if (word && !["大阪営業所", "名古屋営業所"].includes(name)) {
+        // 「測定室」「倉庫」など場所の語（ライン・車両は上で確認）が値の中にあること。
+        const key = ["測定室", "校正待ち棚", "倉庫", "恒温室", "検査室", "部品倉庫", "試験室", "電波暗室"].find((w) => name.endsWith(w));
+        if (key) assert.ok(r.value.includes(key), `${r.value} → ${name}`);
+      }
+    }
+  });
+
+  it("件数の大半（85% 以上）は正式な場所に寄る", () => {
+    // 残りは空欄・「倉庫」だけ・「不明」など、場所を決められない値（2026-10 時点で約 10%）。
+    const total = rows.reduce((n, r) => n + r.count, 0);
+    const linked = rows.filter((r) => matched(r.value)).reduce((n, r) => n + r.count, 0);
+    assert.ok(linked / total > 0.85, `${linked}/${total}`);
+  });
+});
