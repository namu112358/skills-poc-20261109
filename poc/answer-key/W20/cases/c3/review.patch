+// PATCH /api/locations/:id — 場所の名称変更・使用終了（active: false）・再開（active: true）。ログインが必要。場所の削除はしない。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { getLocation, updateLocation, validateLocationInput } from "@/lib/location-master";
+import { parseId } from "@/lib/instruments";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function PATCH(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  if (id === undefined || !getLocation(id)) return jsonError(404, "場所が見つかりません");
+  const result = validateLocationInput(await readJson(request), { partial: true, currentId: id });
+  if (!result.ok) return jsonError(result.conflict ? 409 : 400, result.conflict ? result.errors[0] : "入力内容に誤りがあります", result.conflict ? undefined : result.errors);
+  return NextResponse.json({ location: updateLocation(id, result.value) });
+}
