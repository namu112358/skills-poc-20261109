+                  <form onSubmit={rename} aria-label={`${l.name}の名称変更`}>
+                    <label>
+                      名称{" "}
+                      <input
+                        value={editing.name}
+                        onChange={(e) => setEditing({ id: l.id, name: e.target.value })}
+                        maxLength={100}
+                        required
+                      />
+                    </label>{" "}
+                    <button type="submit">変更を保存</button>{" "}
+                    <button type="button" onClick={() => setEditing(undefined)}>
+                      取りやめ
+                    </button>
+                  </form>
+                ) : (
+                  l.name
+                )}
+              </td>
+              <td>{l.active ? "使用中" : "使用終了"}</td>
+              <td>{l.instrumentCount}</td>
+              <td>
+                <button type="button" onClick={() => setEditing({ id: l.id, name: l.name })}>
+                  名称を変更
+                </button>{" "}
+                <button type="button" onClick={() => setActive(l, !l.active)}>
+                  {l.active ? "使用終了にする" : "使用中に戻す"}
+                </button>
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </section>
+  );
+}
