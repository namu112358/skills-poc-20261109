+        CHECK (inspection_interval_months BETWEEN 1 AND 120);
+      ALTER TABLE instruments ADD COLUMN legacy_inspector TEXT; -- 旧データの点検者の書き方（担当者にできなかったもの）
+      CREATE INDEX instruments_inspector ON instruments(inspector_id);
+      CREATE TABLE inspection_records (
+        id               INTEGER PRIMARY KEY AUTOINCREMENT,
+        instrument_id    INTEGER NOT NULL REFERENCES instruments(id),
+        inspected_on     TEXT,                      -- YYYY-MM-DD。旧データで読めなかったときは NULL
+        inspector_id     TEXT REFERENCES users(id), -- 点検した人。旧データで分からないときは NULL
+        result           TEXT NOT NULL CHECK (result IN ('good', 'repair')), -- 良好 / 要修理
+        memo             TEXT NOT NULL DEFAULT '',
+        legacy_inspector TEXT,                      -- 旧データの点検者の書き方
+        legacy_date      TEXT,                      -- 旧データの点検日の書き方（読めなかったときだけ）
+        recorded_by      TEXT REFERENCES users(id), -- 登録者。旧データからの移行分は NULL
+        recorded_at      TEXT NOT NULL,             -- ISO 8601（UTC）
+        CHECK (inspected_on IS NOT NULL OR legacy_date IS NOT NULL)
+      );
+      CREATE INDEX inspection_records_instrument ON inspection_records(instrument_id, inspected_on);
+    `,
+    apply: (db) => importLegacyInspections(db),
+  },
 ];
diff --git a/src/lib/inspections-legacy.ts b/src/lib/inspections-legacy.ts
new file mode 100644
index 0000000..cd442a2
--- /dev/null
+++ b/src/lib/inspections-legacy.ts
@@ -0,0 +1,81 @@
+// 旧データ（instruments.extra の inspector / last_inspected）を、点検の担当者・点検記録へ移行する。
+// - 名前が利用者と一致するもの（「鈴木さん」のような敬称つきも）は、その人を担当者にする。
+// - 一致しないもの（「外部委託」など）は、元の書き方を legacy_inspector に残し、担当者は未設定にする。
+// - 日付が読めないものも、元の書き方を legacy_date に残す。黙って捨てない。
+// - extra は消さない。何度実行しても同じ結果になる（移行済みの計測器は飛ばす）。
+import type { Db } from "./db/index.ts";
+import { isValidDate } from "./dates.ts";
+
+/** 旧データの点検日を YYYY-MM-DD にする。読めなければ undefined。例: 2026-09-01 / 2026/8/20 / R8.9.10 */
+export function parseLegacyDate(text: string): string | undefined {
+  const t = text.trim().replace(/[０-９]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0));
+  let y: number, m: number, d: number;
+  const western = /^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})$/.exec(t);
+  const era = /^(令和|平成|R|H)\s*(\d{1,2})[-/.年]\s*(\d{1,2})[-/.月]\s*(\d{1,2})日?$/i.exec(t);
+  if (western) {
+    [y, m, d] = [Number(western[1]), Number(western[2]), Number(western[3])];
+  } else if (era) {
+    const base = era[1] === "令和" || era[1].toUpperCase() === "R" ? 2018 : 1988;
+    [y, m, d] = [base + Number(era[2]), Number(era[3]), Number(era[4])];
+  } else {
+    return undefined;
+  }
+  const iso = `${String(y).padStart(4, "0")}-${String(m).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
+  return isValidDate(iso) ? iso : undefined;
+}
+
+/** 点検者の書き方から、空白と敬称を除いた名前を返す。 */
+export function normalizeInspectorName(text: string): string {
+  return text.trim().replace(/[\s　]+/g, "").replace(/(さん|様|殿|氏)$/, "");
+}
+
+export function importLegacyInspections(db: Db, now: Date = new Date()): void {
+  const rows = db
+    .prepare(
+      `SELECT i.id, i.extra FROM instruments i
+       WHERE i.inspector_id IS NULL AND i.legacy_inspector IS NULL
+         AND NOT EXISTS (SELECT 1 FROM inspection_records r WHERE r.instrument_id = i.id)`,
+    )
+    .all() as { id: number; extra: string }[];
+  const findUsers = db.prepare("SELECT id FROM users WHERE name = ?");
+  const setInspector = db.prepare("UPDATE instruments SET inspector_id = ?, legacy_inspector = ? WHERE id = ?");
+  const insertRecord = db.prepare(
+    `INSERT INTO inspection_records (instrument_id, inspected_on, inspector_id, result, memo, legacy_inspector, legacy_date, recorded_by, recorded_at)
+     VALUES (?, ?, ?, 'good', ?, ?, ?, NULL, ?)`,
+  );
+  for (const row of rows) {
+    let extra: Record<string, unknown> = {};
+    try {
+      const v = JSON.parse(row.extra);
+      if (v && typeof v === "object" && !Array.isArray(v)) extra = v;
+    } catch {
+      continue;
+    }
+    const inspectorText = typeof extra.inspector === "string" ? extra.inspector.trim() : "";
+    const dateText = typeof extra.last_inspected === "string" ? extra.last_inspected.trim() : "";
+    if (inspectorText === "" && dateText === "") continue;
+
+    let inspectorId: string | null = null;
+    let legacyInspector: string | null = null;
+    if (inspectorText !== "") {
+      const matches = findUsers.all(normalizeInspectorName(inspectorText)) as { id: string }[];
+      if (matches.length === 1) inspectorId = matches[0].id;
+      else legacyInspector = inspectorText;
+    }
+    setInspector.run(inspectorId, legacyInspector, row.id);
+
+    if (dateText !== "") {
+      const date = parseLegacyDate(dateText);
+      // 旧データには結果が無いので「良好」で移行し、メモに移行したことを残す
+      insertRecord.run(
+        row.id,
+        date ?? null,
+        inspectorId,
+        "旧データから移行（結果の記載なし）",
+        inspectorText !== "" ? inspectorText : null,
+        date ? null : dateText,
+        now.toISOString(),
+      );
+    }
+  }
+}
diff --git a/src/lib/inspections.ts b/src/lib/inspections.ts
new file mode 100644
index 0000000..80a8866
--- /dev/null
+++ b/src/lib/inspections.ts
@@ -0,0 +1,249 @@
+// 定期点検。計測器ごとに点検の担当者と周期（月）を持ち、点検の記録を履歴として残す。
+// - 結果は良好（good）か要修理（repair）。要修理なら計測器は使用停止になる（校正の不合格と同じ扱い）。
+// - 次の点検予定日 = 最後の点検日 + 周期。点検日の分かる記録が 1 件も無ければ「未点検」。
+import { getDb, transaction, type Db } from "./db/index.ts";
+import { addMonths, isValidDate, todayJst } from "./dates.ts";
+import { getInstrument, type ValidationResult } from "./instruments.ts";
+import { logger } from "./logger.ts";
+import { isActiveUser } from "./users.ts";
+
+export type InspectionResult = "good" | "repair";
+
+export const INSPECTION_RESULT_LABELS: Record<InspectionResult, string> = { good: "良好", repair: "要修理" };
+
+export const DEFAULT_INSPECTION_INTERVAL_MONTHS = 3;
+
+export type InspectionRecord = {
+  id: number;
+  instrumentId: number;
+  inspectedOn: string | null; // YYYY-MM-DD。旧データで読めなかったときは null
+  inspectorId: string | null; // 点検した人。旧データで分からないときは null
+  result: InspectionResult;
+  memo: string;
+  legacyInspector: string | null; // 旧データの点検者の書き方
+  legacyDate: string | null; // 旧データの点検日の書き方（読めなかったときだけ）
+  recordedBy: string | null;
+  recordedAt: string; // ISO 8601（UTC）
+};
+
+type RecordRow = {
+  id: number;
+  instrument_id: number;
+  inspected_on: string | null;
+  inspector_id: string | null;
+  result: InspectionResult;
+  memo: string;
+  legacy_inspector: string | null;
+  legacy_date: string | null;
+  recorded_by: string | null;
+  recorded_at: string;
+};
+
+const RECORD_COLUMNS =
+  "id, instrument_id, inspected_on, inspector_id, result, memo, legacy_inspector, legacy_date, recorded_by, recorded_at";
+
+function toRecord(r: RecordRow): InspectionRecord {
+  return {
+    id: r.id,
+    instrumentId: r.instrument_id,
+    inspectedOn: r.inspected_on,
+    inspectorId: r.inspector_id,
+    result: r.result,
+    memo: r.memo,
+    legacyInspector: r.legacy_inspector,
+    legacyDate: r.legacy_date,
+    recordedBy: r.recorded_by,
+    recordedAt: r.recorded_at,
+  };
+}
+
+/** 計測器の点検記録を、点検日の新しい順に返す（日付の読めない旧データは最後）。 */
+export function listInspections(instrumentId: number, db: Db = getDb()): InspectionRecord[] {
+  const rows = db
+    .prepare(
+      `SELECT ${RECORD_COLUMNS} FROM inspection_records WHERE instrument_id = ?
+       ORDER BY inspected_on IS NULL, inspected_on DESC, id DESC`,
+    )
+    .all(instrumentId) as RecordRow[];
+  return rows.map(toRecord);
+}
+
+export type InspectionDueStatus = "never" | "overdue" | "ok";
+
+export const DUE_STATUS_LABELS: Record<InspectionDueStatus, string> = {
+  never: "未点検",
+  overdue: "期限切れ",
+  ok: "期限内",
+};
+
+export type InspectionPlan = {
+  instrumentId: number;
+  inspectorId: string | null; // 担当者。未設定は null
+  legacyInspector: string | null; // 担当者にできなかった旧データの点検者の書き方
+  intervalMonths: number; // 点検周期（月）
+  lastInspectedOn: string | null; // 最後の点検日
+  nextDueOn: string | null; // 次の点検予定日。未点検なら null
+  dueStatus: InspectionDueStatus;
+};
+
+/** 最後の点検日と周期から、次の点検予定日と状況を決める。today は日本時間の今日。 */
+export function judgeDue(
+  lastInspectedOn: string | null,
+  intervalMonths: number,
+  today: string,
+): { nextDueOn: string | null; dueStatus: InspectionDueStatus } {
+  if (lastInspectedOn === null) return { nextDueOn: null, dueStatus: "never" };
+  const nextDueOn = addMonths(lastInspectedOn, intervalMonths);
+  // 予定日当日までは期限内
+  return { nextDueOn, dueStatus: nextDueOn < today ? "overdue" : "ok" };
+}
+
+type PlanRow = {
+  id: number;
+  inspector_id: string | null;
+  legacy_inspector: string | null;
+  inspection_interval_months: number;
+  last_inspected_on: string | null;
+};
+
+function toPlan(r: PlanRow, today: string): InspectionPlan {
+  return {
+    instrumentId: r.id,
+    inspectorId: r.inspector_id,
+    legacyInspector: r.legacy_inspector,
+    intervalMonths: r.inspection_interval_months,
+    lastInspectedOn: r.last_inspected_on,
+    ...judgeDue(r.last_inspected_on, r.inspection_interval_months, today),
+  };
+}
+
+const PLAN_SELECT = `SELECT i.id, i.inspector_id, i.legacy_inspector, i.inspection_interval_months,
+    (SELECT MAX(r.inspected_on) FROM inspection_records r WHERE r.instrument_id = i.id) AS last_inspected_on
+  FROM instruments i`;
+
+export function getInspectionPlan(instrumentId: number, db: Db = getDb(), now: Date = new Date()): InspectionPlan | undefined {
+  const row = db.prepare(`${PLAN_SELECT} WHERE i.id = ?`).get(instrumentId) as PlanRow | undefined;
+  return row && toPlan(row, todayJst(now));
+}
+
+/** 全計測器の点検の状況を、計測器の ID をキーにして返す（一覧用）。 */
+export function listInspectionPlans(db: Db = getDb(), now: Date = new Date()): Map<number, InspectionPlan> {
+  const today = todayJst(now);
+  const rows = db.prepare(PLAN_SELECT).all() as PlanRow[];
+  return new Map(rows.map((r) => [r.id, toPlan(r, today)]));
+}
+
+// ---- 担当者・周期の変更 ----
+
+export type PlanChanges = { inspectorId?: string | null; intervalMonths?: number };
+
+/**
+ * 担当者・周期の変更を検証する。送られた項目だけを検証する。
+ * 担当者は在籍中の利用者だけ選べる（すでに担当になっている人を変えないときは、退職・休職でもそのまま）。
+ */
+export function validatePlanInput(body: unknown, currentInspectorId: string | null, db: Db = getDb()): ValidationResult<PlanChanges> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const b = body as Record<string, unknown>;
+  const errors: string[] = [];
+  const value: PlanChanges = {};
+  if ("inspectorId" in b) {
+    if (b.inspectorId === null) value.inspectorId = null;
+    else if (typeof b.inspectorId === "string" && (b.inspectorId === currentInspectorId || isActiveUser(b.inspectorId, db))) {
+      value.inspectorId = b.inspectorId;
+    } else errors.push("担当者は、在籍中の利用者から選んでください");
+  }
+  if ("intervalMonths" in b) {
+    if (!Number.isInteger(b.intervalMonths) || (b.intervalMonths as number) < 1 || (b.intervalMonths as number) > 120) {
+      errors.push("点検周期は 1〜120 か月の整数で入力してください");
+    } else value.intervalMonths = b.intervalMonths as number;
+  }
+  if (!("inspectorId" in b) && !("intervalMonths" in b)) errors.push("変更する項目（inspectorId / intervalMonths）を指定してください");
+  return errors.length > 0 ? { ok: false, errors } : { ok: true, value };
+}
+
+/** 担当者・周期を更新する。計測器が無ければ undefined。担当者を変えたら旧データの書き方は消す。 */
+export function updateInspectionPlan(
+  instrumentId: number,
+  changes: PlanChanges,
+  db: Db = getDb(),
+  now: Date = new Date(),
+): InspectionPlan | undefined {
+  return transaction(db, () => {
+    if (!getInstrument(instrumentId, db)) return undefined;
+    if (changes.inspectorId !== undefined) {
+      // 担当者を決め直したら、移行時に残した元の書き方は役目を終える（点検記録の側には残る）
+      db.prepare("UPDATE instruments SET inspector_id = ?, legacy_inspector = NULL WHERE id = ?").run(changes.inspectorId, instrumentId);
+    }
+    if (changes.intervalMonths !== undefined) {
+      db.prepare("UPDATE instruments SET inspection_interval_months = ? WHERE id = ?").run(changes.intervalMonths, instrumentId);
+    }
+    return getInspectionPlan(instrumentId, db, now);
+  });
+}
+
+// ---- 点検記録の登録 ----
+
+export type InspectionInput = { inspectedOn: string; inspectorId: string; result: InspectionResult; memo: string };
+
+/** 点検記録の入力を検証する。点検した人は在籍中の利用者（担当者以外でもよい）。点検日は今日以前。 */
+export function validateInspectionInput(body: unknown, db: Db = getDb(), now: Date = new Date()): ValidationResult<InspectionInput> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const b = body as Record<string, unknown>;
+  const errors: string[] = [];
+  if (!isValidDate(b.inspectedOn)) errors.push("点検日は YYYY-MM-DD 形式で入力してください");
+  else if (b.inspectedOn > todayJst(now)) errors.push("点検日に未来の日付は指定できません");
+  if (typeof b.inspectorId !== "string" || !isActiveUser(b.inspectorId, db)) {
+    errors.push("点検した人は、在籍中の利用者から選んでください");
+  }
+  if (b.result !== "good" && b.result !== "repair") errors.push("結果は good（良好）か repair（要修理）で指定してください");
+  const memo = b.memo ?? "";
+  if (typeof memo !== "string" || memo.length > 1000) errors.push("メモは 1000 文字以内で入力してください");
+  if (errors.length > 0) return { ok: false, errors };
+  return {
+    ok: true,
+    value: {
+      inspectedOn: b.inspectedOn as string,
+      inspectorId: b.inspectorId as string,
+      result: b.result as InspectionResult,
+      memo: (memo as string).trim(),
+    },
+  };
+}
+
+/** 点検記録を登録する。要修理なら計測器を使用停止にする（廃棄済みは変えない）。計測器が無ければ undefined。 */
+export function recordInspection(
+  instrumentId: number,
+  input: InspectionInput,
+  recordedBy: string,
+  db: Db = getDb(),
+  now: Date = new Date(),
+) {
+  const result = transaction(db, () => {
+    const instrument = getInstrument(instrumentId, db);
+    if (!instrument) return undefined;
+    const { lastInsertRowid } = db
+      .prepare(
+        `INSERT INTO inspection_records (instrument_id, inspected_on, inspector_id, result, memo, recorded_by, recorded_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?)`,
+      )
+      .run(instrumentId, input.inspectedOn, input.inspectorId, input.result, input.memo, recordedBy, now.toISOString());
+    if (input.result === "repair") {
+      db.prepare("UPDATE instruments SET status = 'suspended' WHERE id = ? AND status <> 'disposed'").run(instrumentId);
+    }
+    const record = toRecord(db.prepare(`SELECT ${RECORD_COLUMNS} FROM inspection_records WHERE id = ?`).get(Number(lastInsertRowid)) as RecordRow);
+    return { record, instrument: getInstrument(instrumentId, db)!, plan: getInspectionPlan(instrumentId, db, now)! };
+  });
+  if (result?.record.result === "repair") {
+    logger.warn("inspection.repair_needed", {
+      instrumentId,
+      managementNo: result.instrument.managementNo,
+      recordId: result.record.id,
+      status: result.instrument.status,
+    });
+  }
+  return result;
+}
