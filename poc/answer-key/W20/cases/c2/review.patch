+++ b/src/app/instruments/[id]/inspection-forms.tsx
@@ -0,0 +1,135 @@
+"use client";
+// 点検の担当者・周期の変更と、点検記録の登録。API を呼び、結果を画面に出す。
+import { useRouter } from "next/navigation";
+import { useState, type FormEvent } from "react";
+
+type UserOption = { id: string; name: string };
+
+type Props = {
+  instrumentId: number;
+  users: UserOption[]; // 選べる利用者（在籍中。現在の担当者は退職・休職でも含める）
+  inspectorId: string | null;
+  intervalMonths: number;
+  currentUserId: string;
+  today: string; // 日本時間の今日 YYYY-MM-DD
+};
+
+type Message = { kind: "ok" | "error"; text: string };
+
+async function send(url: string, method: string, body: unknown): Promise<Message> {
+  try {
+    const res = await fetch(url, { method, headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
+    if (res.ok) return { kind: "ok", text: "保存しました" };
+    const data = (await res.json().catch(() => ({}))) as { error?: string; details?: string[] };
+    return { kind: "error", text: [data.error ?? "保存できませんでした", ...(data.details ?? [])].join(" / ") };
+  } catch {
+    return { kind: "error", text: "通信に失敗しました。もう一度お試しください" };
+  }
+}
+
+export function InspectionForms({ instrumentId, users, inspectorId, intervalMonths, currentUserId, today }: Props) {
+  const router = useRouter();
+  const [planMessage, setPlanMessage] = useState<Message>();
+  const [recordMessage, setRecordMessage] = useState<Message>();
+
+  async function submitPlan(e: FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    const form = new FormData(e.currentTarget);
+    const inspector = String(form.get("inspectorId") ?? "");
+    const msg = await send(`/api/instruments/${instrumentId}/inspection`, "PATCH", {
+      inspectorId: inspector === "" ? null : inspector,
+      intervalMonths: Number(form.get("intervalMonths")),
+    });
+    setPlanMessage(msg);
+    if (msg.kind === "ok") router.refresh();
+  }
+
+  async function submitRecord(e: FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    const formEl = e.currentTarget;
+    const form = new FormData(formEl);
+    const msg = await send(`/api/instruments/${instrumentId}/inspections`, "POST", {
+      inspectedOn: form.get("inspectedOn"),
+      inspectorId: form.get("inspectorId"),
+      result: form.get("result"),
+      memo: form.get("memo"),
+    });
+    setRecordMessage(
+      msg.kind === "ok" && form.get("result") === "repair"
+        ? { kind: "ok", text: "保存しました。要修理のため、この計測器を使用停止にしました" }
+        : msg,
+    );
+    if (msg.kind === "ok") {
+      formEl.reset();
+      router.refresh();
+    }
+  }
+
+  return (
+    <>
+      <form onSubmit={submitPlan} aria-label="点検の担当者と周期">
+        <p>
+          <label>
+            担当者{" "}
+            <select name="inspectorId" defaultValue={inspectorId ?? ""}>
+              <option value="">未設定</option>
+              {users.map((u) => (
+                <option key={u.id} value={u.id}>
+                  {u.name}
+                </option>
+              ))}
+            </select>
+          </label>{" "}
+          <label>
+            点検周期（月）{" "}
+            <input name="intervalMonths" type="number" min={1} max={120} defaultValue={intervalMonths} required />
+          </label>{" "}
+          <button type="submit">担当者と周期を保存</button>
+        </p>
+        {planMessage && (
+          <p role={planMessage.kind === "error" ? "alert" : "status"} data-testid="plan-message">
+            {planMessage.text}
+          </p>
+        )}
+      </form>
+
+      <form onSubmit={submitRecord} aria-label="点検の記録">
+        <p>
+          <label>
+            点検日{" "}
+            <input name="inspectedOn" type="date" defaultValue={today} max={today} required />
+          </label>{" "}
+          <label>
+            点検した人{" "}
+            <select name="inspectorId" defaultValue={users.some((u) => u.id === currentUserId) ? currentUserId : ""} required>
+              <option value="" disabled>
+                選択してください
+              </option>
+              {users.map((u) => (
+                <option key={u.id} value={u.id}>
+                  {u.name}
+                </option>
+              ))}
+            </select>
+          </label>{" "}
+          <label>
+            結果{" "}
+            <select name="result" defaultValue="good">
+              <option value="good">良好</option>
+              <option value="repair">要修理（使用停止になります）</option>
+            </select>
+          </label>{" "}
+          <label>
+            メモ <input name="memo" maxLength={1000} size={30} />
+          </label>{" "}
+          <button type="submit">点検を記録</button>
+        </p>
+        {recordMessage && (
+          <p role={recordMessage.kind === "error" ? "alert" : "status"} data-testid="record-message">
+            {recordMessage.text}
+          </p>
+        )}
+      </form>
+    </>
+  );
+}
