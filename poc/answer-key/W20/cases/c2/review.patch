diff --git a/tests/inspections.test.ts b/tests/inspections.test.ts
new file mode 100644
index 0000000..5ca25d3
--- /dev/null
+++ b/tests/inspections.test.ts
@@ -0,0 +1,169 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { DatabaseSync } from "node:sqlite";
+import { addMonths } from "../src/lib/dates.ts";
+import { migrate, openDb } from "../src/lib/db/index.ts";
+import { MIGRATIONS } from "../src/lib/db/migrations.ts";
+import {
+  getInspectionPlan,
+  judgeDue,
+  listInspectionPlans,
+  listInspections,
+  recordInspection,
+  updateInspectionPlan,
+  validateInspectionInput,
+  validatePlanInput,
+} from "../src/lib/inspections.ts";
+import { normalizeInspectorName, parseLegacyDate } from "../src/lib/inspections-legacy.ts";
+import { getInstrument, listInstruments } from "../src/lib/instruments.ts";
+
+const idOf = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!.id;
+const NOW = new Date("2026-11-10T03:00:00.000Z"); // 日本時間 2026-11-10 12:00
+const GOOD = { inspectedOn: "2026-11-09", inspectorId: "sato", result: "good", memo: "" } as const;
+
+describe("addMonths / judgeDue", () => {
+  it("clamps to the end of the month", () => {
+    assert.equal(addMonths("2026-01-31", 1), "2026-02-28");
+    assert.equal(addMonths("2026-11-30", 3), "2027-02-28");
+    assert.equal(addMonths("2026-10-15", 3), "2027-01-15");
+  });
+
+  it("is never inspected without a date, ok until the due date, overdue after", () => {
+    assert.deepEqual(judgeDue(null, 3, "2026-11-10"), { nextDueOn: null, dueStatus: "never" });
+    assert.deepEqual(judgeDue("2026-08-10", 3, "2026-11-10"), { nextDueOn: "2026-11-10", dueStatus: "ok" });
+    assert.deepEqual(judgeDue("2026-08-09", 3, "2026-11-10"), { nextDueOn: "2026-11-09", dueStatus: "overdue" });
+  });
+});
+
+describe("旧データの読み取り", () => {
+  it("parses western, slash and era dates, and rejects the rest", () => {
+    assert.equal(parseLegacyDate("2026-09-01"), "2026-09-01");
+    assert.equal(parseLegacyDate("2026/8/20"), "2026-08-20");
+    assert.equal(parseLegacyDate("R8.9.10"), "2026-09-10");
+    assert.equal(parseLegacyDate("令和8年9月10日"), "2026-09-10");
+    assert.equal(parseLegacyDate("2026/2/30"), undefined);
+    assert.equal(parseLegacyDate("先月"), undefined);
+  });
+
+  it("strips honorifics", () => {
+    assert.equal(normalizeInspectorName(" 鈴木さん "), "鈴木");
+    assert.equal(normalizeInspectorName("外部委託"), "外部委託");
+  });
+});
+
+describe("初期データの移行", () => {
+  it("maps names to users, keeps unmatched text, and keeps unreadable dates", () => {
+    const db = openDb();
+    const plan = (no: string) => getInspectionPlan(idOf(db, no), db, NOW)!;
+    assert.equal(plan("MI-0001").inspectorId, "sato");
+    assert.equal(plan("MI-0001").lastInspectedOn, "2026-09-01");
+    assert.equal(plan("MI-0003").inspectorId, "suzuki"); // 「鈴木さん」
+    assert.equal(plan("MI-0003").lastInspectedOn, "2026-08-20"); // 2026/8/20
+    assert.equal(plan("MI-0006").lastInspectedOn, "2026-09-10"); // R8.9.10
+    assert.equal(plan("MI-0004").inspectorId, "inoue"); // 退職者でも担当のまま
