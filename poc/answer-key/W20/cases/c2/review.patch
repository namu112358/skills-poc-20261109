+// GET /api/instruments/:id/inspection — 点検の担当者・周期・次の点検予定日
+// PATCH — 担当者（inspectorId。null で未設定）と周期（intervalMonths）を、送った項目だけ更新する。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { parseId } from "@/lib/instruments";
+import { getInspectionPlan, updateInspectionPlan, validatePlanInput } from "@/lib/inspections";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function GET(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  const plan = id === undefined ? undefined : getInspectionPlan(id);
+  if (!plan) return jsonError(404, "計測器が見つかりません");
+  return NextResponse.json({ plan });
+}
+
+export async function PATCH(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  const current = id === undefined ? undefined : getInspectionPlan(id);
+  if (id === undefined || !current) return jsonError(404, "計測器が見つかりません");
+  const changes = validatePlanInput(await readJson(request), current.inspectorId);
+  if (!changes.ok) return jsonError(400, "入力内容に誤りがあります", changes.errors);
+  return NextResponse.json({ plan: updateInspectionPlan(id, changes.value) });
+}
diff --git a/src/app/api/instruments/[id]/inspections/route.ts b/src/app/api/instruments/[id]/inspections/route.ts
