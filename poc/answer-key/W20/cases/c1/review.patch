+// POST /api/tasks/bulk-status — 複数のタスクのステータスをまとめて変える。ログインが必要。
+// 本文: { "ids": [1, 2, 3], "status": "done" }。存在しない ID が含まれていれば 404 を返す。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { bulkUpdateStatus, isTaskStatus } from "@/lib/tasks";
+
+const MAX_IDS = 100;
+
+export async function POST(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const body = await readJson(request);
+  const b = (typeof body === "object" && body !== null ? body : {}) as Record<string, unknown>;
+  const errors: string[] = [];
+  if (
+    !Array.isArray(b.ids) ||
+    b.ids.length === 0 ||
+    b.ids.length > MAX_IDS ||
+    !b.ids.every((id) => Number.isInteger(id) && (id as number) > 0)
+  ) {
+    errors.push(`ids は 1〜${MAX_IDS} 件の正の整数の配列で指定してください`);
+  }
+  if (!isTaskStatus(b.status)) errors.push("ステータスが正しくありません");
+  if (errors.length > 0) return jsonError(400, "入力内容に誤りがあります", errors);
+
+  const result = bulkUpdateStatus(b.ids as number[], b.status as "todo" | "in_progress" | "done");
+  if (result.missing.length > 0) {
+    return jsonError(404, "タスクが見つかりません", result.missing.map((id) => `ID ${id}`));
+  }
+  return NextResponse.json({ updated: result.updated });
+}
