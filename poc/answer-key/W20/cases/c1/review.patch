+++ b/tests/tasks-search.test.ts
@@ -0,0 +1,72 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import {
+  bulkUpdateStatus,
+  createTask,
+  deleteTask,
+  getTask,
+  listOverdueTasks,
+  listTasks,
+  parsePageParam,
+  searchTasks,
+} from "../src/lib/tasks.ts";
+
+describe("createTask", () => {
+  it("records the creator", () => {
+    const db = openDb();
+    const task = createTask({ title: "新規", status: "todo", assignee: "tanaka", dueDate: "2026-12-01" }, db, "sato");
+    assert.equal(task.createdBy, "sato");
+    assert.equal(task.version, 1);
+  });
+});
+
+describe("searchTasks", () => {
+  it("finds tasks by a part of the title", () => {
+    const db = openDb();
+    assert.equal(searchTasks("API", 1, 20, db).total, 1);
+    assert.equal(searchTasks("存在しない", 1, 20, db).total, 0);
+  });
+});
+
+describe("parsePageParam", () => {
+  it("defaults to 1 and accepts positive integers only", () => {
+    assert.equal(parsePageParam(null), 1);
+    assert.equal(parsePageParam("3"), 3);
+    for (const bad of ["0", "-1", "1.5", "abc", ""]) assert.equal(parsePageParam(bad), undefined, bad);
+  });
+});
+
+describe("listOverdueTasks", () => {
+  it("returns unfinished tasks whose due date has passed", () => {
+    const db = openDb();
+    const overdue = listOverdueTasks(new Date("2026-11-15T03:00:00Z"), db);
+    assert.deepEqual(
+      overdue.map((t) => t.id),
+      [2, 3],
+    );
+  });
+});
+
+describe("deleteTask", () => {
+  it("deletes a task", () => {
+    const db = openDb();
+    const tasks = listTasks({}, db);
+    assert.ok(deleteTask(1, db) !== undefined);
+    assert.equal(tasks.length, 7);
+  });
+});
+
+describe("bulkUpdateStatus", () => {
+  it("updates every given task", () => {
+    const db = openDb();
+    assert.deepEqual(bulkUpdateStatus([4, 5, 5], "done", db), { updated: 2, missing: [] });
+    assert.equal(getTask(4, db)?.status, "done");
+    assert.equal(getTask(5, db)?.version, 2);
+  });
+
+  it("reports missing ids", () => {
+    const db = openDb();
+    assert.deepEqual(bulkUpdateStatus([999], "done", db).missing, [999]);
+  });
+});
