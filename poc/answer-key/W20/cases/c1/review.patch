+// GET /api/tasks/search?q=…&page=…&limit=… — タイトルの部分一致でタスクを検索する。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, requireApiUser } from "@/lib/api";
+import { SEARCH_LIMIT_DEFAULT, parsePageParam, searchTasks } from "@/lib/tasks";
+
+export async function GET(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const params = new URL(request.url).searchParams;
+  const q = (params.get("q") ?? "").trim();
+  if (q === "") return jsonError(400, "検索語を入力してください");
+  const page = parsePageParam(params.get("page"));
+  if (page === undefined) return jsonError(400, "ページ番号が正しくありません");
+  const limit = Number(params.get("limit") ?? SEARCH_LIMIT_DEFAULT);
+  try {
+    return NextResponse.json({ ...searchTasks(q, page, limit), page, limit });
+  } catch {
+    return NextResponse.json({ tasks: [], total: 0, page, limit });
+  }
+}
