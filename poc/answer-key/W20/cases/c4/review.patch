diff --git a/src/lib/calib-import-nishinihon.ts b/src/lib/calib-import-nishinihon.ts
new file mode 100644
index 0000000..2f20599
--- /dev/null
+++ b/src/lib/calib-import-nishinihon.ts
@@ -0,0 +1,173 @@
+// 西日本校正センターの校正結果 CSV の取込（2026-12 から。仕様は docs/agencies/nishinihon-csv-spec.md）。
+// 東日本計測サービスの CSV は src/lib/legacy/calib-import.ts が受け持つ。
+import { getDb, type Db } from "./db/index.ts";
+import { appendToNote, recordCalibration, type CalibrationResult } from "./calibrations.ts";
+import { parseCsvLine } from "./csv.ts";
+import { isValidDate, todayJst } from "./dates.ts";
+import { logger } from "./logger.ts";
+import type { ImportResult } from "./legacy/calib-import.ts";
+
+export const NISHINIHON_AGENCY = "西日本校正センター";
+
+const REQUIRED_COLUMNS = ["機器番号", "校正実施日", "判定結果", "成績書番号"] as const;
+
+/** 西日本校正センターの CSV（UTF-8・BOM なし・見出しに「機器番号」）かどうか。BOM 付きや Shift_JIS は別の形式。 */
+export function isNishinihonCsv(data: Uint8Array): boolean {
+  if (data.length >= 3 && data[0] === 0xef && data[1] === 0xbb && data[2] === 0xbf) return false;
+  let text: string;
+  try {
+    text = new TextDecoder("utf-8", { fatal: true }).decode(data);
+  } catch {
+    return false;
+  }
+  const first = text.split(/\r\n|\n|\r/).find((l) => l.trim() !== "" && !l.startsWith("#"));
+  return first !== undefined && parseCsvLine(first).includes("機器番号");
+}
+
+/** 管理番号の表記ゆれ（全角・小文字・ハイフン無し）を台帳の形式（MI-0001）にそろえる。 */
+export function normalizeManagementNo(value: string): string {
+  let no = value
+    .replace(/[Ａ-Ｚａ-ｚ０-９－]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0))
+    .toUpperCase();
+  if (/^[A-Z]{2}\d{4}$/.test(no)) no = no.substring(0, 2) + "-" + no.substring(2);
+  return no;
+}
+
+const RESULTS: Record<string, { result: CalibrationResult; conditional: boolean }> = {
+  PASS: { result: "pass", conditional: false },
+  FAIL: { result: "fail", conditional: false },
+  COND: { result: "pass", conditional: true }, // 条件付き合格は合格として取り込み、備考に残す（品質保証部の決定）
+};
+
+/** CSV 全体の誤り（途中で欠けている・見出しが違う）。1 件も取り込まない。 */
+export type ImportFailure = { ok: false; message: string };
+
+/**
+ * 取り込む。有効期限の列は使わない（次の校正は台帳の校正周期で決める）。
+ * 何度取り込んでも同じ結果になる（同じ機器・校正日・成績書番号は「取込済み」で読み飛ばす）。
+ */
+export function importNishinihonCsv(
+  data: Uint8Array,
+  recordedBy: string,
+  db: Db = getDb(),
+  now: Date = new Date(),
+): { ok: true; result: ImportResult } | ImportFailure {
+  const lines = new TextDecoder("utf-8").decode(data).split(/\r\n|\n|\r/);
+  let header: string[] | null = null;
+  const rows: { lineNo: number; cols: string[] }[] = [];
+  let declared: number | null = null;
+  for (let n = 0; n < lines.length; n++) {
+    const raw = lines[n];
+    if (raw.trim() === "" || raw.startsWith("#")) continue;
+    const cols = parseCsvLine(raw);
+    if (header === null) {
+      const missing = REQUIRED_COLUMNS.filter((c) => !cols.includes(c));
+      if (missing.length > 0) {
+        return { ok: false, message: `CSV の形式が違います（見出しに「${missing.join("」「")}」の列がありません）` };
+      }
+      header = cols;
+      continue;
+    }
+    if (declared !== null) {
+      return { ok: false, message: `最終行「END,行数」のあとにデータがあります（${n + 1} 行目）。ファイルが重なっている可能性があります` };
+    }
+    if (cols[0] === "END") {
+      declared = /^\d+$/.test(cols[1] ?? "") ? Number(cols[1]) : NaN;
+      continue;
+    }
+    rows.push({ lineNo: n + 1, cols });
+  }
+  if (header === null) return { ok: false, message: "CSV に見出しの行がありません" };
+  if (declared === null || !Number.isInteger(declared)) {
+    return { ok: false, message: "最終行「END,行数」がありません（または行数が数字ではありません）。ファイルが途中で切れている可能性があります" };
+  }
+  if (declared !== rows.length) {
+    return {
+      ok: false,
+      message: `データの行数が合いません（END の行数 ${declared}、実際 ${rows.length}）。ファイルが途中で欠けている可能性があります`,
+    };
+  }
+
+  const columns = header;
+  const col = (cols: string[], name: string) => {
+    const i = columns.indexOf(name);
+    return i >= 0 && i < cols.length ? cols[i] : "";
+  };
+  const res: ImportResult = { imported: 0, skipped: [], errors: [] };
+  const seen = new Set<string>();
+  const today = todayJst(now);
+  for (const { lineNo, cols } of rows) {
+    const no = normalizeManagementNo(col(cols, "機器番号"));
+    const date = col(cols, "校正実施日");
+    const judged = RESULTS[col(cols, "判定結果").toUpperCase()];
+    const cert = col(cols, "成績書番号");
+    if (no === "") {
+      res.errors.push({ line: lineNo, message: "機器番号が空です" });
+      continue;
+    }
+    if (!isValidDate(date)) {
+      res.errors.push({ line: lineNo, message: `校正実施日が正しくありません（YYYY-MM-DD）: ${date}` });
+      continue;
+    }
+    if (date > today) {
+      // 誤記の未来日を取り込むと前回校正日が戻せなくなり、期限切れが見えなくなる
+      res.errors.push({ line: lineNo, message: `校正実施日が未来の日付です: ${date}` });
+      continue;
+    }
+    if (!judged) {
+      res.errors.push({ line: lineNo, message: `判定結果が読めません（PASS・FAIL・COND）: ${col(cols, "判定結果")}` });
+      continue;
+    }
+    if (cert === "") {
+      res.errors.push({ line: lineNo, message: "成績書番号が空です" });
+      continue;
+    }
+    if (cert.length > 50) {
+      res.errors.push({ line: lineNo, message: "成績書番号は 50 文字以内にしてください" });
+      continue;
+    }
+    const key = `${no}|${date}|${cert}`;
+    if (seen.has(key)) {
+      res.skipped.push({ line: lineNo, reason: "同じファイルの中で重複" });
+      continue;
+    }
+    seen.add(key);
+    const inst = db.prepare("SELECT id FROM instruments WHERE management_no = ?").get(no) as { id: number } | undefined;
+    if (!inst) {
+      res.errors.push({ line: lineNo, message: `管理番号が台帳にありません: ${no}` });
+      continue;
+    }
+    const dup = db
+      .prepare("SELECT 1 FROM calibration_records WHERE instrument_id = ? AND calibrated_on = ? AND certificate_no = ?")
+      .get(inst.id, date, cert);
+    if (dup) {
+      res.skipped.push({ line: lineNo, reason: "取込済み" });
+      continue;
+    }
+    const comment = col(cols, "コメント");
+    const appendNote = judged.conditional ? `条件付き合格（${date}）${comment ? `: ${comment}` : ""}` : undefined;
+    if (appendNote !== undefined) {
+      const current = db.prepare("SELECT note FROM instruments WHERE id = ?").get(inst.id) as { note: string };
+      if (appendToNote(current.note, appendNote) === undefined) {
+        res.errors.push({ line: lineNo, message: `備考に追記できません（1000 文字を超えます）。${no} の備考を整理してから取り込み直してください` });
+        continue;
+      }
+    }
+    recordCalibration(
+      inst.id,
+      { calibratedOn: date, result: judged.result, agency: NISHINIHON_AGENCY, certificateNo: cert },
+      recordedBy,
+      db,
+      now,
+      appendNote,
+    );
+    res.imported++;
+  }
+  logger.info("calibration.imported", {
+    agency: NISHINIHON_AGENCY,
+    imported: res.imported,
+    skipped: res.skipped.length,
+    errors: res.errors.length,
+  });
+  return { ok: true, result: res };
+}
