new file mode 100644
index 0000000..90f893e
--- /dev/null
+++ b/src/lib/csv.ts
@@ -0,0 +1,23 @@
+// CSV の 1 行をカンマで区切る（"..." の中のカンマと "" に対応）。各項目の前後の空白は取り除く。
+export function parseCsvLine(raw: string): string[] {
+  const cols: string[] = [];
+  let cur = "";
+  let quoted = false;
+  for (let i = 0; i < raw.length; i++) {
+    const ch = raw[i];
+    if (quoted) {
+      if (ch === '"') {
+        if (raw[i + 1] === '"') {
+          cur += '"';
+          i++;
+        } else quoted = false;
+      } else cur += ch;
+    } else if (ch === '"') quoted = true;
+    else if (ch === ",") {
+      cols.push(cur.trim());
+      cur = "";
+    } else cur += ch;
+  }
+  cols.push(cur.trim());
+  return cols;
+}
