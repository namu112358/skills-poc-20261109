+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { importNishinihonCsv, isNishinihonCsv, normalizeManagementNo } from "../src/lib/calib-import-nishinihon.ts";
+import { appendToNote, listCalibrations } from "../src/lib/calibrations.ts";
+import { openDb } from "../src/lib/db/index.ts";
+import { listInstruments } from "../src/lib/instruments.ts";
+
+const enc = (s: string) => new TextEncoder().encode(s);
+const byNo = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+const NOW = new Date("2026-11-10T01:00:00.000Z");
+const HEAD = "# 案内\n機器番号,品名,校正実施日,判定結果,成績書番号,有効期限,コメント\n";
+
+function run(db: ReturnType<typeof openDb>, body: string) {
+  const r = importNishinihonCsv(enc(body), "sato", db, NOW);
+  assert.ok(r.ok, r.ok ? "" : r.message);
+  return r.result;
+}
+
+describe("isNishinihonCsv", () => {
+  it("detects the sample file and rejects other formats", () => {
+    assert.equal(isNishinihonCsv(readFileSync("docs/agencies/nishinihon-sample.csv")), true);
+    assert.equal(isNishinihonCsv(enc("管理番号,機器名,校正日,判定,証明書番号,備考\r\n")), false);
+    assert.equal(isNishinihonCsv(new Uint8Array([0xef, 0xbb, 0xbf, ...enc(HEAD)])), false);
+    assert.equal(isNishinihonCsv(new Uint8Array([0x8a, 0x6f, 0x92, 0x4d])), false); // Shift_JIS
+  });
+});
+
+describe("normalizeManagementNo", () => {
+  it("adds the hyphen and unifies width and case", () => {
+    assert.equal(normalizeManagementNo("MI0003"), "MI-0003");
+    assert.equal(normalizeManagementNo("ＭＩ－０００３"), "MI-0003");
+    assert.equal(normalizeManagementNo("mi-0003"), "MI-0003");
+  });
+});
+
+describe("importNishinihonCsv", () => {
+  it("imports the sample: PASS as pass, COND as pass with a note on the instrument", () => {
+    const db = openDb();
+    const r = run(db, readFileSync("docs/agencies/nishinihon-sample.csv", "utf-8"));
+    assert.equal(r.imported, 3);
+    assert.deepEqual(r.errors, []);
+    assert.equal(byNo(db, "MI-0004").status, "suspended");
+    const torque = byNo(db, "MI-0003");
+    assert.equal(torque.lastCalibratedOn, "2026-11-04");
+    assert.equal(listCalibrations(torque.id, db)[0].agency, "西日本校正センター");
+    const hygro = byNo(db, "MI-0010");
+    assert.equal(hygro.lastCalibratedOn, "2026-11-05");
+    assert.equal(hygro.status, "in_use");
+    assert.equal(hygro.note, "条件付き合格（2026-11-05）: 湿度 90%RH のレンジで許容差外");
+    assert.equal(listCalibrations(hygro.id, db)[0].result, "pass");
+  });
+
+  it("appends to an existing note and does not repeat it on re-import", () => {
+    const db = openDb();
+    db.prepare("UPDATE instruments SET note = '既存' WHERE management_no = 'MI-0010'").run();
+    const body = `${HEAD}MI0010,温湿度計,2026-11-05,COND,WN-1,2027-11-04,\nEND,1\n`;
+    run(db, body);
+    assert.equal(byNo(db, "MI-0010").note, "既存\n条件付き合格（2026-11-05）");
+    const again = run(db, body);
+    assert.equal(again.imported, 0);
+    assert.deepEqual(again.skipped, [{ line: 3, reason: "取込済み" }]);
+    assert.equal(byNo(db, "MI-0010").note, "既存\n条件付き合格（2026-11-05）");
+  });
+
+  it("suspends the instrument on FAIL and ignores the expiry column", () => {
+    const db = openDb();
+    const r = run(db, `${HEAD}MI-0001,DMM,2026-11-05,FAIL,WN-2,2099-01-01,\nEND,1\n`);
+    assert.equal(r.imported, 1);
+    const inst = byNo(db, "MI-0001");
+    assert.equal(inst.status, "suspended");
+    assert.equal(inst.lastCalibratedOn, "2026-01-20");
+    assert.equal(inst.note, "");
+  });
+
+  it("reports row errors and keeps importing the other rows", () => {
+    const db = openDb();
+    const r = run(
+      db,
+      `${HEAD}MI0003,a,2026-02-30,PASS,W1,,\nMI0003,a,2026-11-04,MAYBE,W2,,\nMI9999,a,2026-11-04,PASS,W3,,\n,a,2026-11-04,PASS,W4,,\nMI0003,a,2026-11-04,PASS,W5,,\nEND,5\n`,
+    );
+    assert.equal(r.imported, 1);
+    assert.deepEqual(r.errors.map((e) => e.line), [3, 4, 5, 6]);
+  });
+
+  it("skips a duplicate row in the same file", () => {
+    const db = openDb();
+    const r = run(db, `${HEAD}MI0003,a,2026-11-04,PASS,W1,,\nMI0003,a,2026-11-04,PASS,W1,,\nEND,2\n`);
+    assert.equal(r.imported, 1);
+    assert.deepEqual(r.skipped, [{ line: 4, reason: "同じファイルの中で重複" }]);
+  });
+
+  it("rejects the whole file when END is missing or the count does not match", () => {
+    const db = openDb();
+    const row = "MI0003,a,2026-11-04,PASS,W1,,\n";
+    const noEnd = importNishinihonCsv(enc(HEAD + row), "sato", db);
+    assert.equal(noEnd.ok, false);
+    const mismatch = importNishinihonCsv(enc(`${HEAD}${row}END,2\n`), "sato", db);
+    assert.equal(mismatch.ok, false);
+    assert.equal(listCalibrations(byNo(db, "MI-0003").id, db).length, 0);
+  });
+
+  it("rejects a header without the required columns", () => {
+    const r = importNishinihonCsv(enc("機器番号,品名\nEND,0\n"), "sato", openDb());
+    assert.equal(r.ok, false);
+  });
+});
+
+describe("importNishinihonCsv: guards", () => {
+  it("rejects future dates and empty or too long certificate numbers per row", () => {
+    const db = openDb();
+    const r = run(
+      db,
+      `${HEAD}MI0003,a,2026-11-11,PASS,W1,,\nMI0003,a,2026-11-10,PASS,,,\nMI0003,a,2026-11-10,PASS,${"W".repeat(51)},,\nMI0003,a,2026-11-10,PASS,W4,,\nEND,4\n`,
+    );
+    assert.equal(r.imported, 1); // 当日の日付は取り込める
+    assert.deepEqual(r.errors.map((e) => e.line), [3, 4, 5]);
+    assert.equal(byNo(db, "MI-0003").lastCalibratedOn, "2026-11-10");
+  });
+
+  it("does not import a COND row whose note would not fit, and leaves the note untouched", () => {
+    const db = openDb();
+    const note = "x".repeat(990);
+    db.prepare("UPDATE instruments SET note = ? WHERE management_no = 'MI-0010'").run(note);
+    const r = run(db, `${HEAD}MI0010,a,2026-11-05,COND,W1,,許容差外の詳細\nEND,1\n`);
+    assert.equal(r.imported, 0);
+    assert.equal(r.errors.length, 1);
+    const inst = byNo(db, "MI-0010");
+    assert.equal(inst.note, note);
+    assert.equal(inst.lastCalibratedOn, "2025-12-25");
+    assert.equal(listCalibrations(inst.id, db).length, 0); // 初期データに MI-0010 の校正記録は無い
+  });
+
+  it("rejects the file when END is not a number or data follows END", () => {
+    const db = openDb();
+    const row = "MI0003,a,2026-11-04,PASS,W1,,\n";
+    assert.equal(importNishinihonCsv(enc(`${HEAD}${row}END,\n`), "sato", db, NOW).ok, false);
+    assert.equal(importNishinihonCsv(enc(`${HEAD}${row}END,1\n${row}`), "sato", db, NOW).ok, false);
+    assert.equal(listCalibrations(byNo(db, "MI-0003").id, db).length, 0);
+  });
+});
