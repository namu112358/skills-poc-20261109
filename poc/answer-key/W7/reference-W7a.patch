diff --git a/src/lib/completions.ts b/src/lib/completions.ts
new file mode 100644
index 0000000..a12e388
--- /dev/null
+++ b/src/lib/completions.ts
@@ -0,0 +1,70 @@
+import { toUtcIso } from "./datetime.ts";
+import { getDb, transaction, type Db } from "./db/index.ts";
+import { ConflictError, ForbiddenError, NotFoundError } from "./errors.ts";
+import { getTask, type ValidationResult } from "./tasks.ts";
+
+export type Completion = {
+  taskId: number;
+  completedBy: string;
+  completedByName: string;
+  completedAt: string; // ISO 8601（UTC）
+  note: string;
+};
+
+export const COMPLETION_NOTE_MAX_LENGTH = 500;
+
+type Row = { task_id: number; completed_by: string; completed_by_name: string; completed_at: string; note: string };
+
+export function getCompletion(taskId: number, db: Db = getDb()): Completion | null {
+  const r = db
+    .prepare(
+      "SELECT c.task_id, c.completed_by, u.name AS completed_by_name, c.completed_at, c.note FROM task_completions c JOIN users u ON u.id = c.completed_by WHERE c.task_id = ?",
+    )
+    .get(taskId) as Row | undefined;
+  return r
+    ? { taskId: r.task_id, completedBy: r.completed_by, completedByName: r.completed_by_name, completedAt: r.completed_at, note: r.note }
+    : null;
+}
+
+export function validateCompletionInput(body: unknown): ValidationResult<{ note: string }> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const note = (body as Record<string, unknown>).note ?? "";
+  if (typeof note !== "string") return { ok: false, errors: ["メモは文字列で入力してください"] };
+  const trimmed = note.trim();
+  if (trimmed.length > COMPLETION_NOTE_MAX_LENGTH) {
+    return { ok: false, errors: [`メモは ${COMPLETION_NOTE_MAX_LENGTH} 文字以内で入力してください`] };
+  }
+  return { ok: true, value: { note: trimmed } };
+}
+
+/** 担当者（userId）がタスクを完了報告する。ステータスは done になる。 */
+export function completeTask(taskId: number, userId: string, note: string, db: Db = getDb(), now: Date = new Date()): Completion {
+  const task = getTask(taskId, db);
+  if (!task) throw new NotFoundError("タスクが見つかりません");
+  if (task.assignee !== userId) throw new ForbiddenError("完了報告できるのはタスクの担当者だけです");
+  if (task.status === "done" || getCompletion(taskId, db)) throw new ConflictError("このタスクはすでに完了しています");
+  transaction(db, () => {
+    db.prepare("INSERT INTO task_completions (task_id, completed_by, completed_at, note) VALUES (?, ?, ?, ?)").run(
+      taskId,
+      userId,
+      toUtcIso(now),
+      note,
+    );
+    db.prepare("UPDATE tasks SET status = 'done' WHERE id = ?").run(taskId);
+  });
+  return getCompletion(taskId, db)!;
+}
+
+/** 完了報告をした本人（userId）が取り消す。ステータスは in_progress に戻る。 */
+export function cancelCompletion(taskId: number, userId: string, db: Db = getDb()): void {
+  if (!getTask(taskId, db)) throw new NotFoundError("タスクが見つかりません");
+  const c = getCompletion(taskId, db);
+  if (!c) throw new ConflictError("このタスクには完了報告がありません");
+  if (c.completedBy !== userId) throw new ForbiddenError("取り消しできるのは完了報告をした本人だけです");
+  transaction(db, () => {
+    db.prepare("DELETE FROM task_completions WHERE task_id = ?").run(taskId);
+    db.prepare("UPDATE tasks SET status = 'in_progress' WHERE id = ?").run(taskId);
+  });
+}
