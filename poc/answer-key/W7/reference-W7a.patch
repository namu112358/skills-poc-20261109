+// GET/POST/DELETE /api/tasks/:id/completion — 完了報告の取得・報告・取り消し。ログインが必要。
+import { NextResponse } from "next/server";
+import { currentApiUser, readJson, withApi } from "@/lib/api";
+import { cancelCompletion, completeTask, getCompletion, validateCompletionInput } from "@/lib/completions";
+import { NotFoundError, ValidationError } from "@/lib/errors";
+import { getTask, parseTaskId } from "@/lib/tasks";
+
+function requireTaskId(value: string): number {
+  const id = parseTaskId(value);
+  if (id === undefined || !getTask(id)) throw new NotFoundError("タスクが見つかりません");
+  return id;
+}
+
+type Context = { params: Promise<{ id: string }> };
+
+export const GET = withApi(async (_request, { params }: Context) => {
+  await currentApiUser();
+  const taskId = requireTaskId((await params).id);
+  return NextResponse.json({ completion: getCompletion(taskId) });
+});
+
+export const POST = withApi(async (request, { params }: Context) => {
+  const user = await currentApiUser();
+  const taskId = requireTaskId((await params).id);
+  const result = validateCompletionInput(await readJson(request));
+  if (!result.ok) throw new ValidationError(result.errors);
+  return NextResponse.json({ completion: completeTask(taskId, user.id, result.value.note) }, { status: 201 });
+});
+
+export const DELETE = withApi(async (_request, { params }: Context) => {
+  const user = await currentApiUser();
+  const taskId = requireTaskId((await params).id);
+  cancelCompletion(taskId, user.id);
+  return new NextResponse(null, { status: 204 });
+});
