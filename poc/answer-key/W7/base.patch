+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { AppError, ConflictError, ForbiddenError, NotFoundError, UnauthorizedError, ValidationError } from "../src/lib/errors.ts";
+
+describe("errors", () => {
+  it("carries the HTTP status and code", () => {
+    const cases: [AppError, number, string][] = [
+      [new ValidationError(["x"]), 400, "VALIDATION_ERROR"],
+      [new UnauthorizedError(), 401, "UNAUTHORIZED"],
+      [new ForbiddenError(), 403, "FORBIDDEN"],
+      [new NotFoundError(), 404, "NOT_FOUND"],
+      [new ConflictError(), 409, "CONFLICT"],
+    ];
+    for (const [e, status, code] of cases) {
+      assert.ok(e instanceof AppError);
+      assert.equal(e.status, status);
+      assert.equal(e.code, code);
+    }
+    assert.deepEqual(new ValidationError(["x"]).details, ["x"]);
+  });
+});
