+// 日時の変換。
+
+/** 保存用の日時（ISO 8601 形式の UTC）。 */
+export function toUtcIso(date: Date = new Date()): string {
+  return date.toISOString();
+}
+
+const JST = new Intl.DateTimeFormat("ja-JP", {
+  timeZone: "Asia/Tokyo",
+  year: "numeric",
+  month: "2-digit",
+  day: "2-digit",
+  hour: "2-digit",
+  minute: "2-digit",
+  hourCycle: "h23",
+});
+
+/** 保存された日時（ISO 8601 形式の UTC）を、画面用の日本時間「YYYY/MM/DD HH:mm」にする。 */
+export function formatJst(iso: string): string {
+  const parts = Object.fromEntries(JST.formatToParts(new Date(iso)).map((p) => [p.type, p.value]));
+  return `${parts.year}/${parts.month}/${parts.day} ${parts.hour}:${parts.minute}`;
+}
