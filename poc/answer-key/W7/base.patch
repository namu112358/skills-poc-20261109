+// GET /api/tasks/:id/comments — コメント一覧（古い順） / POST — コメントを投稿する。ログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { createComment, listComments, validateCommentInput } from "@/lib/comments";
+import { getTask, parseTaskId } from "@/lib/tasks";
+
+type Context = { params: Promise<{ id: string }> };
+
+async function findTaskId(params: Context["params"]): Promise<number | undefined> {
+  const id = parseTaskId((await params).id);
+  return id !== undefined && getTask(id) ? id : undefined;
+}
+
+export async function GET(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const taskId = await findTaskId(params);
+  if (taskId === undefined) return jsonError(404, "タスクが見つかりません");
+  return NextResponse.json({ comments: listComments(taskId) });
+}
+
+export async function POST(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const taskId = await findTaskId(params);
+  if (taskId === undefined) return jsonError(404, "タスクが見つかりません");
+  const result = validateCommentInput(await readJson(request));
+  if (!result.ok) return jsonError(400, "入力内容に誤りがあります", result.errors);
+  return NextResponse.json({ comment: createComment({ taskId, author: user.id, body: result.value.body }) }, { status: 201 });
+}
