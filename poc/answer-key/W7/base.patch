+// API 用のエラー型。投げると withApi（src/lib/api.ts）が { error, code, details? } の JSON 応答に変える。
+export class AppError extends Error {
+  readonly status: number;
+  readonly code: string;
+  readonly details?: string[];
+
+  constructor(status: number, code: string, message: string, details?: string[]) {
+    super(message);
+    this.name = new.target.name;
+    this.status = status;
+    this.code = code;
+    this.details = details;
+  }
+}
+
+/** 入力内容の誤り（400）。details に項目ごとの理由を入れる。 */
+export class ValidationError extends AppError {
+  constructor(details?: string[], message = "入力内容に誤りがあります") {
+    super(400, "VALIDATION_ERROR", message, details);
+  }
+}
+
+/** 未ログイン・認証の失敗（401）。 */
+export class UnauthorizedError extends AppError {
+  constructor(message = "ログインしてください") {
+    super(401, "UNAUTHORIZED", message);
+  }
+}
+
+/** 権限が無い操作（403）。 */
+export class ForbiddenError extends AppError {
+  constructor(message = "この操作は許可されていません") {
+    super(403, "FORBIDDEN", message);
+  }
+}
+
+/** 対象が見つからない（404）。 */
+export class NotFoundError extends AppError {
+  constructor(message = "見つかりません") {
+    super(404, "NOT_FOUND", message);
+  }
+}
+
+/** 対象の今の状態ではできない操作（409）。 */
+export class ConflictError extends AppError {
+  constructor(message = "現在の状態ではこの操作はできません") {
+    super(409, "CONFLICT", message);
+  }
+}
