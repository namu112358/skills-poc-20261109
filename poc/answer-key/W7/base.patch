+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { createComment, deleteComment, listComments, validateCommentInput } from "../src/lib/comments.ts";
+import { openDb } from "../src/lib/db/index.ts";
+
+describe("comments", () => {
+  it("lists comments oldest first", () => {
+    const db = openDb();
+    const a = createComment({ taskId: 1, author: "sato", body: "最初" }, db, new Date("2026-11-09T03:04:05.000Z"));
+    createComment({ taskId: 1, author: "suzuki", body: "次" }, db);
+    assert.equal(a.createdAt, "2026-11-09T03:04:05.000Z");
+    assert.equal(a.authorName, "佐藤");
+    assert.deepEqual(listComments(1, db).map((c) => c.body), ["最初", "次"]);
+    assert.deepEqual(listComments(2, db), []);
+  });
+
+  it("validates the body", () => {
+    assert.deepEqual(validateCommentInput({ body: "  本文 " }), { ok: true, value: { body: "本文" } });
+    for (const body of [undefined, {}, { body: "  " }, { body: 1 }, { body: "あ".repeat(1001) }]) {
+      assert.equal(validateCommentInput(body).ok, false);
+    }
+  });
+
+  it("lets only the author delete a comment", () => {
+    const db = openDb();
+    const c = createComment({ taskId: 1, author: "sato", body: "本文" }, db);
+    assert.equal(deleteComment(1, c.id, "suzuki", db), "forbidden");
+    assert.equal(deleteComment(2, c.id, "sato", db), "not_found");
+    assert.equal(deleteComment(1, c.id, "sato", db), "deleted");
+    assert.deepEqual(listComments(1, db), []);
+  });
+});
