+// GET /api/me — ログイン中のユーザーと、今のセッションの有効期限を返す。ログインが必要。
+import { cookies } from "next/headers";
+import { NextResponse } from "next/server";
+import { currentApiUser, withApi } from "@/lib/api";
+import { SESSION_COOKIE, getSessionExpiry } from "@/lib/auth";
+import { NotFoundError } from "@/lib/errors";
+
+export const GET = withApi(async () => {
+  const user = await currentApiUser();
+  const token = (await cookies()).get(SESSION_COOKIE)?.value;
+  const expiresAt = token ? getSessionExpiry(token) : undefined;
+  if (!expiresAt) throw new NotFoundError("セッションが見つかりません");
+  return NextResponse.json({ user, sessionExpiresAt: expiresAt });
+});
