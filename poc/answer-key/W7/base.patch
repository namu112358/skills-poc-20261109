+
+/** 投げられたエラーを応答にする。AppError は { error, code, details? }、想定外のエラーは 500。 */
+export function errorResponse(e: unknown): NextResponse {
+  if (e instanceof AppError) {
+    return NextResponse.json(
+      { error: e.message, code: e.code, ...(e.details ? { details: e.details } : {}) },
+      { status: e.status },
+    );
+  }
+  console.error(e);
+  return NextResponse.json({ error: "サーバーでエラーが発生しました", code: "INTERNAL_ERROR" }, { status: 500 });
+}
+
+/** API Route のハンドラーを包み、投げられたエラーを errorResponse で応答にする。 */
+export function withApi<C = unknown>(
+  handler: (request: Request, context: C) => Promise<Response>,
+): (request: Request, context: C) => Promise<Response> {
+  return async (request, context) => {
+    try {
+      return await handler(request, context);
+    } catch (e) {
+      return errorResponse(e);
+    }
+  };
+}
+
+/** ログイン中のユーザーを返す。未ログインなら UnauthorizedError を投げる（withApi の中で使う）。 */
+export async function currentApiUser(): Promise<User> {
+  const user = await getCurrentUser();
+  if (!user) throw new UnauthorizedError();
+  return user;
+}
