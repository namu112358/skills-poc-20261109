+// GET /api/me/worklogs?date=YYYY-MM-DD — ログイン中のユーザーが、その日（日本時間）に記録した作業記録と合計。ログインが必要。
+import { NextResponse } from "next/server";
+import { currentApiUser, withApi } from "@/lib/api";
+import { isValidDate } from "@/lib/datetime";
+import { ValidationError } from "@/lib/errors";
+import { listMyWorklogs, totalMinutes } from "@/lib/worklogs";
+
+export const GET = withApi(async (request) => {
+  const user = await currentApiUser();
+  const date = new URL(request.url).searchParams.get("date");
+  if (!isValidDate(date)) throw new ValidationError(["日付は YYYY-MM-DD 形式で指定してください"]);
+  const worklogs = listMyWorklogs(user.id, date);
+  return NextResponse.json({ date, worklogs, totalMinutes: totalMinutes(worklogs) });
+});
diff --git a/src/app/my/worklogs/page.tsx b/src/app/my/worklogs/page.tsx
