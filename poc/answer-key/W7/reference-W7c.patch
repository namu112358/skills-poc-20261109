@@ -0,0 +1,43 @@
+import { formatJst, isValidDate } from "@/lib/datetime";
+import { requireUser } from "@/lib/session";
+import { listMyWorklogs, totalMinutes } from "@/lib/worklogs";
+
+type Props = {
+  searchParams: Promise<{ date?: string | string[] }>;
+};
+
+export default async function MyWorklogsPage({ searchParams }: Props) {
+  const user = await requireUser();
+  const date = (await searchParams).date;
+  if (!isValidDate(date)) {
+    return (
+      <main>
+        <h1>自分の作業記録</h1>
+        <p>日付を YYYY-MM-DD の形で指定してください。</p>
+      </main>
+    );
+  }
+  const worklogs = listMyWorklogs(user.id, date);
+  return (
+    <main>
+      <h1>自分の作業記録</h1>
+      <p data-testid="my-worklog-date">{date}</p>
+      {worklogs.length === 0 ? (
+        <p>この日の作業記録はありません。</p>
+      ) : (
+        <>
+          <p data-testid="my-worklog-total">合計 {totalMinutes(worklogs)} 分</p>
+          <ul>
+            {worklogs.map((w) => (
+              <li key={w.id} data-testid="my-worklog">
+                <a href={`/tasks/${w.taskId}`}>{w.taskTitle}</a> {w.minutes} 分{" "}
+                <time dateTime={w.recordedAt}>{formatJst(w.recordedAt)}</time>
+                {w.note && <p style={{ whiteSpace: "pre-wrap" }}>{w.note}</p>}
+              </li>
+            ))}
+          </ul>
+        </>
+      )}
+    </main>
+  );
+}
diff --git a/src/lib/datetime.ts b/src/lib/datetime.ts
index f7497d4..8badee6 100644
--- a/src/lib/datetime.ts
+++ b/src/lib/datetime.ts
@@ -20,3 +20,22 @@ export function formatJst(iso: string): string {
   const parts = Object.fromEntries(JST.formatToParts(new Date(iso)).map((p) => [p.type, p.value]));
   return `${parts.year}/${parts.month}/${parts.day} ${parts.hour}:${parts.minute}`;
 }
+
+const DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+const JST_OFFSET_MS = 9 * 60 * 60 * 1000;
+
+/** 日本時間の日付（YYYY-MM-DD）として正しいか（存在しない日付は false）。 */
+export function isValidDate(value: unknown): value is string {
+  if (typeof value !== "string") return false;
+  const m = DATE_RE.exec(value);
+  if (!m) return false;
+  const d = new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3])));
+  return d.getUTCFullYear() === Number(m[1]) && d.getUTCMonth() === Number(m[2]) - 1 && d.getUTCDate() === Number(m[3]);
+}
+
+/** 日本時間の日付（YYYY-MM-DD）の 0 時から翌日 0 時までを、保存用の日時（ISO 8601 形式の UTC）の範囲 [start, end) にする。 */
+export function jstDayRange(date: string, days = 1): { start: string; end: string } {
+  const [y, m, d] = date.split("-").map(Number);
+  const start = Date.UTC(y, m - 1, d) - JST_OFFSET_MS;
+  return { start: new Date(start).toISOString(), end: new Date(start + days * 24 * 60 * 60 * 1000).toISOString() };
+}
