   if (w.author !== userId) throw new ForbiddenError("自分の作業記録だけを削除できます");
   db.prepare("DELETE FROM worklogs WHERE id = ?").run(worklogId);
 }
+
+export type MyWorklog = Worklog & { taskTitle: string };
+
+/** userId が、日本時間の日付 from〜to（両端を含む）に記録した作業記録（記録日時の古い順、同じなら ID の小さい順）。 */
+export function listMyWorklogs(userId: string, from: string, to: string = from, db: Db = getDb()): MyWorklog[] {
+  const { start } = jstDayRange(from);
+  const { end } = jstDayRange(to);
+  const rows = db
+    .prepare(
+      `SELECT w.id, w.task_id, w.author, u.name AS author_name, w.minutes, w.note, w.recorded_at, t.title AS task_title
+       FROM worklogs w JOIN users u ON u.id = w.author JOIN tasks t ON t.id = w.task_id
+       WHERE w.author = ? AND w.recorded_at >= ? AND w.recorded_at < ? ORDER BY w.recorded_at, w.id`,
+    )
+    .all(userId, start, end) as (Row & { task_title: string })[];
+  return rows.map((r) => ({ ...toWorklog(r), taskTitle: r.task_title }));
+}
diff --git a/tests/my-worklogs.test.ts b/tests/my-worklogs.test.ts
new file mode 100644
index 0000000..2986b35
--- /dev/null
+++ b/tests/my-worklogs.test.ts
@@ -0,0 +1,26 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { isValidDate, jstDayRange } from "../src/lib/datetime.ts";
+import { openDb } from "../src/lib/db/index.ts";
+import { createWorklog, listMyWorklogs } from "../src/lib/worklogs.ts";
+
+test("isValidDate は存在しない日付を弾く", () => {
+  assert.equal(isValidDate("2026-11-10"), true);
+  assert.equal(isValidDate("2026-02-30"), false);
+  assert.equal(isValidDate("2026-1-1"), false);
+  assert.equal(isValidDate(undefined), false);
+});
+
+test("jstDayRange は日本時間の 0 時を UTC にする", () => {
+  assert.deepEqual(jstDayRange("2026-11-10"), { start: "2026-11-09T15:00:00.000Z", end: "2026-11-10T15:00:00.000Z" });
+});
+
+test("listMyWorklogs は日本時間の日付で絞り、自分の記録だけを古い順に返す", () => {
+  const db = openDb();
+  createWorklog({ taskId: 3, author: "sato", minutes: 10, note: "" }, db, new Date("2026-11-09T14:59:00Z"));
+  const b = createWorklog({ taskId: 3, author: "sato", minutes: 20, note: "" }, db, new Date("2026-11-09T15:00:00Z"));
+  const c = createWorklog({ taskId: 6, author: "sato", minutes: 30, note: "" }, db, new Date("2026-11-10T14:30:00Z"));
+  createWorklog({ taskId: 3, author: "suzuki", minutes: 40, note: "" }, db, new Date("2026-11-10T01:00:00Z"));
+  assert.deepEqual(listMyWorklogs("sato", "2026-11-10", "2026-11-10", db).map((w) => w.id), [b.id, c.id]);
+  assert.equal(listMyWorklogs("sato", "2026-11-10", "2026-11-10", db)[1].taskTitle, "E2E テストの追加");
+});
