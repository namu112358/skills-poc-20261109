@@ -0,0 +1,23 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { openDb } from "../src/lib/db/index.ts";
+import { exportMyWorklogs, validateExportRange } from "../src/lib/worklog-export.ts";
+import { createWorklog } from "../src/lib/worklogs.ts";
+
+test("validateExportRange は形式・順序・31 日を検証する", () => {
+  assert.equal(validateExportRange("2026-11-01", "2026-11-30").ok, true);
+  assert.equal(validateExportRange("2026-11-01", "2026-12-01").ok, true);
+  assert.equal(validateExportRange("2026-11-01", "2026-12-02").ok, false);
+  assert.equal(validateExportRange("2026-11-02", "2026-11-01").ok, false);
+  assert.equal(validateExportRange("2026-11-01", null).ok, false);
+});
+
+test("exportMyWorklogs は日本時間の期間で絞り、記録日時を日本時間で出し、値を CSV の規則で囲む", () => {
+  const db = openDb();
+  createWorklog({ taskId: 3, author: "sato", minutes: 10, note: "" }, db, new Date("2026-11-09T14:59:00Z"));
+  createWorklog({ taskId: 3, author: "sato", minutes: 20, note: 'a,"b"' }, db, new Date("2026-11-09T15:00:00Z"));
+  assert.equal(
+    exportMyWorklogs("sato", "2026-11-10", "2026-11-10", db),
+    '記録日時,タスク,作業時間（分）,メモ\r\n2026/11/10 00:00,API 設計,20,"a,""b"""\r\n',
+  );
+});
