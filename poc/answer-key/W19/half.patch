diff --git a/src/lib/inspections.ts b/src/lib/inspections.ts
new file mode 100644
index 0000000..ad2e3c8
--- /dev/null
+++ b/src/lib/inspections.ts
@@ -0,0 +1,44 @@
+// 定期点検の記録。担当者は計測器のその他の項目（extra.inspector_id）に入れる。
+import { getDb, transaction, type Db } from "./db/index.ts";
+import { isValidDate } from "./dates.ts";
+import { isActiveUser } from "./users.ts";
+
+export type InspectionResult = "good" | "needs_repair";
+export type InspectionRecord = { id: number; instrumentId: number; inspectedOn: string; inspectorId: string; result: InspectionResult; note: string };
+
+export function listInspections(instrumentId: number, db: Db = getDb()): InspectionRecord[] {
+  return db
+    .prepare(
+      `SELECT id, instrument_id AS instrumentId, inspected_on AS inspectedOn, inspector_id AS inspectorId, result, note
+       FROM inspection_records WHERE instrument_id = ? ORDER BY inspected_on DESC, id DESC`,
+    )
+    .all(instrumentId) as InspectionRecord[];
+}
+
+export function lastInspectedOn(instrumentId: number, db: Db = getDb()): string | null {
+  const r = db.prepare("SELECT MAX(inspected_on) AS d FROM inspection_records WHERE instrument_id = ?").get(instrumentId) as { d: string | null };
+  return r.d;
+}
+
+export function validateInspection(b: Record<string, unknown>, db: Db = getDb()): string[] {
+  const errors: string[] = [];
+  if (!isValidDate(b.inspectedOn)) errors.push("点検日は YYYY-MM-DD 形式で入力してください");
+  if (typeof b.inspectorId !== "string" || !isActiveUser(b.inspectorId, db)) errors.push("点検した人は在籍している利用者から選んでください");
+  if (b.result !== "good" && b.result !== "needs_repair") errors.push("結果は good か needs_repair で指定してください");
+  return errors;
+}
+
+export function recordInspection(instrumentId: number, b: Record<string, unknown>, db: Db = getDb(), now = new Date()): InspectionRecord {
+  return transaction(db, () => {
+    const { lastInsertRowid } = db
+      .prepare("INSERT INTO inspection_records (instrument_id, inspected_on, inspector_id, result, note, recorded_at) VALUES (?, ?, ?, ?, ?, ?)")
+      .run(instrumentId, b.inspectedOn as string, b.inspectorId as string, b.result as string, typeof b.note === "string" ? b.note : "", now.toISOString());
+    if (b.result === "needs_repair") db.prepare("UPDATE instruments SET status = 'suspended' WHERE id = ?").run(instrumentId);
+    return listInspections(instrumentId, db).find((r) => r.id === Number(lastInsertRowid))!;
+  });
+}
+
+/** 担当者を extra.inspector_id に入れる前の確認。 */
+export function canAssignInspector(userId: unknown, db: Db = getDb()): boolean {
+  return userId === null || (typeof userId === "string" && isActiveUser(userId, db));
+}
diff --git a/tests/inspections.test.ts b/tests/inspections.test.ts
new file mode 100644
index 0000000..0ccdf25
--- /dev/null
+++ b/tests/inspections.test.ts
@@ -0,0 +1,22 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { openDb } from "../src/lib/db/index.ts";
+import { canAssignInspector, lastInspectedOn, listInspections, recordInspection, validateInspection } from "../src/lib/inspections.ts";
+import { getInstrument, listInstruments } from "../src/lib/instruments.ts";
+
+describe("点検", () => {
+  it("validates and records inspections, suspending on needs_repair", () => {
+    const db = openDb();
+    const id = listInstruments({}, db).find((i) => i.managementNo === "MI-0010")!.id;
+    assert.equal(validateInspection({ inspectedOn: "2026-11-01", inspectorId: "inoue", result: "good" }, db).length, 1);
+    recordInspection(id, { inspectedOn: "2026-11-01", inspectorId: "ito", result: "needs_repair" }, db);
+    assert.equal(getInstrument(id, db)!.status, "suspended");
+    assert.equal(lastInspectedOn(id, db), "2026-11-01");
+    assert.equal(listInspections(id, db).length, 1);
+  });
+  it("only active users can be assigned", () => {
+    const db = openDb();
+    assert.ok(canAssignInspector("sato", db));
+    assert.equal(canAssignInspector("inoue", db), false);
+  });
+});
