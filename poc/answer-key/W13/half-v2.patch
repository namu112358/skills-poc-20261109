--- /dev/null
+++ b/src/app/api/instruments/[id]/reservations/[reservationId]/approve/route.ts
@@ -0,0 +1,13 @@
+import { NextResponse } from "next/server";
+import { jsonError, requireApiUser } from "@/lib/api";
+import { approveReservation } from "@/lib/reservations";
+
+type Context = { params: Promise<{ id: string; reservationId: string }> };
+
+export async function POST(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const p = await params;
+  if (!approveReservation(Number(p.id), Number(p.reservationId), user.id)) return jsonError(400, "できません");
+  return NextResponse.json({ ok: true });
+}
