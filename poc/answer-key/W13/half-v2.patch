+
+/** 管理者が承認する。 */
+export function approveReservation(instrumentId: number, id: number, userId: string, db: Db = getDb()): boolean {
+  const r = getReservation(instrumentId, id, db);
+  const instrument = getInstrument(instrumentId, db);
+  if (!r || !instrument || instrument.managerId !== userId || r.status !== "active" || r.approved) return false;
+  db.prepare("UPDATE reservations SET approved = 1 WHERE id = ?").run(id);
+  return true;
+}
+
+/** 管理者が却下する（取消として扱う）。 */
+export function rejectReservation(instrumentId: number, id: number, userId: string, db: Db = getDb()): boolean {
+  const r = getReservation(instrumentId, id, db);
+  const instrument = getInstrument(instrumentId, db);
+  if (!r || !instrument || instrument.managerId !== userId || r.status !== "active") return false;
+  db.prepare("UPDATE reservations SET status = 'cancelled' WHERE id = ?").run(id);
+  return true;
+}
