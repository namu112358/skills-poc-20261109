+// 予約の承認・却下・取消の API Route の共通部分。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "./api.ts";
+import { parseId } from "./instruments.ts";
+import { changeReservation, type ReservationAction } from "./reservations.ts";
+
+const FORBIDDEN: Record<ReservationAction, string> = {
+  approve: "承認できるのは計測器の管理者（管理者が無効なら部署の代表者）です",
+  reject: "却下できるのは計測器の管理者（管理者が無効なら部署の代表者）です",
+  cancel: "予約を取り消せるのは、予約した本人と計測器の管理者です",
+};
+const INVALID_STATE: Record<ReservationAction, string> = {
+  approve: "承認できるのは承認待ちの仮予約だけです",
+  reject: "却下できるのは承認待ちの仮予約だけです",
+  cancel: "仮予約か確定した予約だけを取り消せます",
+};
+
+export async function handleReservationChange(
+  action: ReservationAction,
+  request: Request,
+  params: Promise<{ id: string; reservationId: string }>,
+): Promise<NextResponse> {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const p = await params;
+  const id = parseId(p.id);
+  const reservationId = parseId(p.reservationId);
+  if (id === undefined || reservationId === undefined) return jsonError(404, "予約が見つかりません");
+  const body = action === "reject" ? await readJson(request) : undefined;
+  const reason =
+    typeof body === "object" && body !== null && typeof (body as { reason?: unknown }).reason === "string"
+      ? (body as { reason: string }).reason
+      : undefined;
+  const result = changeReservation(action, id, reservationId, user.id, undefined, undefined, { reason });
+  if (!result.ok) {
+    if (result.reason === "not_found") return jsonError(404, "予約が見つかりません");
+    if (result.reason === "forbidden") return jsonError(403, FORBIDDEN[action]);
+    return jsonError(409, INVALID_STATE[action]);
+  }
+  return NextResponse.json({ reservation: result.reservation });
+}
