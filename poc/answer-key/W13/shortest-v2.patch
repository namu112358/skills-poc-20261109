diff --git a/src/app/api/instruments/[id]/reservations/[rid]/approve/route.ts b/src/app/api/instruments/[id]/reservations/[rid]/approve/route.ts
new file mode 100644
index 0000000..dad15a1
--- /dev/null
+++ b/src/app/api/instruments/[id]/reservations/[rid]/approve/route.ts
@@ -0,0 +1,10 @@
+import { NextResponse } from "next/server";
+import { requireApiUser } from "@/lib/api";
+import { approve } from "@/lib/reservations";
+
+export async function POST(_r: Request, { params }: { params: Promise<{ rid: string }> }) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  approve(Number((await params).rid));
+  return NextResponse.json({ ok: true });
+}
