+// GET /api/instruments?status=… — 計測器の一覧 / POST /api/instruments — 計測器を台帳に登録する。いずれもログインが必要。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import {
+  createInstrument,
+  isInstrumentStatus,
+  listInstruments,
+  managementNoExists,
+  validateInstrumentInput,
+  type InstrumentInput,
+} from "@/lib/instruments";
+
+export async function GET(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const params = new URL(request.url).searchParams;
+  const status = params.get("status");
+  const manager = params.get("manager");
+  return NextResponse.json({
+    instruments: listInstruments({
+      status: isInstrumentStatus(status) ? status : undefined,
+      managerId: manager || undefined,
+    }),
+  });
+}
+
+export async function POST(request: Request) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const result = validateInstrumentInput(await readJson(request));
+  if (!result.ok) return jsonError(400, "入力内容に誤りがあります", result.errors);
+  const input = result.value as InstrumentInput;
+  if (managementNoExists(input.managementNo)) return jsonError(409, "その管理番号はすでに登録されています");
+  return NextResponse.json({ instrument: createInstrument(input) }, { status: 201 });
+}
