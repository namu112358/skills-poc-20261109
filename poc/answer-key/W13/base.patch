+// POST /api/instruments/:id/loans/:loanId/return — 返却する。計測器は使用中に戻る。
+import { NextResponse } from "next/server";
+import { jsonError, requireApiUser } from "@/lib/api";
+import { parseId } from "@/lib/instruments";
+import { returnLoan } from "@/lib/loans";
+
+type Context = { params: Promise<{ id: string; loanId: string }> };
+
+export async function POST(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const p = await params;
+  const id = parseId(p.id);
+  const loanId = parseId(p.loanId);
+  const loan = id === undefined || loanId === undefined ? undefined : returnLoan(id, loanId);
+  return loan ? NextResponse.json({ loan }) : jsonError(404, "返却されていない貸出が見つかりません");
+}
