+// GET /api/instruments/:id/loans — 貸出の記録 / POST /api/instruments/:id/loans — 貸し出す（本文 { borrowerId, dueOn }）。
+import { NextResponse } from "next/server";
+import { jsonError, readJson, requireApiUser } from "@/lib/api";
+import { getInstrument, parseId } from "@/lib/instruments";
+import { lendInstrument, listLoans, validateLoanInput } from "@/lib/loans";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function GET(_request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  if (id === undefined || !getInstrument(id)) return jsonError(404, "計測器が見つかりません");
+  return NextResponse.json({ loans: listLoans(id) });
+}
+
+export async function POST(request: Request, { params }: Context) {
+  const user = await requireApiUser();
+  if (user instanceof NextResponse) return user;
+  const id = parseId((await params).id);
+  if (id === undefined || !getInstrument(id)) return jsonError(404, "計測器が見つかりません");
+  const input = validateLoanInput(await readJson(request));
+  if (!input.ok) return jsonError(400, "入力内容に誤りがあります", input.errors);
+  const result = lendInstrument(id, input.value);
+  if (!result.ok) {
+    return result.reason === "not_found"
+      ? jsonError(404, "計測器が見つかりません")
+      : jsonError(409, "使用中の計測器だけを貸し出せます");
+  }
+  return NextResponse.json({ loan: result.loan }, { status: 201 });
+}
