+// POST /api/jobs/overdue-loans — 返却予定日を過ぎた貸出を集計してログに出す（運用の cron が毎朝 8:00 JST に呼ぶ）。
+import { NextResponse } from "next/server";
+import { requireJobAuth } from "@/lib/api";
+import { todayJst } from "@/lib/dates";
+import { listOverdueLoans } from "@/lib/loans";
+import { logger } from "@/lib/logger";
+
+export async function POST(request: Request) {
+  const denied = requireJobAuth(request, "overdue-loans");
+  if (denied) return denied;
+  const today = todayJst();
+  const overdue = listOverdueLoans(today);
+  for (const loan of overdue) {
+    logger.info("loan.overdue", {
+      loanId: loan.id,
+      managementNo: loan.managementNo,
+      borrowerId: loan.borrowerId,
+      dueOn: loan.dueOn,
+    });
+  }
+  logger.info("job.completed", { job: "overdue-loans", today, overdue: overdue.length });
+  return NextResponse.json({ today, overdue: overdue.length });
+}
