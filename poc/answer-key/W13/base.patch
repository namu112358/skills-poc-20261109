diff --git a/src/lib/instruments.ts b/src/lib/instruments.ts
new file mode 100644
index 0000000..97538e9
--- /dev/null
+++ b/src/lib/instruments.ts
@@ -0,0 +1,214 @@
+// 計測器の台帳。
+import { getDb, type Db } from "./db/index.ts";
+import { isValidDate } from "./dates.ts";
+
+export type InstrumentStatus = "in_use" | "on_loan" | "calibrating" | "suspended" | "disposed";
+
+export type Instrument = {
+  id: number;
+  managementNo: string; // 管理番号（例: MI-0001）
+  name: string;
+  model: string; // 型式
+  location: string; // 設置場所
+  managerId: string; // 管理者（users.id）
+  intervalMonths: number; // 校正周期（月）
+  lastCalibratedOn: string; // 前回校正日 YYYY-MM-DD
+  status: InstrumentStatus;
+  note: string;
+};
+
+export const INSTRUMENT_STATUSES: readonly InstrumentStatus[] = ["in_use", "on_loan", "calibrating", "suspended", "disposed"];
+
+export const STATUS_LABELS: Record<InstrumentStatus, string> = {
+  in_use: "使用中",
+  on_loan: "貸出中",
+  calibrating: "校正中",
+  suspended: "使用停止",
+  disposed: "廃棄",
+};
+
+/** 台帳の編集で直接設定できる状態。貸出中は貸出・返却の操作でだけ変わる。 */
+export const EDITABLE_STATUSES: readonly InstrumentStatus[] = ["in_use", "calibrating", "suspended", "disposed"];
+
+export function isInstrumentStatus(value: unknown): value is InstrumentStatus {
+  return typeof value === "string" && (INSTRUMENT_STATUSES as readonly string[]).includes(value);
+}
+
+export type InstrumentFilter = {
+  status?: InstrumentStatus;
+  managerId?: string;
+};
+
+type InstrumentRow = {
+  id: number;
+  management_no: string;
+  name: string;
+  model: string;
+  location: string;
+  manager_id: string;
+  interval_months: number;
+  last_calibrated_on: string;
+  status: InstrumentStatus;
+  note: string;
+};
+
+const COLUMNS =
+  "id, management_no, name, model, location, manager_id, interval_months, last_calibrated_on, status, note";
+
+function toInstrument(row: InstrumentRow): Instrument {
+  return {
+    id: row.id,
+    managementNo: row.management_no,
+    name: row.name,
+    model: row.model,
+    location: row.location,
+    managerId: row.manager_id,
+    intervalMonths: row.interval_months,
+    lastCalibratedOn: row.last_calibrated_on,
+    status: row.status,
+    note: row.note,
+  };
+}
+
+export function listInstruments(filter: InstrumentFilter = {}, db: Db = getDb()): Instrument[] {
+  const rows = db
+    .prepare(
+      `SELECT ${COLUMNS} FROM instruments
+       WHERE (:status IS NULL OR status = :status) AND (:manager IS NULL OR manager_id = :manager)
+       ORDER BY management_no`,
+    )
+    .all({ status: filter.status ?? null, manager: filter.managerId ?? null }) as InstrumentRow[];
+  return rows.map(toInstrument);
+}
+
+export function getInstrument(id: number, db: Db = getDb()): Instrument | undefined {
+  const row = db.prepare(`SELECT ${COLUMNS} FROM instruments WHERE id = ?`).get(id) as InstrumentRow | undefined;
+  return row && toInstrument(row);
+}
+
+/** URL のパスの ID を検証する。正の整数でなければ undefined。 */
+export function parseId(value: unknown): number | undefined {
+  if (typeof value !== "string" || !/^[1-9][0-9]{0,9}$/.test(value)) return undefined;
+  return Number(value);
+}
+
+export type InstrumentInput = Omit<Instrument, "id">;
+
+export type ValidationResult<T> = { ok: true; value: T } | { ok: false; errors: string[] };
+
+const MANAGEMENT_NO_RE = /^[A-Z]{2}-\d{4}$/;
+
+function text(b: Record<string, unknown>, key: string, max: number, required: boolean): string | undefined {
+  const v = b[key];
+  if (typeof v !== "string" || v.length > max || (required && v.trim() === "")) return undefined;
+  return v.trim();
+}
+
+/**
+ * API に送られた計測器の内容を検証する。partial = true（更新）のときは、送られた項目だけを検証する。
+ * 管理者が存在するかは DB で確認する。貸出中（on_loan）は貸出の操作でだけ設定できる。
+ */
+export function validateInstrumentInput(
+  body: unknown,
+  options: { partial?: boolean } = {},
+  db: Db = getDb(),
+): ValidationResult<Partial<InstrumentInput>> {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, errors: ["リクエストの形式が正しくありません"] };
+  }
+  const b = body as Record<string, unknown>;
+  const errors: string[] = [];
+  const value: Partial<InstrumentInput> = {};
+  const need = (key: string) => !options.partial || key in b;
+
+  if (need("managementNo")) {
+    if (typeof b.managementNo !== "string" || !MANAGEMENT_NO_RE.test(b.managementNo)) {
+      errors.push("管理番号は「MI-0001」の形式で入力してください");
+    } else value.managementNo = b.managementNo;
+  }
+  if (need("name")) {
+    const v = text(b, "name", 100, true);
+    if (v === undefined) errors.push("名称は 1〜100 文字で入力してください");
+    else value.name = v;
+  }
+  for (const [key, label] of [["model", "型式"], ["location", "設置場所"]] as const) {
+    if (key in b || !options.partial) {
+      const v = key in b ? text(b, key, 100, false) : "";
+      if (v === undefined) errors.push(`${label}は 100 文字以内で入力してください`);
+      else value[key] = v;
+    }
+  }
+  if ("note" in b || !options.partial) {
+    const v = "note" in b ? text(b, "note", 1000, false) : "";
+    if (v === undefined) errors.push("備考は 1000 文字以内で入力してください");
+    else value.note = v;
+  }
+  if (need("managerId")) {
+    const exists =
+      typeof b.managerId === "string" && db.prepare("SELECT 1 FROM users WHERE id = ?").get(b.managerId) !== undefined;
+    if (!exists) errors.push("管理者が存在しません");
+    else value.managerId = b.managerId as string;
+  }
+  if (need("intervalMonths")) {
+    if (!Number.isInteger(b.intervalMonths) || (b.intervalMonths as number) < 1 || (b.intervalMonths as number) > 120) {
+      errors.push("校正周期は 1〜120 か月の整数で入力してください");
+    } else value.intervalMonths = b.intervalMonths as number;
+  }
+  if (need("lastCalibratedOn")) {
+    if (!isValidDate(b.lastCalibratedOn)) errors.push("前回校正日は YYYY-MM-DD 形式で入力してください");
+    else value.lastCalibratedOn = b.lastCalibratedOn;
+  }
+  if ("status" in b || !options.partial) {
+    const s = "status" in b ? b.status : "in_use";
+    if (!isInstrumentStatus(s) || !EDITABLE_STATUSES.includes(s)) errors.push("状態が正しくありません");
+    else value.status = s;
+  }
+  return errors.length > 0 ? { ok: false, errors } : { ok: true, value };
+}
+
+export function managementNoExists(managementNo: string, db: Db = getDb()): boolean {
+  return db.prepare("SELECT 1 FROM instruments WHERE management_no = ?").get(managementNo) !== undefined;
+}
+
+export function createInstrument(input: InstrumentInput, db: Db = getDb()): Instrument {
+  const { lastInsertRowid } = db
+    .prepare(
+      `INSERT INTO instruments (management_no, name, model, location, manager_id, interval_months, last_calibrated_on, status, note)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+    )
+    .run(
+      input.managementNo,
+      input.name,
+      input.model,
+      input.location,
+      input.managerId,
+      input.intervalMonths,
+      input.lastCalibratedOn,
+      input.status,
+      input.note,
+    );
+  return getInstrument(Number(lastInsertRowid), db)!;
+}
+
+/** 指定した項目だけを更新する。計測器が無ければ undefined。 */
+export function updateInstrument(id: number, changes: Partial<InstrumentInput>, db: Db = getDb()): Instrument | undefined {
+  const current = getInstrument(id, db);
+  if (!current) return undefined;
+  const next = { ...current, ...changes };
+  db.prepare(
+    `UPDATE instruments SET management_no = ?, name = ?, model = ?, location = ?, manager_id = ?, interval_months = ?,
+       last_calibrated_on = ?, status = ?, note = ? WHERE id = ?`,
+  ).run(
+    next.managementNo,
+    next.name,
+    next.model,
+    next.location,
+    next.managerId,
+    next.intervalMonths,
+    next.lastCalibratedOn,
+    next.status,
+    next.note,
+    id,
+  );
+  return getInstrument(id, db);
+}
