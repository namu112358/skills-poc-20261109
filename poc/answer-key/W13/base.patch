+  });
+});
+
+describe("isAuthorizedJobRequest", () => {
+  it("accepts only the configured bearer token", () => {
+    assert.equal(isAuthorizedJobRequest("Bearer s3cret", "s3cret"), true);
+    assert.equal(isAuthorizedJobRequest("Bearer wrong", "s3cret"), false);
+    assert.equal(isAuthorizedJobRequest("s3cret", "s3cret"), false);
+    assert.equal(isAuthorizedJobRequest(null, "s3cret"), false);
+    assert.equal(isAuthorizedJobRequest("Bearer ", ""), false);
+    assert.equal(isAuthorizedJobRequest("Bearer x", undefined), false);
+  });
+});
