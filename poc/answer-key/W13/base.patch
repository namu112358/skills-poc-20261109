+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { listCalibrations, recordCalibration, validateCalibrationInput } from "../src/lib/calibrations.ts";
+import { openDb } from "../src/lib/db/index.ts";
+import { listInstruments } from "../src/lib/instruments.ts";
+
+const byNo = (db: ReturnType<typeof openDb>, no: string) => listInstruments({}, db).find((i) => i.managementNo === no)!;
+const PASS = { calibratedOn: "2026-11-05", result: "pass", agency: "東日本計測サービス", certificateNo: "EJ-1" } as const;
+
+describe("recordCalibration", () => {
+  it("updates the last calibration date and returns calibrating instruments to use when passed", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0005");
+    const r = recordCalibration(inst.id, PASS, "tanaka", db);
+    assert.equal(r?.instrument.lastCalibratedOn, "2026-11-05");
+    assert.equal(r?.instrument.status, "in_use");
+    assert.equal(listCalibrations(inst.id, db)[0].certificateNo, "EJ-1");
+  });
+
+  it("does not move the last calibration date backwards", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0003");
+    const r = recordCalibration(inst.id, { ...PASS, calibratedOn: "2026-01-01" }, "suzuki", db);
+    assert.equal(r?.instrument.lastCalibratedOn, "2026-06-03");
+  });
+
+  it("suspends the instrument when failed and keeps the last calibration date", () => {
+    const db = openDb();
+    const inst = byNo(db, "MI-0001");
+    const r = recordCalibration(inst.id, { ...PASS, result: "fail" }, "sato", db);
+    assert.equal(r?.instrument.status, "suspended");
+    assert.equal(r?.instrument.lastCalibratedOn, "2026-01-20");
+  });
+
+  it("returns undefined for unknown instruments", () => {
+    assert.equal(recordCalibration(9999, PASS, "sato", openDb()), undefined);
+  });
+});
+
+describe("validateCalibrationInput", () => {
+  it("checks the date, result and agency", () => {
+    assert.equal(validateCalibrationInput(PASS).ok, true);
+    const r = validateCalibrationInput({ calibratedOn: "2026-02-30", result: "ok", agency: " " });
+    assert.equal(r.ok, false);
+    if (!r.ok) assert.equal(r.errors.length, 3);
+  });
+});
