# GitHub MCP 用 Fine-grained PAT（対象リポジトリのみ / 最小権限）
# 推奨権限: Contents: Read, Issues: Read & Write, Pull requests: Read & Write, Actions: Read, Metadata: Read
# 値はシェルの環境変数として設定し、このファイルに実値を書いてコミットしないこと。
GITHUB_PERSONAL_ACCESS_TOKEN=

# Supabase MCP（scripts/add-stack.sh supabase を適用した場合）
# 接続先を限定する開発用プロジェクトの project ref（秘密情報ではないが、本番の ref は設定しないこと）
SUPABASE_PROJECT_REF=
